[paths]
source =
    odoo/addons/
    */acsone/odoo-alcyon/odoo/addons

[run]
source =
    ./odoo/addons
dynamic_context = test_function
branch = True
parallel = True

[report]

omit =
    */scenario/*
    */scenarios/*
    */lib/*
    *_example/*
    *__init__.py
    *__manifest__.py
    *hooks.py
    *_parser.py
    # NOT INSTALLABLE ADDONS
    odoo/addons/alc_db_cleaner/*
    odoo/addons/alc_partner_delivery_person/*
    # END NOT INSTALLABLE ADDONS

# Regexes for lines to exclude from consideration
exclude_lines =
    pragma: no cover
    if context is None:
    raise NotImplementedError
    except ImportError:
    except AccessError:
