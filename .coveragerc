[paths]
source =
    odoo/addons/
    */acsone/odoo-alcyon/odoo/addons

[run]
source =
    ./odoo/addons
dynamic_context = test_function
branch = True
parallel = True

[report]

omit =
    */scenario/*
    */scenarios/*
    */lib/*
    *_example/*
    *__init__.py
    *__manifest__.py
    *hooks.py
    *_parser.py
    # NOT INSTALLABLE ADDONS
    odoo/addons/account_invoice_email/*
    odoo/addons/account_payment_order_background/*
    odoo/addons/alc_account_invoice_peppol_server_env/*
    odoo/addons/alc_country/*
    odoo/addons/alc_db_cleaner/*
    odoo/addons/alc_delivery_rounds_geooptimize/*
    odoo/addons/alc_edi_connector/*
    odoo/addons/alc_elasticsearch_price_sorting/*
    odoo/addons/alc_elasticsearch_score_script/*
    odoo/addons/alc_eshop/*
    odoo/addons/alc_eshop_app/*
    odoo/addons/alc_eshop_auth_api_key/*
    odoo/addons/alc_eshop_product_domain/*
    odoo/addons/alc_internal_package_groupbypartner/*
    odoo/addons/alc_mrp_repair/*
    odoo/addons/alc_partner_delivery_person/*
    odoo/addons/alc_partner_delivery_window_import/*
    odoo/addons/alc_price_cache_import/*
    odoo/addons/alc_print_all_deliveryslip/*
    odoo/addons/alc_product_promotion_mailing/*
    odoo/addons/alc_product_search_cnk/*
    odoo/addons/alc_purchase_order_import_ubl/*
    odoo/addons/alc_purchase_order_ubl/*
    odoo/addons/alc_shopfloor_cluster_picking_by_partners/*
    odoo/addons/alc_shopfloor_cluster_picking_transfer_async/*
    odoo/addons/alc_shopfloor_mobile_workstation/*
    odoo/addons/alc_shopinvader_category/*
    odoo/addons/alc_standby_delivery/*
    odoo/addons/alc_stock_location_barcode_search/*
    odoo/addons/alc_stock_picking_assignable/*
    odoo/addons/alc_stock_picking_number_package/*
    odoo/addons/alc_stock_picking_wave_type/*
    odoo/addons/alc_stock_storage_type/*
    odoo/addons/alc_storage/*
    odoo/addons/alce_purchase_report/*
    odoo/addons/base_cached_xmlid/*
    odoo/addons/l10n_be_vat/*
    odoo/addons/partner_archive_new_partner/*
    odoo/addons/shopinvader_search_engine_export/*
    odoo/addons/stock_inventory_constrains/*
    odoo/addons/storage_file_url_store/*
    odoo/addons/test_alc_shopfloor_stock_issue_product_additional/*
    odoo/addons/test_product_additional_groupbypartner/*
    # END NOT INSTALLABLE ADDONS

# Regexes for lines to exclude from consideration
exclude_lines =
    pragma: no cover
    if context is None:
    raise NotImplementedError
    except ImportError:
    except AccessError:
