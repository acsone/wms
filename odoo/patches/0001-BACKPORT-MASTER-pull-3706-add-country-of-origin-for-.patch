From 223a0e8b19a474bf24bfe9dae09c6c2ba396c8c8 Mon Sep 17 00:00:00 2001
From: vrenaville <vincent.renaville@camptocamp.com>
Date: Wed, 27 Feb 2019 10:42:39 +0100
Subject: [PATCH] [BACKPORT MASTER] pull 3706 , add country of origin for
 intrastat

---
 addons/l10n_be_intrastat_2019/__manifest__.py            |  2 ++
 .../l10n_be_intrastat_2019/data/account_invoice_data.xml | 15 +++++++++++++++
 addons/l10n_be_intrastat_2019/models/__init__.py         |  1 +
 .../models/account_invoice_line.py                       | 10 +++++++++-
 addons/l10n_be_intrastat_2019/models/product_template.py | 12 ++++++++++++
 .../views/product_template_view.xml                      | 16 ++++++++++++++++
 6 files changed, 55 insertions(+), 1 deletion(-)
 create mode 100644 addons/l10n_be_intrastat_2019/data/account_invoice_data.xml
 create mode 100644 addons/l10n_be_intrastat_2019/models/product_template.py
 create mode 100644 addons/l10n_be_intrastat_2019/views/product_template_view.xml

diff --git a/addons/l10n_be_intrastat_2019/__manifest__.py b/addons/l10n_be_intrastat_2019/__manifest__.py
index b3de01c..9adb859 100644
--- a/addons/l10n_be_intrastat_2019/__manifest__.py
+++ b/addons/l10n_be_intrastat_2019/__manifest__.py
@@ -10,6 +10,8 @@ Adds the possibility to specify the origin country of goods and the partner VAT
     'depends': ['l10n_be_intrastat'],
     'data': [
         'views/account_invoice_line_view.xml',
+        'views/product_template_view.xml',
+        'data/account_invoice_data.xml',
     ],
     'auto_install': True,
 }
diff --git a/addons/l10n_be_intrastat_2019/data/account_invoice_data.xml b/addons/l10n_be_intrastat_2019/data/account_invoice_data.xml
new file mode 100644
index 0000000..171af14
--- /dev/null
+++ b/addons/l10n_be_intrastat_2019/data/account_invoice_data.xml
@@ -0,0 +1,15 @@
+<?xml version="1.0" encoding="utf-8"?>
+<odoo>
+    <data>
+        <record model="ir.actions.server" id="action_set_intrastat_country">
+            <field name="name">Set Intrastat Country</field>
+            <field name="model_id" ref="account.model_account_invoice"/>
+            <field name="binding_model_id" ref="account.model_account_invoice" />
+            <field name="state">code</field>
+            <field name="code">
+for line in records.mapped('invoice_line_ids').filtered(lambda r: not r.intrastat_product_origin_country_id):
+    line._onchange_product_intrastat()
+            </field>
+        </record>
+    </data>
+</odoo>
\ No newline at end of file
diff --git a/addons/l10n_be_intrastat_2019/models/__init__.py b/addons/l10n_be_intrastat_2019/models/__init__.py
index 9115b4d..ed0606c 100644
--- a/addons/l10n_be_intrastat_2019/models/__init__.py
+++ b/addons/l10n_be_intrastat_2019/models/__init__.py
@@ -2,3 +2,4 @@
 
 from . import account_intrastat_report
 from . import account_invoice_line
+from . import product_template
diff --git a/addons/l10n_be_intrastat_2019/models/account_invoice_line.py b/addons/l10n_be_intrastat_2019/models/account_invoice_line.py
index 01199b0..579a92e 100644
--- a/addons/l10n_be_intrastat_2019/models/account_invoice_line.py
+++ b/addons/l10n_be_intrastat_2019/models/account_invoice_line.py
@@ -3,7 +3,15 @@
 
 from odoo import api, fields, models
 
+
 class AccountInvoiceLine(models.Model):
     _inherit = 'account.invoice.line'
 
-    intrastat_product_origin_country_id = fields.Many2one('res.country', string='Origin Country of Product')
+    intrastat_product_origin_country_id = fields.Many2one(
+        'res.country', string='Origin Country of Product')
+
+    @api.onchange('product_id')
+    def _onchange_product_intrastat(self):
+        if self.product_id:
+            self.intrastat_product_origin_country_id =\
+                self.product_id.intrastat_product_origin_country_id
diff --git a/addons/l10n_be_intrastat_2019/models/product_template.py b/addons/l10n_be_intrastat_2019/models/product_template.py
new file mode 100644
index 0000000..6d2bd80
--- /dev/null
+++ b/addons/l10n_be_intrastat_2019/models/product_template.py
@@ -0,0 +1,12 @@
+# -*- coding: utf-8 -*-
+# Part of Odoo. See LICENSE file for full copyright and licensing details.
+
+from odoo import fields, models
+
+
+class ProductTemplate(models.Model):
+    _inherit = "product.template"
+
+    intrastat_product_origin_country_id = fields.Many2one(
+        "res.country", string="Origin Country of Product"
+    )
diff --git a/addons/l10n_be_intrastat_2019/views/product_template_view.xml b/addons/l10n_be_intrastat_2019/views/product_template_view.xml
new file mode 100644
index 0000000..5c04600
--- /dev/null
+++ b/addons/l10n_be_intrastat_2019/views/product_template_view.xml
@@ -0,0 +1,16 @@
+<?xml version="1.0" encoding="utf-8"?>
+<odoo>
+    <data>
+        <record id="product_template_form_view_inherit_l10n_be_intrastat_2019" model="ir.ui.view">
+            <field name="name">product.template.form.inherit.l10n.be.intrastat.2019</field>
+            <field name="model">product.template</field>
+            <field name="inherit_id" ref="stock.view_template_property_form"/>
+            <field name="arch" type="xml">
+                <xpath expr="//field[@name='intrastat_id']"
+                       position="after">
+                    <field name="intrastat_product_origin_country_id"/>
+                </xpath>
+            </field>
+        </record>
+    </data>
+</odoo>
\ No newline at end of file
-- 
2.7.4

