<odoo>
    <record id="view_purchase_order_filter" model="ir.ui.view">
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.view_purchase_order_filter" />
        <field name="arch" type="xml">
            <filter name="my_purchases" position="attributes">
                <attribute
          name="domain"
        >['|', ('user_id', '=', uid), ('purchase_manager_id', '=', uid)]</attribute>
            </filter>
            <xpath expr="//filter[@name='my_purchases']" position="after">
                <filter
          name="without_responsible"
          string="Without responsible"
          domain="[('user_id', '=', False)]"
        />
                <filter
          name="without_supplier_user"
          string="Without Purchase Manager"
          domain="[('purchase_manager_id', '=', False)]"
        />
            </xpath>
            <field name="user_id" position="after">
                <field name="purchase_manager_id" />
            </field>
            <field name="user_id" />
            <filter name="representative" position="after">
                <filter
          string="Purchase Manager"
          name="purchase_manager"
          domain="[]"
          context="{'group_by': 'purchase_manager_id'}"
        />
            </filter>
        </field>

    </record>

    <record id="purchase_order_view_search" model="ir.ui.view">
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_view_search" />
        <field name="arch" type="xml">
            <field name="user_id" position="after">
                <field name="purchase_manager_id" />
            </field>
            <field name="user_id" />
            <filter name="representative" position="after">
                <filter
          string="Purchase Manager"
          name="purchase_manager"
          domain="[]"
          context="{'group_by': 'purchase_manager_id'}"
        />
            </filter>
        </field>

    </record>



    <record id="purchase_order_view_tree" model="ir.ui.view">
        <field
      name="name"
    >purchase.order.tree (in alc_supplier_purchase_manager)</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_view_tree" />
        <field name="arch" type="xml">
            <field name="user_id" position="after">
                <field name="purchase_manager_id" widget="many2one_avatar_user" />
            </field>
        </field>
    </record>

    <record id="purchase_order_kpis_tree" model="ir.ui.view">
        <field
      name="name"
    >purchase.order.tree (in alc_supplier_purchase_manager)</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_kpis_tree" />
        <field name="arch" type="xml">
            <field name="user_id" position="after">
                <field name="purchase_manager_id" widget="many2one_avatar_user" />
            </field>
        </field>
    </record>

    <record id="purchase_order_form" model="ir.ui.view">
        <field name="name">purchase.order.form</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form" />
        <field name="arch" type="xml">
            <field name="user_id" position="after">
                <field name="purchase_manager_id" widget="many2one_avatar_user" />
            </field>
        </field>
    </record>
</odoo>
