<odoo>

    <record model="ir.ui.view" id="stock_production_lot_form_view">
        <field name="name">stock.production.lot.form (in alc_stock_lot_available)</field>
        <field name="model">stock.production.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_form" />
            <field name="arch" type="xml">
                <data>
                    <field name="ref" position="before">
                        <field name="qty_available"/>
                    </field>
                </data>
            </field>
    </record>


    <record model="ir.ui.view" id="stock_production_lot_tree_view">
        <field name="name">stock.production.lot.tree (in alc_stock_lot_available)</field>
        <field name="model">stock.production.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_tree" />
            <field name="arch" type="xml">
                <data>
                    <field name="create_date" position="before">
                        <field name="qty_available"/>
                    </field>
                </data>
            </field>
    </record>

</odoo>
