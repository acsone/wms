<odoo>

    <record model="ir.ui.view" id="res_config_settings_form_view">
        <field name="name">res.config.settings.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <div id="product_packs_tracking" position="after">
                <div
          class="col-12 col-lg-6 o_setting_box"
          id="excludes_expired_lot_from_qty_available"
        >
                    <div class="o_setting_left_pane">
                        <field name="excludes_expired_lot_from_qty_available" />
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="excludes_expired_lot_from_qty_available" />
                        <div class="text-muted">
                            When checked, the expired lots will be excluded from the quantity available.
                        </div>
                    </div>
                </div>
            </div>
        </field>
    </record>


</odoo>
