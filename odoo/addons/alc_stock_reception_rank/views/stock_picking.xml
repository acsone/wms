<odoo>
  <record id="view_picking_tree" model="ir.ui.view">
    <field name="model">stock.picking</field>
    <field name="inherit_id" ref="stock.vpicktree" />
    <field name="arch" type="xml">
      <field name="state" position="after">
        <field name="count_partners_waiting_for_reception" optional="show" />
        <field name="count_products_waiting_for_reception" optional="show" />
      </field>
    </field>
  </record>
  <record id="view_picking_form" model="ir.ui.view">
    <field name="model">stock.picking</field>
    <field name="inherit_id" ref="stock.view_picking_form" />
    <field name="arch" type="xml">
      <field name="origin" position="after">
        <label
          for="count_partners_waiting_for_reception"
          attrs="{'invisible':[('count_partners_waiting_for_reception','&lt;' , 1)]}"
        />
        <div
          attrs="{'invisible':[('count_partners_waiting_for_reception','&lt;' , 1)]}"
        >
                    <field name="count_partners_waiting_for_reception" />
                    ;
                    <field name="count_products_waiting_for_reception" />
                    <button
            name="button_rank_recompute"
            class="oe_link"
            string="recompute"
            type="object"
          />
                </div>
      </field>
    </field>
  </record>
</odoo>
