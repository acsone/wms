<odoo>

    <record model="ir.ui.view" id="stock_picking_form_view">
        <field name="name">stock.picking.form (in alc_logiweb_maximum_package)</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form" />
        <field name="arch" type="xml">
          <div name="button_box" position="before">
            <div
          class="alert alert-warning"
          attrs="{'invisible': [('is_number_of_packages_outranged', '=', False)]}"
        >
              The number of packages outranged the adviced number of packages
            </div>
          </div>
          <field name="origin" position="after">
                <field name="is_number_of_packages_visible" invisble="1" />
                <label for="number_of_packages" string="Number of packages" />
                <div>
                  <field
            name="number_of_packages"
            class="oe_inline"
            attrs="{'invisible':[('is_number_of_packages_visible','=',False)]}"
            style="margin-right:5px"
          />
                  /
                  <field
            name="theoritical_number_of_packages"
            nolabel="1"
            class="oe_inline"
            attrs="{'invisible':[('is_number_of_packages_visible','=',False)]}"
            style="margin-left:5px"
          />
                </div>
          </field>
        </field>
    </record>

</odoo>
