<odoo>

    <record model="ir.ui.view" id="stock_location_form_view">
        <field name="model">stock.location</field>
        <field name="inherit_id" ref="shopfloor.view_location_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='shopfloor_picking_sequence']" position="after">
                <field
          name="display_in_shopfloor_product_info"
          attrs="{'invisible': [('usage', '!=', 'internal')]}"
        />
            </xpath>
        </field>
    </record>



</odoo>
