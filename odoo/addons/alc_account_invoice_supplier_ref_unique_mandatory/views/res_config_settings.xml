<odoo>
    <record model="ir.ui.view" id="res_config_settings_form_view">
        <field
      name="name"
    >res.config.settings.form (in alc_account_invoice_supplier_ref_mandatory)</field>
        <field name="model">res.config.settings</field>
        <field
      name="inherit_id"
      ref="account_invoice_supplier_ref_unique.res_config_settings_form_view"
    />
        <field name="arch" type="xml">
            <xpath
        expr="//div[@name='invoice_supplier_ref_unique_right_pane']/parent::div"
        position="after"
      >
                <div
          class="col-xs-12 col-md-6 o_setting_box"
          title="If you check this box, the system verifies that supplier invoice number is mandatory."
        >
                    <div class="o_setting_left_pane">
                        <field name="check_invoice_supplier_number_mandatory" />
                    </div>
                    <div
            class="o_setting_right_pane"
            name="invoice_supplier_ref_mandatory_right_pane"
          >
                        <label
              string="Check Supplier Invoice Number Mandatory"
              for="check_invoice_supplier_number_mandatory"
            />
                        <div class="text-muted">
                            Check whether the supplier invoice number is mandatory
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
