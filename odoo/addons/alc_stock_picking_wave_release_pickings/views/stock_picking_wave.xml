<odoo>
    <record model="ir.ui.view" id="stock_picking_wave_form_view">
        <field
      name="name"
    >stock.picking.wave.form (in alc_stock_picking_wave_release_pickings)</field>
        <field name="model">stock.picking.wave</field>
        <field name="inherit_id" ref="stock_picking_wave.view_picking_wave_form" />
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='done']" position="after">
            <field name="release_not_allowed" invisible="1" />
            <button
          name="release"
          string="Release"
          type="object"
          class="oe_highlight"
          attrs="{'invisible': [('release_not_allowed', '=', True)]}"
        />
            </xpath>
        </field>
    </record>
</odoo>
