<odoo>

    <record model="ir.ui.view" id="stock_release_channel_form_view">
        <field
      name="name"
    >stock.release.channel.form (in alc_stock_release_channel_deliver_toursolver)</field>
        <field name="model">stock.release.channel</field>
        <field
      name="inherit_id"
      ref="stock_release_channel.stock_release_channel_form_view"
    />
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="is_mobile_export_allowed" invisible="1" />
                    <button
          name="button_export_to_mobile_app"
          string="Export to mobile app"
          type="object"
          class="oe_stat_button"
          icon="fa-mobile"
          attrs="{'invisible': [('is_mobile_export_allowed', '=', False)]}"
        />
            </xpath>
        </field>
    </record>

</odoo>
