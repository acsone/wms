<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
  <record id="csv_import_wizard_view_form" model="ir.ui.view">
    <field name="name">csv.file.import.wizard.view.form</field>
    <field name="model">csv.file.import.wizard</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <h3>Imports</h3>
          <field name="import_ids" />
        </sheet>
        <footer>
          <button
            name="execute_imports"
            string="Execute imports"
            type="object"
            class="oe_highlight"
          />
          <button string="Cancel" class="oe_link" special="cancel" />
        </footer>
      </form>
    </field>
  </record>
</odoo>
