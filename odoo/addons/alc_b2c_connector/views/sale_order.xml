<odoo>
  <record model="ir.ui.view" id="sale_order_form_view">
    <field name="name">sale.order.form (in alc_b2c_connector)</field>
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="specific_sale.view_order_form" />
    <field name="arch" type="xml">
      <field name="sale_channel" position="after">
        <field name="b2c_ref" readonly="1" />
      </field>
    </field>
  </record>
  <record model="ir.ui.view" id="sale_order_search_view">
    <field name="name">sale.order.search (in alc_b2c_connector)</field>
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale.view_sales_order_filter" />
    <field name="arch" type="xml">
      <field name="product_id" postion="after">
        <field name="b2c_ref" />
      </field>
    </field>
  </record>
</odoo>
