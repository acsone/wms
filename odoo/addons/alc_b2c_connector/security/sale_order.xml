<odoo>

    <record id="sale_order_b2c_rule" model="ir.rule">
        <field name="name">sale_order b2c rule</field>
        <field ref="sale.model_sale_order" name="model_id" />
        <field name="domain_force">[('b2c_ref', '!=', False)]</field>
        <field name="perm_write" eval="1" />
        <field name="perm_create" eval="1" />
        <field name="perm_read" eval="1" />
        <field name="perm_unlink" eval="0" />
        <field name="groups" eval="[(4, ref('alc_b2c_connector.b2c_group'))]" />
    </record>
</odoo>
