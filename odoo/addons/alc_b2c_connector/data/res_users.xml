<odoo>
  <record
    id="alc_b2c_rest_api_user"
    model="res.users"
    context="{'no_reset_password': True}"
  >
    <field name="name">B2C REST API User</field>
    <field name="login">alc_b2c_rest_api_user</field>
    <field name="company_id" ref="base.main_company" />
    <field name="groups_id" eval="[(6,0,[])]" />
    <field name="active" eval="0" />
  </record>
  <function model="res.partner" name="write">
        <value
      model="res.partner"
      eval="obj().env.ref('alc_b2c_connector.alc_b2c_rest_api_user').partner_id.ids"
    />
        <value eval="{'user_id': ref('alc_b2c_connector.alc_b2c_rest_api_user')}" />
    </function>
</odoo>
