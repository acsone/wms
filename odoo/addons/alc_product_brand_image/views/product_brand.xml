<odoo>

    <record model="ir.ui.view" id="product_brand_form_view">
        <field name="name">product.brand.form (in alc_product_brand_image)</field>
        <field name="model">product.brand</field>
        <field name="inherit_id" ref="product_brand.view_product_brand_form" />
        <field name="arch" type="xml">
            <field name="logo" position="attributes">
                <attribute name="filename" value="logo_filename" />
            </field>
            <field name="logo" position="after">
                <field name="logo_filename" nvisible="1" />
            </field>
        </field>
    </record>

    <record model="ir.ui.view" id="product_brand_kanban_view">
        <field name="name">product.brand.kanban (in alc_product_brand_image)</field>
        <field name="model">product.brand</field>
        <field name="inherit_id" ref="product_brand.view_product_brand_kanban" />
        <field name="priority" eval="1000" />
        <field name="arch" type="xml">
            <field name="logo" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
            <field name="logo" position="after">
                <field name="image_small_url" widget="image_url" />
            </field>
            <xpath expr="//div[@class='o_kanban_image']/img" position="replace">
                <img t-att-src="record.image_small_url.value" />
            </xpath>
        </field>
    </record>

</odoo>
