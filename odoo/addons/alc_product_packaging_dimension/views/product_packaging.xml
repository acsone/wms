<odoo>
  <record id="product_packaging_form_view_inherit" model="ir.ui.view">
    <field name="name">product.packaging.form (in alc_product_packaging)</field>
    <field name="model">product.packaging</field>
    <field
      name="inherit_id"
      ref="product_packaging_dimension.product_packaging_form_view_inherit"
    />
    <field name="arch" type="xml">
      <field name="lngth" position="attributes">
        <attribute name="invisible">1</attribute>
      </field>
      <field name="width" position="attributes">
        <attribute name="invisible">1</attribute>
      </field>
      <field name="height" position="attributes">
        <attribute name="invisible">1</attribute>
      </field>
      <field name="volume" position="attributes">
        <attribute name="invisible">1</attribute>
      </field>
      <field name="lngth" position="after">
        <field name="length_cm" />
        <field name="width_cm" />
        <field name="height_cm" />
        <field name="volume_l" />
      </field>
    </field>
  </record>
</odoo>
