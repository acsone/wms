<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field
      name="name"
    >res.config.settings.view.form.inherit.product (in alc_product_packaging)</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="product.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@id='manage_volume_uom_setting']" postion="after">
                <div
          class="col-12 col-lg-6 o_setting_box"
          id="manage_packaging_displayed_uom"
        >
                    <div class="o_setting_left_pane">
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="product_weight_in_lbs" string="Weight" />
                        <div class="text-muted">
                            Define your unit of measure to display on packagings
                        </div>
                        <div class="content-group">
                            <div class="mt16">
                                <field
                  name="packaging_displayed_uom_id"
                  class="o_light_label"
                />
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
