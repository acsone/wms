<odoo noupdate="1">
    <record forcecreate="True" id="ir_cron_cleanup_average" model="ir.cron">
        <field name="name">Cleanup Average Replenishments</field>
        <field eval="False" name="active" />
        <field
      name="model_id"
      ref="stock_location_orderpoint.model_stock_location_orderpoint"
    />
        <field name="state">code</field>
        <field name="code">model.run_cleanup_method('average_daily_sale')</field>
        <field
      name="user_id"
      ref="alc_stock_location_orderpoint_cleanup.alc_stock_location_orderpoint_cleanup"
    />
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="doall" eval="False" />
        <field name="run_as_queue_job" eval="True" />
        <field name="no_parallel_queue_job_run" eval="True" />
    </record>

    <record forcecreate="True" id="ir_cron_cleanup_fillup" model="ir.cron">
        <field name="name">Cleanup Fillup Replenishments</field>
        <field eval="False" name="active" />
        <field
      name="model_id"
      ref="stock_location_orderpoint.model_stock_location_orderpoint"
    />
        <field name="state">code</field>
        <field
      name="code"
    >model.run_cleanup_method() # Default is fill_up</field> <!-- Default is fill_up -->
        <field
      name="user_id"
      ref="alc_stock_location_orderpoint_cleanup.alc_stock_location_orderpoint_cleanup"
    />
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="doall" eval="False" />
        <field name="run_as_queue_job" eval="True" />
        <field name="no_parallel_queue_job_run" eval="True" />
    </record>
</odoo>
