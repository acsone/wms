<odoo>
  <record model="ir.ui.view" id="sale_order_form_view">
    <field name="name">sale.order.form (in alc_sale_product_qty_unavailable)</field>
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale_order_line_cancel.sale_order_form_view" />
    <field name="arch" type="xml">
      <xpath
        expr="//field[@name='order_line']/form//label[@for='qty_delivered']"
        position="before"
      >
        <field name="product_qty_unavailable" />
      </xpath>
      <xpath
        expr="//field[@name='order_line']/tree//field[@name='product_uom_qty']"
        position="after"
      >
        <field name="product_qty_unavailable" />
        <field name="date_order" invisible="1" />
      </xpath>
    </field>
  </record>
  <record id="sale_order_line_tree_view" model="ir.ui.view">
    <field name="name">sale.order.line.tree (in procurement_sale)</field>
    <field name="model">sale.order.line</field>
    <field name="inherit_id" ref="sale.view_order_line_tree" />
    <field name="arch" type="xml">
      <xpath expr="//field[@name='order_id']" position="after">
        <field name="date_order" />
      </xpath>
    </field>
  </record>
</odoo>
