<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="package_level_tree_view_picking" model="ir.ui.view">
        <field name="name">Package Level Tree Picking (in alc_gls_putinpack)</field>
        <field name="model">stock.package_level</field>
        <field name="inherit_id" ref="stock.package_level_tree_view_picking" />
        <field name="arch" type="xml">
            <field name="state" position="before">
                <button
          name="display_package_content"
          title="Display package content"
          type="object"
          icon="fa-dropbox"
        />
            </field>
        </field>
    </record>
</odoo>
