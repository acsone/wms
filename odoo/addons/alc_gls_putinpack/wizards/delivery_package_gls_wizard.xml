<odoo>
  <record model="ir.ui.view" id="delivery_package_gls_wizard_form_view">
    <field name="name">GLS: send package wizard</field>
    <field name="model">delivery.package.gls.wizard</field>
    <field name="arch" type="xml">
      <form disable_autofocus="1">
        <group>
          <field name="picking_id" />
          <field name="allowed_package_ids" invisible="1" />
          <field name="package_id_domain" invisible="1" />
          <field name="package_id" domain="package_id_domain" />
          <field name="is_sent" invisible="1" required="1" />
          <field name="can_put_in_pack" invisible="1" />
          <field name="package_type_id" required="1" />
          <field name="shipping_weight" required="1" widget="web_scale" />
        </group>
        <footer>
                    <button
            name="put_in_pack"
            barcode_trigger="gls-send"
            class="btn btn-primary"
            type="object"
            string="Put in Pack"
            attrs="{'invisible': ['|', ('can_put_in_pack', '=', False), ('shipping_weight','=', 0)]}"
          />
                    <button
            name="send"
            barcode_trigger="gls-send"
            class="btn btn-primary"
            type="object"
            string="GLS: Send"
            attrs="{'invisible': ['|', ('package_id','=', False), ('is_sent','!=', False)]}"
          />
                    <button
            name="resend"
            class="btn btn-primary"
            type="object"
            string="GLS: Resend"
            attrs="{'invisible': ['|', ('package_id','=', False), ('is_sent','=', False)]}"
          />
                    <button
            name="abort"
            class="btn btn-primary"
            type="object"
            string="GLS: Cancel"
            attrs="{'invisible': ['|', ('package_id','=', False), ('is_sent','=', False)]}"
          />
                    <button special="cancel" string="Cancel" />
                </footer>
      </form>
    </field>
  </record>
  <record model="ir.actions.act_window" id="delivery_package_gls_wizard_act_window">
    <field name="name">GLS: send package wizard</field>
    <field name="res_model">delivery.package.gls.wizard</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
    <field name="domain">[]</field>
    <field name="context">{}</field>
  </record>
</odoo>
