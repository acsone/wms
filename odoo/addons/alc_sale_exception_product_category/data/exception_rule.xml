  <!-- General exceptions not enabled, test only or ? Should keep ? -->
  <record id="order_amount_material_maximum" model="exception.rule">
    <field name="name">Montant maximum à 1000 euros (matériel)</field>
    <field
      name="description"
    >Le montant total de la commande ne peut pas être supérieur à 1000 euros pour les produits de type matériel</field>
    <field name="active">False</field>
    <field name="sequence">30</field>
    <field name="model">sale.order</field>
    <field name="code">
material_category = object.env.ref('alc_product_category_data.product_categ_materiel')
material_categories = object.env['product.category'].search([('id', 'child_of', material_category.ids)])
if sum([line.price_total for line in object.order_line.filtered(lambda l: l.product_id.categ_id.id in material_categories.ids)]) &gt; 1000:
    failed=True
            </field>
    <field name="is_blocking">True</field>
  </record>
