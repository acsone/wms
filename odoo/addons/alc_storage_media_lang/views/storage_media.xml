<odoo>

    <record model="ir.ui.view" id="storage_media_form_view">
        <field name="name">storage.media.form (in alc_storage_media_lang)</field>
        <field name="model">storage.media</field>
        <field name="inherit_id" ref="storage_media.storage_media_view_form" />
        <field name="arch" type="xml">
            <field name="media_type_id" position="after">
                <field name="lang" />
            </field>
        </field>
    </record>

    <record model="ir.ui.view" id="storage_media_tree_view">
        <field name="name">storage.media.tree (in alc_storage_media_lang)</field>
        <field name="model">storage.media</field>
        <field name="inherit_id" ref="storage_media.storage_media_view_tree" />
        <field name="arch" type="xml">
            <field name="media_type_id" position="after">
                <field name="lang" />
            </field>
        </field>
    </record>

</odoo>
