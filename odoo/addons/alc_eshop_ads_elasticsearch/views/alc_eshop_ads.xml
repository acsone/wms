<odoo>

    <record model="ir.ui.view" id="alc_eshop_ads_form_view">
        <field name="name">alc.eshop.ads.form (in
            alc_eshop_ads_elasticsearch)
        </field>
        <field name="model">alc.eshop.ads</field>
        <field name="inherit_id" ref="alc_eshop_ads.alc_eshop_ads_form_view" />
        <field name="arch" type="xml">
            <div class="oe_button_box" name="button_box" position="inside">
                <field name="sync_state" invisible="1" />
                <button
          name="action_export_to_se"
          type="object"
          fg_color="red:sync_state in ('new', 'to_update');"
          icon="fa-life-ring"
        >
                    <span>Export to EShop</span>
                </button>
            </div>
        </field>
    </record>

    <record model="ir.actions.server" id="action_eshop_manual_export">
        <field name="name">Force EShop Export</field>
        <field name="model_id" ref="alc_eshop_ads.model_alc_eshop_ads" />
        <field name="state">code</field>
        <field name="code">records.action_export_to_se()
        </field>
    </record>
    <record id="run_action_eshop_manual_export" model="ir.values">
            <field name="model_id" ref="alc_eshop_ads.model_alc_eshop_ads" />
            <field name="name">Force EShop Export</field>
            <field name="key2">client_action_multi</field>
            <field name="key">action</field>
            <field name="model">alc.eshop.ads</field>
            <field
      name="value"
      eval="'ir.actions.server,' + str(ref('alc_eshop_ads_elasticsearch.action_eshop_manual_export'))"
    />
    </record>

</odoo>
