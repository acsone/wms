<odoo>

    <record model="ir.ui.view" id="stock_config_settings_form_view">
        <field name="name">stock.config.settings.form (in stock_refill)</field>
        <field name="model">stock.config.settings</field>
        <field name="inherit_id" ref="stock.view_stock_config_settings" />
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <group name="stock_refill" String="Gestion des réserves">
                    <field name="enable_reserve_on_putaway" />
                </group>
            </xpath>
        </field>
    </record>


</odoo>
