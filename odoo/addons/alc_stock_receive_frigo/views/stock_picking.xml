<odoo>
  <record model="ir.ui.view" id="stock_picking_form_view">
    <field name="name">stock.picking.form (in alc_stock_receive_frigo)</field>
    <field name="model">stock.picking</field>
    <field name="inherit_id" ref="stock.view_picking_form" />
    <field name="arch" type="xml">
      <field name="backorder_id" position="after">
        <field
          name="is_picking_frigo"
          readonly="1"
          attrs="{'invisible': [('is_picking_frigo','=',False)]}"
        />
      </field>
    </field>
  </record>
  <record model="ir.ui.view" id="stock_picking_tree_view">
    <field name="name">stock.picking.tree (in alc_stock_receive_frigo)</field>
    <field name="model">stock.picking</field>
    <field name="inherit_id" ref="stock.vpicktree" />
    <field name="arch" type="xml">
      <field name="origin" position="after">
        <field name="is_picking_frigo" />
      </field>
    </field>
  </record>
</odoo>
