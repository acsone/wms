<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="view_stock_history_report_tree" model="ir.ui.view">
    <field name="name">stock.history.report.tree</field>
    <field name="model">stock.history</field>
    <field name="inherit_id" ref="stock_account.view_stock_history_report_tree" />
    <field name="priority">99</field>
    <field name="arch" type="xml">
      <field name="product_id" position="replace">
        <field name="product_id" />
        <field name="product_categ_id" />
        <field name="product_supplier_id" />
        <field name="cost_method" />
        <field name="location_id" />
      </field>
      <field name="move_id" position="replace" />
    </field>
  </record>
  <record id="view_stock_history_report_search" model="ir.ui.view">
    <field name="name">stock.history.report.search</field>
    <field name="model">stock.history</field>
    <field name="inherit_id" ref="stock_account.view_stock_history_report_search" />
    <field name="arch" type="xml">
      <field name="product_id" position="after">
        <field
          name="product_categ_id"
          filter_domain="[('product_categ_id', 'child_of', self)]"
        />
        <field name="product_supplier_id" />
      </field>
    </field>
  </record>
  <record id="stock_account.action_history_tree" model="ir.actions.act_window">
    <field name="name">Current Inventory Valuation</field>
    <field name="res_model">stock.history</field>
    <field name="type">ir.actions.act_window</field>
    <field name="domain">[('date','&lt;=',time.strftime('%Y-%m-%d %H:%M:%S'))]</field>
    <field name="view_type">form</field>
    <field name="view_mode">tree,graph</field>
    <field
      name="context"
    >{'search_default_group_by_product': False, 'search_default_group_by_location': False}</field>
  </record>
  <record id="view_stock_history_report_pivot_inventory_value" model="ir.ui.view">
    <field name="name">stock.history.value.pivot.inventory.value</field>
    <field name="model">stock.history</field>
    <field name="inherit_id" ref="stock_account.view_stock_history_report_pivot" />
    <field name="priority">99</field>
    <field name="arch" type="xml">
      <field name="quantity" position="after">
        <field name="inventory_value" type="measure" />
      </field>
      <field name="location_id" position="replace">
            </field>
    </field>
  </record>
</odoo>
