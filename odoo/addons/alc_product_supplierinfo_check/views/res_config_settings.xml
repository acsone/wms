<odoo>
  <record model="ir.ui.view" id="res_config_settings_view_form">
    <field
      name="name"
    >res.config.settings.form (in alc_product_supplierinfo_check)</field>
    <field name="model">res.config.settings</field>
    <field name="inherit_id" ref="product.res_config_settings_view_form" />
    <field name="arch" type="xml">
      <xpath expr="//div[@id='companies']" position="after">
        <h2>Supplier constraints</h2>
        <div class="row mt16 o_settings_container" id="supplierinfo_general_settings">
          <div
            class="col-xs-12 col-md-6 o_setting_box"
            id="check_alcyon_constraints_on_supplierinfo"
          >
            <div class="o_setting_left_pane">
              <field name="check_alcyon_constraints_on_supplierinfo" />
            </div>
            <div class="o_setting_right_pane">
              <label for="check_alcyon_constraints_on_supplierinfo" />
              <div class="text-muted">
                For Alcyon, constrains have been defined on the supplier info to enforce one supplier by product, avoid overlapping dates in supplier promotions, ensure that the supplier promotion are correctly defined, etc.
              </div>
            </div>
          </div>
        </div>
      </xpath>
    </field>
  </record>
</odoo>
