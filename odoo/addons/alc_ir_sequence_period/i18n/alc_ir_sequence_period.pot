#. module: alc_ir_sequence_period
#: model:ir.model.fields,help:alc_ir_sequence_period.field_ir_sequence__use_end_date
msgid ""
"By default Odoo will use the start date (from) to compute date with the\n"
"        prefix range_ (eg: range_year). If you set this flag Odoo will use the end date\n"
"        (to) to compute date with the prefix range. Eg: From 1/10/2016 to 31/9/2017\n"
"        without the flag: %(range_year)s => 2016 with the flag %(range_year)s => 2017"
msgstr ""

