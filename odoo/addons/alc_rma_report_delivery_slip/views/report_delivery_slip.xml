<odoo>
    <template
        id="report_deliveryslip"
        inherit_id="alc_report_delivery_slip.alcyon_report_deliveryslip"
    >
        <xpath expr="//div/h3[@id='rma_title']" position="after">
            <div id="rma_infos_container" t-if="deliveryslip.picking_type_code=='incoming'">
                <div t-if="deliveryslip.rma_id.reason_id">
                    <strong t-field="deliveryslip.rma_id.reason_id" />
                </div>
                <div t-if="deliveryslip.rma_id.operation_id">
                    <strong t-field="deliveryslip.rma_id.operation_id" />
                </div>
            </div>

        </xpath>
    </template>
</odoo>
