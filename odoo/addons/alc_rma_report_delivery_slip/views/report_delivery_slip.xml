<odoo>
    <template
        id="report_deliveryslip"
        inherit_id="alc_report_delivery_slip.alcyon_report_deliveryslip"
    >
        <xpath expr="//div/h3[@id='rma_title']" position="after">
            <div id="rma_infos_container">
                <div t-if="deliveryslip.rma_reason">
                    <strong>
                        <t t-esc="deliveryslip.rma_reason" />
                    </strong>
                </div>
                <div t-if="deliveryslip.rma_operation">
                    <strong>
                        <t t-esc="deliveryslip.rma_operation" />
                    </strong>
                </div>
            </div>

        </xpath>
    </template>
</odoo>
