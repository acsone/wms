<odoo>

    <record model="ir.ui.view" id="alc_stock_release_channel_unlock_form_view">
        <field name="model">alc.stock.release.channel.unlock</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="preparation_plan_id" />
                    <field
            name="stock_release_channel_tag_ids"
            widget="many2many_tags"
          />
                    <field name="process_end_date" />
                </group>
                <footer>
                    <button
            name="action_unlock"
            string="Unlock"
            class="btn-primary"
            type="object"
          />
                    <button string="Cancel" class="btn-default" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record
    model="ir.actions.act_window"
    id="alc_stock_release_channel_unlock_act_window"
  >
        <field name="name">Unlock Release Channels</field>
        <field name="res_model">alc.stock.release.channel.unlock</field>
        <field name="view_mode">form</field>
        <field name="context">{}</field>
        <field name="target">new</field>
    </record>


    <record model="ir.ui.menu" id="alc_stock_release_channel_unlock_menu">
        <field name="name">Unlock Release Channels</field>
        <field
      name="parent_id"
      ref="alc_stock_release_channel_menu.alc_stock_release_channel_action_menu"
    />
        <field name="action" ref="alc_stock_release_channel_unlock_act_window" />
        <field name="sequence" eval="20" />
    </record>
</odoo>
