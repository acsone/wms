<odoo>
  <record model="ir.ui.view" id="res_partner_form_view">
    <field name="name">res.partner.form (in alc_customer_audit)</field>
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="base.view_partner_form" />
    <field name="arch" type="xml">
      <form position="inside">
        <field name="has_anomaly" invisible="1" />
        <field name="no_release_channel" invisible="1" />
        <field name="no_pharmacist" invisible="1" />
      </form>
      <div name="button_box" position="before">
        <div
          class="alert alert-warning"
          role="alert"
          attrs="{'invisible': [('has_anomaly', '=', False)]}"
        >
                    Following issue(s) is/are observed on the customer:
                    <div attrs="{'invisible': [('no_release_channel', '=', False)]}">
            <p> - Customer is active without any release channel </p>
          </div>
                    <div attrs="{'invisible': [('no_pharmacist', '=', False)]}">
            <p
            >- Customer is a veterinarian with a depot and does not have a pharmacist</p>
          </div>
                </div>
      </div>
    </field>
  </record>
  <record model="ir.ui.view" id="res_partner_search_view">
    <field name="name">res.partner.search (in alc_customer_audit)</field>
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="base.view_res_partner_filter" />
    <field name="arch" type="xml">
      <xpath expr="//search" position="inside">
        <separator />
        <filter
          string="Customer has an anomaly"
          name="filter_has_anomaly"
          domain="[('has_anomaly','=',True)]"
        />
        <filter
          string="No release channel"
          name="filter_no_release_channel"
          domain="[('no_release_channel','=',True)]"
        />
        <filter
          string="No pharmacist"
          name="filter_no_pharmacist"
          domain="[('no_pharmacist','=',True)]"
        />
      </xpath>
    </field>
  </record>
  <record model="ir.ui.view" id="res_partner_tree_view">
    <field name="name">res.partner.tree (in alc_customer_audit)</field>
    <field name="model">res.partner</field>
    <field
      name="inherit_id"
      ref="alc_partner_manual_rank.view_res_partner_specific_tree"
    />
    <field name="arch" type="xml">
      <field name="is_supplier" position="after">
        <field name="has_anomaly" />
      </field>
    </field>
  </record>
</odoo>
