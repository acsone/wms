<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_repair_order_form" model="ir.ui.view">
        <field name="name">mrp.repair.form</field>
        <field name="model">mrp.repair</field>
        <field name="inherit_id" ref="mrp_repair.view_repair_order_form" />
        <field name="arch" type="xml">
            <xpath
        expr="(//button[@name='action_repair_cancel_draft'])[1]"
        position="attributes"
      >
                <attribute name="states">confirmed, cancel</attribute>
            </xpath>

            <xpath expr="(//button[@name='action_repair_cancel'])" position="after">
               <button
          name="action_send_quote_email"
          states="draft,confirmed"
          type="object"
          string="Send by email"
        />

            </xpath>

        </field>
    </record>
</odoo>
