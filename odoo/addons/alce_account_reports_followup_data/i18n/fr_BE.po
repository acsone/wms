msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"          Cher(e) Docteur,<br>\n"
"          Madame, Monsieur,<br>\n"
"          <br>\n"
"          Nous vous prions de trouver ci-dessous un relevé de factures "
"échues.<br>\n"
"          <br>\n"
"          Nous vous serions reconnaissants de vérifier que vous les avez "
"bien reçues et de procéder au paiement dans les meilleurs délais, ou de nous "
"contacter en cas de contestation.<br>\n"
"          <br>\n"
"          Si vous venez d’effectuer votre paiement, veuillez nous excuser "
"pour ce rappel.<br>\n"
"          <br>\n"
"          Nous restons à votre disposition et vous prions d'agréer, Cher(e) "
"Docteur, Madame, Monsieur, l'expression de nos sentiments dévoués.<br>\n"
"          <br>\n"
"          <br>\n"
"          Pour le service comptabilité<br>\n"
"          <br>\n"
"          JF MARECHAL<br>\n"
"          Jf.marechal@alcyonbelux.be<br>\n"
"          04/338 84 34<br>\n"
"        </div>\n"
"      "
msgstr ""
"\n"
"Cher(e) Docteur,\n"
"Madame, Monsieur,\n"
"\n"
"Nous vous prions de trouver ci-dessous un relevé de factures échues.\n"
"\n"
"Nous vous serions reconnaissants de vérifier que vous les avez bien reçues "
"et de procéder au paiement dans les meilleurs délais, ou de nous contacter "
"en cas de contestation.\n"
"\n"
"Si vous venez d’effectuer votre paiement, veuillez nous excuser pour ce "
"rappel.\n"
"\n"
"Nous restons à votre disposition et vous prions d'agréer, Cher(e) Docteur, "
"Madame, Monsieur, l'expression de nos sentiments dévoués.\n"
"\n"
"\n"
"Pour le service comptabilité\n"
"\n"
"JF MARECHAL\n"
"Jf.marechal@alcyonbelux.be\n"
"04/338 84 34\n"
"  "

