#. module: alce_account_reports_followup_data
#: model:mail.template,body_html:alce_account_reports_followup_data.alcyon_email_template_followup_1
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"          Cher(e) Docteur,<br>\n"
"          Madame, Monsieur,<br>\n"
"          <br>\n"
"          Nous vous prions de trouver ci-dessous un relevé de factures échues.<br>\n"
"          <br>\n"
"          Nous vous serions reconnaissants de vérifier que vous les avez bien reçues et de procéder au paiement dans les meilleurs délais, ou de nous contacter en cas de contestation.<br>\n"
"          <br>\n"
"          Si vous venez d’effectuer votre paiement, veuillez nous excuser pour ce rappel.<br>\n"
"          <br>\n"
"          Nous restons à votre disposition et vous prions d'agréer, Cher(e) Docteur, Madame, Monsieur, l'expression de nos sentiments dévoués.<br>\n"
"          <br>\n"
"          <br>\n"
"          Pour le service comptabilité<br>\n"
"          <br>\n"
"          JF MARECHAL<br>\n"
"          Jf.marechal@alcyonbelux.be<br>\n"
"          04/338 84 34<br>\n"
"        </div>\n"
"      "
msgstr ""

#. module: alce_account_reports_followup_data
#: model:mail.template,body_html:alce_account_reports_followup_data.alcyon_email_template_followup_2
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"          Cher(e) Docteur,<br>\n"
"          Madame, Monsieur,<br>\n"
"          <br>\n"
"          Sauf erreur ou omission de notre part, les factures reprises sur notre précédent rappel n’ont pas été réglées.<br>\n"
"          <br>\n"
"          Nous vous prions de trouver ci-dessous le relevé des factures échues et vous invitons donc à procéder au règlement dans les dix jours sur notre compte bancaire BE33 3400 3074 9846 – BBRUBEBB.<br>\n"
"          <br>\n"
"          Si entretemps vous avez effectué le paiement, veuillez nous excuser pour ce rappel.<br>\n"
"          <br>\n"
"          Nous restons à votre disposition et vous prions d'agréer, Cher(e) Docteur, Madame, Monsieur, l'expression de nos sentiments dévoués.<br>\n"
"          <br>\n"
"          <br>\n"
"          Pour le service comptabilité<br>\n"
"          <br>\n"
"          JF MARECHAL<br>\n"
"          Jf.marechal@alcyonbelux.be<br>\n"
"          04/338 84 34<br>\n"
"        </div>\n"
"      "
msgstr ""

