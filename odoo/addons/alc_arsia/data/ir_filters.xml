<odoo noupdate="1">
  <record id="arsia_product_assortment_filter" model="ir.filters">
    <field name="name">ARSIA Product Assortment</field>
    <field name="model_id">product.product</field>
    <field name="domain">[("categ_id", "child_of", ref('alc_product_category_data.product_categ_vet_belges'))]</field>
    <!-- initialized by the post init hook -->
    <field name="user_id" eval="False" />
    <field name="context">{}</field>
    <field name="is_assortment" eval="True" />
  </record>
</odoo>
