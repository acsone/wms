<odoo noupdate="1">

    <record
    model="res.users"
    id="alc_user_callcenter"
    context="{'no_reset_password': True}"
  >
      <field name="name">CallCenter Alcyon</field>
      <field name="login">callcenter</field>
      <field name="company_id" ref="base.main_company" />
      <field name="groups_id" eval="[Command.set([])]" />
