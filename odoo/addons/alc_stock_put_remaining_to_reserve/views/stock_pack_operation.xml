<odoo>
  <record model="ir.ui.view" id="stock_picking_form_view">
    <field
      name="name"
    >stock.picking.form (in alc_stock_put_remaining_to_reserve)</field>
    <field name="model">stock.picking</field>
    <field name="inherit_id" ref="stock.view_picking_form" />
    <field name="arch" type="xml">
      <xpath
        expr="//field[@name='pack_operation_product_ids']//field[@name='qty_done']"
        position="after"
      >
        <field name="is_action_put_in_reserve" invisible="1" />
        <button
          name="action_put_in_reserve"
          type="object"
          icon="fa-building-o"
          string="Put remaining items in reserve"
          attrs="{'invisible': [('is_action_put_in_reserve', '=', False)]}"
        />
      </xpath>
    </field>
  </record>
</odoo>
