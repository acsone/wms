<odoo>

    <record model="ir.ui.view" id="res_partner_form_view">
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <field name="loyalty_cards_count" invisible="1"/>
                    <button
                        class="oe_stat_button"
                        type="object"
                        icon="fa-tags"
                        name="action_open_loyalty_cards" attrs="{'invisible': [('loyalty_cards_count','=', 0)]}">
                        <field string="Loyalty Cards" name="loyalty_cards_count" widget="statinfo"/>
                    </button>
                </div>
        </field>
    </record>



</odoo>
