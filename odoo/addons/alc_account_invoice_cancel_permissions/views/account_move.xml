<odoo>

    <record model="ir.ui.view" id="account_move_form_view">
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath expr="//button[@name='button_cancel']" position="before">
                <field name="action_invoice_cancel_allowed" invisible="1" />
            </xpath>
            <xpath expr="//button[@name='button_cancel'][2]" position="attributes">
                <attribute
          name="attrs"
        >{'invisible':['|', '|', ('id', '=', False), ('action_invoice_cancel_allowed', '!=', True),('move_type', '==', 'entry')]}</attribute>
            </xpath>
        </field>
    </record>

</odoo>
