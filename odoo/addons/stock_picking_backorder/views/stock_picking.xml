<odoo>

    <record model="ir.ui.view" id="stock_picking_form_view">
        <field name="name">stock.picking.form (in stock_picking_backorder)
        </field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <button name="button_scrap" position="after">
                <field name="is_action_force_transfer_allowed" invisible="1"/>
                <button name="action_force_transfer"
                        string="Force transfer"
                        type="object"
                    attrs="{'invisible': [('is_action_force_transfer_allowed', '=', False)]}"/>
            </button>
        </field>
    </record>

</odoo>
