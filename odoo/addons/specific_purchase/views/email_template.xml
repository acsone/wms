<?xml version="1.0" encoding="UTF-8" ?>
<odoo noupdate="1">
  <record id="cancel_purchase_order" model="mail.template">
    <field name="name">Cancel purchase order</field>
    <field name="model_id" ref="purchase.model_purchase_order" />
    <field name="partner_to">${object.partner_id.id}</field>
    <field name="subject">Purchase order ${object.partner_ref or ''} canceled</field>
    <field name="body_html">
            <![CDATA[
                <p>Hello,</p>
                <p>We decided to cancel the purchase order ${object.partner_ref or ''} (${object.amount_total} €) from ${object.date_order} for the following reason:<br/>
                ${object.cancel_reason_id.name}</p>
                <p>Thank you for your understanding.</p>
                <p>Best regards,<br/>
                Alcyon</p>
            ]]>
        </field>
  </record>
</odoo>
