#. module: alc_product_expiry
#: model:ir.model.fields,field_description:alc_product_expiry.field_stock_picking__to_process_quant_expired
msgid "Bypass restriction on expired quants"
msgstr "Ignorer les restrictions sur les lots expirés"

#. module: alc_product_expiry
#: model:ir.model.fields,help:alc_product_expiry.field_stock_picking_type__no_expired_reservation_allowed
msgid ""
"Check this box to enforce a policy that prevents reservations for lots that "
"have already expired. When enabled, users won't be able to make reservations"
" for lots whose expiration date has passed."
msgstr ""
"Cochez cette case pour appliquer une politique qui empêche les réservations "
"pour les lots déjà expirés. Lorsque activée, les utilisateurs ne pourront "
"pas effectuer de réservations pour des lots dont la date d'expiration est "
"dépassée."

#. module: alc_product_expiry
#: model:ir.model.fields,field_description:alc_product_expiry.field_stock_picking_type__no_expired_reservation_allowed
msgid "Disallow Expired Lot Reservations"
msgstr "Interdiction des réservations de lots expirés"

