<odoo>
    <record model="ir.ui.view" id="product_template_form_view">
        <field name="name">product.template.form (in alc_product_is_new)</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view" />
        <field name="arch" type="xml">
            <form position="inside">
                <field name="new_product_with_old_date" invisible="1" />
            </form>
            <header position="after">
                <div
          class="alert alert-warning"
          role="alert"
          attrs="{'invisible': [('new_product_with_old_date', '=', False)]}"
        >
                    <div>
                        <p
            >Product has the storage type 'new' but is older than a month</p>
                    </div>
                </div>
            </header>
        </field>
    </record>

    <record model="ir.ui.view" id="product_template_search_view">
        <field name="name">product.template.search (in alc_product_is_new)</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view" />
        <field name="arch" type="xml">
            <xpath expr="//search//filter[@name='consumable']" position="after">
                <separator />
                <filter
          name="filter_new_product_with_old_date"
          string="Product is categorized as 'new' but is older than a month"
          domain="[('new_product_with_old_date', '=', True)]"
        />
            </xpath>
        </field>
    </record>
</odoo>
