<odoo>

    <record model="ir.ui.view" id="alc_stock_release_channel_tag_form_view">
        <field name="model">alc.stock.release.channel.tag</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record model="ir.ui.view" id="alc_stock_release_channel_tag_tree_view">
        <field name="model">alc.stock.release.channel.tag</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
            </tree>
        </field>
    </record>


    <record model="ir.actions.act_window" id="alc_stock_release_channel_tag_act_window">
        <field name="name">Release Channel Tags</field>
        <field name="res_model">alc.stock.release.channel.tag</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>

    <record model="ir.ui.menu" id="alc_stock_release_channel_tag_menu">
        <field name="name">Release Channel Tags</field>
        <field name="parent_id" ref="stock.menu_stock_config_settings" />
        <field name="action" ref="alc_stock_release_channel_tag_act_window" />
        <field name="sequence" eval="20" />
    </record>

</odoo>
