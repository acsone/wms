<odoo>
    <record id="product_category_search_view" model="ir.ui.view">
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_search_view" />
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator />
                <filter
          name="is_web"
          string="Web category"
          domain="[('is_web', '=', True)]"
        />
                <filter
          name="is_not_web"
          string="Alcyon category"
          domain="[('is_web', '=', False)]"
        />
            </xpath>
        </field>
    </record>
    <record id="product_category_form_view" model="ir.ui.view">
        <field name="model">product.category</field>
       <field name="inherit_id" ref="product.product_category_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='first']" position="inside">
                <field name="is_web" readonly="1" />
            </xpath>
        </field>
    </record>
    <record id="product_category_action_form_web" model="ir.actions.act_window">
        <field name="name">Product Categories Web</field>
        <field name="res_model">product.category</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="product.product_category_list_view" />
        <field
      name="search_view_id"
      ref="alc_product_shop_category.product_category_search_view"
    />
        <field name="context">{'search_default_is_web': 1}</field>
    </record>


    <record id="product.product_category_action_form" model="ir.actions.act_window">
        <field name="context">{'search_default_is_not_web': 1}</field>
    </record>

    <record model="ir.ui.menu" id="menu_product_category_is_web">
        <field name="name">Product Categories Web</field>
        <field name="parent_id" ref="sale.prod_config_main" />
        <field
      name="action"
      ref="alc_product_shop_category.product_category_action_form_web"
    />
        <field name="sequence" eval="1" />
        <field name="groups_id" eval="[(6,0,[ref('base.group_no_one')])]" />
    </record>
</odoo>
