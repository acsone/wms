<odoo>

    <record model="ir.ui.view" id="alc_delivery_plan_form_view">
        <field name="model">alc.delivery.plan</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget
            name="web_ribbon"
            title="Archived"
            bg_color="bg-danger"
            attrs="{'invisible': [('active', '=', True)]}"
          />
                    <div class="oe_button_box" name="button_box">
                        <button
              class="oe_stat_button"
              type="object"
              name="action_show_channels"
              icon="fa-map-o"
              string="Channels"
            />
                        </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" />
                        </h1>
                    </div>
                    <field name="active" invisible="1" />
                </sheet>
            </form>
        </field>
    </record>


    <record model="ir.ui.view" id="alc_delivery_plan_tree_view">
        <field name="model">alc.delivery.plan</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
            </tree>
        </field>
    </record>

    <record model="ir.actions.act_window" id="alc_delivery_plan_act_window">
        <field name="name">Delivery Plans</field>
        <field name="res_model">alc.delivery.plan</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>

    <record model="ir.ui.menu" id="alc_delivery_plan_menu">
        <field name="name">Delivery Plans</field>
        <field
      name="parent_id"
      ref="alc_stock_release_channel_menu.alc_stock_release_channel_setting_menu"
    />
        <field name="action" ref="alc_delivery_plan_act_window" />
        <field name="sequence" eval="16" />
    </record>

    <record id="alc_import_delivery_zone_wizard_action" model="ir.actions.server">
        <field name="name">Import Release channels</field>
        <field name="model_id" ref="model_alc_delivery_plan" />
        <field name="binding_model_id" ref="model_alc_delivery_plan" />
        <field name="state">code</field>
        <field name="code">action = records.action_import_release_channels()</field>
    </record>

</odoo>
