<odoo>

    <record model="ir.ui.view" id="stock_release_channel_form_view">
        <field name="model">stock.release.channel</field>
        <field
                name="inherit_id"
                ref="stock_release_channel_geoengine.stock_release_channel_form_view"
        />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='delivery_zone']" position="before">
                <group>
                    <group>
                        <field name="shape_name"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
