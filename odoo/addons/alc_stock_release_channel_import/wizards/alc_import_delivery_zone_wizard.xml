<odoo>

    <record model="ir.ui.view" id="alc_import_delivery_zone_wizard_form_view">
        <field name="model">alc.import.delivery.zone.wizard</field>
        <field name="arch" type="xml">
            <form string="Alc Import Delivery Zone Wizard">
                <group>
                    <field name="delivery_plan_id" />
                    <field name="file" filename="filename" />
                    <field name="filename" invisible="1" />
                </group>
                <footer>
                    <button
            name="button_import"
            string="Import"
            class="btn-primary"
            type="object"
          />
                    <button string="Cancel" class="btn-default" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record
    model="ir.actions.act_window"
    id="alc_import_delivery_zone_wizard_act_window"
  >
        <field name="name">Import Delivery Plans</field>
        <field name="res_model">alc.import.delivery.zone.wizard</field>
        <field name="view_mode">form</field>
        <field name="context">{}</field>
        <field name="target">new</field>
    </record>

    <record model="ir.ui.menu" id="alc_import_delivery_zone_wizard_menu">
        <field name="name">Import Delivery Plans</field>
        <field
      name="parent_id"
      ref="alc_stock_release_channel_menu.alc_stock_release_channel_action_menu"
    />
        <field name="action" ref="alc_import_delivery_zone_wizard_act_window" />
        <field name="sequence" eval="100" />
    </record>
</odoo>
