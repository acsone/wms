<odoo>

    <record model="ir.ui.view" id="stock_release_channel_form_view">
        <field name="model">stock.release.channel</field>
        <field
      name="inherit_id"
      ref="stock_release_channel.stock_release_channel_form_view"
    />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']/parent::h1" position="after">
                <group>
                    <label for="total_weight" />
                        <div>
                            <field name="total_weight" class="oe_inline" />
                            <span class="oe_inline mr4" />
                            <field name="weight_uom_name" class="oe_inline" />
                        </div>
                </group>
            </xpath>
        </field>
    </record>



</odoo>
