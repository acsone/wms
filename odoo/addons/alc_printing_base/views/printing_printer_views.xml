<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
  <record id="printing_printer_view_tree" model="ir.ui.view">
    <field name="name">printing.printer.view.tree</field>
    <field name="model">printing.printer</field>
    <field name="inherit_id" ref="base_report_to_printer.printing_printer_view_tree" />
    <field name="arch" type="xml">
      <xpath expr="//field[@name='system_name']" position="after">
        <field name="code" />
        <field name="type" />
      </xpath>
    </field>
  </record>
  <record id="printing_printer_view_form" model="ir.ui.view">
    <field name="name">printing.printer.view.form</field>
    <field name="model">printing.printer</field>
    <field name="inherit_id" ref="base_report_to_printer.printing_printer_view_form" />
    <field name="arch" type="xml">
      <xpath expr="//field[@name='location']" position="after">
        <field name="code" />
        <field name="type" />
      </xpath>
    </field>
  </record>
</odoo>
