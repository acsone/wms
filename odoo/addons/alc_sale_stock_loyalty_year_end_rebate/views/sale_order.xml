<?xml version="1.0" ?>
<odoo>
    <record id="sale_order_view_form_display_discount" model="ir.ui.view">
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="priority">200</field>
        <field name="arch" type="xml">
            <data>
                <xpath expr="//group[@name='sale_total']/field[last()]" position="after">
                    <field name="rebate_potential_amount" />
                    <field name="rebate_accrued_amount" />
                    <field name="rebate_accrued_total_amount" />
                </xpath>
            </data>
        </field>
    </record>
</odoo>
