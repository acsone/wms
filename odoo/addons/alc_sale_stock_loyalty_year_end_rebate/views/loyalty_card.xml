<odoo>

    <record model="ir.ui.view" id="loyalty_card_form_view">
        <field name="model">loyalty.card</field>
        <field name="inherit_id" ref="loyalty.loyalty_card_view_form"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="program_type" invisible="1"/>
            </field>
            <xpath expr="//span" position="after">
                <label string="Accrued Points" for="accrued_points"/>
                <span class="d-inline-block" attrs="{'invisible': [('program_type', '!=', 'year_end_rebate')]}" >
                    <field name="accrued_points" class="w-auto oe_inline me-1"/>
                    <field name="point_name" no_label="1" class="d-inline"/>
                </span>
            </xpath>
        </field>
    </record>

    <record model="ir.ui.view" id="loyalty_card_tree_view">
        <field name="model">loyalty.card</field>
        <field name="inherit_id" ref="loyalty.loyalty_card_view_tree"/>
        <field name="arch" type="xml">
            <field name="points_display" position="after">
                <field name="accrued_points"/>
            </field>
        </field>
    </record>

</odoo>
