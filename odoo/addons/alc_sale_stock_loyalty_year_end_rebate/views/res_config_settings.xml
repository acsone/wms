<odoo>
  <record model="ir.ui.view" id="res_config_settings_form_view">
    <field name="model">res.config.settings</field>
    <field name="inherit_id" ref="sale.res_config_settings_view_form" />
    <field name="arch" type="xml">
      <xpath expr="//div[@id='proforma_configuration']" position="after">
        <div
          class="col-xs-12 col-md-6 o_setting_box"
          id="display_rebate_on_sale_order_report"
        >
          <div class="o_setting_left_pane">
            <field name="display_rebate_on_sale_order_report" />
          </div>
          <div class="o_setting_right_pane">
            <label for="display_rebate_on_sale_order_report" string="Display rebate on printed sale order" />
            <div class="text-muted">
              If checked, the rebate information will be displayed on the sale order reports.
            </div>
          </div>
        </div>
      </xpath>
    </field>
  </record>
</odoo>
