<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <template
    id="report_saleorder_specific_document"
    inherit_id="sale.report_saleorder_document"
  >
    <!--
            Add "Quantity unavailable" column
            Add "Discount 2" column
            Add "Discount 3" column
            The additional warnings are now handled in : alc_sale_order_product_category_warning
        -->
    <xpath expr="//th[@name='th_description']" position="before">
      <th name="th_reference" class="text-start">Product reference</th>
    </xpath>
    <xpath expr="//th[@name='th_quantity']" position="after">
      <th class="text-end">BO</th>
    </xpath>
    <xpath expr="//th[@name='th_taxes']" position="after">
      <th class="text-end">Promotion</th>
      <th class="text-end">Discount</th>
    </xpath>
    <xpath expr="//td[@name='td_name']" position="before">
      <td>
        <span t-field="line.product_id.default_code" />
      </td>
    </xpath>
    <xpath expr="//td[@name='td_quantity']" position="after">
      <td class="text-end">
        <span t-field="line.product_qty_unavailable" />
      </td>
    </xpath>
    <xpath expr="//td[@name='td_taxes']" position="after">
       <td class="text-end">
        <span t-field="line.discount2" />
      </td>
      <td class="text-end">
        <span t-field="line.discount3" />
      </td>
    </xpath>
  </template>
</odoo>
