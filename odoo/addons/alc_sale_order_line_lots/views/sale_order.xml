<odoo>

    <record model="ir.ui.view" id="sale_order_form_view">
        <field name="name">sale.order.form (in alc_sale_order_line_lots)</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath
        expr="//field[@name='order_line']/tree//field[@name='name']"
        position="before"
      >
                <field name="older_lot_expiration_date" widget="date" />
            </xpath>
            <xpath
        expr="//field[@name='order_line']/form//div[@name='invoice_lines']"
        position="after"
      >
                <label
          for="action_view_lots"
          string="Lots:"
          style="font-weight: bold;"
        />
                <button
          name="action_view_lots"
          id="button_view_lots"
          type="object"
          class="oe_stat_button"
          icon="fa-bars"
        >
                    <span>View Lots</span>
                </button>
            </xpath>
        </field>
    </record>

</odoo>
