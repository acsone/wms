<odoo>
    <record model="ir.ui.view" id="alc_sale_line_stock_lot_tree_view">
        <field name="name">stock.lot.tree (in alc_sale_order_line_lots)</field>
        <field name="model">stock.lot</field>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="qty_available" />
                <field name="product_uom_id" />
                <field name="use_date" />
                <field name="expiration_date" />
            </tree>
        </field>
    </record>

    <record id="action_sale_line_lots" model="ir.actions.act_window">
        <field name="name">Lots/Serial Numbers</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">stock.lot</field>
        <field
      name="view_ids"
      eval="[(5, 0, 0),
                          (0, 0, {'view_mode': 'tree', 'view_id': ref('alc_sale_line_stock_lot_tree_view')}),
                          (0, 0, {'view_mode': 'form', 'view_id': ref('stock.view_production_lot_form')})]"
    />
        <field name="search_view_id" ref="stock.search_product_lot_filter" />
    </record>
</odoo>
