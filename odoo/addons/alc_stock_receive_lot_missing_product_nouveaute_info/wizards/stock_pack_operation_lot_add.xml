<odoo>

  <record model="ir.ui.view" id="stock_pack_operation_lot_add_form_view">
    <field
      name="name"
    >stock.pack.operation.lot.add.form (in alc_stock_receive_lot_missing_product_nouveaute_info)
    </field>
    <field name="model">stock.pack.operation.lot.add</field>
    <field
      name="inherit_id"
      ref="alc_stock_receive_lot.view_pack_operation_lot_add_form"
    />
    <field name="arch" type="xml">
      <xpath expr="//group[@name='operation_details']" position="after">
        <field name="edit_dimensions_barcode_fields" invisible="1" />
        <group name="missing_infos">
          <field
            name="product_weight"
            attrs="{'invisible': [('edit_dimensions_barcode_fields', '=', False)], 'required': [('edit_dimensions_barcode_fields', '=', True)]}"
          />
          <field
            name="product_length"
            attrs="{'invisible': [('edit_dimensions_barcode_fields', '=', False)], 'required': [('edit_dimensions_barcode_fields', '=', True)]}"
          />
          <field
            name="product_height"
            attrs="{'invisible': [('edit_dimensions_barcode_fields', '=', False)], 'required': [('edit_dimensions_barcode_fields', '=', True)]}"
          />
          <field
            name="product_width"
            attrs="{'invisible': [('edit_dimensions_barcode_fields', '=', False)], 'required': [('edit_dimensions_barcode_fields', '=', True)]}"
          />
          <field
            name="product_barcode"
            attrs="{'invisible': [('edit_dimensions_barcode_fields', '=', False)], 'required': [('edit_dimensions_barcode_fields', '=', True), ('no_barcode_authorized', '=', False)]}"
          />
          <field
            name="no_barcode_authorized"
            attrs="{'invisible': [('edit_dimensions_barcode_fields', '=', False)], 'required': [('edit_dimensions_barcode_fields', '=', True), ('product_barcode', '=', False)]}"
          />
          <field
            name="product_packaging_ids"
            attrs="{'invisible': [('edit_dimensions_barcode_fields', '=', False)]}"
            context="{'default_product_id': product_id}"
          />
        </group>
      </xpath>
    </field>
  </record>


</odoo>
