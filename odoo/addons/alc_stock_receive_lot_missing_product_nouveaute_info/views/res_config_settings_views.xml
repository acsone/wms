<odoo>

    <record model="ir.ui.view" id="res_config_settings_form_view">
        <field
      name="name"
    >res.config.settings.form (in alc_stock_receive_lot_missing_product_nouveaute_info)</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <div id="reception_report" position="after">
                <div
          class="col-12 col-lg-6 o_setting_box"
          id="reception_wizard_constraints"
        >
                    <div class="o_setting_left_pane">
                        <field name="reception_wizard_constraints" />
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="reception_wizard_constraints" />
                        <div class="text-muted">
                            Force the user to enter dimensions, weight and barcode of a new product received through the purchase reception wizard.
                        </div>
                    </div>
                </div>
            </div>
        </field>
    </record>

</odoo>
