<odoo>



    <record model="ir.ui.view" id="stock_picking_form_view">
        <field
      name="name"
    >stock.picking.form (in alc_stock_receive_lot_missing_product_nouveaute_info)</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form" />
        <field name="arch" type="xml">
            <header position="after">
                <field name="has_missing_info" invisible="1" />
                <div
          class="alert alert-danger"
          style="margin-bottom:0px;font-weight: bolder;text-align: center;"
          role="alert"
          attrs="{'invisible': [('has_missing_info', '=', False)]}"
        >
                    Some information are missing on new products (dimensions, weight or barcode), please complete them before picking.
                </div>
            </header>
            <xpath
        expr="//field[@name='move_ids_without_package']//tree/field[@name='quantity_done']"
        position="after"
      >
                <field name="has_missing_info" invisible="1" />
            </xpath>
            <xpath
        expr="//field[@name='move_ids_without_package']//tree"
        position="attributes"
      >
                <attribute name="decoration-danger">has_missing_info == True</attribute>
            </xpath>
        </field>
    </record>

</odoo>
