<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="view_stock_pack_operation_pivot" model="ir.ui.view">
    <field name="name">Stock.pack.operation.pivot</field>
    <field name="model">stock.pack.operation.operator</field>
    <field name="arch" type="xml">
      <pivot string="Packing Operation" disable_linking="True">
        <field name="operator_id" type="row" />
        <field name="write_date" type="col" interval="day" />
      </pivot>
    </field>
  </record>
  <record id="view_stock_pack_operation_search" model="ir.ui.view">
    <field name="name">stock.pack.operation.operator.search</field>
    <field name="model">stock.pack.operation.operator</field>
    <field name="arch" type="xml">
      <search>
        <group>
          <filter
            string="Nbr lignes Picking Last month"
            name="filter_nbr_lines_picking_last_month"
            domain="[
                      ('qty_done', '>', 0),
                      ('picking_destination_location_id', '=',%(stock.stock_location_output)d),
                      ('write_date', '&gt;=', (context_today()-relativedelta(months=1)).strftime('%Y-%m-01'))
                    ]"
          />
          <filter
            string="Last month"
            name="filter_last_month"
            domain="[
                      ('write_date', '&gt;=', (context_today()-relativedelta(months=1)).strftime('%Y-%m-01'))
                    ]"
          />
          <filter
            string="Nbr lignes Picking"
            name="filter_nbr_lines_picking"
            domain="[
                        ('qty_done', '>', 0),
                        ('picking_destination_location_id', '=', %(stock.stock_location_output)d),
                      ]"
          />
        </group>
      </search>
    </field>
  </record>
  <record id="action_stock_pack_operation_report" model="ir.actions.act_window">
    <field name="name">Stock Pack Operation Report</field>
    <field name="res_model">stock.pack.operation.operator</field>
    <field name="view_type">form</field>
    <field name="view_mode">pivot</field>
    <field name="context">{
            'search_default_filter_nbr_lines_picking_last_month': 1
          }</field>
    <field name="view_id" ref="view_stock_pack_operation_pivot" />
  </record>
  <menuitem
    action="action_stock_pack_operation_report"
    id="menu_pack_operation_report"
    parent="stock.menu_warehouse_report"
    sequence="140"
  />
</odoo>
