<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="zetes_logger_view_form" model="ir.ui.view">
        <field name="name">zetes.logger.view.form</field>
        <field name="model">zetes.logger</field>
        <field name="arch" type="xml">
            <form string="Zetes loggers">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="toggle_is_checked" type="object" class="oe_stat_button" icon="fa-check-square-o">
                            <field name="is_checked" widget="boolean_button" options='{"terminology": {"string_true": "Checked", "string_false": "Not checked"}}'/>
                        </button>
                    </div>
                    <group>
                        <field name="name"/>
                        <field name="traceback"/>
                        <field name="command"/>
                        <field name="action"/>
                        <field name="domain"/>
                        <field name="user_id"/>
                        <field name="picking_id"/>
                        <field name="operation_id"/>
                        <field name="error_type"/>
                    </group>
                    <notebook>
                        <page name="request" string="Request">
                            <group>
                                <field name="request" nolabel="1" colspan="2"/>
                                <field name="formatted_request" nolabel="1" colspan="2"/>
                            </group>
                        </page>
                        <page name="tech" string="Debug">
                            <separator for="call_stack" string="Call Stack"/>
                            <field name="call_stack"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="zetes_logger_view_tree" model="ir.ui.view">
        <field name="name">zetes.logger.view.tree</field>
        <field name="model">zetes.logger</field>
        <field name="arch" type="xml">
            <tree decoration-danger="to_check">
                <field name="to_check" invisible="1"/>
                <field name="create_date"/>
                <field name="name"/>
                <field name="traceback"/>
                <field name="command"/>
                <field name="action"/>
                <field name="domain"/>
                <field name="user_id"/>
                <field name="picking_id"/>
                <field name="operation_id"/>
                <field name="error_type"/>
                <button name="button_checked" string="Check" type="object" icon="fa-check-square-o" groups="stock.group_stock_manager"
                        attrs="{'invisible': [('to_check', '=', False)]}"/>
            </tree>
        </field>
    </record>

    <record id="zetes_logger_view_search" model="ir.ui.view">
        <field name="name">zetes.logger.view.search</field>
        <field name="model">zetes.logger</field>
        <field name="arch" type="xml">
            <search>
                <field name="command" string="Command" filter_domain="[('command','ilike',self)]"/>
                <field name="domain" string="Domain" filter_domain="[('domain','ilike',self)]"/>
                <field name="command" string="Complete command" filter_domain="[('command','ilike',self)]"/>
                <field name="picking_id" />
                <field name="operation_id" />
                <field name="user_id" />
                <field name="error_type" />
                <separator/>
                <filter name="need_to_be_check" string="Need to be check" domain="[('to_check', '=', True)]"/>
                <separator/>
                <filter name="human_error" string="Human errors" domain="[('error_type', '=', 'human')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_command" string="Command" context="{'group_by':'command'}"/>
                    <filter name="group_by_domain" string="Domain" context="{'group_by':'domain'}"/>
                    <filter name="group_by_command" string="Complete command" context="{'group_by':'command'}"/>
                    <filter name="group_by_user_id" string="User" context="{'group_by':'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_zetes_logger" model="ir.actions.act_window">
        <field name="name">Zetes logger</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">zetes.logger</field>
        <field name="view_type">form</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_need_to_be_check': 1}</field>
    </record>

    <menuitem action="action_zetes_logger" id="menu_zetes_logger" parent="stock.menu_stock_config_settings" sequence="60" groups="stock.group_stock_manager"/>
</odoo>
