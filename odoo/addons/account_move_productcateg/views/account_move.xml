<?xml version="1.0" ?>
<odoo>
  <record id="view_move_form" model="ir.ui.view">
    <field name="name">product category</field>
    <field name="model">account.move</field>
    <field name="inherit_id" ref="account.view_move_form" />
    <field name="arch" type="xml">
      <xpath
        expr="//field[@name='line_ids']/tree/field[@name='analytic_account_id']"
        position="after"
      >
        <field name="categ_id" />
      </xpath>
    </field>
  </record>
  <record id="view_move_line_form" model="ir.ui.view">
    <field name="name">product category</field>
    <field name="model">account.move.line</field>
    <field name="inherit_id" ref="account.view_move_line_form" />
    <field name="arch" type="xml">
      <field name="analytic_tag_ids" position="after">
        <field name="categ_id" />
      </field>
    </field>
  </record>
  <record id="view_move_line_search" model="ir.ui.view">
    <field name="name">product category</field>
    <field name="model">account.move.line</field>
    <field name="inherit_id" ref="account.view_account_move_line_filter" />
    <field name="arch" type="xml">
      <xpath expr="//group/filter[last()]" position="after">
        <filter string="Category" domain="[]" context="{'group_by':'categ_id'}" />
      </xpath>
    </field>
  </record>
</odoo>
