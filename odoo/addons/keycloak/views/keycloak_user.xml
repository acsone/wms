<odoo>
    <record model="ir.ui.view" id="keycloak_user_form_view">
        <field name="name">keycloak.user.form</field>
        <field name="model">keycloak.user</field>
        <field name="arch" type="xml">
            <form string="Keycloak User">
                <header>
                    <button
            name="action_open_update_wizard"
            type="object"
            string="Open Update Wizard"
            help="Update password or send actions to user."
          />
                </header>
                <sheet>
                    <label for="name" class="oe_edit_only" />
                    <h1>
                        <field name="username" />
                    </h1>
                    <group name="configuration" string="Configuration">
                        <field name="keycloak_backend_id" />
                        <field name="partner_id" />
                        <field name="enabled" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record model="ir.ui.view" id="keycloak_user_tree_view">
        <field name="name">keycloak.user.tree</field>
        <field name="model">keycloak.user</field>
        <field name="arch" type="xml">
            <tree>
                <field name="username" />
                <field name="enabled" />
                <field name="partner_id" />
                <field name="keycloak_backend_id" />
                <button
          name="action_open_update_wizard"
          type="object"
          icon="fa-cog"
          help="Update password or send actions to user."
        />
            </tree>
        </field>
    </record>

    <record model="ir.actions.act_window" id="keycloak_user_act_window">
        <field name="name">Keycloak Users</field>
        <field name="res_model">keycloak.user</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>

    <menuitem
    id="keycloak_user_menu"
    name="Keycloak Users"
    parent="base.menu_custom"
    action="keycloak_user_act_window"
  />
</odoo>
