<odoo>

    <record model="ir.ui.view" id="stock_release_channel_form_view">
        <field name="model">stock.release.channel</field>
        <field
      name="inherit_id"
      ref="stock_release_channel.stock_release_channel_form_view"
    />
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="is_action_print_cash_invoices_allowed" invisible="1" />
                    <button
          name="action_print_cash_invoices"
          string="Print INV"
          type="object"
          class="oe_stat_button"
          icon="fa-truck"
          attrs="{'invisible': [('is_action_print_cash_invoices_allowed', '=', False)]}"
        />
            </xpath>
        </field>
    </record>



</odoo>
