<?xml version="1.0" ?>
<odoo>
  <record id="view_product_putaway_form" model="ir.ui.view">
    <field name="name">product.putaway.defaultfixedlocation</field>
    <field name="model">product.putaway</field>
    <field name="inherit_id" ref="stock.view_putaway" />
    <field name="arch" type="xml">
      <field name="method" position="after">
        <field
          name="fixed_location_id"
          attrs="{'invisible': [('method', '!=', 'fixed')]}"
        />
      </field>
    </field>
  </record>
</odoo>
