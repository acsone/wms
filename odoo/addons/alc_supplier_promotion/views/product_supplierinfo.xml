<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
  <record id="product_supplierinfo_form_view" model="ir.ui.view">
    <field name="model">product.supplierinfo</field>
    <field name="inherit_id" ref="product.product_supplierinfo_form_view" />
    <field name="priority">20</field>
    <field name="arch" type="xml">
      <xpath expr="//group[field[@name='product_tmpl_id']]" position="after">
        <group string="Sale" name="sale">
          <field
            name="min_qty_sale"
            attrs="{'readonly': [('date_start', '=', False), ('date_end', '=', False)]}"
            widget="integer"
          />
          <field name="discount_sale" />
          <p colspan="2" style="font-weight: bold">For <field
              name="ratio_main_product"
              class="oe_inline"
              attrs="{'readonly': [('date_start', '=', False), ('date_end', '=', False)]}"
            /> products, <field
              name="ratio_promotional_product"
              class="oe_inline"
              attrs="{'readonly': [('date_start', '=', False), ('date_end', '=', False)]}"
            /> free.</p>
          <field
            name="only_for_veterinaries"
            attrs="{'invisible': [('ratio_main_product', '&lt;', 1)]}"
          />
        </group>
      </xpath>
      <xpath expr="//field[@name='min_qty']" position="attributes">
        <attribute
          name="attrs"
        >{'readonly': [('date_start', '=', False), ('date_end', '=', False)]}</attribute>
        <attribute name="widget">integer</attribute>
      </xpath>
    </field>
  </record>
  <record id="product_supplierinfo_tree_view" model="ir.ui.view">
    <field name="model">product.supplierinfo</field>
    <field name="inherit_id" ref="product.product_supplierinfo_tree_view" />
    <field name="arch" type="xml">
      <xpath expr="//tree" position="inside">
        <field name="ratio_display_name" />
      </xpath>
      <xpath expr="//field[@name='sequence']" position="attributes">
        <attribute name="widget" />
        <attribute name="invisible">1</attribute>
      </xpath>
      <xpath expr="//field[@name='min_qty']" position="attributes">
        <attribute name="widget">integer</attribute>
      </xpath>
      <field name="date_start" position="before">
        <field name="min_qty_sale" widget="integer" />
        <field name="discount_sale" />
      </field>
    </field>
  </record>
</odoo>
