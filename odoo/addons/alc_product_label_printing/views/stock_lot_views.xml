<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="view_production_lot_form" model="ir.ui.view">
    <field name="name">view.production.lot.form (in alc_product_label_printing)</field>
    <field name="inherit_id" ref="stock.view_production_lot_form" />
    <field name="model">stock.lot</field>
    <field name="arch" type="xml">
      <xpath expr="//div[@name='button_box']" position="inside">
        <button
          class="oe_stat_button"
          name="%(alc_label_printing_base.print_label_action)d"
          type="action"
          icon="fa-print"
          string="Print Lot"
          context="{'default_label_type': 'lot'}"
        />
      </xpath>
    </field>
  </record>
  <record id="action_menu_print_lots" model="ir.actions.act_window">
      <field name="name">Print lots</field>
      <field name="res_model">print.label</field>
      <field name="binding_model_id" ref="model_stock_lot" />
      <field name="binding_type">action</field>
      <field name="view_mode">form</field>
      <field name="target">new</field>
      <field name="context">{'default_label_type': 'lot'}</field>
  </record>
  <template id="stock_lot_label_zebra_v1">
    <div class="raw">
      <t t-foreach="docs" t-as="lot">
^XA
^PRC
^LH0,0^FS\r
^FO25,105^A0N,37,32^CI13^FR^FDLot:^FS\r
^FO90,105^A0N,37,32^CI13^FR^FD<t t-esc="lot.name" />^FS\r
^FO25,145^A0N,37,32^CI13^FR^FDBac:^FS\r
      <t t-if="lot.product_id.putaway_rule_ids">
          <t t-set="rule" t-value="lot.product_id.putaway_rule_ids[0]" />
^FO90,145^A0N,37,32^CI13^FR^FD<t
            t-esc="rule.location_in_id.name + '/' + rule.location_out_id.name"
          />^FS\r
      </t>
^FO25,190^A0N,37,32^CI13^FR^FDDate limite:^FS\r
^FO190,180^A0N,50,40^CI13^FR^FD<t
          t-out="lot.expiration_date and lot.expiration_date or ''"
          t-options='{"widget": "date"}'
        />^FS\r
^FO25,240^A0N,37,32^CI13^FR^FDArticle:^FS\r
^FO140,240^A0N,37,40^CI13^FR^FD<t t-esc="lot.product_id.default_code" />^FS\r
^FO25,283^A0N,31,23^CI13^FR^FD<t t-esc="lot.product_id.name[:30]" />^FS\r
^FO25,322^A0N,31,23^CI13^FR^FD<t t-esc="lot.product_id.name[30:75]" />^FS\r
^FO420,150\r
^BQN,2,6\r
^FDQA,#<t t-esc="lot.product_id.default_code" />#<t t-esc="lot.name" />^FS\r
^FO25,360^A0N,25,20^CI13^FR^FDPrint: <t t-esc="datetime.datetime.now().strftime('%d/%m/%Y')" />^FS\r
^XZ
</t>
    </div>
  </template>
  <record model="ir.actions.report" id="report_lot_label">
    <field name="name">Alcyon lot Label</field>
    <field name="model">stock.lot</field>
    <field name="report_type">qweb-pdf</field>
    <field
      name="report_name"
    >alc_product_label_printing.stock_lot_label_zebra_v1</field>
    <field
      name="report_file"
    >alc_product_label_printing.stock_lot_label_zebra_v1</field>
  </record>
</odoo>
