<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="view_move_line_form" model="ir.ui.view">
    <field name="name">stock.move.line.form (in alc_product_label_printing)</field>
    <field name="model">stock.move.line</field>
    <field name="inherit_id" ref="stock.view_move_line_form" />
    <field name="arch" type="xml">
      <xpath expr="//sheet" position="before">
          <button
          type="object"
          name="button_print_product_label"
          string="Print Med Product Label"
          class="oe-link fa fa-print"
        />
          <button
          name="print_food_report"
          type="object"
          string="Print Ali Product Label"
          context="{'default_label_type': 'food_product'}"
          class="oe-link"
        />
          <button
          type="object"
          name="button_print_product_product_label"
          string="Print Product Label"
          class="oe-link"
        />
      </xpath>
    </field>
  </record>
  <template id="stock_product_food_label_zebra_v1">
<div class="raw">
<t t-foreach="docs" t-as="line">
<t t-set="pick" t-value="line.picking_id" />
<t t-set="partner_info" t-value="line._product_food_label_partner_info()" />
<t
          t-set="ships"
          t-value="pick._get_all_dest_pickings().filtered(lambda r: r.picking_type_code == 'outgoing' and r.state not in ('cancel', 'done'))"
        />
<t t-set="ship" t-value="ships and ships[0]" />

<!--
Migration note:
The lot_id is given in arg in v10 as it is not part of the pack operation
In next versions, we can extract it from the move line

t t-set="lot_id" t-value="line.lot_id"
-->

<t t-foreach="xrange(1, int(qty_done) + 1)" t-as="index">
    ^XA
    ^FWR

    ^FO310,60^GB70,<t
            t-esc="len(pick.release_channel_id.channel_code or '') * 38"
          />,3,2^FS\r
    ^FO310,70^A060,60^FD<t t-esc="pick.release_channel_id.channel_code" />^FS\r

    <t t-if="('customer_id' in pick) and pick.customer_id.is_b2c_customer">
    ^FO330,330^A030,30^FDB2C^FS\r
    </t>

    ^FO310,480^A040,40^FD<t t-esc="index" /> / <t t-esc="int(qty_done)" />^FS\r

    ^FO255,60^A025,25^FD<t t-esc="partner_info['partner_name_first_line']" />^FS\r
    ^FO225,60^A025,25^FD<t t-esc="partner_info['partner_name_second_line']" />^FS\r
    ^FO195,60^A030,25^FD<t t-esc="partner_info['partner_zip']" /> <t
            t-esc="partner_info['partner_city']"
          />^FS\r
    ^FO165,60^A025,25^FD<t t-esc="partner_info['customer_name']" />^FS\r


    <t t-if="pick.partner_id.is_price_on_labels and line.product_id.indicated_price">
    ^FO130,420^A025,25^FDPVI <t t-esc="line.product_id.indicated_price" /> EUR^FS\r
    </t>

    ^FO80,60^BY2
    ^BC,40,Y,Y,N,A^FDS-<t t-esc="line.product_id.default_code" />-<t
            t-esc="lot_id and lot_id.name or ''"
          />-^FS\r

    ^FO50,60^A018,18^FD<t t-esc="line.product_id.name[:60]" />^FS\r
    ^FO25,60^A018,18^FD<t t-esc="line.product_id.name[60:120]" />^FS\r

    <t t-if="ship">
    ^FO295,200
    ^BQ,2,4
    ^FDQA,<t t-esc="ship.name" />^FS\r
    ^FO290,300^A020,20^FD<t t-esc="ship.name" />^FS\r
    </t>

    ^FWN
    ^XZ
</t>
</t>
</div>
  </template>
  <record model="ir.actions.report" id="report_stock_product_food_label">
    <field name="name">Alcyon Product Food Label</field>
    <field name="model">stock.move.line</field>
    <field name="report_type">qweb-pdf</field>
    <field
      name="report_name"
    >alc_product_label_printing.stock_product_food_label_zebra_v1</field>
    <field
      name="report_file"
    >alc_product_label_printing.stock_product_food_label_zebra_v1</field>
  </record>
  <template id="stock_product_label_toshiba_v1">
<div class="raw">
<t t-foreach="docs" t-as="pack">
<t t-foreach="pack.get_qty_by_lot()" t-as="line">
<t t-set="qty" t-value="line[0]" />
<t t-set="lot" t-value="line[1]" />
<t t-set="customer" t-value="pack.get_so_partner()" /><t t-if="qty">{U2;0120|}\r
{D0275,0560,0250|}\r
{C|}\r
{PC001;0400,0040,05,05,J,00,B|}\r
{RC001;ALCYON sa |}\r
{PC004;0010,0040,05,05,J,00,B|}\r
{RC004;<t
              t-esc="res_company.convert_to_ascii(pack.picking_id.partner_id.display_name[:30])"
            />|}\r
{PC009;0010,0070,05,05,J,00,B|}\r
{RC009;<t t-esc="customer.vet_depot_number or ''" />|}\r
{PC005;0010,0100,05,05,J,00,B|}\r
{RC005;<t t-if="customer.vet_subscription_number">Doc.n : 1/<t
                t-esc="customer.vet_subscription_number or ''"
              />/</t>|}\r
{PC002;0010,0130,05,05,J,00,B|}\r
{RC002;<t t-esc="pack.product_id.name or ''" />|}\r<t
              t-if="pack.picking_id.partner_id.is_price_on_labels"
            >{PC007;0350,0070,05,05,J,00,B|}\r{RC007;PVI : <t
                t-esc="pack.product_id.indicated_price"
              />|}\r</t>{XB01;0030,0150,9,1,02,0,0080|}\r{RB01;S<t
              t-esc="pack.product_id and pack.product_id.default_code[:8].ljust(8) or ''"
            /><t t-esc="lot and lot.name[:12].ljust(12) or ''" /><t
              t-esc="lot and lot.expiration_date and lot.expiration_date.strftime('%d%m%y') or ''"
            />|}\r
{PC003;0030,0250,05,05,J,00,B|}\r
{RC003;S-<t t-esc="pack.product_id.default_code[:8].ljust(8)" />-<t
              t-esc="lot and lot.name[:12].ljust(12) or ''"
            />-<t
              t-esc="lot and lot.expiration_date and lot.expiration_date.strftime('%d/%m/%y') or ''"
            />|}\r
{XS;I,<t t-esc="'%04d'%qty" />,0002C3200|}\r
{U1;0120|}\r
</t>
</t>
</t>
</div>
  </template>
  <record model="ir.actions.report" id="report_stock_product_label">
    <field name="name">Alcyon Product Label</field>
    <field name="model">stock.move.line</field>
    <field name="report_type">qweb-pdf</field>
    <field
      name="report_name"
    >alc_product_label_printing.stock_product_label_toshiba_v1</field>
    <field
      name="report_file"
    >alc_product_label_printing.stock_product_label_toshiba_v1</field>
  </record>
  <record id="stock_move_line_action" model="ir.actions.act_window">
    <field name="name">Detailed operation</field>
    <field name="res_model">stock.move.line</field>
    <field name="view_mode">form</field>
    <field name="view_id" ref="view_move_line_form" />
    <field name="target">current</field>
  </record>
</odoo>
