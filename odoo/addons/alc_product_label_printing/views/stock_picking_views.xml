<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="view_picking_form" model="ir.ui.view">
    <field name="name">stock.picking.form.print (in alc_product_label_printing)</field>
    <field name="model">stock.picking</field>
    <field name="inherit_id" ref="alc_label_printing_base.view_picking_form" />
    <field name="arch" type="xml">
        <button name="%(alc_label_printing_base.print_label_action)d" position="after">
          <button
          class="oe_link oe_right fa fa-print"
          name="print_labels_report"
          type="object"
          string="Print Med Products"
          context="{'default_label_type': 'product'}"
        />
          <button
          class="oe_link oe_right fa fa-print"
          name="print_food_report"
          type="object"
          string="Print Food Products"
          context="{'default_label_type': 'food_product'}"
        />
        </button>
    </field>
  </record>
</odoo>
