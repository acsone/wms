#. module: alc_rma_shipment_advice
#: model:ir.model.fields,help:alc_rma_shipment_advice.field_stock_picking__is_rma
#: model:ir.model.fields,help:alc_rma_shipment_advice.field_stock_picking_type__is_rma
msgid ""
"Indicates if this picking type is used for RMA (Return Merchandise "
"Authorization) operations."
msgstr ""
"Indique si ce type de transfert est utilisé pour les opérations de RMA "
"(Autorisation de Retour de Marchandises)."

#. module: alc_rma_shipment_advice
#: model:ir.model.fields,help:alc_rma_shipment_advice.field_stock_picking__rma_shipment_advice_id
msgid ""
"Links this picking to a Shipment Advice, allowing the transporter tocollect "
"returned products when delivering to the customer."
msgstr ""
"Lie ce transfert à une note d'envoi, permettant au transporteur de récupérer "
"les produits retournés lors de la livraison au client."

#. module: alc_rma_shipment_advice
#: model:ir.model.fields,help:alc_rma_shipment_advice.field_shipment_advice__rma_picking_ids
msgid "List of RMA pickings linked to this shipment advice."
msgstr "Liste des transferts RMA liés à cette note d'envoi."

