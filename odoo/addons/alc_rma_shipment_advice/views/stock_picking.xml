<odoo>

    <record model="ir.ui.view" id="stock_picking_form_view">
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='other_infos']" position="inside">
                <field name="is_rma" invisible="1" />
                <field
          name="rma_shipment_advice_id"
          attrs="{'invisible': [('is_rma', '=', False)]}"
        />

            </xpath>
        </field>
    </record>



</odoo>
