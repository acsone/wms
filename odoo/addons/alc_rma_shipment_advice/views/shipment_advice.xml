<odoo>

    <record model="ir.ui.view" id="shipment_advice_form_view">
        <field name="model">shipment.advice</field>
        <field name="inherit_id" ref="shipment_advice.shipment_advice_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
          name="button_open_rma_pickings"
          type="object"
          class="oe_stat_button"
          icon="fa-truck"
          states="done"
          attrs="{'invisible': [('rma_pickings_count', '=', 0)]}"
        >
                            <field
            string="RMA"
            name="rma_pickings_count"
            widget="statinfo"
          />
                        </button>
            </xpath>
        </field>
    </record>



</odoo>
