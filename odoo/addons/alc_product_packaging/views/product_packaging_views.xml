<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="product_packaging_tree_view2" model="ir.ui.view">
        <field
      name="name"
    >product.packaging.tree.view2 in (alc_product_packaging)</field>
        <field name="model">product.packaging</field>
        <field name="inherit_id" ref="product.product_packaging_tree_view2" />
        <field name="arch" type="xml">
            <xpath expr="//tree[@name='packaging']" position="attributes">
                <attribute name="editable" />
            </xpath>
        </field>
    </record>

</odoo>
