<odoo noupdate="1">

        <record id="product_packaging_type_palette" model="product.packaging.type">
            <field name="name">Palette</field>
            <field name="is_pallet" eval="1"/>
            <field name="code">PAL</field>
            <field name="sequence">30</field>
        </record>

        <record id="product_packaging_type_box" model="product.packaging.type">
            <field name="name">Boîte</field>
            <field name="is_pallet" eval="0"/>
            <field name="code">BOX</field>
            <field name="sequence">10</field>
        </record>

        <record id="product_packaging_type_shrink_wrap" model="product.packaging.type">
            <field name="name">Fardelage</field>
            <field name="is_pallet" eval="0"/>
            <field name="code">FAR</field>
            <field name="sequence">20</field>
        </record>

</odoo>