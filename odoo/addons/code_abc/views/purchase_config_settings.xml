<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
  <record id="view_purchase_configuration" model="ir.ui.view">
    <field name="name">view.purchase.configuration</field>
    <field name="model">purchase.config.settings</field>
    <field name="inherit_id" ref="purchase.view_purchase_configuration" />
    <field name="arch" type="xml">
      <xpath expr="//group[field[@name='group_warning_purchase']]" position="after">
        <group string="Code ABC" name="abc_group">
          <field name="turnover_delay" />
        </group>
      </xpath>
    </field>
  </record>
</odoo>
