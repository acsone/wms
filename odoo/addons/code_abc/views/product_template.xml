<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
  <record id="product_template_form_view" model="ir.ui.view">
    <field name="name">Inherit product template form view</field>
    <field name="model">product.template</field>
    <field name="inherit_id" ref="product.product_template_form_view" />
    <field name="arch" type="xml">
      <xpath expr="//notebook" position="inside">
        <page string="ABC" name="abc">
          <group string="ABC" name="abc">
            <field name="business_unit_id" />
            <field name="abc_id" />
            <field name="turnover" />
            <field name="turnover_nbr_lines" />
            <field name="turnover_average" />
            <field name="turnover_average_nbr_lines" />
          </group>
        </page>
      </xpath>
    </field>
  </record>
</odoo>
