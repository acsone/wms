<odoo>

    <record model="ir.ui.view" id="storage_file_form_view">
        <field name="name">storage.file.form (in alc_storage_file_lang)</field>
        <field name="model">storage.file</field>
        <field name="inherit_id" ref="storage_file.storage_file_view_form" />
        <field name="arch" type="xml">
            <field name="file_type" position="after">
                <field name="lang" />
            </field>
        </field>
    </record>

    <record model="ir.ui.view" id="storage_file_search_view">
        <field name="name">storage.file.search (in alc_storage_file_lang)
        </field>
        <field name="model">storage.file</field>
        <field name="inherit_id" ref="storage_file.storage_file_view_search" />
        <field name="arch" type="xml">
            <field name="url" postion="after">
                <group expand="0" string="Group By">
                    <filter
            name="group_by_supplier_id"
            string="Vendor"
            context="{'group_by':'supplier_id'}"
          />
                </group>
            </field>
        </field>
    </record>

    <record model="ir.ui.view" id="storage_file_tree_view">
        <field name="name">storage.file.tree (in alc_storage_file_lang)</field>
        <field name="model">storage.file</field>
        <field name="inherit_id" ref="storage_file.storage_file_view_tree" />
        <field name="arch" type="xml">
            <field name="file_type" position="after">
                <field name="lang" />
            </field>
        </field>
    </record>

</odoo>
