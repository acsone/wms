<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
  <record model="ir.ui.view" id="product_product_form_view_sale_order_button">
    <field name="name">product.product.sale.order.button</field>
    <field name="model">product.product</field>
    <field name="inherit_id" ref="product.product_normal_form_view" />
    <field name="arch" type="xml">
      <div name="button_box" position="inside">
        <button
          class="oe_stat_button"
          name="action_view_sale_lines_unavailable"
          type="object"
          icon="fa-usd"
          groups="sales_team.group_sale_salesman"
        >
          <field string="Sales" name="sales_count" widget="statinfo" />
        </button>
      </div>
    </field>
  </record>
</odoo>
