<odoo>

    <record model="ir.ui.view" id="alc_eshop_form_form_view">
        <field name="name">alc.eshop.form.form</field>
        <field name="model">alc.eshop.form</field>
        <field name="arch" type="xml">
            <form>
                <header>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
              class="oe_stat_button"
              name="publish_button"
              type="object"
              icon="fa-globe"
            >
                            <field
                name="published"
                widget="boolean_button"
                options='{"terminology": {
                                        "string_true": "Published",
                                        "hover_true": "Remove from eshop",
                                        "string_false": "Private",
                                        "hover_false": "Publish on eshop"
                                }}'
              />
                        </button>
                    </div>
                    <div class="oe_title">
                        <label class="oe_edit_only" for="name" string="Name" />
                        <h1>
                            <field name="name" placeholder="name" />
                        </h1>
                    </div>
                    <group>
                        <field name="code" />
                        <field name="sequence" />
                        <field name="audience" />
                        <field name="email" />
                        <field name="email_subject" />
                        <field name="form" widget="formio" />
                        <field name="form_options" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>


    <record model="ir.ui.view" id="alc_eshop_form_tree_view">
        <field name="name">alc.eshop.form.tree (in alc_eshop_form)</field>
        <field name="model">alc.eshop.form</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" widget='handle' />
                <field name="name" />
                <field name="email" />
                <field name="published" />
                <field name="audience" />
                <field name="code" />
            </tree>
        </field>
    </record>

    <record model="ir.ui.view" id="alc_eshop_form_search_view">
        <field name="name">alc.eshop.form.search (in alc_eshop_form)</field>
        <field name="model">alc.eshop.form</field>
        <field name="arch" type="xml">
            <search>
               <filter
          string="Public"
          name="public"
          domain="[('audience','=', 'public_only')]"
        />
                <filter
          string="Authenticated"
          name="authenticated"
          domain="[('audience','=', 'authenticated_only')]"
        />
                <filter
          string="Published"
          name="published"
          domain="[('published','=', True)]"
        />
            </search>
        </field>
    </record>

    <record model="ir.actions.act_window" id="alc_eshop_form_act_window">
        <field name="name">Eshop Form</field>
        <field name="res_model">alc.eshop.form</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
               <field name="context">{"search_default_published":1}
        </field>
    </record>

    <record model="ir.ui.menu" id="alc_eshop_form_menu">
        <field name="name">Eshop Form</field>
        <field name="parent_id" ref="base.menu_custom" />
        <field name="action" ref="alc_eshop_form_act_window" />
        <field name="sequence" eval="99" />
    </record>

</odoo>
