<odoo>

    <record model="ir.ui.view" id="select_printing_printer_form_view">
        <field name="name">select.printing.printer.form</field>
        <field name="model">select.printing.printer</field>
        <field name="arch" type="xml">
            <form string="Select Printing Printer">
                <group>
                    <field name="printer_id" />
                </group>
                <footer>
                    <button
            name="change_printer"
            string="OK"
            class="btn-primary"
            type="object"
          />
                    <button string="Cancel" class="btn-default" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
    <record model="ir.actions.act_window" id="select_printing_printer_act_window">
        <field name="name">Select Printing Printer</field>
        <field name="res_model">select.printing.printer</field>
        <field name="view_mode">form</field>
        <field name="context">{}</field>
        <field name="target">new</field>
    </record>
    <menuitem
    id="select_printing_printer_menu"
    name="Select Printing Printer"
    parent="stock.menu_stock_inventory_control"
    sequence="90"
    action="select_printing_printer_act_window"
  />

</odoo>
