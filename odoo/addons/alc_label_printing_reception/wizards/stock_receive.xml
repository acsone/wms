<?xml version="1.0" ?>
<odoo>
  <record id="view_pack_operation_lot_add_form" model="ir.ui.view">
    <field name="name">stock.pack.operation.lot.add.form</field>
    <field name="model">stock.pack.operation.lot.add</field>
    <field
      name="inherit_id"
      ref="alc_stock_receive_lot.view_pack_operation_lot_add_form"
    />
    <field name="arch" type="xml">
      <footer position="before">
        <hr />
        <group name="bottom_button">
          <field
            name="print_qty"
            nolabel="1"
            style="width: 25px !important; text-align: center;"
          />
          <button
            name="print_label"
            string="Print"
            type="object"
            class="oe_highlight"
          />
        </group>
      </footer>
    </field>
  </record>
</odoo>
