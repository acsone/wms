<odoo>

    <record model="ir.ui.view" id="res_config_settings_form_view">
        <field
      name="name"
    >res.config.settings.form (in alc_stock_picking_backorder_no_user)</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <div id="product_packs_tracking" position="after">
                <div class="col-12 col-lg-6 o_setting_box" id="alc_backorder_no_user">
                    <div class="o_setting_left_pane">
                        <field name="no_user_on_backorder" />
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="no_user_on_backorder" />
                        <div class="text-muted">
                            The picking responsible user won't be copied to the backorder.
                        </div>
                    </div>
                </div>
            </div>
        </field>
    </record>


</odoo>
