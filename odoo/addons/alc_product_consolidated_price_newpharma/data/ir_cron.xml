<odoo noupdate="1">
  <record
    forcecreate="True"
    id="ir_cron_product_consolidate_price_newpharma"
    model="ir.cron"
  >
    <field name="name">Generate consolidated price for Newpharama</field>
    <field eval="True" name="active" />
    <field name="user_id" ref="base.user_root" />
    <field name="interval_number">1</field>
    <field name="interval_type">days</field>
    <field name="numbercall">-1</field>
    <field eval="False" name="doall" />
    <field eval="'alc.product.partner.price'" name="model" />
    <field eval="'cron_generate_for_new_pharma'" name="function" />
    <field eval="'()'" name="args" />
    <field eval="1" name="run_as_queue_job" />
    <field ref="queue_job_cron.channel_root_ir_cron" name="channel_id" />
    <field name="nextcall" eval="(DateTime.now()).strftime('%Y-%m-%d 02:00:00')" />
  </record>
</odoo>
