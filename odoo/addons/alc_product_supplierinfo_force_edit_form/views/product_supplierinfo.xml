<odoo>
    <record id="product_supplierinfo_tree_view3" model="ir.ui.view">
        <field
      name="name"
    >product.supplierinfo.tree.view3 (in alc_product_supplierinfo_force_edit_form)</field>
        <field name="model">product.supplierinfo</field>
        <field name="inherit_id" ref="purchase.product_supplierinfo_tree_view2" />
        <field name="mode">primary</field>
        <field name="priority" eval="10000" />
        <field name="arch" type="xml">
            <xpath expr="//tree" position="attributes">
                <attribute name="editable" />
                <attribute name="multi_edit" />
            </xpath>
        </field>
    </record>

   <record id="view_product_supplier_inherit" model="ir.ui.view">
            <field
      name="name"
    >product.template.supplier.form.inherit (in alc_product_supplierinfo_force_edit_form)</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="purchase.view_product_supplier_inherit" />
            <field name="arch" type="xml">
              <field name="seller_ids" position="attributes">
                <attribute
          name="context"
        >{'default_product_tmpl_id':context.get('product_tmpl_id',active_id), 'product_template_invisible_variant': True, 'tree_view_ref':'alc_product_supplierinfo_force_edit_form.product_supplierinfo_tree_view3'}</attribute>
              </field>
              <field name="variant_seller_ids" position="attributes">
                <attribute
          name="context"
        >{'model': active_model, 'active_id': active_id, 'tree_view_ref':'alc_product_supplierinfo_force_edit_form.product_supplierinfo_tree_view3'}</attribute>
              </field>
            </field>
   </record>
</odoo>
