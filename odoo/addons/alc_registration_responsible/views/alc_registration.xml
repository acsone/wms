<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="alc_registration_form_view" model="ir.ui.view">
        <field name="name">alc.regitration.form.responsible</field>
        <field name="inherit_id" ref="alc_registration.alc_registration_form_view" />
        <field name="model">alc.registration</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="before">
                <field name="user_id" />
            </xpath>
        </field>
    </record>

</odoo>
