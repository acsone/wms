<odoo>

    <record model="ir.ui.view" id="stock_release_channel_form_view">
        <field name="model">stock.release.channel</field>
        <field
      name="inherit_id"
      ref="alc_stock_release_channel_print_shipment_advice.stock_release_channel_form_view"
    />
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_print']" position="after">
                <button
          name="print_all_deliveryslip"
          type="object"
          string="Print all deliveryslip"
          icon="fa-print"
          attrs="{'invisible': [('is_action_print_allowed', '=', False)]}"
        />
            </xpath>
        </field>
    </record>


</odoo>
