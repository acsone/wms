<odoo>

    <record model="ir.ui.view" id="stock_package_type_category_form_view">
        <field
      name="name"
    >stock.package.type.category.form (in stock_package_type_category)</field>
        <field name="model">stock.package.type.category</field>
        <field
      name="inherit_id"
      ref="stock_package_type_category.stock_package_type_category_form_view"
    />
        <field name="arch" type="xml">
            <xpath expr="//field[@name]/parent::group" position="after">
                <group string="Delivery Slip Report" id="alc_report_delivery_slip">
                    <field name="show_in_delivery_slip_report" />
                    <field name="sequence_in_delivery_slip_report" />
                </group>
            </xpath>
        </field>
    </record>
</odoo>
