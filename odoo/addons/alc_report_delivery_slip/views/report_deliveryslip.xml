            <th>Expiration date</th>
          </tr>
        </thead>
        <tbody class="invoice_tbody">
          <t
            t-foreach="deliveryslip.with_context(lang=partner.lang).get_moves_by_order(is_entry_register=True)"
            t-as="grouped_lines"
          >
            <t t-set="order" t-value="grouped_lines[0]" />
            <t t-set="move_lines" t-value="grouped_lines[1][0]" />
            <t t-if="order">
              <tr>
                <td />
                <td />
                <td />
                <td />
                <td />
                <td />
                <td />
              </tr>
              <tr>
                <td colspan="7" class="sale_separator">
                  <t t-call="alc_report_delivery_slip.deliveryslip_orderref" />
                </td>
              </tr>
              <tr>
                <td />
                <td />
                <td />
                <td />
                <td />
                <td />
                <td />
              </tr>
            </t>
            <t t-foreach="move_lines" t-as="line">
              <t t-set="order_line" t-value="line.sale_line_id" />
              <t t-set="quants" t-value="line.get_lots()" />
              <t t-set="first_quant" t-value="quants and quants.pop()" />
              <tr>
                <td>
                  <span t-field="line.product_id.default_code" />
                </td>
                <td class="text-left">
                  <span t-field="line.product_id.name" />
                  <div t-if="line.serial_number"> (S/N: <span
                      t-field="line.serial_number"
                    />)</div>

                  <div t-if="line.product_id.product_tmpl_id.code_amm"> <small
                    >(AMM: <span
                        t-field="line.product_id.product_tmpl_id.code_amm"
                      />)</small></div>
                </td>
                <td class="text-center">
                  <span
                    t-if="any(line.move_orig_ids.picking_type_id.mapped('is_cold'))"
                  >
                    <i class="fa fa-check" aria-hidden="true" />
                  </span>
                </td>
                <td>
                  <span
                    t-if="line.picking_type_id.code=='incoming'"
                    t-esc="-int(line.product_qty)"
                  />
                  <span t-else="" t-esc="int(line.product_qty)" />
                </td>
                <td>
                  <t t-esc="first_quant and first_quant[0] or ''" />
                </td>
                <td>
                  <t t-esc="first_quant and int(first_quant[1])  or ''" />
                </td>
                <td style="white-space:nowrap">
                  <t
                    t-esc="first_quant and first_quant[2] and first_quant[2].date() or ''"
                  />
                </td>
              </tr>
              <tr t-foreach="quants" t-as="quant">
                <td />
                <td />
                <td />
                <td />
                <td>
                  <span t-esc="quant[0]" />
                </td>
                <td>
                  <span t-esc="int(quant[1])" />
                </td>
                <td style="white-space:nowrap">
                  <span t-esc="quant[2] and quant[2].date()" />
                </td>
              </tr>
            </t>
          </t>
          <tr>
            <td />
            <td />
            <td />
            <td />
            <td />
            <td />
            <td />
          </tr>
        </tbody>
      </table>
    </div>
  </template>
  <template id="alc_report_delivery_slip.alcyon_report_deliveryslip">
    <t t-call="web.basic_layout">
       <t t-set="company" t-value="res_company" />
        <t t-set="partner" t-value="deliveryslip.partner_id" />
        <div class="header">
            <div class="logo">
              <img
            t-if="company.logo"
            t-att-src="image_data_uri(company.logo)"
            style="max-height: 70px;"
            alt="Logo"
          />
            </div>
            <div class="main_title">
              <t t-if="deliveryslip.picking_type_code=='outgoing'">Delivery slip</t>
              <t t-if="deliveryslip.picking_type_code=='incoming'">Goods return note</t>
            </div>
        </div>
        <t
        t-call="alc_report_delivery_slip.report_deliveryslip_alcyon"
        t-lang="partner.lang"
      />
        <t t-call="alc_report_base.page_number_footer" t-lang="partner.lang" />
    </t>
  </template>
  <template id="alc_report_delivery_slip.report_deliveryslip_entry_register">
    <t t-call="web.basic_layout">
      <t t-set="company" t-value="res_company" />
      <t t-set="partner" t-value="deliveryslip.partner_id" />
      <div class="header">
        <div>
          <div class="logo">
            <img
              t-if="company.logo"
              t-att-src="image_data_uri(company.logo)"
              style="max-height: 70px;"
              alt="Logo"
            />
          </div>
          <div class="main_title">
            Entry register
          </div>
        </div>
      </div>
      <t
        t-call="alc_report_delivery_slip.report_deliveryslip_entry_register_body"
        t-lang="partner.lang"
      />
      <t t-call="alc_report_base.page_number_footer" t-lang="partner.lang" />
    </t>
  </template>
  <template
    id="report_deliveryslip"
    inherit_id="stock.report_deliveryslip"
    priority="100"
  >
    <xpath expr="//t[@t-foreach='docs']" position="replace">
        <t t-foreach="docs" t-as="doc">
          <t t-set="deliveryslip" t-value="doc" />

               <t
          t-call="alc_report_delivery_slip.alcyon_report_deliveryslip"
          t-lang="deliveryslip.partner_id.lang"
        />
              <t
          t-set="depot_number"
          t-value="deliveryslip.partner_id.vet_depot_number or deliveryslip.partner_id.parent_id.vet_depot_number"
        />
              <t
          t-set="register_lines"
          t-value="deliveryslip.get_entry_register_lines()"
        />
              <div
          t-if="not deliveryslip.partner_id.is_hide_entry_register and depot_number and register_lines"
          style="page-break-before:always;"
        />
              <t
          t-if="not deliveryslip.partner_id.is_hide_entry_register and depot_number and register_lines"
          t-call="alc_report_delivery_slip.report_deliveryslip_entry_register"
          t-lang="deliveryslip.partner_id.lang"
        />
          </t>

    </xpath>
  </template>
</odoo>
