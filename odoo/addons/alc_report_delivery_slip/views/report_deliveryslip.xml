<odoo>
  <template id="alc_report_delivery_slip.report_deliveryslip_alcyon">
    <div class="page">
      <div id="left_header" class="remove_padding_top">
        <table id="invoice_reference" class="border_table round_table">
          <tr>
            <td>
              <span>Customer</span>
            </td>
            <td>
              <span>N° Document</span>
            </td>
            <td>
              <span>Date</span>
            </td>
          </tr>
          <tr>
            <td>
              <span t-field="partner.ref" />
            </td>
            <td>
              <span t-field="deliveryslip.name" />
            </td>
            <td>
              <span t-field="deliveryslip.date_done" />
            </td>
          </tr>
          <tr>
            <td colspan="3">
              <span>Your VAT number:</span>
              <span t-field="partner.vat" />
            </td>
          </tr>
        </table>
      </div>
      <div id="partner_header" class="remove_padding_top">
        <div
          t-if="deliveryslip.customer_id != deliveryslip.partner_id"
          t-esc="deliveryslip.customer_id.name"
        />
        <div
          t-field="deliveryslip.partner_id"
          t-options='{"widget": "contact", "fields": ["name", "address"], "no_marker": True}'
        />
      </div>
      <div>
        <span style="font-weight:bold;text-decoration:underline;font-size:18px;"><center
          >DON'T FORGET TO BRING BACK COOLPACK IF ANY</center></span>
      </div>
      <t
        t-call="alc_report_delivery_slip.deliveryslip_with_price"
        t-if="not partner.is_hide_prices_deliveryslip and not deliveryslip.customer_id.is_b2c_customer"
        t-lang="partner.lang"
      />
      <t
        t-call="alc_report_delivery_slip.deliveryslip_b2c_customer"
        t-if="deliveryslip.customer_id.is_b2c_customer"
        t-lang="partner.lang"
      />
      <t
        t-call="alc_report_delivery_slip.deliveryslip_without_price"
        t-if="partner.is_hide_prices_deliveryslip"
        t-lang="partner.lang"
      />
      <!-- Rebrowse company with partner lang to get the right translation -->
      <div id="delivery_condition">
        <t t-esc="company.with_context(lang=partner.lang).delivery_terms_conditions" />
      </div>
      <div class="row" style="page-break-inside:avoid">
        <div class="col-6 me-4">
          <div class="round_table summary_deliverslip" id="product_type_summary">
            <t t-set="deliveryslip_single" t-value="deliveryslip.with_prefetch()" />
            <t t-set="delivery_totals" t-value="" />
            <div style="border-bottom: 1px solid black">
              Shipment advice:
              <span
                t-if="deliveryslip.loaded_shipment_advice_ids"
                t-field="deliveryslip.loaded_shipment_advice_ids.display_name"
              />
            </div>
            <t
              t-set="source_summary"
              t-value="deliveryslip_single.get_numbers_per_source()"
            />
            <table style="width:100%">
              <tr>
                <t t-foreach="source_summary.keys()" t-as="source">
                  <th><span t-esc="source" /></th>
                </t>
              </tr>
              <tr>
                <t t-foreach="source_summary.values()" t-as="numbers">
                  <td><span t-esc="numbers['parcels']" /> boxes</td>
                </t>
              </tr>
              <tr>
                <t t-foreach="source_summary.values()" t-as="numbers">
                  <td><span t-esc="numbers['items']" /> items</td>
                </t>
              </tr>
            </table>
          </div>
        </div>
        <div class="col-2 me-4">
          <div
            class="round_table summary_deliverslip"
            style="text-align: center; padding-top: 30px"
          >
            Weight:<br /><span t-field="deliveryslip.weight" /> Kg
          </div>
        </div>
        <div class="col-3">
          <div class="round_table summary_deliverslip">
            <div>
              Received the:<br />
              Signature:
            </div>
          </div>
        </div>
      </div>
    </div>
  </template>
  <template id="alc_report_delivery_slip.deliveryslip_orderref">
    <div>
      <span t-if="not order.is_consignment">Order</span>
      <span t-if="order.is_consignment">Consignement</span>
      <span t-field="order.name" />
      <t
        t-set="depot_number"
        t-value="order.partner_id.vet_depot_number or order.partner_id.parent_id.vet_depot_number"
      />
      <t t-if="depot_number">
                (<t t-esc="deliveryslip.date_done.strftime('%y')" />/<t
          t-esc="depot_number"
        />/<t t-esc="order.suite_name or '000'" />)
            </t>
      <span>of</span>
      <span t-esc="order.date_order.date()" />
      <t t-if="order.client_order_ref">
                (<span t-esc="order.client_order_ref" />)
            </t>
    </div>
  </template>
  <template id="alc_report_delivery_slip.deliveryslip_with_price">
    <table
      id="products_table_with_price"
      class="round_table products_table_deliveryslip"
    >
      <thead>
        <tr>
          <th rowspan="2">Product<br />reference</th>
          <th rowspan="2">Name</th>
          <th rowspan="2">Fridge</th>
          <th rowspan="2">Quantity</th>
          <th colspan="3" style="border-left: thin solid black;">By lot</th>
          <th rowspan="2">Gross<br />unit<br />price</th>
          <th rowspan="2">Net<br />unit<br />price</th>
          <th rowspan="2">Subtotal</th>
          <th rowspan="2" style="min-width:70px">VAT</th>
        </tr>
        <tr>
          <th style="border-left: thin solid black;">Number</th>
          <th>Quantity</th>
          <th>Expiration date</th>
        </tr>
      </thead>
      <tbody class="invoice_tbody">
        <t
          t-foreach="deliveryslip.with_context(lang=partner.lang).get_moves_by_order()"
          t-as="grouped_lines"
        >
          <t t-set="order" t-value="grouped_lines[0]" />
          <t t-set="move_lines" t-value="grouped_lines[1][0]" />
          <t t-set="backorder_move_lines" t-value="grouped_lines[1][1]" />
          <t t-if="order">
            <tr>
              <td />
              <td />
              <td />
              <td />
              <td />
              <td />
              <td />
              <td />
              <td />
              <td />
              <td />
            </tr>
            <tr>
              <td colspan="11" class="sale_separator">
                <t t-call="alc_report_delivery_slip.deliveryslip_orderref" />
              </td>
            </tr>
            <tr>
              <td />
              <td />
              <td />
              <td />
              <td />
              <td />
              <td />
              <td />
              <td />
              <td />
              <td />
            </tr>
          </t>
          <t t-foreach="move_lines" t-as="line">
            <t t-set="order_line" t-value="line.sale_line_id" />
            <t t-set="quants" t-value="line.get_lots()" />
            <t t-set="first_quant" t-value="quants and quants.pop()" />
            <tr>
              <td>
                <span t-field="line.product_id.default_code" />
              </td>
              <td class="text-left">
                <span t-field="line.product_id.name" />
                <div t-if="line.serial_number"> (S/N: <span
                    t-field="line.serial_number"
                  />)</div>
                <div t-if="line.product_id.product_tmpl_id.code_amm"> <small>(AMM: <span
                      t-field="line.product_id.product_tmpl_id.code_amm"
                    />)</small></div>
              </td>
              <td class="text-center">
                <span t-if="any(line.move_orig_ids.picking_type_id.mapped('is_cold'))">
                  <i class="fa fa-check" aria-hidden="true" />
                </span>
              </td>
              <td>
                <span t-esc="int(line.product_qty)" />
              </td>
              <td>
                <t t-esc="first_quant and first_quant[0] or ''" />
              </td>
              <td>
                <t t-esc="first_quant and int(first_quant[1])  or ''" />
              </td>
              <td style="white-space:nowrap">
                <t
                  t-esc="first_quant and first_quant[2] and first_quant[2].date() or ''"
                />
              </td>
              <td>
                <span
                  t-field="order_line.price_unit"
                  t-if="not line.is_additional_move and not line.order_id.is_consignment"
                />
                <span
                  t-if="line.is_additional_move or line.order_id.is_consignment"
                > 0 </span>
              </td>
              <td>
                <span
                  t-field="order_line.price_reduce_taxexcl"
                  t-if="not line.is_additional_move and not line.order_id.is_consignment"
                />
                <span
                  t-if="line.is_additional_move or line.order_id.is_consignment"
                > 0 </span>
              </td>
              <td>
                <t
                  t-esc="order_line.price_reduce_taxexcl * int(line.product_qty)"
                  t-options="{'widget': 'monetary', 'display_currency': order_line.currency_id}"
                  t-if="order_line and not line.is_additional_move and not line.order_id.is_consignment"
                />
                <span
                  t-if="line.is_additional_move or line.order_id.is_consignment"
                > 0 </span>
              </td>
              <td>
                <t t-foreach="order_line.tax_id" t-as="tax">
                  <t t-if="tax_index">, </t>
                  <span style="white-space:nowrap">
                    <t t-esc="tax.description or tax.name" />
                  </span>
                </t>
              </td>
            </tr>
            <tr t-foreach="quants" t-as="quant">
              <td />
              <td />
              <td />
              <td />
              <td>
                <span t-esc="quant[0]" />
              </td>
              <td>
                <span t-esc="int(quant[1])" />
              </td>
              <td>
                <span t-esc="quant[2] and quant[2].date()" />
              </td>
              <td />
              <td />
              <td />
              <td />
            </tr>
          </t>
          <t t-if="backorder_move_lines">
            <tr>
              <td />
              <td />
              <td />
              <td />
              <td />
              <td />
              <td />
              <td />
              <td />
              <td />
              <td />
            </tr>
            <tr>
              <td colspan="11" class="sale_separator">
                <div
                  class="no_background"
                  style="padding-left: 2mm; padding-right: 2mm; padding-top: 1mm"
                >
                  <div
                    t-if="order"
                    style="padding-left: 2mm; padding-right: 2mm;"
                  >Balance to be delivered on order <span t-field="order.name" /></div>
                  <div t-if="not order">Balance to be delivered</div>
                  <table style="width: 50%;">
                    <tbody>
                      <tr t-foreach="backorder_move_lines" t-as="line">
                        <td style="border: none;">
                          <span t-field="line.product_id.default_code" />
                        </td>
                        <td style="border: none;">
                          <span t-field="line.product_id.name" />
                        </td>
                        <td style="border: none;">
                          <span t-esc="int(line.product_qty)" />
                        </td>
                      </tr>
                    </tbody>
                  </table>
                </div>
              </td>
            </tr>
          </t>
        </t>
        <tr>
          <td />
          <td />
          <td />
          <td />
          <td />
          <td />
          <td />
          <td />
          <td />
          <td />
          <td />
        </tr>
      </tbody>
    </table>
  </template>
