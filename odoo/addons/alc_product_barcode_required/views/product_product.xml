<odoo>
    <record id="product_normal_form_view" model="ir.ui.view">
        <field name="name">product.product.form (in alc_product_audit)</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view" />
        <field name="arch" type="xml">
            <field name="barcode" position="after">
                <field name="is_new" invisible="1" />
                <field name="template_variant_count" invisible="1" />

                <field
                    name="no_barcode_authorized"
                    attrs="{'invisible': [('template_variant_count', '>', 1)]}"
                />
            </field>
            <field name="barcode" position="attributes">
                <attribute name="attrs">
                    {'required': [('no_barcode_authorized', '=', False), ('is_new', '=', False)]}
                </attribute>
            </field>
            <header position="after">
                <field name="missing_barcode" invisible="1" />
                <div
                    class="alert alert-warning"
                    role="alert"
                    attrs="{'invisible': [('missing_barcode', '=', False)]}"
                >
                    <p>- You must enter a barcode or specify product without barcode.</p>
                </div>

            </header>
        </field>
    </record>
</odoo>
