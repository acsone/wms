<odoo>
  <record id="s3_images_backend" model="storage.backend">
    <field name="name">ImagesS3</field>
    <field name="backend_type">amazon_s3</field>
    <field name="is_public" eval="True" />
    <field name="served_by">external</field>
    <field name="url_include_directory_path" eval="True" />
    <field name="aws_file_acl">public-read</field>
    <field name="filename_strategy">name_with_id</field>
    <field name="aws_cache_control">public,max-age=31536000</field>
  </record>
</odoo>
