<odoo>

    <record model="ir.ui.view" id="shopfloor_menu_form_view">
        <field name="name">shopfloor.menu.form (in alc_shopfloor_packing)
        </field>
        <field name="model">shopfloor.menu</field>
        <field name="inherit_id" ref="alc_shopfloor.shopfloor_menu_form_view" />
        <field name="arch" type="xml">
            <group name="keep_existing_reservations" position="after">
                <group
          name="pack_pickings"
          attrs="{'invisible': [('pack_pickings_is_possible', '=', False)]}"
        >
                    <field name="pack_pickings_is_possible" invisible="1" />
                    <field name="pack_pickings" />
                </group>
            </group>
        </field>
    </record>


</odoo>
