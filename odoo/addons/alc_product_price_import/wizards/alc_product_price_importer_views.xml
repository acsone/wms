<odoo>
  <record model="ir.ui.view" id="alc_product_price_importer_form_view">
    <field
      name="name"
    >alc.product.price.importer.form (in alc_product_price_import)</field>
    <field name="model">alc.product.price.importer</field>
    <field name="arch" type="xml">
      <form string="Product Price Importer">
        <group>
          <field name="document" />
        </group>
        <footer>
          <button name="doit" string="Import" class="btn-primary" type="object" />
          <button string="Cancel" class="btn-default" special="cancel" />
        </footer>
      </form>
    </field>
  </record>
  <record model="ir.actions.act_window" id="alc_product_price_importer_act_window">
    <field name="name">Product Price Importer</field>
    <field name="res_model">alc.product.price.importer</field>
    <field name="view_mode">form</field>
    <field name="context">{}</field>
    <field name="target">new</field>
  </record>
  <record model="ir.ui.menu" id="product_price_importer_menu">
    <field name="name">Product Price Importer</field>
    <field name="parent_id" ref="purchase.menu_procurement_management" />
    <field name="action" ref="alc_product_price_importer_act_window" />
    <field name="sequence" eval="17" />
  </record>
</odoo>
