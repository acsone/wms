<odoo>

    <record model="ir.ui.view" id="res_config_settings_form_view">
        <field
      name="name"
    >res.config.settings.form (in alc_sale_exception_settings)</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <div id="proforma_configuration" position="after">
                <div
          class="col-12 col-lg-6 o_setting_box"
          id="sale_exception_configuration"
        >
                    <div class="o_setting_left_pane">
                        <field name="alc_sale_exception_check_enabled" />
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="alc_sale_exception_check_enabled" />
                        <div class="text-muted">
                            Allows you to activate/deactivate sale exception checks
                        </div>
                    </div>
                    <div
            class="o_setting_left_pane"
            attrs="{'invisible':[('alc_sale_exception_check_enabled', '=', False)]}"
          >
                        <field name="alc_sale_exception_skip_non_blocking" />
                    </div>
                    <div
            class="o_setting_right_pane"
            attrs="{'invisible':[('alc_sale_exception_check_enabled', '=', False)]}"
          >
                        <label for="alc_sale_exception_skip_non_blocking" />
                        <div class="text-muted">
                            Allows you to enable/disable the confirmation of a sale order having non blocking exception
                        </div>
                    </div>
                </div>
            </div>

        </field>
    </record>

</odoo>
