<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
  <record id="print_label_view_form" model="ir.ui.view">
    <field name="name">print.label.view.form</field>
    <field name="model">print.label</field>
    <field name="arch" type="xml">
      <form string="Print label">
        <sheet>
          <group>
            <field name="printer_id" />
            <field name="qty" />
            <field name="label_type" invisible="1" />
            <field name="picking_ids" invisible="1" />
            <field name="lot_ids" invisible="1" />
          </group>
        </sheet>
        <footer>
          <button
            name="print_label"
            string="Print label"
            type="object"
            class="oe_highlight"
          />
          <button string="Cancel" class="oe_link" special="cancel" />
        </footer>
      </form>
    </field>
  </record>
  <record id="print_label_action" model="ir.actions.act_window">
    <field name="name">Print label</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">print.label</field>
    <field name="view_mode">form</field>
    <field name="view_type">form</field>
    <field name="target">new</field>
  </record>
</odoo>
