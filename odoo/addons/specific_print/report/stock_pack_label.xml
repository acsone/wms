<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
  <template id="stock_pick_packs_label_zebra_v1">
    <div class="raw">
      <t t-foreach="docs" t-as="pick">
        <t
          t-set="packages"
          t-value="pick.mapped('pack_operation_ids.result_package_id')"
        />
        <t
          t-set="ships"
          t-value="pick._get_all_dest_pickings().filtered(lambda r: r.picking_type_code == 'outgoing' and r.state not in ('cancel', 'done'))"
        />
        <t t-set="ship" t-value="ships and ships[0]" />
        <t t-foreach="packages" t-as="package">
          <t t-foreach="xrange(package.nbr_packages)" t-as="index">
            ^XA
            ^FO30,30^GB<t
              t-esc="pick.delivery_round_id.template_id.code and len(pick.delivery_round_id.template_id.code) * 38"
            />,75,3,2^FS\r
            ^FO40,47^A0N60,60^FD<t
              t-esc="pick.delivery_round_id.template_id.code"
            />^FS\r

            <t t-if="ship">
              ^FO200,20
              ^BQN,2,4
              ^FDQA,<t t-esc="ship.name" />^FS\r
            </t>

            <t t-if="('customer_id' in pick) and pick.customer_id.is_b2c_customer">
              ^FO340,47^A0N60,60^FDB2C^FS\r
            </t>

            ^FO570,47,1^A0N60,60^FD<t t-esc="index + 1" /> / <t
              t-esc="package.nbr_packages"
            />^FS\r

            ^FO30,140^A0N30,30^FD<t
              t-esc="res_company.convert_to_ascii(pick.partner_id.display_name and pick.partner_id.display_name[:29] or u'')"
            />^FS\r
            ^FO30,170^A0N30,30^FD<t
              t-esc="res_company.convert_to_ascii(pick.partner_id.display_name and pick.partner_id.display_name[29:50] or u'')"
            />^FS\r
            ^FO30,205^A0N35,30^FD<t t-esc="pick.partner_id.zip" /> <t
              t-esc="pick.partner_id.city and res_company.convert_to_ascii(pick.partner_id.city)"
            />^FS\r
            ^FO30,250^A0N30,30^FD<t
              t-esc="('customer_id' in pick) and (pick.partner_id != pick.customer_id) and res_company.convert_to_ascii(pick.customer_id.name and pick.customer_id.name[:29] or u'') or ''"
            />^FS\r


            ^FO30,310^A0N20,25^FD<t t-esc="pick.name" /> - <t
              t-esc="pick._get_all_dest_pickings()[0].filtered(lambda r: r.picking_type_code == 'outgoing' and r.state not in ('cancel', 'done')).name"
            />^FS\r
            ^FO30,350^A0N45,45^FD<t t-esc="pick.checksum" />^FS\r

            ^FO570,310,1
            ^BXN,5,200
            ^FD<t t-esc="res_company.convert_to_ascii(package.name)" />^FS\r

            ^XZ
          </t>
        </t>
      </t>
    </div>
  </template>
  <report
    id="report_stock_pick_packs_label"
    string="Alcyon Pack Label"
    model="stock.picking"
    report_type="qweb-pdf"
    file="specific_print.stock_pick_packs_label_zebra_v1"
    name="specific_print.stock_pick_packs_label_zebra_v1"
  />
</odoo>
