<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
  <template id="stock_product_food_label_zebra_v1">
    <div class="raw">
    <t t-foreach="docs" t-as="line">
    <t t-set="pick" t-value="line.picking_id" />
    <t
          t-set="ships"
          t-value="pick._get_all_dest_pickings().filtered(lambda r: r.picking_type_code == 'outgoing' and r.state not in ('cancel', 'done'))"
        />
    <t t-set="ship" t-value="ships and ships[0]" />

    <!--
    Migration note:
    The lot_id is given in arg in v10 as it is not part of the pack operation
    In next versions, we can extract it from the move line

    t t-set="lot_id" t-value="line.lot_id"
    -->

    <t t-foreach="xrange(1, int(qty_done) + 1)" t-as="index">

    ^XA
    ^FWR

    ^FO310,60^GB70,<t
            t-esc="len(pick.delivery_round_id.template_id.code) * 38"
          />,3,2^FS\r
    ^FO310,70^A060,60^FD<t t-esc="pick.delivery_round_id.template_id.code" />^FS\r

    <t t-if="('customer_id' in pick) and pick.customer_id.is_b2c_customer">
    ^FO310,330^A030,30^FDB2C^FS\r
    </t>

    ^FO310,480^A040,40^FD<t t-esc="index" /> / <t t-esc="int(qty_done)" />^FS\r

    ^FO255,60^A025,25^FD<t
            t-esc="res_company.convert_to_ascii(pick.partner_id.display_name and pick.partner_id.display_name[:38] or u'')"
          />^FS\r
    ^FO225,60^A025,25^FD<t
            t-esc="res_company.convert_to_ascii(pick.partner_id.display_name and pick.partner_id.display_name[38:60] or u'')"
          />^FS\r
    ^FO195,60^A030,25^FD<t t-esc="pick.partner_id.zip" /> <t
            t-esc="res_company.convert_to_ascii(pick.partner_id.city)"
          />^FS\r
    ^FO145,60^A025,25^FD<t
            t-esc="('customer_id' in pick) and (pick.partner_id != pick.customer_id) and res_company.convert_to_ascii(pick.customer_id.name and pick.customer_id.name[:29] or u'') or ''"
          />^FS\r


    <t t-if="pick.partner_id.is_price_on_labels and line.product_id.indicated_price">
    ^FO100,420^A025,25^FDPVI <t t-esc="line.product_id.indicated_price" /> EUR^FS\r
    </t>

    ^FO60,60^BY2
    ^BC,40,Y,Y,N,A^FDS-<t t-esc="line.product_id.default_code" />-<t
            t-esc="lot_id and lot_id.name or ''"
          />-^FS\r

    ^FO20,60^A015,15^FD<t t-esc="line.product_id.name[:60]" />^FS\r

    <t t-if="ship">
    ^FO295,200
    ^BQ,2,4
    ^FDQA,<t t-esc="ship.name" />^FS\r
    ^FO290,300^A020,20^FD<t t-esc="ship.name" />^FS\r
    </t>

    ^FWN
    ^XZ

    </t>
    </t>
    </div>
  </template>
  <report
    id="report_stock_product_food_label"
    string="Alcyon Product Food Label"
    model="stock.pack.operation"
    report_type="qweb-pdf"
    file="specific_print.stock_product_food_label_zebra_v1"
    name="specific_print.stock_product_food_label_zebra_v1"
  />
</odoo>
