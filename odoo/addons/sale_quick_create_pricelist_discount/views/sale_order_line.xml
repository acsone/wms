<odoo>
  <record model="ir.ui.view" id="sale_order_line_tree_edit">
    <field name="name">sale.order.line.tree.sale_quick_create_pricelist_discount</field>
    <field name="model">sale.order.line</field>
    <field name="inherit_id" ref="sale_quick_create.sale_order_line_tree_edit" />
    <field name="arch" type="xml">
      <xpath expr="//tree/field[@name='order_pricelist_id']" position="after">
        <field name="order_discount_pricelist_ids" invisible="1" />
      </xpath>
      <xpath expr="//tree/field[@name='discounting_type']" position="after">
        <field name="discount_item_id" invisible="1" />
      </xpath>
    </field>
  </record>
</odoo>
