<odoo noupdate="1">
    <record id="backend" model="shopinvader.backend">
        <field name="name">Alcyon Store</field>
        <field name="tech_name">alcyon_store</field>
        <field
      name="pricelist_id"
      eval="False"
    /> <!-- not pricelist since it come from the partner -->
        <field name="jwt_aud">alcyon_test</field>
        <field name="website_public_name">Alcyon</field>
        <field name="allowed_country_ids" eval="[(6,0,[ref('base.be')])]" />
<!-- BACKPORT         <field name="currency_ids" eval="[(6,0,[ref('base.EUR'),])]" />-->
<!-- BACKPORT         <field name="tech_name">shopinvader_backend</field>-->
<!-- BACKPORT         <field name="auth_api_key_id" ref="shopinvader_auth_key"/>-->
        <field name="product_manual_binding" eval="False" />
        <field name="product_assortment_id" ref="alc_eshop_product_domain.shopinvader_assortment_store" />
        <field
      name="shopinvader_variant_resize_ids"
      eval="[(6, 0, [ref('image_resize_small'), ref('image_resize_medium'), ref('image_resize_large')])]"
    />
        <field
      name="filter_ids"
      eval="[(6, 0, [ref('alc_eshop_filter_data.filter_manufacturer')])]"
    />
        <field
      name="lang_ids"
      eval="[(6, 0, [ref('base.lang_en'), ref('base.lang_fr_BE'), ref('base.lang_nl_BE')])]"
    />
        <field
      name="shopinvader_category_resize_ids"
      eval="[(6, 0, [ref('image_resize_small'), ref('image_resize_medium')])]"
    />
    </record>

</odoo>
