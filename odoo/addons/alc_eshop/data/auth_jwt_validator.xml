<?xml version="1.0" encoding="UTF-8" ?>
<odoo noupdate="1">
  <record id="shopinvader_keycloak_validator" model="auth.jwt.validator">
        <field name="name">shopinvader</field>
        <field name="audience">alcyon_test</field>
        <field
      name="issuer"
    >https://keycloak-alcyon.acsone-k8s-test.acsone.eu/auth/realms/alcyon-test</field>
        <field name="signature_type">public_key</field>
        <field name="public_key_algorithm">RS256</field>
        <field
      name="public_key_jwk_uri"
    >https://keycloak-alcyon.acsone-k8s-test.acsone.eu/auth/realms/alcyon-test/protocol/openid-connect/certs</field>
        <field name="user_id_strategy">static</field>
        <field name="static_user_id">1</field>
        <field name="partner_id_strategy">keycloak_pref_user</field>
        <field name="partner_id_required" eval="True" />
    </record>
</odoo>
