<odoo>

    <record model="ir.ui.view" id="magento_user_search_view">
        <field name="name">magento.user.search (in alc_eshop_user_migration)</field>
        <field name="model">magento.user</field>
        <field name="arch" type="xml">
            <search>
                <filter
          name="activated"
          string="Activated"
          domain="[('activated', '=', True)]"
        />
                <filter
          name="not_activated"
          string="Not yet activated"
          domain="[('activated', '=', False)]"
        />
            </search>
        </field>
    </record>

    <record model="ir.ui.view" id="magento_user_tree_view">
        <field name="name">magento.user.tree (in alc_eshop_user_migration)</field>
        <field name="model">magento.user</field>
        <field name="arch" type="xml">
            <tree>
                <field name="activated" />
                <field name="username" />
                <field name="partner_id" />
                <field name="magento_id" />
            </tree>
        </field>
    </record>

    <record model="ir.actions.act_window" id="magento_user_act_window">
        <field name="name">Magento User</field>
        <field name="res_model">magento.user</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>

    <record model="ir.ui.menu" id="magento_user_menu">
        <field name="name">Magento User</field>
        <field name="parent_id" ref="base.menu_custom" />
        <field name="action" ref="magento_user_act_window" />
        <field name="sequence" eval="99" />
    </record>

</odoo>
