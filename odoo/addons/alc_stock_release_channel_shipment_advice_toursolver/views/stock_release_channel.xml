<odoo>

    <record model="ir.ui.view" id="stock_release_channel_form_view">
        <field name="model">stock.release.channel</field>
        <field
      name="inherit_id"
      ref="stock_release_channel_shipment_advice_process_end_time.stock_release_channel_form_view"
    />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='group_loading']" position="before">
                <p
          colspan="2"
          style="color: grey; font-style: italic;"
        >Loading start = departure from the dock - loading time</p>
            </xpath>
            <xpath expr="//group[@name='group_loading_right']" position="inside">
                <field name="planned_start_loading_time" widget="float_time" />
            </xpath>
            <xpath expr="//group[@name='group_loading_left']" position="inside">
                <label for="loading_duration" />
                <div>
                    <field name="loading_duration" class="oe_inline" />
                    <span>minutes</span>
                </div>
            </xpath>
        </field>
    </record>



</odoo>
