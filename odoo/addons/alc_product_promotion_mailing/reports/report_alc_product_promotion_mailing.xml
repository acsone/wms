<odoo>
    <template
    id="report_alc_product_promotion_mailing"
    name="alc_product_promotion_mailing.report_alc_product_promotion_mailing"
  >
        <t t-set="title">Alcyon: Alert fin de promotion.</t>
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <div class="oe_structure" />
                    <div class="row">
                        <p>Chère / Cher
                            <span t-esc="partner.name" />,
                        </p>
                    </div>
                    <div class="row" t-foreach="promotions" t-as="promo_date">
                        <p>La promotion sur les articles suivants se termine le
                            <span t-esc="promo_date" style="font-weight: bold" />, sauf
                            modification de la part
                            du fournisseur.
                        </p>
                        <ul>
                            <t t-foreach="promotions[promo_date]" t-as="product">
                                <li>
                                    <t t-if="product.main_image_id">
                                        <t
                      t-set="image"
                      t-value="product.main_image_id"
                    />
                                        <t t-if="image.url">
                                            <img
                        t-att-src="image.url"
                        t-att-alt="image.name"
                        style="height: 80px; box-shadow: 10px 10px 20px black;"
                      />
                                        </t>
                                    </t>
                                    <a t-att-href="get_variant_url(product)">
                                        <span itemprop="website" t-esc="product.name" />
                                    </a>
                                </li>
                            </t>
                        </ul>
                    </div>
                    <p />
                    <p>Votre équipe Alcyon.</p>
                </div>
            </t>
        </t>
    </template>
    <record model="ir.actions.report" id="report_action_alc_product_promotion_mailing">
    <field name="name">Alcyon product mailing list</field>
    <field name="report_type">qweb-html</field>
      <field name="model">res.partner</field>
    <field
      name="report_name"
    >alc_product_promotion_mailing.report_alc_product_promotion_mailing</field>
    <field
      name="report_file"
    >alc_product_promotion_mailing.report_alc_product_promotion_mailing</field>
  </record>
</odoo>
