<odoo>

    <record model="ir.ui.view" id="res_config_settings_form_view">
        <field
      name="name"
    >res.config.settings.form (in alc_sale_exception_settings)</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <div id="connectors_setting_container" position="after">
                <h2 class="mt32">Promotions</h2>
                <div
          class="row mt16 o_settings_container"
          id="connectors_setting_container"
        >
                    <div
            class="col-12 col-lg-12 o_setting_box"
            id="nbr_before_end_promotion_mailing"
          >
                        <div class="o_setting_left_pane" />
                        <div class="o_setting_right_pane">
                            <label for="nbr_before_end_promotion_mailing_setting" />
                            <span>   </span>
                            <field name="nbr_before_end_promotion_mailing_setting" />
                        </div>
                    </div>
                    <div
            class="col-12 col-lg-12 o_setting_box"
            id="promotion_mailing_email_from"
          >
                        <div class="o_setting_left_pane" />
                        <div class="o_setting_right_pane">
                            <label for="promotion_mailing_email_from_setting" />
                            <span>   </span>
                            <field name="promotion_mailing_email_from_setting" />
                        </div>
                    </div>
                    <div
            class="col-12 col-lg-12 o_setting_box"
            id="promotion_website_url"
          >
                        <div class="o_setting_left_pane" />
                        <div class="o_setting_right_pane">
                            <label for="promotion_website_url_setting" />
                            <span>   </span>
                            <field name="promotion_website_url_setting" />
                        </div>
                    </div>
                </div>
            </div>
        </field>
    </record>

</odoo>
