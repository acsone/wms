<odoo>

    <record model="ir.ui.view" id="sale_config_settings_form_view">
        <field
      name="name"
    >sale.config.settings.form (in alc_product_promotion_mailing)</field>
        <field name="model">sale.config.settings</field>
        <field name="inherit_id" ref="sale.view_sales_config" />
        <field name="arch" type="xml">
            <group id="sale" position="after">
                <group id="discount" string="Promotions">
                    <field name="nbr_before_end_promotion_mailing_setting" />
                    <field name="promotion_mailing_email_from_setting" />
                </group>
            </group>
        </field>
    </record>

</odoo>
