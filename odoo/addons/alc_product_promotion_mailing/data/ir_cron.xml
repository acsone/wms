<odoo noupdate="1">
  <record forcecreate="True" id="ir_cron_generate_promotion_mailing" model="ir.cron">
    <field name="name">Send en of promotion mail alert</field>
    <field eval="True" name="active" />
    <field name="user_id" ref="base.user_root" />
    <field name="interval_number">1</field>
    <field name="interval_type">days</field>
    <field name="numbercall">-1</field>
    <field
      name="model_id"
      ref="alc_product_promotion_mailing.model_product_promotion_mailing_generator"
    />
    <field name="code">model._generate_promotion_mailing()</field>
    <field name="run_as_queue_job" eval="1" />
    <field ref="queue_job_cron.channel_root_ir_cron" name="channel_id" />
  </record>
</odoo>
