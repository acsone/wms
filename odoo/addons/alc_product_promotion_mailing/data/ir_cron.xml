<odoo noupdate="1">
  <record forcecreate="True" id="ir_cron_generate_promotion_mailing" model="ir.cron">
    <field name="name">Send en of promotion mail alert</field>
    <field eval="True" name="active" />
    <field name="user_id" ref="base.user_root" />
    <field name="interval_number">1</field>
    <field name="interval_type">days</field>
    <field name="numbercall">-1</field>
    <field eval="False" name="doall" />
    <field eval="'product.promotion.mailing.generator'" name="model" />
    <field eval="'_generate_promotion_mailing'" name="function" />
    <field eval="'()'" name="args" />
    <field eval="1" name="run_as_queue_job" />
    <field ref="queue_job_cron.channel_root_ir_cron" name="channel_id" />
  </record>
</odoo>
