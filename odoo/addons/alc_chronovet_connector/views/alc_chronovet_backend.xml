<odoo>

    <record model="ir.ui.view" id="alc_chronovet_backend_form_view">
        <field name="name">alc.chronovet.backend.form (in
            alc_chronovet_connector)
        </field>
        <field name="model">alc.chronovet.backend</field>
        <field name="arch" type="xml">
            <form>
                <header>
                </header>
                <sheet>
                    <label for="name" class="oe_edit_only"/>
                    <h1>
                        <field name="name" class="oe_inline"/>
                    </h1>
                    <group name="configuration">
                        <field name="product_assortment_id"
                               context="{'form_view_ref': 'product_assortment.product_assortment_view_form',
                                     'product_assortment': True,
                                     'default_is_assortment': 1}"/>
                        <field name="pricelist_id"/>
                        <field name="sale_team_id"/>
                        <field name="payment_mode_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>


    <record model="ir.actions.act_window"
            id="alc_chronovet_backend_act_window">
        <field name="name">Chronovet Configuration</field>
        <field name="res_model">alc.chronovet.backend</field>
        <field name="view_mode">form</field>
        <field name="view_type">form</field>
        <field name="res_id"
               ref="alc_chronovet_connector.alc_chronovet_backend"/>
    </record>


    <record model="ir.ui.menu" id="alc_chronovet_root_menu">
        <field name="name">Chronovet
        </field>
        <field name="parent_id" ref="connector.menu_connector_root"/>
        <field name="action" ref="alc_chronovet_backend_act_window"/>
        <field name="sequence" eval="36"/>
    </record>

    <record model="ir.ui.menu" id="alc_chronovet_backend_menu">
        <field name="name">Backend</field>
        <field name="parent_id" ref="alc_chronovet_root_menu"/>
        <field name="action" ref="alc_chronovet_backend_act_window"/>
        <field name="sequence" eval="16"/>
    </record>

</odoo>
