<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="view_move_picking_tree_helpdesk" model="ir.ui.view">
    <field name="name">view_move_picking_tree_helpdesk</field>
    <field name="model">stock.move</field>
    <field name="inherit_id" ref="stock.view_move_picking_tree" />
    <field name="arch" type="xml">
      <xpath expr="/tree/field[@name='state']" position="before">
        <field name="helpdesk_tickets_count" invisible="1" />
        <button
          name="helpdesk_ticket_clicked"
          type="object"
          fg_color="red:helpdesk_tickets_count>0;"
          icon="fa-life-ring"
        />
      </xpath>
    </field>
  </record>
</odoo>
