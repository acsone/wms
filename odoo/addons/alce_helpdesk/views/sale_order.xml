<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="sale_order_specific_form" model="ir.ui.view">
        <field name="name">sale.order.specific.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <div name="button_box" position="inside">
                <button class="oe_stat_button" name="action_view_helpdesk_tickets"
                        type="object" icon="fa-life-ring"
                        context="{'default_sale_order_id': active_id, 'default_partner_id': partner_id}">
                    <field string="Tickets" name="helpdesk_tickets_count" widget="statinfo" />
                </button>
            </div>

        </field>
    </record>

</odoo>
