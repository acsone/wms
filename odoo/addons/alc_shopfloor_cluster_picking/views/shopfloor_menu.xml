<odoo>

    <record model="ir.ui.view" id="shopfloor_menu_form_view">
        <field
      name="name"
    >shopfloor.menu.form (in alc_shopfloor_cluster_picking)</field>
        <field name="model">shopfloor.menu</field>
        <field name="inherit_id" ref="alc_shopfloor.shopfloor_menu_form_view" />
        <field name="arch" type="xml">
             <group name="options" position="inside">
                <group
          name="batch_create"
          attrs="{'invisible': [('scenario', '!=', 'cluster_picking')]}"
        >
                  <field name="batch_create" />
                  <field
            name="maximum_number_of_preparation_lines"
            attrs="{'invisible': [('batch_create', '=', False)]}"
          />
                  <field
            name="stock_device_type_ids"
            attrs="{'required': [('batch_create', '=', True)]}"
          />
                </group>
             </group>
        </field>
    </record>



</odoo>
