<odoo>
    <template id="alc_report_shipment_advice_document">
        <t t-call="web.html_container">
            <t t-set="index" t-value="1" />
            <t t-set="report" t-value="o.get_alc_report_shipment_advice()" />
            <t t-set="lines" t-value="report.line_ids" />
            <t t-set="company" t-value="o.company_id or res_company" />
            <div class="page">
                <h2>
                    <span t-field="o.display_name" /> -
                    <t t-if="o.toursolver_resource_id">
                        <span t-field="o.toursolver_resource_id.display_name" /> -
                    </t>
                    <span t-esc="datetime.date.today().strftime('%d/%m/%Y')" />
                </h2>
                <div class="row mb-3" id="shipment_header">
                    <div class="col-5">
                        <table class="table table-borderless">
                            <tbody>
                                <tr>
                                    <td>
                                        Exp: <span t-field="company.name" />
                                        <br />
                                        <span t-field="company.street" />
                                        <br />
                                        <span t-field="company.zip" />,
                                        <span t-field="company.city" />
                                    </td>
                                </tr>
                                <tr>
                                    <td>Start mileage</td>
                                    <td />
                                </tr>
                                <tr>
                                    <td>End mileage</td>
                                    <td />
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <div class="col-5 offset-2">
                        <table class="table table-borderless">
                            <tbody>
                                <tr>
                                    <td class="col-4">Stops</td>
                                    <td class="col-8">
                                        <span t-esc="len(lines)" />
                                    </td>
                                </tr>
                                <tr>
                                    <td>Departure time</td>
                                    <td>

                                    </td>
                                </tr>
                                <tr>
                                    <td>Arriving time</td>
                                    <td>

                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="row" id="shipment_content">
                    <t
            t-set="zone_mapping"
            t-value="{'Médicaments':'Médic.','Matériel':'Mat.','Aliments':'Alim.', 'Frigo': 'Froid'}"
          />
                    <table
            class="table table-bordered table-sm"
            name="bulk_content"
            t-if="lines"
          >
                        <thead>
                            <tr class="active bg-grey">
                                <th width="3%">Seq.</th>
                                <th width="20%">Customer</th>
                                <th>Notes</th>
                                <th width="10%">Phone</th>
                                <t t-set="max_zones" t-value="0" />
                                <t
                  t-foreach="report.location_ids.sorted('sequence_in_shipment_advice_report')._ids"
                  t-as="zone_location_id"
                >
                                    <th width="7%">
                                        <t t-if="zone_location_id">
                                            <t
                        t-esc="zone_mapping.get(o.env['stock.location'].browse(zone_location_id).name, '???')"
                      />
                                        </t>
                                        <t t-else="">
                                            <span
                        t-esc="o.env['stock.location'].browse(zone_location_id).name"
                      />
                                        </t>
                                        <t t-set="max_zones" t-value="max_zones + 1" />
                                    </th>
                                </t>
                                <th width="7%">Tot.</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="lines" t-as="line">
                                <t t-set="partner" t-value="line['partner_id']" />
                                <tr>
                                    <td>
                                        <span t-esc="index" />
                                    </td>
                                    <td>
                                        <div
                      t-esc="partner"
                      t-options='{"widget": "contact", "fields": ["name", "address"], "no_marker": True}'
                    />
                                        <span t-field="partner.ref" />
                                    </td>
                                    <td>
                                        <strong>
                                            <span t-esc="line['note']" />
                                        </strong>
                                    </td>
                                    <td>
                                        <span t-field="partner.mobile" />
                                        <br />
                                        <span t-field="partner.phone" />
                                    </td>
                                    <t t-set="nb_zones" t-value="0" />
                                    <t
                    t-foreach="report.location_ids._ids"
                    t-as="location_key"
                  >
                                        <td>
                                            <t
                        t-if="line.parcels_and_items_per_source['parcels'].get(str(location_key) if location_key else 'false')"
                      >
                                                <t
                          t-esc="int(line.parcels_and_items_per_source['parcels'][str(location_key) if location_key else 'false'])"
                        />
                                                box(es)
                                                <br />
                                            </t>
                                            <t
                        t-if="line.parcels_and_items_per_source['items'].get(str(location_key) if location_key else 'false')"
                      >
                                                <t
                          t-esc="int(line.parcels_and_items_per_source['items'][str(location_key) if location_key else 'false'])"
                        />
                                                unit(s)
                                            </t>
                                            <t
                        t-set="nb_zones"
                        t-value="nb_zones + 1"
                      />
                                        </td>
                                    </t>
                                    <t t-foreach="max_zones - nb_zones" t-as="idx">
                                        <td />
                                    </t>
                                    <td>
                                        <t
                      t-esc="int(line.parcels_and_items_per_source['parcels_total'])"
                    />
                                        box(es)
                                        <br />
                                        <t
                      t-esc="int(line.parcels_and_items_per_source['items_total'])"
                    />
                                        unit(s)
                                    </td>
                                </tr>
                                <t t-set="index" t-value="index + 1" />
                            </tr>
                            <tr>
                                <td
                  colspan="4"
                  class="active bg-grey"
                >Total number of box(es)</td>
                                <t
                  t-foreach="report.location_ids._ids"
                  t-as="zone_location_id"
                >
                                    <td class="text-end">
                                        <t
                      t-esc="int(report.parcels_and_items_per_source['total_zone_parcels'].get(str(zone_location_id), 0))"
                    />
                                    </td>
                                </t>
                                <td class="text-end">
                                    <t
                    t-esc="int(sum(x for x in report.parcels_and_items_per_source['total_zone_parcels'].values()))"
                  />
                                </td>
                            </tr>
                            <tr>
                                <td
                  colspan="4"
                  class="active bg-grey"
                >Total number of unit(s)</td>
                                 <t
                  t-foreach="report.location_ids._ids"
                  t-as="zone_location_id"
                >
                                    <td class="text-end">
                                        <t
                      t-esc="int(report.parcels_and_items_per_source['total_zone_items'].get(str(zone_location_id), 0))"
                    />
                                    </td>
                                </t>
                                <td class="text-end">
                                    <t
                    t-esc="int(sum(x for x in report.parcels_and_items_per_source['total_zone_items'].values()))"
                  />
                                </td>
                           </tr>
                            <tr>
                                <td
                  colspan="4"
                  class="active bg-grey"
                >Total of parcel(s)</td>
                                <t
                  t-foreach="report.location_ids._ids"
                  t-as="zone_location_id"
                >
                                    <td class="text-end">
                                        <t
                      t-esc="int(report.parcels_and_items_per_source['total_zone'].get(str(zone_location_id), 0))"
                    />
                                    </td>
                                </t>
                                <td class="text-end">
                                    <t
                    t-esc="int(sum(x for x in report.parcels_and_items_per_source['total_zone'].values()))"
                  />
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </t>
    </template>

    <template
    id="report_shipment_advice"
    inherit_id="shipment_advice.report_shipment_advice"
    priority="99"
  >
        <xpath
      expr="//t[@t-call='shipment_advice.report_shipment_advice_document']"
      position="replace"
    >
            <div
        class="article"
        t-att-data-oe-model="o and o._name"
        t-att-data-oe-id="o and o.id"
        t-att-data-oe-lang="o and o.env.context.get('lang')"
      >
                <t
          t-call="alc_report_shipment_advice.alc_report_shipment_advice_document"
        />
            </div>
        </xpath>
    </template>

    <record
    id="shipment_advice.action_report_shipment_advice"
    model="ir.actions.report"
  >
        <field
      name="paperformat_id"
      ref="alc_report_shipment_advice.paperformat_shipment_advice"
    />
    </record>
</odoo>
