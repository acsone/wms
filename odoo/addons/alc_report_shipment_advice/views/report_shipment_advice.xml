<odoo>
    <template
    id="report_shipment_advice_document"
    inherit_id="shipment_advice.report_shipment_advice_document"
  >

        <xpath expr="//div[hasclass('page')]" position="before">
            <t t-set="index" t-value="1" />
            <t t-set="report" t-value="o.get_alc_report_shipment_advice()" />
            <t t-set="lines" t-value="report.line_ids" />
            <t t-set="company" t-value="o.company_id" />
        </xpath>
        <xpath expr="//table[@name='header']" position="attributes">
            <attribute name="invisible">1</attribute>
        </xpath>
        <xpath expr="//table[@name='header']" position="after">
            <h2>
                <t t-if="o.toursolver_resource_id">
                    <span t-field="o.display_name" /> -
                    <span t-field="o.toursolver_resource_id.display_name" />
                </t>
                <t t-else="">
                    <span t-field="o.display_name" />
                </t>
            </h2>
            <div class="row">
                <div class="col-5">
                    <table class="table">
                        <tbody>
                            <tr>
                                <td>
                                    Exp: <span t-field="company.name" />
                                    <br />
                                    <span t-field="company.street" />
                                    <br />
                                    <span t-field="company.zip" />,
                                    <span t-field="company.city" />
                                </td>
                            </tr>
                            <tr>
                                <td>Start mileage</td>
                                <td />
                            </tr>
                            <tr>
                                <td>End mileage</td>
                                <td />
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="col-5 offset-2">
                    <table class="table">
                        <tbody>
                            <tr>
                                <td class="col-4">Stops</td>
                                <td class="col-8">
                                    <span t-esc="len(lines)" />
                                </td>
                            </tr>
                            <tr>
                                <td>Departure time</td>
                                <td>
                                    <t t-if="o.departure_date">
                                        <span
                      t-esc="o.departure_date.strftime('%H:%M')"
                    />
                                    </t>

                                </td>
                            </tr>
                            <tr>
                                <td>Arriving time</td>
                                    <t t-if="o.arrival_date">
                                        <span
                    t-esc="o.arrival_date.strftime('%H:%M')"
                  />
                                    </t>
                                <td />
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </xpath>
        <xpath expr="//table[@name='package_content']" position="attributes">
            <attribute name="invisible">1</attribute>
        </xpath>
        <xpath expr="//table[@name='bulk_content']" position="attributes">
            <attribute name="invisible">1</attribute>
        </xpath>
        <xpath expr="//table[@name='bulk_content']" position="after">
            <div class="row">
                <table
          class="table table-bordered table-condensed"
          name="bulk_content"
          t-if="lines"
        >
                    <thead>
                        <tr class="active">
                            <th>Seq.</th>
                            <th>Customer</th>
                            <th>Notes</th>
                            <th>Phone</th>
                            <t t-foreach="report.location_ids" t-as="zone_location">
                                <th>
                                    <t t-esc="zone_location.name" />
                                </th>
                            </t>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="lines" t-as="line">
                            <t t-set="partner" t-value="line['partner_id']" />
                            <tr>
                                <td>
                                    <span t-esc="index" />
                                </td>
                                <td>
                                    <div
                    t-esc="partner"
                    t-options='{"widget": "contact", "fields": ["name", "address"], "no_marker": True}'
                  />
                                    <span t-field="partner.ref" />
                                </td>
                                <td style="width: 40%;">
                                    <strong>
                                        <span t-esc="line['note']" />
                                    </strong>
                                </td>
                                <td>
                                    <span t-field="partner.mobile" />
                                    <br />
                                    <span t-field="partner.phone" />
                                </td>
                                <t
                  t-foreach="line.parcels_and_items_per_source['locations']"
                  t-as="location_key"
                >
                                    <td>
                                        <t
                      t-if="line.parcels_and_items_per_source['parcels'].get(str(location_key))"
                    >
                                            <t
                        t-esc="line.parcels_and_items_per_source['parcels'][str(location_key)]"
                      />
                                            box(es)
                                            <br />
                                        </t>
                                        <t
                      t-if="line.parcels_and_items_per_source['items'].get(str(location_key))"
                    >
                                            <t
                        t-esc="line.parcels_and_items_per_source['items'][str(location_key)]"
                      />
                                            unit(s)
                                        </t>

                                    </td>

                                </t>
                            </tr>
                        <t t-set="index" t-value="index + 1" />
                        </tr>
                        <tr>
                            <td colspan="4" class="active">Total number of box(es)</td>
                            <td>
                                <t
                  t-esc="o.parcels_and_items_per_source['total_parcels']"
                />
                            </td>
                        </tr>
                        <tr>
                            <td colspan="4" class="active">Total number of unit(s)</td>
                            <td>
                                <t
                  t-esc="o.parcels_and_items_per_source['total_items']"
                />
                            </td>
                        </tr>
                        <tr>
                            <td colspan="4" class="active">Total of parcel(s)</td>
                            <td>
                                <t t-esc="o.parcels_and_items_per_source['total']" />
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </xpath>
    </template>

    <template id="report_shipment_advice">
        <t t-foreach="docs" t-as="o">
            <t t-call="alc_report_shipment_advice.report_shipment_advice_document" />
        </t>
    </template>

    <record
    id="shipment_advice.action_report_shipment_advice"
    model="ir.actions.report"
  >
        <field
      name="paperformat_id"
      ref="alc_report_shipment_advice.paperformat_shipment_advice"
    />
    </record>
</odoo>
