<odoo>
    <record id="res_config_settings_view_form_stock" model="ir.ui.view">
        <field name="name">alc_report_shipment_advice res.config.settings form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath
        expr="//div[@data-string='Inventory']//div[@name='shipping_setting_container']"
        position="inside"
      >
                <div
          class="col-12 col-lg-6 o_setting_box"
          id="alc_shipment_advice_report"
          title="Configure the default behaviour for new delivery carriers."
        >
                    <div class="o_setting_left_pane">

                    </div>
                    <div class="o_setting_right_pane">
                        <label for="shipment_advice_packages_display_mode" />
                        <field name="shipment_advice_packages_display_mode" />
                        <div
              class="text-muted"
              id="shipment_advice_packages_display_mode_help"
            >
                            Check this to enable automatic package creation behaviour for all new delivery carriers.
                        </div>
                    </div>


                </div>
            </xpath>
        </field>
    </record>
</odoo>
