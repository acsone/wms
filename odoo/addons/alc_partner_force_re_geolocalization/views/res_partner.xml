<odoo>
  <record model="ir.ui.view" id="res_partner_form_view">
    <field
      name="name"
    >res.partner.form (in alc_partner_force_re_geolocalization)</field>
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="base.view_partner_form" />
    <field name="arch" type="xml">
        <field name="name" position="after">
          <field name="coordinates_should_be_checked" invisible="1" />
        </field>
        <div name="button_box" position="after">
        <div
          class="text-warning"
          attrs="{'invisible': [('coordinates_should_be_checked', '=', False)]}"
        >
          The address has changed for this partner. Please press 'Geolocalize' once again (Partner Assignation tab) and check that the point correspond to the address. If not, please enter the correct point on the map.
        </div>
        </div>
    </field>
  </record>
</odoo>
