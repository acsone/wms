<odoo>

    <record model="ir.ui.view" id="stock_picking_form_view">
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form" />
        <field name="arch" type="xml">
            <xpath
        expr="//button[@name='%(stock.act_stock_return_picking)d']"
        position="attributes"
      >
                <attribute
          name="groups"
        >alc_stock_picking_return_security.group_can_return_stock_picking</attribute>
            </xpath>
        </field>
    </record>

</odoo>
