<odoo>


    <record model="ir.ui.view" id="select_pharmacy_printing_printer_form_view">
        <field
      name="name"
    >select.pharmacy.printing.printer.form (in alc_reception_pharmacy)</field>
        <field name="model">select.pharmacy.printing.printer</field>
        <field name="arch" type="xml">
            <form string="Select Pharmacy Printer">
                <group>
                    <field name="printer_id" />
                </group>
                <footer>
                    <button name="doit" string="OK" class="btn-primary" type="object" />
                    <button string="Cancel" class="btn-default" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
    <record
    model="ir.actions.act_window"
    id="select_pharmacy_printing_printer_act_window"
  >
        <field name="name">Select Pharmacy Printer</field>
        <field name="res_model">select.pharmacy.printing.printer</field>
        <field name="view_mode">form</field>
        <field name="context">{}</field>
        <field name="target">new</field>
    </record>
    <menuitem
    id="select_pharmacy_printing_printer_menu"
    name="Select Pharmacy Printing Printer"
    parent="stock.menu_stock_inventory_control"
    sequence="80"
    action="select_pharmacy_printing_printer_act_window"
  />

</odoo>
