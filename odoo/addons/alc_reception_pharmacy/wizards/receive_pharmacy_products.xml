<odoo>

    <record model="ir.ui.view" id="receive_pharmacy_products_form_view">
        <field
      name="name"
    >receive.pharmacy.products.form (in alc_reception_pharmacy)</field>
        <field name="model">receive.pharmacy.products</field>
        <field name="arch" type="xml">
            <form string="Receive Pharmacy Products">
                <sheet>
                    <group name="pharmacy_line_info">
                        <group>
                            <field name="customer_id" required="1" />
                            <field name="bin_id" required="1" />
                            <field name="lot_name" required="1" />
                            <field name="product_qty" required="1" />
                            <field name="state" invisible="1" />
                            <field name="reception_pharmacy_id" invisible="1" />
                        </group>
                    </group>
                    <button
            name="validate_reception"
            type="object"
            string="ADD"
            class="btn btn-primary"
            attrs="{'invisible': [('state', '!=', 'draft')]}"
          />
                </sheet>
            </form>
        </field>
    </record>

    <record model="ir.actions.act_window" id="receive_pharmacy_products_act_window">
        <field name="name">Receive Pharmacy Products</field>
        <field name="res_model">receive.pharmacy.products</field>
        <field name="view_mode">form</field>
        <field name="context">{}</field>
        <field name="target">current</field>
    </record>



</odoo>
