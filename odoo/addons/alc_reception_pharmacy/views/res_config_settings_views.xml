<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view (in alc_reception_pharmacy)</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <div name="operations_setting_container" position="inside">
                <div
          class="col-12 col-lg-6 o_setting_box"
          id="delivered_by_alcyon_constraint"
        >
                    <div class="o_setting_left_pane">
                        <field name="delivered_by_alcyon_constraint" />
                    </div>
                    <div class="o_setting_right_pane">
                        <label
              for="delivered_by_alcyon_constraint"
              string="Constrain customers for pharmacy receptions"
            />
                        <div class="text-muted">
                            Enable the constraint that check there is a at least a release channel with Alcyon as
                            transporter and a delivery zone containing the geographic location of the customer.
                        </div>
                    </div>
                </div>
            </div>
        </field>
    </record>
</odoo>
