<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_reception_pharmacy_line_tree" model="ir.ui.view">
    <field name="name">reception.pharmacy.line.tree</field>
    <field name="model">reception.pharmacy.line</field>
    <field name="arch" type="xml">
      <tree editable="bottom" create="0">
          <field name="customer_id" options="{'no_open':True,'no_create':True}" />
          <field
          name="partner_shipping_id"
          options="{'no_open':True,'no_create':True}"
        />
          <field name="bin_id" options="{'no_open':True,'no_create':True}" />
          <field name="lot_id" options="{'no_open':True,'no_create':True}" />
          <field name="product_qty" options="{'no_open':True,'no_create':True}" />
          <field name="state" />
        </tree>
    </field>
  </record>
</odoo>
