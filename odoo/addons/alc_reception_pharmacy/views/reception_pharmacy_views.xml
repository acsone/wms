<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="reception_pharmacy_view_tree" model="ir.ui.view">
    <field name="name">reception.pharmacy</field>
    <field name="model">reception.pharmacy</field>
    <field name="arch" type="xml">
      <tree>
        <field name="create_uid" />
        <field name="date" />
        <field name="state" />
      </tree>
    </field>
  </record>
  <record id="reception_pharmacy_view_form" model="ir.ui.view">
    <field name="name">reception.pharmacy</field>
    <field name="model">reception.pharmacy</field>
    <field name="arch" type="xml">
      <form string="Pharmacy Reception">
        <header>
          <button name="validate" string="Transfer" type="object" states="draft" />
          <button
            name="%(receive_pharmacy_products_act_window)d"
            string="Receive"
            type="action"
            states="draft"
            context="{'default_reception_pharmacy_id': active_id}"
          />
          <button name="action_cancel" string="Cancel" type="object" states="draft" />
          <field name="state" widget="statusbar" statusbar_visible="draft,done" />
        </header>
        <sheet>
          <group>
            <group>
              <field name="product_id" />
            </group>
            <group>
              <field name="date" readonly="1" />
              <field name="create_uid" readonly="1" />
            </group>
          </group>
          <field
            name="line_ids"
            context="{'tree_view_ref': 'alc_reception_pharmacy.view_reception_pharmacy_line_tree'}"
          />
        </sheet>
      </form>
    </field>
  </record>

  <record id="reception_pharmacy_action" model="ir.actions.act_window">
    <field name="name">Reception Pharmacy List</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">reception.pharmacy</field>
    <field name="view_mode">tree,form</field>
  </record>
  <menuitem
    id="reception_pharmacy_menu"
    action="reception_pharmacy_action"
    name="Reception Pharmacy"
    parent="stock.menu_stock_inventory_control"
    sequence="60"
  />

</odoo>
