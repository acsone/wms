<odoo>


    <record model="ir.ui.view" id="stock_move_line_search_view">
        <field name="name">stock.move.line.search</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.stock_move_line_view_search" />
        <field name="arch" type="xml">
            <filter name="done" position="after">
              <separator />
              <filter string="Urgent" name="urgent" domain="[('priority', '=', '1')]" />
            </filter>
        </field>
    </record>

    <record model="ir.ui.view" id="stock_move_line_tree_view">
        <field name="name">stock.move.line.tree</field>
        <field name="model">stock.move.line</field>
       <field name="inherit_id" ref="stock.view_move_line_tree" />
        <field name="arch" type="xml">
            <field name="location_usage" position="before">
                <field
          name="priority"
          string="Priority"
          widget="priority"
          optional="hide"
        />
            </field>
        </field>
    </record>

    <record model="ir.ui.view" id="stock_move_line_tree_detailed_view">
        <field name="name">stock.move.line.tree.detailed</field>
        <field name="model">stock.move.line</field>
       <field name="inherit_id" ref="stock.view_move_line_tree_detailed" />
        <field name="arch" type="xml">
            <field name="date" position="before">
                <field
          name="priority"
          string="Priority"
          widget="priority"
          optional="hide"
        />
            </field>
        </field>
    </record>
</odoo>
