<odoo>
    <record id="stock_picking_form_view" model="ir.ui.view">
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form" />
        <field name="arch" type="xml">
            <header position="inside">
                <field name="delivery_requires_other_lines" invisible="1" />
                <field name="ignore_release_channel_block" invisible="1" />
                <button
          name="button_ignore_release_channel_block"
          type="object"
          string="Ignore release channel block"
          attrs="{'invisible': ['|', ('delivery_requires_other_lines', '=', False), ('ignore_release_channel_block', '=', True)]}"
        />
            </header>
        </field>
    </record>
</odoo>
