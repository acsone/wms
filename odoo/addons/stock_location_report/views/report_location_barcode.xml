<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data>

<template id="assets_common" name="stock_location_barcodes pdf assets" inherit_id="report.assets_common">
    <xpath expr="." position="inside">
        <link href="/stock_location_report/static/src/less/location_barcode_8x2.less" rel="stylesheet"/>
        <link href="/stock_location_report/static/src/less/location_barcode_4x2.less" rel="stylesheet"/>
    </xpath>
</template>

<template id="stock_location_report.report_location_barcode_8x2">
    <t t-call="report.html_container">
        <div class="page stock_location_barcode_8x2">
            <t t-call="stock_location_report.qrcode_items"/>
        </div>
    </t>
</template>

<template id="stock_location_report.report_location_barcode_4x2">
    <t t-call="report.html_container">
        <div class="page stock_location_barcode_4x2">
            <t t-call="stock_location_report.barcode_items"/>
        </div>
    </t>
</template>

<template id="stock_location_report.barcode_items">
    <div t-foreach="docs" t-as="o"  t-att-class="'container container_%s %s' % (o.height, o.kind)">
        <t t-if="not o.barcode"><t t-set="content" t-value="'L#%s' % o.name"/></t>
        <t t-set="content" t-value="content.replace('#', '%%23')"/>
        <div class="barcode_name">
            <t t-esc="o.name[0:2]"/> <t t-esc="o.name[2:4]"/> <t t-esc="o.name[4:]"/>
        </div>
        <div class="barcode_checksum">
            <div t-esc="o.bin_checksum_1"/>

        </div> 
        <div class="barcode">
            <img t-att-src="'/report/barcode/?type=%s&amp;value=%s&amp;width=%s&amp;height=%s' % ('Code128', content, 425, 73)"/>
        </div> 
    </div>
</template>

<template id="stock_location_report.qrcode_items">
    <div t-foreach="docs" t-as="o" t-att-class="'container container_%s %s' % (o.height, o.kind)">
        <t t-if="o.barcode"><t t-set="content" t-value="o.barcode"/></t>
        <t t-if="not o.barcode"><t t-set="content" t-value="'L#%s' % o.name"/></t>
        <t t-set="content" t-value="content.replace('#', '%%23')"/>
        <div class="barcode">
            <img t-att-src="'/report/qrcode/?value=%s&amp;size=5&amp;border=1' % content"/>
        </div>
        <div class="barcode_name">
            <t t-esc="o.name[0:2]"/> <t t-esc="o.name[2:4]"/> <t t-esc="o.name[4:]"/>
        </div>
        <div class="barcode_checksum">
            <div t-esc="o.bin_checksum_1"/>
            <div t-esc="o.bin_checksum_2"/>
        </div>
    </div>
</template>

<report
    string="Location Barcode 4x2"
    id="action_report_location_barcode_4x2"
    model="stock.location"
    report_type="qweb-pdf"
    name="stock_location_report.report_location_barcode_4x2"
    file="stock_location_report.report_location_barcode_4x2"
/>

<report
    string="Location Barcode 8x2"
    id="action_report_location_barcode_8x2"
    model="stock.location"
    report_type="qweb-pdf"
    name="stock_location_report.report_location_barcode_8x2"
    file="stock_location_report.report_location_barcode_8x2"
/>

</data>
</odoo>
