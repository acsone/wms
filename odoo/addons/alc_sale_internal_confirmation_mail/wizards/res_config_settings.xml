<odoo>

    <record model="ir.ui.view" id="res_config_settings_form_view">
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath
        expr="//div[@id='sale_config_online_confirmation_pay']"
        position="after"
      >
                <div
          class="col-xs-12 col-md-6 o_setting_box"
          id="send_confirmation_email_internal"
        >
            <div class="o_setting_left_pane">
              <field name="send_confirmation_email_internal" />
            </div>
            <div class="o_setting_right_pane">
              <label for="send_confirmation_email_internal" />
              <div class="text-muted">
                Send confirmation mail for orders from internal sale channels.
              </div>
            </div>
          </div>
            </xpath>
        </field>
    </record>

</odoo>
