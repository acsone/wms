<odoo>

    <record model="ir.ui.view" id="round_instance_form_view">
        <field
      name="name"
    >round.instance.form (in alc_delivery_rounds_close_pickings_by_zone)</field>
        <field name="model">round.instance</field>
        <field name="inherit_id" ref="delivery_rounds.view_round_instance_form" />
        <field name="arch" type="xml">
            <xpath
        expr="//button[@name='toggle_picking_launched']"
        position="before"
      >  <button
          name="toggle_picking_ali_launched"
          states="draft,close"
          type="object"
          class="oe_stat_button"
          icon="fa-volume-down"
        >
                <field
            name="picking_ali_launched"
            widget="boolean_button"
            options="{&quot;terminology&quot;: {'string_true':'Ali Launched','string_false':'Ali Stopped'}}"
          />
                </button>
                <button
          name="toggle_picking_med_launched"
          states="draft,close"
          type="object"
          class="oe_stat_button"
          icon="fa-volume-down"
        >
                <field
            name="picking_med_launched"
            widget="boolean_button"
            options="{&quot;terminology&quot;: {'string_true':'Med Launched','string_false':'Med Stopped'}}"
          />
                </button>
                <button
          name="toggle_picking_mat_launched"
          states="draft,close"
          type="object"
          class="oe_stat_button"
          icon="fa-volume-down"
        >
                <field
            name="picking_mat_launched"
            widget="boolean_button"
            options="{&quot;terminology&quot;: {'string_true':'Mat Launched','string_false':'Mat Stopped'}}"
          />
                </button>
                <button
          name="toggle_picking_frigo_launched"
          states="draft,close"
          type="object"
          class="oe_stat_button"
          icon="fa-volume-down"
        >
                <field
            name="picking_frigo_launched"
            widget="boolean_button"
            options="{&quot;terminology&quot;: {'string_true':'Frigo Launched','string_false':'Frigo Stopped'}}"
          />
                </button>
            </xpath>
           <xpath expr="//field[@name='time_leave_planned']" position="after">
        <field name="auto_close_picking_launched" />
        <field
          name="time_reopen_picking_launched"
          widget="float_time"
          attrs="{'invisible': [('auto_close_picking_launched', '=', False)]}"
        />
      </xpath>
        </field>
    </record>

  <record id="view_round_instance_kanban" model="ir.ui.view">
    <field
      name="name"
    >round.instance (in alc_delivery_rounds_close_pickings_by_zone</field>
    <field name="model">round.instance</field>
    <field name="inherit_id" ref="delivery_rounds_alcyon.view_round_instance_kanban" />
    <field name="arch" type="xml">
      <xpath expr="//templates" position="before">
        <field name="picking_ali_launched" />
        <field name="picking_med_launched" />
        <field name="picking_frigo_launched" />
        <field name="picking_mat_launched" />
        <field name="partially_open" />
      </xpath>
        <xpath expr="//i[@name='start_stop_pickings']" position="attributes">
        <attribute name="t-attf-class">
        oe_inline fa #{record.picking_launched.raw_value ? 'fa-volume-up' : 'fa-volume-off'} #{record.partially_open.raw_value ? 'orange-mic' : ''}
        </attribute>
        </xpath>
      <xpath expr="//div[@id='progress-bar-ali']" position="attributes">
          <attribute name="class">resize-progress-bar</attribute>
      </xpath>
      <xpath expr="//div[@id='master-ali']" position="inside">
            <div class="btn-toggle-sound">
              <a name="toggle_picking_ali_launched" type="object" states="draft,close">
                <i
              t-attf-class="fa #{record.picking_ali_launched.raw_value ? 'fa-volume-up' : 'fa-volume-off'}"
              title="Start/Stop ali pickings"
            />
              </a>
            </div>
        </xpath>
      <xpath expr="//div[@id='progress-bar-pharm']" position="attributes">
          <attribute name="class">resize-progress-bar</attribute>
      </xpath>
      <xpath expr="//div[@id='master-pharm']" position="inside">
            <div class="btn-toggle-sound">
              <a name="toggle_picking_med_launched" type="object" states="draft,close">
                <i
              t-attf-class="fa #{record.picking_med_launched.raw_value ? 'fa-volume-up' : 'fa-volume-off'}"
              title="Start/Stop med pickings"
            />
              </a>
            </div>
        </xpath>
      <xpath expr="//div[@id='progress-bar-frigo']" position="attributes">
          <attribute name="class">resize-progress-bar</attribute>
      </xpath>
      <xpath expr="//div[@id='master-frigo']" position="inside">
            <div class="btn-toggle-sound">
              <a
            name="toggle_picking_frigo_launched"
            type="object"
            states="draft,close"
          >
                <i
              t-attf-class="fa #{record.picking_frigo_launched.raw_value ? 'fa-volume-up' : 'fa-volume-off'}"
              title="Start/Stop frigo pickings"
            />
              </a>
            </div>
        </xpath>
      <xpath expr="//div[@id='progress-bar-mat']" position="attributes">
          <attribute name="class">resize-progress-bar</attribute>
      </xpath>
      <xpath expr="//div[@id='master-mat']" position="inside">
            <div class="btn-toggle-sound">
              <a name="toggle_picking_mat_launched" type="object" states="draft,close">
                <i
              t-attf-class="fa #{record.picking_mat_launched.raw_value ? 'fa-volume-up' : 'fa-volume-off'}"
              title="Start/Stop mat pickings"
            />
              </a>
            </div>
        </xpath>
    </field>
  </record>

</odoo>
