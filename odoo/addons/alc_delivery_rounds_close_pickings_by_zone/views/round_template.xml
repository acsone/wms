<odoo>

    <record model="ir.ui.view" id="round_template_form_view">
        <field
      name="name"
    >round.template.form (in alc_delivery_rounds_close_pickings_by_zone)</field>
        <field name="model">round.template</field>
        <field name="inherit_id" ref="delivery_rounds.view_round_template_form" />
        <field name="arch" type="xml">
            <field name="time_leave_planned" position="after">
                <field name="auto_close_picking_launched" />
                <field name="time_reopen_picking_lauched" widget="float_time" />
            </field>
        </field>
    </record>

    <record model="ir.ui.view" id="round_template_tree_view">
        <field
      name="name"
    >round.template.tree (in alc_delivery_rounds_close_pickings_by_zone)</field>
        <field name="model">round.template</field>
        <field name="inherit_id" ref="delivery_rounds.view_round_template_tree" />
        <field name="arch" type="xml">
        <field name="name" position="after">
            <field name="auto_close_picking_launched" />
            <field name="time_reopen_picking_lauched" widget="float_time" />
        </field>
        </field>
    </record>

</odoo>
