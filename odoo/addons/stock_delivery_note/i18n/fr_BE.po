#. module: stock_delivery_note
#: model:mail.template,body_html:stock_delivery_note.delivery_note_csv
msgid ""
"\n"
"            \n"
"                <p>Hello,</p>\n"
"                <p>Please find here attached the electronic delivery note.</"
"p>\n"
"                <p>We wish you good reception.</p>\n"
"                <p>Sincerely,</p>\n"
"                <p>Your Team Alcyon</p>\n"
"            \n"
"        "
msgstr ""
"\n"
"\n"
"<p>Bonjour,</p>\n"
"<p>Vous trouverez ci-joint la note d’envoi électronique de votre livraison.</"
"p>\n"
"<p>Nous vous en souhaitons bonne réception.</p>\n"
"<p>Cordialement,</p>\n"
"<p>Votre équipe Alcyon</p>\n"
"\n"

