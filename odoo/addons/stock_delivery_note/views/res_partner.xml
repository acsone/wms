<odoo>
    <record model="ir.ui.view" id="view_partner_form">
        <field name="name">res.partner.form (in stock_delivery_note)</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="delivery_rounds.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='delivery']" position="inside">
                <field name="send_csv_deliveryship" attrs="{'invisible': [('customer', '=', False)]}"/>
                <field name="send_pdf_deliveryship" attrs="{'invisible': [('customer', '=', False)]}"/>
          </xpath>
        </field>
    </record>
</odoo>
