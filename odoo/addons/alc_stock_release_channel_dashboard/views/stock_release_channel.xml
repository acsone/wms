<odoo>

    <record id="stock_release_channel_dashboard_kanban_view" model="ir.ui.view">
        <field name="model">stock.release.channel</field>
        <field name="arch" type="xml">
            <kanban
        class="oe_background_grey o_kanban_dashboard o_release_channel_kanban"
        group_create="0"
        create="0"
        js_class="alc_stock_release_channel_kanban"
      >
                <field name="id" />
                <field name="name" />
                <field name="color" />
                <field name="pick_allowed" />
                <field name="state" />
                <field name="is_auto_release_allowed" />
                <field name="is_action_wake_up_allowed" />
                <field name="is_action_sleep_allowed" />
                <field name="is_action_unlock_allowed" />
                <field name="is_action_lock_allowed" />
                <field name="is_action_deliver_allowed" />
                <field name="is_action_print_allowed" />
                <field name="is_action_print_cash_invoices_allowed" />
                <field name="is_mobile_export_allowed" />
                <field name="release_forbidden" />
                <field name="active" />
                <field name="kanban_dashboard" />
                <templates>
                    <t t-name="kanban-box">
                        <t
              t-value="JSON.parse(record.kanban_dashboard.raw_value)"
              t-set="dashboard"
            />
                        <t t-value="dashboard['data']" t-set="dashboard_data" />
                        <t t-value="dashboard['tags']" t-set="dashboard_tags" />
                        <div
              t-attf-class="#{!selection_mode ? kanban_color(record.color.raw_value) : ''}"
            >
                            <t t-call="ChannelTop" />
                            <t t-call="ChannelDashboard" />
                        </div>
                    </t>
                    <t t-name="ChannelTop">
                        <div t-attf-class="o_kanban_card_header">
                            <div class="o_kanban_card_header_title">
                                <div class="o_primary">
                                    <a
                    type="object"
                    name="action_kanban_dashboard_open"
                    style="margin-right: 10%;"
                  >
                                        <field name="name" />
                                        <field
                      name="process_end_date"
                      title="End Date"
                      attrs="{'invisible': [('process_end_date', '=', False)]}"
                      class="badge rounded-pill bg-o-color-1 ml4"
                    />
                                    </a>
                                    <span
                    tabindex="-1"
                    class="o_tag_color_0 badge rounded-pill o_tag d-inline-flex align-items-center"
                    data-color="0"
                    t-att-title="tag"
                    style="box-shadow: inset 0 0 0 1px;background-color: red;color: white;"
                    attrs="{'invisible': [('release_forbidden', '=', False)]}"
                  >
                                        <div class="o_tag_badge_text">Forbidden</div>
                                    </span>
                                    <span
                    tabindex="-1"
                    class="o_tag_color_0 badge rounded-pill o_tag d-inline-flex align-items-center"
                    data-color="0"
                    t-att-title="tag"
                    style="box-shadow: inset 0 0 0 1px;background-color: orange;color: white;"
                    attrs="{'invisible': [('state', '!=', 'delivering')]}"
                  >
                                        <div class="o_tag_badge_text">Delivering</div>
                                    </span>
                                    <span
                    tabindex="-1"
                    class="o_tag_color_0 badge rounded-pill o_tag d-inline-flex align-items-center"
                    data-color="0"
                    t-att-title="tag"
                    style="box-shadow: inset 0 0 0 1px;background-color: red;color: white;"
                    attrs="{'invisible': [('state', '!=', 'delivering_error')]}"
                  >
                                        <div
                      class="o_tag_badge_text"
                    >Delivering error</div>
                                    </span>
                                    <span
                    tabindex="-1"
                    class="o_tag_color_0 badge rounded-pill o_tag d-inline-flex align-items-center"
                    data-color="0"
                    t-att-title="tag"
                    style="box-shadow: inset 0 0 0 1px;background-color: green;color: white;"
                    attrs="{'invisible': [('state', '!=', 'delivered')]}"
                  >
                                        <div class="o_tag_badge_text">Delivered</div>
                                    </span>
                                    <span
                    tabindex="-1"
                    class="o_tag_color_0 badge rounded-pill o_tag d-inline-flex align-items-center"
                    data-color="0"
                    t-att-title="tag"
                    style="box-shadow: inset 0 0 0 1px;background-color: red;color: white;"
                    attrs="{'invisible': [('active', '=', True)]}"
                  >
                                        <div class="o_tag_badge_text">Archived</div>
                                    </span>
                                </div>
                                <t t-foreach="dashboard_tags" t-as="tag">
                                    <span
                    tabindex="-1"
                    class="o_tag_color_0 badge rounded-pill o_tag d-inline-flex align-items-center"
                    data-color="0"
                    t-att-title="tag"
                    style="box-shadow: inset 0 0 0 1px;"
                  >
                                        <div class="o_tag_badge_text"><t
                        t-esc="tag"
                      /></div>
                                    </span>
                                </t>
                            </div>
                            <div class="o_kanban_manage_button_section">
                                <a class="o_kanban_manage_toggle_button" href="#">
                                    <i
                    class="fa fa-ellipsis-v"
                    aria-label="Selection"
                    role="img"
                    title="Selection"
                  />
                                </a>
                            </div>
                            <div
                class="container o_kanban_card_manage_pane dropdown-menu"
                role="menu"
              >
                                <t t-call="ChannelManage" />
                            </div>
                        </div>
                    </t>
                    <t t-name="ChannelManage">
                        <div class="row">
                            <span>Actions</span>
                        </div>
                        <div
              t-if="record.is_mobile_export_allowed.raw_value"
              class="row"
            >
                          <a
                name="button_export_to_mobile_app"
                type="object"
              >Export to mobile app</a>
                        </div>
                        <div
              t-if="widget.editable"
              class="o_kanban_card_manage_settings row"
            >
                            <div class="col-8">
                                <ul class="oe_kanban_colorpicker" data-field="color" />
                            </div>
                        </div>
                        <div class="row o_kanban_card_settings">
                            <div class="col-6 text-right mt-1">
                                <a
                  class="dropdown-item"
                  t-if="widget.editable"
                  type="edit"
                >Configuration
                                </a>
                            </div>
                        </div>
                    </t>
                    <t t-name="ChannelDashboard">

                        <div class="o_kanban_card_header_title">
                            <div class="row">
                                <div class="col-2">
                                  <a name="button_toggle_pick_allowed" type="object">
                                    <i
                      name="start_stop_pickings"
                      t-attf-class="oe_inline fa #{record.pick_allowed.raw_value ? 'fa-volume-up' : 'fa-volume-off'}"
                      title="Start/Stop pickings"
                    />
                                  </a>
                                </div>
                                <div class="col-4">
                                  <a
                    t-if="record.is_action_lock_allowed.raw_value"
                    name="action_lock"
                    type="object"
                    icon="fa-unlock"
                  >Lock</a>
                                    <a
                    t-if="record.is_action_unlock_allowed.raw_value"
                    name="action_unlock"
                    type="object"
                    icon="fa-lock"
                  >Unlock</a><br t-if="record.is_action_unlock_allowed.raw_value" /><a
                    t-if="record.is_action_deliver_allowed.raw_value"
                    name="action_deliver"
                    type="object"
                    icon="fa-truck"
                  >Deliver</a>
                                    <a
                    t-if="record.is_action_print_allowed.raw_value"
                    name="action_print"
                    type="object"
                    icon="fa-print"
                  >Print SA</a><br t-if="record.is_action_print_allowed.raw_value" />
                                    <a
                    t-if="record.is_action_print_allowed.raw_value"
                    name="print_all_deliveryslip"
                    type="object"
                    icon="fa-print"
                  >Print DS</a>
                <br t-if="record.is_action_print_allowed.raw_value" />
                                    <a
                    t-if="record.is_action_print_cash_invoices_allowed.raw_value"
                    name="action_print_cash_invoices"
                    type="object"
                    icon="fa-print"
                  >Print INV</a><br
                    t-if="record.is_action_print_cash_invoices_allowed.raw_value"
                  />
                <a
                    t-if="record.is_action_print_allowed.raw_value"
                    name="action_sleep"
                    type="object"
                    icon="fa-bed"
                  >Sleep</a>
                                </div>
                                <div class="col-6">
                                <!-- stats-->
                                    <div class="row">
                                        <div class="col-12">
                                            Total Weight:
                                            <field name="total_weight" />
                                            <span class="mr4" />
                                            <field name="weight_uom_name" />
                                        </div>
                                    </div>
                                </div>
                                <div
                  class="col-2"
                  attrs="{'invisible': [('release_mode', '!=', 'auto')]}"
                >
                                    <i
                    t-att-class="'fa fa-cog ' + (record.is_auto_release_allowed.raw_value ? 'fa-spin': '')"
                    role="img"
                    aria-label="Release mode auto"
                    title="Automatic Release mode"
                  />
                                </div>

                                <div class="col-10">
                                    <field name="release_mode" />
                                </div>
                            </div>
                        </div>
                        <div
              class="row o_kanban_card_manage_section o_kanban_manage_view"
            >
                            <div class="col-12">
                            <table style="width:100%;">
                            <tr
                    t-foreach="dashboard_data"
                    t-as="obj"
                    t-att-style="'border-bottom: 2px #f6f6fa solid; background-color: ' + (record.state.raw_value=='open' and 'lightgreen' or record.state.raw_value=='asleep' and 'lightsalmon' or record.state.raw_value=='locked' and 'sandybrown' or record.state.raw_value=='delivering' and 'deepskyblue' or record.state.raw_value=='delivering_error' and 'red' or  record.state.raw_value=='delivered' and 'lightsteelblue' or 'lightgray')"
                  >
                                <td width="40%">
                                    <a
                        type="object"
                        name="action_kanban_dashboard_open"
                        t-att-context="{'active_id': obj['id'], 'active_model': obj['model'], 'filter_type':'todo'}"
                      >
                                        <strong t-out="obj['name']" />
                                    </a>
                                </td>
                                <td width="50%">
                                    <div class="progress">
                                       <div
                          class="progress-bar progress-bar-striped"
                          role="progressbar"
                          t-att-aria-valuenow="obj['done']"
                          aria-valuemin="0"
                          t-att-aria-valuemax="obj['todo']"
                          t-att-style="'width: ' + obj['done'] / obj['todo'] * 100 + '%;'"
                        >
                                           <span
                            t-out="obj['done']"
                            t-if="obj['done'] > 0"
                          />
                                       </div>
                                        <div
                          class="progress-bar progress-bar-striped bg-danger"
                          role="progressbar"
                          t-att-aria-valuenow="obj['waiting']"
                          aria-valuemin="0"
                          t-att-aria-valuemax="obj['todo']"
                          t-att-style="'width: ' + obj['waiting'] / obj['todo'] * 100 + '%;'"
                        >
                                           <span
                            t-out="obj['waiting']"
                            t-if="obj['waiting'] > 0"
                          />
                                       </div>

                                      <div
                          class="progress-bar progress-bar-striped bg-success"
                          role="progressbar"
                          t-att-aria-valuenow="obj['started']"
                          aria-valuemin="0"
                          t-att-aria-valuemax="obj['todo']"
                          t-att-style="'width: ' + obj['started'] / obj['todo'] * 100 + '%;'"
                        >
                                           <span
                            t-out="obj['started']"
                            t-if="obj['started'] > 0"
                          />
                                       </div>
                                    </div>
                                </td>
                                <td width="4%" style="text-align: right;">
                                    <a
                        type="object"
                        name="action_kanban_dashboard_open"
                        t-att-context="{'active_id': obj['id'], 'active_model': obj['model'], 'filter_type':'done'}"
                      >
                                        <span t-out="obj['done']" />
                                    </a>
                                </td>
                                <td width="1%">/</td>
                                <td width="4%">
                                    <a
                        type="object"
                        name="action_kanban_dashboard_open"
                        t-att-context="{'active_id': obj['id'], 'active_model': obj['model'], 'filter_type':'todo'}"
                      >
                                    <span t-out="obj['todo']" />
                                    </a>
                                </td>
                                <td width="1%">
                                  <a
                        name="button_toggle_pick_allowed"
                        type="object"
                        t-att-context="{'picking_type_id': obj['id']}"
                        t-if="'pick_allowed' in obj"
                      >
                                    <i
                          name="start_stop_pickings"
                          t-attf-class="oe_inline fa #{obj['pick_allowed'] ? 'fa-volume-up' : 'fa-volume-off'}"
                          title="Start/Stop pickings"
                        />
                                  </a>
                                </td>
                            </tr>
                            </table>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record
    id="stock_release_channel_geoengine.action_stock_release_channel_kanban"
    model="ir.actions.act_window.view"
  >
    <field
      name="view_id"
      ref="alc_stock_release_channel_dashboard.stock_release_channel_dashboard_kanban_view"
    />

  </record>
    <!-- Inherit Form View to Modify it -->
    <record id="stock_release_channel_form_view" model="ir.ui.view">
        <field name="model">stock.release.channel</field>
        <field
      name="inherit_id"
      ref="stock_release_channel.stock_release_channel_form_view"
    />
        <field name="arch" type="xml">

            <xpath expr="//div[@name='button_box']" position="inside">
                <button
          class="oe_stat_button"
          type="object"
          name="button_show_picking_int"
          icon="fa-cubes"
          string="Internal (Ready)"
          context="{'default_release_channel_id':active_id}"
        />
                <button
          class="oe_stat_button"
          type="object"
          name="button_show_picking_out"
          icon="fa-truck"
          string="Deliveries (Ready)"
          context="{'default_release_channel_id':active_id}"
        />
            </xpath>

        </field>
    </record>
</odoo>
