<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
  <record id="view_order_line_form_edit" model="ir.ui.view">
    <field name="name">sale.order.line.form</field>
    <field name="model">sale.order.line</field>
    <field name="arch" type="xml">
      <form string="Sales Order Lines">
        <sheet>
          <group>
            <group>
              <field name="order_id" />
              <field name="order_partner_id" context="{'show_address': 1}" />
              <field name="date_order" />
              <field
                name="product_id"
                context="parent and {'partner_id':parent.partner_id, 'quantity':product_uom_qty, 'pricelist':parent.pricelist_id, 'uom':product_uom, 'company_id': parent.company_id}"
                attrs="{'readonly': ['|', ('qty_invoiced', '&gt;', 0), ('procurement_ids', '!=', [])]}"
              />
              <field name="layout_category_id" groups="sale.group_sale_layout" />
              <field name="invoice_status" invisible="1" />
              <field name="qty_to_invoice" invisible="1" />
              <field name="qty_delivered_updateable" invisible="1" />
              <field name="procurement_ids" invisible="1" />
              <label for="product_uom_qty" string="Ordered Quantity" />
              <div>
                <field
                  context="{'partner_id':parent.partner_id, 'quantity':product_uom_qty, 'pricelist':parent.pricelist_id, 'uom':product_uom, 'uom_qty_change':True, 'company_id': parent.company_id}"
                  name="product_uom_qty"
                  class="oe_inline"
                />
                <field
                  name="product_uom"
                  groups="product.group_uom"
                  class="oe_inline oe_no_button"
                  attrs="{'readonly': [('state', 'in', ('sale','done', 'cancel'))]}"
                />
              </div>
              <label
                for="qty_delivered"
                string="Delivered Quantity"
                invisible="context.get('hide_sale')"
              />
              <div invisible="context.get('hide_sale')">
                <field
                  name="qty_delivered"
                  attrs="{'readonly': [('qty_delivered_updateable', '=', False)]}"
                />
              </div>
              <label
                for="qty_invoiced"
                string="Invoiced Quantity"
                invisible="context.get('hide_sale')"
              />
              <div invisible="context.get('hide_sale')">
                <field name="qty_invoiced" invisible="context.get('hide_sale')" />
              </div>
              <field name="product_qty_unavailable" />
              <field name="current_product_qty_unavailable" />
              <field name="product_qty_remains_to_deliver" />
              <field name="price_unit" />
              <field name="price_subtotal" />
              <label for="discount" groups="sale.group_discount_per_so_line" />
              <div name="discount" groups="sale.group_discount_per_so_line">
                                <field name="discount" class="oe_inline" /> %
                            </div>
            </group>
            <group>
              <field
                name="tax_id"
                widget="many2many_tags"
                domain="[('type_tax_use','=','sale'),('company_id','=',parent.company_id)]"
                attrs="{'readonly': [('qty_invoiced', '&gt;', 0)]}"
              />
              <label for="customer_lead" />
              <div>
                                <field name="customer_lead" class="oe_inline" /> days
                            </div>
              <label
                for="analytic_tag_ids"
                groups="analytic.group_analytic_accounting"
              />
              <div>
                <field
                  name="analytic_tag_ids"
                  widget="many2many_tags"
                  groups="analytic.group_analytic_accounting"
                />
              </div>
            </group>
          </group>
          <label for="name" />
          <field name="name" />
          <div groups="base.group_no_one">
            <label for="invoice_lines" />
            <field name="invoice_lines" />
          </div>
          <field name="state" invisible="1" />
        </sheet>
      </form>
    </field>
  </record>
  <!--
        Any change done in the lines here must be reported in sale_quick_edit.sale_order_line_tree_edit.
    -->
  <record id="view_order_form" model="ir.ui.view">
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale_exception.view_order_form" />
    <field name="arch" type="xml">
      <xpath expr="//field[@name='main_exception_id']/parent::group" position="replace">
        <div
          class="alert alert-warning"
          role="alert"
          attrs="{'invisible': [('main_exception_id','=',False)]}"
        >
          <field
            name="main_exception_id"
            options="{'no_open': True}"
            class="oe_inline"
            modifiers="{'invisible': [['main_exception_id', '=', false]], 'readonly': true}"
          />
        </div>
      </xpath>
      <field name="client_order_ref" position="replace" />
      <field name="partner_id" position="after">
        <field name="client_order_ref" />
        <field name="suite_name" />
      </field>
      <field name="client_order_ref" position="after">
        <field name="sale_channel" />
      </field>
      <xpath
        expr="//field[@name='order_line']/tree//field[@name='product_id']"
        position="after"
      >
        <field name="picking_zone_id" groups="base.group_no_one" />
        <field name="older_lot_life_date" widget="date" />
      </xpath>
      <xpath
        expr="//field[@name='order_line']/tree//field[@name='product_id']"
        position="attributes"
      >
        <attribute
          name="attrs"
        >{'readonly': [('procurement_ids', '!=', [])]}</attribute>
      </xpath>
      <xpath
        expr="//field[@name='order_line']/tree//field[@name='product_uom_qty']"
        position="attributes"
      >
        <attribute
          name="attrs"
        >{'readonly': [('procurement_ids', '!=', [])]}</attribute>
      </xpath>
      <xpath
        expr="//field[@name='order_line']/tree//field[@name='price_subtotal']"
        position="after"
      >
        <field name="exception" />
      </xpath>
      <xpath expr="//field[@name='order_line']/tree" position="attributes">
        <attribute name="decoration-warning">exception</attribute>
      </xpath>
      <xpath
        expr="//field[@name='order_line']/tree/field[@name='analytic_tag_ids']"
        position="attributes"
      >
        <attribute name='invisible'>1</attribute>
      </xpath>
      <xpath
        expr="//field[@name='order_line']/form//field[@name='analytic_tag_ids']/parent::div"
        position="after"
      >
        <label for="production_lot_ids" colspan="2" />
        <div colspan="2">
          <field name="production_lot_ids">
            <tree>
              <field name="name" />
              <field name="qty_available" />
              <field name="product_uom_id" />
              <field name="use_date" />
              <field name="life_date" />
            </tree>
          </field>
        </div>
      </xpath>
    </field>
  </record>
  <record id="view_order_form_with_carrier" model="ir.ui.view">
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="delivery.view_order_form_with_carrier" />
    <field name="arch" type="xml">
      <field name="carrier_id" position="attributes">
        <attribute
          name="attrs"
        >{'required':[('state','in',('draft','sent'))], 'readonly':[('state','not in',('draft','sent'))]}</attribute>
      </field>
    </field>
  </record>
  <record id="sale.action_quotations" model="ir.actions.act_window">
    <field name="domain">[('state', 'not in', ('sale', 'done'))]</field>
  </record>
  <record id="action_sale_lines_unavailable_list" model="ir.actions.act_window">
    <field name="name">Sale Order Lines</field>
    <field name="res_model">sale.order.line</field>
    <field name="view_id" ref="sale.view_order_line_tree" />
    <field name="search_view_id" ref="sale.view_sales_order_line_filter" />
    <field name="domain">[('state', 'in', ['sale'])]</field>
    <field name="context">{'search_default_remains_to_deliver': 1}</field>
  </record>
</odoo>
