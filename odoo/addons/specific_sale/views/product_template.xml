<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record model="ir.ui.view" id="product_template_form_view_sale_lines_unavailable_button">
        <field name="name">product.template.sale.lines.unavailable.button</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="groups_id" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        <field name="priority">25</field>
        <field name="arch" type="xml">

            <button name="%(stock.product_open_quants)d" position="attributes">
                <attribute name="invisible">True</attribute>
            </button>

        </field>
    </record>

    <record model="ir.ui.view" id="view_product_template_stock_bin_form">
        <field name="name">view.product.template.stock.bin.form.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="stock_product_bin.view_product_template_stock_bin_form"/>
        <field name="priority">20</field>
        <field name="arch" type="xml">

            <xpath expr="//group[@name='stock_bins']/field[@name='stock_bin_ids']" position="before">
                <field name="lot_ids" attrs="{'invisible': [('tracking', '!=', 'lot')]}" nolabel="1">
                    <tree>
                        <field name="name"/>
                        <field name="qty_available" widget="integer"/>
                        <field name="life_date"/>
                    </tree>
                </field>
            </xpath>

        </field>
    </record>

    <record id="product_template_hs_code" model="ir.ui.view">
        <field name="name">product.template.hs.code.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="delivery.product_template_hs_code"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='hs_code']" position="attributes">
                <attribute name="invisible">True</attribute>
            </xpath>

        </field>
    </record>

</odoo>
