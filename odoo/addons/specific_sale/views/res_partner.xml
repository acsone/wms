<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
  <record model="ir.ui.view" id="view_partner_simple_form_last_suite_name">
    <field name="name">res.partner.form.last_suite_name</field>
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="specific_partner.view_partner_form" />
    <field name="arch" type="xml">
      <field name="call_name" position="after">
        <field name="last_suite_name" />
      </field>
    </field>
  </record>
  <record model="ir.ui.view" id="partner_form_view_sale_lines_unavailable_button">
    <field name="name">res.partner.sale.lines.unavailable.button</field>
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="base.view_partner_form" />
    <field name="groups_id" eval="[(4, ref('sales_team.group_sale_salesman'))]" />
    <field name="arch" type="xml">
      <div name="button_box" position="inside">
        <button
          class="oe_stat_button"
          name="action_view_sale_lines_unavailable"
          type="object"
          icon="fa-usd"
        >
          <field string="Lines unavailable" name="sale_lines_count" widget="statinfo" />
        </button>
      </div>
    </field>
  </record>
  <record model="ir.ui.view" id="view_partner_product_group">
    <field name="name">res.partner.product.form</field>
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="product.view_partner_property_form" />
    <field name="arch" type="xml">
      <group name="sale" position="inside">
        <field name="help_with_fee" />
        <field name="auto_cancel_unavailable_qty_sold" />
      </group>
    </field>
  </record>
</odoo>
