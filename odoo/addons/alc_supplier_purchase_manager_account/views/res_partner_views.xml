<odoo>
  <record model="ir.ui.view" id="view_partner_form">
    <field
      name="name"
    >res.partner.form (in alc_supplier_purchase_manager_account)</field>
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="base.view_partner_form" />
    <field name="arch" type="xml">
      <xpath expr="//group[@name='purchase']" position="inside">
        <field name="supplier_rank" invisible="1" />
      </xpath>
      <field name="purchase_manager_id" position="attributes">
        <attribute name="attrs">
          {'invisible': [('supplier_rank', '&lt;', 1)]}
        </attribute>
      </field>
      <field name="substitute_purchase_manager_id" position="attributes">
        <attribute name="attrs">
          {'invisible': [('supplier_rank', '&lt;', 1)]}
        </attribute>
      </field>
    </field>
  </record>
</odoo>
