<odoo noupdate="1">

    <record id="index_config_eshop_ads" model="se.index.config">
        <field name="name">EShop Ads Index config</field>
        <field name="body">{}</field>
        <field name="body_str">
            {
                "settings" : {
                    "index" : {
                        "sort.field" : ["date_start"],
                        "sort.order" : ["asc"]
                    }
                },
                "mappings": {
                    "properties": {
                        "id": {
                        "type": "integer"
                        },
                            "date_start": {
                            "type": "date"
                        },
                        "date_end": {
                            "type": "date"
                        }
                    }
                }
            }
        </field>
    </record>

</odoo>
