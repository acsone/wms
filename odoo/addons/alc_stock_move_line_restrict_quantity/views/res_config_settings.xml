<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field
      name="name"
    >res.config.settings.view.form.inherit.stock (in alc_stock_move_line_restrict_zero_quantity)</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <div id="reception_report" position="after">
                <div
          class="col-12 col-lg-6 o_setting_box"
          id="alc_stock_move_line_quantity_div"
        >
                    <div class="o_setting_left_pane">
                        <field name="restrict_move_line_quantity" />
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="restrict_move_line_quantity" />
                        <div class="text-muted">
                            Check this box if you want to restrict a zero quantity or a negative in a stock move line (reserved_uom_qty)
                        </div>

                    </div>
                </div>
            </div>
        </field>
    </record>
</odoo>
