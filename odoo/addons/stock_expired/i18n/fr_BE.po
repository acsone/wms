#. module: stock_expired
#: model:mail.template,body_html:stock_expired.email_template_alert_quant_expired
msgid ""
"\n"
"                \n"
"                    <p>Hello,</p>\n"
"                    <p>Following quants are on alert:</p>\n"
"                    <p>\n"
"                        <ul>\n"
"                            % for quant in ctx['quants_on_alert']:\n"
"                            <li>${quant.name}</li>\n"
"                            % endfor\n"
"                        </ul>\n"
"                    </p>\n"
"                \n"
"            "
msgstr ""
"\n"
