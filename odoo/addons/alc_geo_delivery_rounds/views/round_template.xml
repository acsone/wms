<odoo>
  <record model="ir.ui.view" id="round_template_search_view">
    <field name="name">round.template.search (in alc_geo_delivery_rounds)</field>
    <field name="model">round.template</field>
    <field name="inherit_id" ref="delivery_rounds.view_round_template_search" />
    <field name="arch" type="xml">
      <field name="name" position="after">
        <field name="delivery_plan_id" string="Delivery plan" />
      </field>
    </field>
  </record>
  <record model="ir.ui.view" id="round_template_form_view">
    <field name="name">round.template.form (in alc_geo_delivery_rounds)</field>
    <field name="model">round.template</field>
    <field name="inherit_id" ref="delivery_rounds.view_round_template_form" />
    <field name="arch" type="xml">
      <field name="name" position="after">
        <notebook colspan="4">
          <page string="Geometry">
            <field
              name="geo_polygon_shape"
              widget="geo_edit_map"
              groups="base_geoengine.group_geoengine_user,base_geoengine.group_geoengine_admin"
              options='{"opacity": 0.4, "fill_color":"#33ccff"}'
            />
          </page>
        </notebook>
      </field>
    </field>
  </record>
  <record model="ir.ui.view" id="round_template_tree_view">
    <field name="name">round.template.tree (in alc_geo_delivery_rounds)</field>
    <field name="model">round.template</field>
    <field name="inherit_id" ref="delivery_rounds.view_round_template_tree" />
    <field name="arch" type="xml">
      <field name="geo_optimization_resource_id" position="after">
        <field name="delivery_plan_id" />
      </field>
    </field>
  </record>
  <!-- GeoEngine views -->
  <record id="round_template_geoengine_view" model="ir.ui.view">
    <field name="name">round.template.geoengine (in alc_geo_delivery_rounds)</field>
    <field name="arch" type="xml">
      <geoengine>
        <field name="name" />
        <field name="delivery_plan_id" />
        <templates>
          <t t-name="layer-box">
            <div id="content">
              <b>
                <field name="name" />
              </b>
              <hr />
              <div class="row">
                <div class="col-xs-6">
                  <b>Delivery plan:</b>
                </div>
                <div class="col-xs-6">
                  <field name="delivery_plan_id" />
                </div>
              </div>
            </div>
          </t>
        </templates>
      </geoengine>
    </field>
    <field eval="16" name="priority" />
    <field name="model">round.template</field>
  </record>
  <record id="res_partner_details_view_geoengine" model="ir.ui.view">
    <field name="name">res.partner.details.geo_view</field>
    <field name="arch" type="xml">
      <geoengine>
        <field name="name" />
        <field name="ref" />
        <field name="tag_labels" />
        <templates>
          <t t-name="layer-box">
            <div id="content">
              <b>
                <field name="name" />
              </b>
              <hr />
              <div class="row">
                <div class="col-xs-4">
                  <b>Reference:</b>
                </div>
                <div class="col-xs-8">
                  <field name="ref" />
                </div>
              </div>
              <div class="row">
                <div class="col-xs-4">
                  <b>Tags:</b>
                </div>
                <div class="col-xs-8">
                  <field name="tag_labels" />
                </div>
              </div>
              <br />
            </div>
          </t>
        </templates>
      </geoengine>
    </field>
    <!--
    put a higher priority to be sure that this view is not the one used by default
    -->
    <field name="priority" eval="16" />
    <field name="model">res.partner</field>
  </record>
  <record id="round_template_geoengine_vector_layer" model="geoengine.vector.layer">
    <field
      name="geo_field_id"
      ref="alc_geo_delivery_rounds.field_round_template_geo_polygon_shape"
    />
    <field name="name">Geographic zones</field>
    <field name="view_id" ref="round_template_geoengine_view" />
    <field name="geo_repr">basic</field>
    <field name="begin_color">#33ccff</field>
    <field name="layer_opacity">0.6</field>
    <field name="display_polygon_labels" eval="1" />
    <field name="attribute_field_id" ref="delivery_rounds.field_round_template_name" />
  </record>
  <record id="res_partner_geoengine_vector_layer" model="geoengine.vector.layer">
    <field name="model_id" ref="base.model_res_partner" />
    <field
      name="model_view_id"
      ref="alc_geo_delivery_rounds.res_partner_details_view_geoengine"
    />
    <field name="geo_field_id" ref="geoengine_partner.field_res_partner_geo_point" />
    <field name="name">Partners positions</field>
    <field name="view_id" ref="round_template_geoengine_view" />
    <field name="geo_repr">basic</field>
    <field name="begin_color">#ff3333</field>
    <field name="layer_opacity">0.9</field>
    <field name="display_polygon_labels" eval="0" />
  </record>
  <record id="round_template_geoengine_raster_layer" model="geoengine.raster.layer">
    <field name="raster_type">osm</field>
    <field name="name">OSM layer</field>
    <field name="view_id" ref="round_template_geoengine_view" />
    <field eval="0" name="overlay" />
  </record>
  <record id="round_template_geoengine_raster_layer_osm" model="geoengine.raster.layer">
    <field name="raster_type">osm</field>
    <field name="name">OSM Light layer</field>
    <field name="view_id" ref="round_template_geoengine_view" />
    <field eval="1" name="overlay" />
  </record>
  <record id="action_round_template_geoengine" model="ir.actions.act_window.view">
    <field eval="20" name="sequence" />
    <field name="view_mode">geoengine</field>
    <field name="view_id" ref="round_template_geoengine_view" />
    <field name="act_window_id" ref="delivery_rounds.action_round_template_tree" />
  </record>
</odoo>
