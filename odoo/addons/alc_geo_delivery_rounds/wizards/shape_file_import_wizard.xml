<odoo>
  <record model="ir.ui.view" id="shape_file_import_wizard_form_view">
    <field
      name="name"
    >shape.file.import.wizard.form (in alc_geo_delivery_rounds)</field>
    <field name="model">shape.file.import.wizard</field>
    <field name="arch" type="xml">
      <form string="Shape File Import Wizard">
        <group>
          <field name="shape_file" filename="filename" />
          <field name="filename" invisible="1" />
        </group>
        <footer>
          <button
            name="execute_import"
            string="Execute import"
            class="oe_highlight"
            type="object"
          />
          <button string="Cancel" class="oe_link" special="cancel" />
        </footer>
      </form>
    </field>
  </record>
  <record model="ir.actions.act_window" id="action_shape_file_import">
    <field name="name">Shape File Import Wizard</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">shape.file.import.wizard</field>
    <field name="view_mode">form</field>
    <field name="view_id" ref="shape_file_import_wizard_form_view" />
    <field name="target">new</field>
  </record>
</odoo>
