<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <template id="report_picking" inherit_id="stock.report_picking" priority="100">
    <xpath expr="//t[@t-call='web.html_container']" position="replace">
      <t t-foreach="docs" t-as="picking">
        <div
          class="article"
          t-att-data-oe-model="picking and picking._name"
          t-att-data-oe-id="picking and picking.id"
          t-att-data-oe-lang="picking and picking.env.context.get('lang')"
        >
          <t
            t-call="alc_report_stock_picking_operations.report_picking_page"
            t-lang="picking.partner_id.lang"
          />
        </div>
      </t>
    </xpath>
  </template>
  <template id="alc_report_stock_picking_operations.report_picking_page">
    <t t-set="company" t-value="res_company" />
    <t t-call="web.html_container">
      <div class="header">
        <div>
          <div class="logo">
            <img
              t-if="company.logo"
              t-att-src="image_data_uri(company.logo)"
              style="max-height: 70px;"
            />
          </div>
          <div class="main_title">
            <t t-esc="docs[0].picking_type_id.name" />
          </div>
        </div>
      </div>
      <t t-call="alc_report_stock_picking_operations.report_picking_body" />
      <t t-call="alc_report_base.page_number_footer" />
    </t>
  </template>
  <template id="alc_report_stock_picking_operations.report_picking_body">
    <div class="page">
      <div id="left_header" class="remove_padding_top">
        <table id="invoice_reference" class="border_table round_table">
          <tr>
            <td>
              <span>Customer</span>
            </td>
            <td>
              <span>N° Document</span>
            </td>
            <td>
              <span>Date</span>
            </td>
          </tr>
          <tr>
            <td>
              <span t-field="picking.partner_id.ref" />
            </td>
            <td>
              <span t-field="picking.name" />
            </td>
            <td>
              <span t-field="picking.date" />
            </td>
          </tr>
          <tr>
            <td colspan="3">
              <span t-field="picking.origin" />
            </td>
          </tr>
        </table>
        <br />
        <div>
          <img
            t-att-src="'/report/barcode/?barcode_type=%s&amp;value=%s&amp;width=%s&amp;height=%s'
                          % ('QR', picking.name, 100, 100)"
          />
        </div>
      </div>
      <div id="partner_header" class="remove_padding_top">
        <div
          t-field="picking.partner_id"
          t-options='{"widget": "contact", "fields": ["name", "address", "phone"], "no_marker": True, "phone_icons": True}'
        />
      </div>
      <t t-set="move_line_ids" t-value="picking.move_line_ids" />
      <t
        groups="base.group_portal"
        t-set="move_line_ids"
        t-value="picking.move_line_ids.sudo()"
      />
      <t t-set="package_ids" t-value="move_line_ids.package_id" />
      <t
        t-set="no_pack_line_ids"
        t-value="move_line_ids.filtered(lambda ml: not ml.package_id)"
      />
      <div class="bicol">
        <div class="pick_card" t-foreach="package_ids" t-as="pack">
          <div>
              <span t-field="pack.display_name" />
          </div>
          <div>
            Location: <strong>
              <span t-field="pack.move_line_ids[0].location_id.name" />
            </strong> -> <strong>
              <span t-field="pack.location_id.name" />
            </strong>
            <div>Package:
              <span t-field="pack.display_name" />
            </div>
            <div class="row">
                <div class="col-6 text-center" style="padding-top:20px">
                  <strong>
                    <t t-if="pack.number_of_parcels and not pack.package_type_id.auto_distribute_products_in_parcels">
                      <span t-field="pack.number_of_parcels" />
                    </t>
                  </strong>
                </div>
            </div>
          </div>
        </div>
        <div class="pick_card" t-foreach="no_pack_line_ids" t-as="move_line">
          <div>
            <span t-field="move_line.product_id" />
            <br />
            <span t-field="move_line.product_id.description_picking" />
          </div>
          <div
            t-if="move_line.env.ref('__setup__.stock_location_route_pick_froid') in move_line.product_id.route_ids"
            class="flag"
          >
            <i class="fa fa-check" aria-hidden="true" />
          </div>
          <div>Location: <strong>
              <span t-field="move_line.location_id.name" />
            </strong> -> <strong>
              <span t-field="move_line.location_dest_id.name" />
            </strong>
          </div>
          <div t-if="move_line.result_package_id">Resulting Package: <span
              t-field="move_line.result_package_id"
            />
          </div>
          <div class="qrcode row">
            <div t-if="not move_line.lot_id" class="col-6 text-center">
              <div style="float:right;padding-top:10px">
                <t t-if="move_line.product_id.default_code">
                  <t t-set="barcode" t-value="move_line.product_id.default_code" />
                  <img
                    t-att-src="'/report/barcode/?barcode_type=%s&amp;value=%s&amp;width=%s&amp;height=%s'
                                  % ('QR', barcode, 50, 50)"
                  />
                </t>
              </div>
              <div style="padding-top:20px">
                <strong>
                  <t t-if="move_line.qty_done"><span
                      t-field="move_line.qty_done"
                    /> / </t>
                  <span t-field="move_line.reserved_uom_qty" />
                  <span t-field="move_line.product_uom_id" groups="product.group_uom" />
                </strong>
              </div>
            </div>
            <div t-if="move_line.lot_id" class="col-6 text-center">
              <div style="float:right;padding-top:10px">
                <t t-if="move_line.product_id.default_code and move_line.lot_id.name">
                  <t
                    t-set="barcode"
                    t-value="'%%23' + move_line.product_id.default_code + '%%23' + move_line.lot_id.name"
                  />
                  <img
                    t-att-src="'/report/barcode/?barcode_type=%s&amp;value=%s&amp;width=%s&amp;height=%s'
                                  % ('QR', barcode, 50, 50)"
                  />
                </t>
              </div>
              <div style="padding-top:10px">
                <span t-field="move_line.lot_id.name" />
              </div>
              <div>
                <strong>
                  <span t-field="move_line.qty_done" /> /
                  <span t-field="move_line.reserved_uom_qty" />
                  <span t-field="move_line.product_uom_id" groups="product.group_uom" />
                </strong>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div>
        <p t-field="picking.note" />
      </div>
    </div>
  </template>
</odoo>
