      </record>
    <record
    id="job_function_product_product_remove_price_cache"
    model="queue.job.function"
  >
        <field name="model_id" ref="product.model_product_product" />
        <field name="method">_remove_price_cache</field>
        <field name="channel_id" ref="alc_price_cache.channel_root_background_price" />
