<odoo>

    <record model="ir.ui.view" id="stock_picking_form_view">
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                    <button
          name="action_view_all_move"
          type="object"
          class="oe_stat_button"
          icon="fa-list"
        >
                        <span>All Moves</span>
                    </button>
                    <button
          name="action_view_all_move_line"
          type="object"
          class="oe_stat_button"
          icon="fa-list"
        >
                        <span>All Move Lines</span>
                    </button>

                    <button
          name="action_view_related_picking"
          type="object"
          class="oe_stat_button"
          icon="fa-list"
        >
                        <span>Related Transfers</span>
                    </button>
            </xpath>
        </field>
    </record>



</odoo>
