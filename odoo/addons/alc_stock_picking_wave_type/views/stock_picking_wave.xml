<odoo>

    <record model="ir.ui.view" id="stock_picking_wave_form_view">
        <field
      name="name"
    >stock.picking.wave.form (in alc_stock_picking_wave_type)</field>
        <field name="model">stock.picking.wave</field>
        <field name="inherit_id" ref="stock_picking_wave.view_picking_wave_form" />
        <field name="arch" type="xml">
            <field name="user_id" position="after">
                <field name="picking_type_id" />
            </field>
        </field>
    </record>

    <record model="ir.ui.view" id="stock_picking_wave_tree_view">
        <field
      name="name"
    >stock.picking.wave.tree (in alc_stock_picking_wave_type)</field>
        <field name="model">stock.picking.wave</field>
        <field name="inherit_id" ref="stock_picking_wave.view_picking_wave_tree" />
        <field name="arch" type="xml">
            <field name="user_id" position="after">
                <field name="picking_type_id" />
            </field>
        </field>
    </record>

    <record model="ir.ui.view" id="stock_picking_wave_search_view">
        <field
      name="name"
    >stock.picking.wave.search (in alc_stock_picking_wave_type)</field>
        <field name="model">stock.picking.wave</field>
        <field name="inherit_id" ref="stock_picking_wave.view_picking_wave_filter" />
        <field name="arch" type="xml">
            <xpath expr="//group/filter[last()]" position="after">
                <filter
          string="Picking type"
          domain="[]"
          context="{'group_by':'picking_type_id'}"
        />
            </xpath>
        </field>
    </record>


</odoo>
