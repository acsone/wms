<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="put_in_pack_helper_view_form" model="ir.ui.view">
    <field name="name">put.in.pack.helper.view.form</field>
    <field name="model">put.in.pack.helper</field>
    <field name="arch" type="xml">
      <form string="Put in Pack helper">
        <group>
          <field name="picking_id" invisible="1" />
          <field name="nbr_packages" />
        </group>
        <footer>
          <button
            name="do_put_in_pack"
            string="Put in Pack"
            type="object"
            class="btn btn-sm btn-primary"
          />
          <button string="Cancel" class="btn btn-sm btn-default" special="cancel" />
        </footer>
      </form>
    </field>
  </record>
  <record id="put_in_pack_helper_action" model="ir.actions.act_window">
    <field name="name">Put in Pack</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">put.in.pack.helper</field>
    <field name="view_mode">form</field>
    <field name="view_type">form</field>
    <field name="target">new</field>
  </record>
</odoo>
