<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="view_stock_move_wizard_handler_form" model="ir.ui.view">
    <field name="name">wizard.stock.move.update.handler.form</field>
    <field name="model">wizard.stock.move.update.handler</field>
    <field name="arch" type="xml">
      <form string="">
        <sheet>
          <group>
            <field name="move_id" />
            <field name="new_date_expected" required="1" />
          </group>
        </sheet>
        <footer>
          <button
            name="action_set_expired_date"
            string="Set Scheduled Date"
            type="object"
            class="btn-primary"
          />
          <button
            name="action_cancel_move"
            string="Cancel move"
            class="btn-default"
            type="object"
          />
          <button string="Cancel" class="btn-default" special="cancel" />
        </footer>
      </form>
    </field>
  </record>
  <record id="stock_move_wizard_handler_action" model="ir.actions.act_window">
    <field name="name">Stock Move Handler</field>
    <field name="res_model">wizard.stock.move.update.handler</field>
    <field name="view_type">form</field>
    <field name="view_mode">form</field>
    <field name="domain">[]</field>
    <field name="context">{}</field>
  </record>
</odoo>
