<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="open_uop_view_form" model="ir.ui.view">
    <field name="name">open.uop.view.form</field>
    <field name="model">open.uop</field>
    <field name="arch" type="xml">
      <form>
        <group>
          <field name="uop" />
        </group>
        <footer>
          <button
            name="open_uop"
            string="Open UOP"
            type="object"
            class="btn btn-sm btn-primary"
          />
          <button string="Cancel" class="btn btn-sm btn-default" special="cancel" />
        </footer>
      </form>
    </field>
  </record>
  <record id="open_uop_action" model="ir.actions.act_window">
    <field name="name">Open UOP</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">open.uop</field>
    <field name="view_mode">form</field>
    <field name="view_type">form</field>
    <field name="target">new</field>
  </record>
  <menuitem
    action="open_uop_action"
    id="open_uop_menu"
    parent="stock.menu_stock_warehouse_mgmt"
    sequence="2"
  />
</odoo>
