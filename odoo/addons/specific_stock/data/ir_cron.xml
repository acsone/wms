<?xml version="1.0" encoding="UTF-8" ?>
<openerp>
  <data noupdate="1">
    <!-- Scheduler for disable lot -->
    <record forcecreate="True" id="ir_cron_archive_lots" model="ir.cron">
      <field name="name">Archive lots</field>
      <field eval="False" name="active" />
      <field name="user_id" ref="base.user_root" />
      <field name="interval_number">1</field>
      <field name="interval_type">days</field>
      <field name="numbercall">-1</field>
      <field eval="False" name="doall" />
      <field eval="'stock.production.lot'" name="model" />
      <field eval="'archive_lots'" name="function" />
      <field name="nextcall" eval="(DateTime.now()).strftime('%Y-%m-%d 23:00:01')" />
    </record>
    <record forcecreate="True" id="ir_cron_create_daily_inventory" model="ir.cron">
      <field name="name">Create daily inventory</field>
      <field eval="False" name="active" />
      <field name="user_id" ref="base.user_root" />
      <field name="interval_number">1</field>
      <field name="interval_type">days</field>
      <field name="numbercall">-1</field>
      <field eval="False" name="doall" />
      <field eval="'stock.inventory'" name="model" />
      <field eval="'create_daily_inventory'" name="function" />
      <field name="nextcall" eval="(DateTime.now()).strftime('%Y-%m-%d 04:00:01')" />
    </record>
  </data>
</openerp>
