<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
  <record id="view_product_template_specific_form" model="ir.ui.view">
    <field name="name">product.template.specific.form</field>
    <field name="model">product.template</field>
    <field name="inherit_id" ref="stock.view_template_property_form" />
    <field name="arch" type="xml">
      <field name="use_time" position="attributes">
        <attribute name="readonly">True</attribute>
      </field>
      <field name="life_time" position="attributes">
        <attribute name="readonly">True</attribute>
      </field>
      <field name="removal_time" position="attributes">
        <attribute name="readonly">True</attribute>
      </field>
      <field name="alert_time" position="attributes">
        <attribute name="readonly">True</attribute>
      </field>
    </field>
  </record>
  <record id="product_template_form_view" model="ir.ui.view">
    <field name="name">specific_stock</field>
    <field name="model">product.template</field>
    <field name="inherit_id" ref="stock.view_template_property_form" />
    <field name="arch" type="xml">
      <xpath expr="//field[@name='route_from_categ_ids']" position="attributes">
        <attribute name="groups">base.group_no_one</attribute>
      </xpath>
    </field>
  </record>
  <record id="product_template_search_view" model="ir.ui.view">
    <field name="name">product.template.search</field>
    <field name="model">product.template</field>
    <field name="inherit_id" ref="specific_purchase.product_template_search_view" />
    <field name="arch" type="xml">
      <xpath expr="//search" position="inside">
        <separator />
        <filter
          string="Normal product"
          name="normal_product"
          domain="[('is_mto_product','=',False)]"
        />
        <filter
          string="On Order"
          name="on_order"
          domain="[('is_mto_product','=',True)]"
        />
      </xpath>
      <xpath expr="//filter[@name='group_by_supplier_id']" position="after">
        <filter
          name="group_by_internal_category"
          string="Category"
          context="{'group_by':'categ_id'}"
        />
      </xpath>
    </field>
  </record>
</odoo>
