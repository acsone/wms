<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="view_stock_config_settings" model="ir.ui.view">
    <field name="name">stock.config.settings</field>
    <field name="model">stock.config.settings</field>
    <field name="inherit_id" ref="stock.view_stock_config_settings" />
    <field name="arch" type="xml">
      <xpath expr="//form" position="inside">
        <group name="daily_inventory" string="Daily inventory">
          <field name="price_limit_for_inventory" />
          <field name="nbr_open_days" />
          <field name="months_between_inventory" />
          <field name="delay_inventory_expensive_products" />
          <field name="delay_inventory_best_sellers_products" />
          <field name="delay_inventory_other_products" />
          <field name="best_sellers_duration" />
          <field name="best_sellers_percent" />
        </group>
      </xpath>
    </field>
  </record>
</odoo>
