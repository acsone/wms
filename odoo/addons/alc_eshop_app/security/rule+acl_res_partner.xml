<odoo>
   <!-- base acl -->
  <record model="ir.model.access" id="eshop_res_partner_access_view">
    <field name="name">res.partner eshop technical user access</field>
    <field name="model_id" ref="base.model_res_partner" />
    <field name="group_id" ref="eshop_technical_user_group" />
    <field name="perm_read" eval="1" />
    <field name="perm_create" eval="0" />
    <field name="perm_unlink" eval="0" />
    <field name="perm_write" eval="0" />
  </record>
   <!-- base rule -->
  <record model="ir.rule" id="eshop_res_partner_rule">
    <field name="name">res partner eshop rule</field>
    <field name="model_id" ref="base.model_res_partner" />
    <field name="domain_force">[
      ("id", '=', authenticated_partner_id),
      ]
    </field>
    <field name="groups" eval="[(6, 0, [ref('eshop_technical_user_group')])]" />
    <field name="perm_read" eval="1" />
    <field name="perm_create" eval="0" />
    <field name="perm_write" eval="0" />
    <field name="perm_unlink" eval="0" />
  </record>
</odoo>
