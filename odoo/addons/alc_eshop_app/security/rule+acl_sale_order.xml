<odoo>
   <!-- base acl -->
  <record model="ir.model.access" id="eshop_sale_order_access_view">
    <field name="name">sale_order eshop technical user access</field>
    <field name="model_id" ref="sale.model_sale_order" />
    <field name="group_id" ref="eshop_technical_user_group" />
    <field name="perm_read" eval="1" />
    <field name="perm_create" eval="0" />
    <field name="perm_unlink" eval="0" />
    <field name="perm_write" eval="0" />
  </record>

  <!-- rules for shop services  -->
  <record model="ir.rule" id="eshop_sale_order_rule">
    <field name="name">sale_order eshop rule</field>
    <field name="model_id" ref="sale.model_sale_order" />
    <field name="domain_force">[
      ("partner_id", '=', authenticated_partner_id)
      ]
    </field>
    <field name="groups" eval="[(6, 0, [ref('eshop_technical_user_group')])]" />
    <field name="perm_read" eval="1" />
    <field name="perm_create" eval="1" />
    <field name="perm_write" eval="1" />
    <field name="perm_unlink" eval="1" />
  </record>

</odoo>
