<odoo>
   <!-- base acl -->
  <record model="ir.model.access" id="eshop_alc_eshop_product_ordered_qty_access_view">
    <field name="name">alc_eshop_product_ordered_qty eshop technical user access</field>
    <field
      name="model_id"
      ref="alc_eshop_sale_statistic.model_alc_eshop_product_ordered_qty"
    />
    <field name="group_id" ref="eshop_technical_user_group" />
    <field name="perm_read" eval="1" />
    <field name="perm_create" eval="0" />
    <field name="perm_unlink" eval="0" />
    <field name="perm_write" eval="0" />
  </record>

  <!-- rules for the service 'promo_subsciptions'  -->
  <record model="ir.rule" id="eshop_alc_eshop_product_ordered_qty_rule">
    <field name="name">alc.product.promotion.subscription eshop rule</field>
    <field
      name="model_id"
      ref="alc_eshop_sale_statistic.model_alc_eshop_product_ordered_qty"
    />
    <field name="domain_force">[
      '|',
      ("partner_id", '=', authenticated_partner_id)
      ]
    </field>
    <field name="groups" eval="[(6, 0, [ref('eshop_technical_user_group')])]" />
    <field name="perm_read" eval="1" />
    <field name="perm_create" eval="0" />
    <field name="perm_write" eval="0" />
    <field name="perm_unlink" eval="0" />
  </record>

</odoo>
