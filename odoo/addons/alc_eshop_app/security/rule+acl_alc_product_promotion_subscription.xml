<odoo>
  <!-- acl's for the service 'promo_subsciptions' -->
  <record
    model="ir.model.access"
    id="eshop_alc_product_promotion_subscription_access_view"
  >
    <field
      name="name"
    >alc.product.promotion.subscription eshop technical user access</field>
    <field
      name="model_id"
      ref="alc_product_promotion_subscription.model_alc_product_promotion_subscription"
    />
    <field name="group_id" ref="eshop_technical_user_group" />
    <field name="perm_read" eval="1" />
    <field name="perm_create" eval="1" />
    <field name="perm_unlink" eval="1" />
    <field name="perm_write" eval="1" />
  </record>
  <!-- rules for the service 'promo_subsciptions'  -->
  <record model="ir.rule" id="eshop_alc_product_promotion_subscription_rule">
    <field name="name">alc.product.promotion.subscription eshop rule</field>
    <field
      name="model_id"
      ref="alc_product_promotion_subscription.model_alc_product_promotion_subscription"
    />
    <field name="domain_force">[
      '|',
      ("partner_id", '=', authenticated_partner_id),
      ("partner_id", '=', False),
      ]
    </field>
    <field name="groups" eval="[(6, 0, [ref('eshop_technical_user_group')])]" />
    <field name="perm_read" eval="1" />
    <field name="perm_create" eval="1" />
    <field name="perm_write" eval="1" />
    <field name="perm_unlink" eval="1" />
  </record>

</odoo>
