<odoo>
  <record
    model="res.users"
    id="eshop_technical_user"
    context="{'no_reset_password': True}"
  >
    <field name="name">Utilisateur Technique EShop</field>
    <field name="login">alc_eshop_user</field>
    <field
      name="groups_id"
      eval="[(6,0,[ref('alc_eshop_app.eshop_technical_user_group')])]"
    />
    <field name="tz">Europe/Brussels</field>
    <field name="active" eval="0" />
  </record>
</odoo>
