<odoo>

        <record id="stock_moves_with_partner_view_tree" model="ir.ui.view">
            <field name="name">alc.stock.move.report.tree</field>
            <field name="model">alc.stock.move.report</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="product_id"/>
                    <field name="validation_date"/>
                    <field name="location_id" groups="stock.group_stock_multi_locations"/>
                    <field name="location_dest_id" groups="stock.group_stock_multi_locations"/>
                    <field name="state"/>
                    <field name="product_qty"/>
                    <field name="product_default_code"/>
                    <field name="product_name"/>
                    <field name="product_price"/>
                    <field name="product_sale_price_2"/>
                    <field name="product_standard_price"/>
                    <field name="supplier_ref"/>
                    <field name="supplier_name"/>
                    <field name="price_unit"/>
                    <field name="internal_ref_for_partner_invoice"/>
                    <field name="partner_invoice_name"/>
                    <field name="partner_invoice_street"/>
                    <field name="partner_invoice_city"/>
                    <field name="partner_invoice_zip"/>
                    <field name="partner_invoice_vat"/>
                    <field name="partner_invoice_depot_number"/>
                    <field name="partner_invoice_alcyon_category"/>
                    <field name="picking_reference"/>
                    <field name="customer_in_statistics"/>
                </tree>
            </field>
        </record>


        <record id="stock_moves_with_partner_view_search" model="ir.ui.view">
        <field name="name">alc.stock.move.report.search</field>
        <field name="model">alc.stock.move.report</field>
        <field name="arch" type="xml">
            <search>
                <filter string="is in statistics" name="filter_is_in_statistics"
                  domain="[
                      ('customer_in_statistics', '=', True),
                    ]"/>
                <separator/>
                <filter string="customer related stock moves" name="customer_related_stock_moves"
                  domain="['|',
                      ('state', '=', 'done'), ('location_id', 'ilike', 'Customers'), ('location_dest_id', 'ilike', 'Customers')
                    ]"/>
                 <separator/>
                <filter name="last_month" string="Previous Month"
                            domain="[
                                '&amp;',
                                ('validation_date', '>=', (context_today() - relativedelta(months=1)).strftime('%Y-%m-01')),
                                ('validation_date', '&lt;', context_today().strftime('%Y-%m-01')),
                            ]"/>
            </search>
        </field>
        </record>

    <record id="action_stock_moves_with_partner" model="ir.actions.act_window">
        <field name="name">Stock Move (with partner)</field>
        <field name="res_model">alc.stock.move.report</field>
        <field name="view_mode">tree</field>
        <field name="context">{
            'search_default_filter_is_in_statistics': 1,
            'search_default_customer_related_stock_moves': 1,
            'search_default_last_month': 1,
          }</field>
        <field name="search_view_id" ref="stock_moves_with_partner_view_search"/>
    </record>
    <menuitem id="menu_stock_moves_with_partner" action="action_stock_moves_with_partner" parent="stock.menu_warehouse_report" sequence="25" groups="base.group_no_one"/>
</odoo>
