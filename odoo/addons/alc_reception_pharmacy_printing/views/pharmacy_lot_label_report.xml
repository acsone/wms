<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <template id="pharmacy_lot_label">
    <div class="raw">
      <t t-foreach="docs" t-as="line">
^XA
^PRC
^LH0,0^FS\r
^FO32,70^A0N,29,31^FDClient:^FS\r
^FO120,68^A0N,34,28^FD<t t-esc="line.customer_id.name" />^FS\r
^FO32,105^A0N,34,28^FDLot:^FS\r
^FO90,105^A0N,34,28^FD<t t-esc="line.lot_id.name" />^FS\r
^FO32,145^A0N,34,28^FDBac:^FS\r
^FO90,145^A0N,34,28^FD<t t-esc="line.bin_id.name" />^FS\r
^FO32,190^A0N,34,28^FDDate limite:^FS\r
^FO175,186^A0N,40,30^FD<t
          t-esc="line.lot_id.expiration_date and line.lot_id.expiration_date.strftime('%d/%m/%Y') or ''"
        />^FS\r
^FO32,240^A0N,34,28^FDArticle:^FS\r
^FO120,240^A0N,34,36^FD<t t-esc="line.lot_id.product_id.default_code" />^FS\r
^FO32,283^A0N,31,23^FD<t
          t-esc="line.lot_id.product_id.name and line.lot_id.product_id.name[:45]"
        />^FS\r
^FO420,150\r
^BQN,2,6\r
^FDQA,<t t-esc="line.lot_id.name" />^FS\r
^XZ
</t>
    </div>
  </template>
  <record model="ir.actions.report" id="report_pharmacy_lot_label">
    <field name="name">Alcyon pharmacy lot label</field>
    <field name="model">reception.pharmacy.line</field>
    <field name="report_type">qweb-pdf</field>
    <field name="report_name">alc_reception_pharmacy_printing.pharmacy_lot_label</field>
    <field name="report_file">alc_reception_pharmacy_printing.pharmacy_lot_label</field>
  </record>

</odoo>
