<odoo>
  <record model="ir.ui.view" id="product_template_search_view">
    <field name="name">product.template.search (in alc_product_audit)</field>
    <field name="model">product.template</field>
    <field name="inherit_id" ref="product.product_template_search_view" />
    <field name="arch" type="xml">
      <xpath expr="//search" position="inside">
        <separator />
        <filter
          string="Product has an anomaly"
          name="filter_has_anomaly"
          domain="[('has_anomaly','=',True)]"
        />
        <filter
          string="No min/max and no 'on command reappro'"
          name="filter_no_min_max_no_on_command_reappro"
          domain="[('no_min_max_no_on_command_reappro','=',True)]"
        />
        <filter
          string="Min/max and 'on command reappro'"
          name="filter_min_max_on_command_reappro"
          domain="[('min_max_on_command_reappro','=',True)]"
        />
        <filter
          string="Not salable but not archived"
          name="filter_sale_not_ok_not_archived"
          domain="[('sale_not_ok_not_archived','=',True)]"
        />
        <filter
          string="Not salable or archived but with a bin"
          name="filter_sale_not_ok_archived_bin_available"
          domain="[('sale_not_ok_archived_bin_available','=',True)]"
        />
        <filter
          string="Mismatch between route and picking zone"
          name="filter_mismatch_route_picking"
          domain="[('mismatch_route_picking','=',True)]"
        />
        <filter
          string="Mismatch between picking zone and bin"
          name="filter_mismatch_picking_bin"
          domain="[('mismatch_picking_bin','=',True)]"
        />
        <filter
          string="MTO product has abnormal routes"
          name="filter_mto_with_abnormal_route"
          domain="[('mto_with_abnormal_route','=',True)]"
        />
        <filter
          string="can be bought without buy routes"
          name="filter_can_be_bought_without_buy_route"
          domain="[('can_be_bought_without_buy_route','=',True)]"
        />
      </xpath>
    </field>
  </record>
  <record id="product_template_tree_view" model="ir.ui.view">
    <field name="name">product.template.tree (in alc_product_audit)</field>
    <field name="model">product.template</field>
    <field name="inherit_id" ref="product.product_template_tree_view" />
    <field name="arch" type="xml">
      <field name="categ_id" position="after">
        <field name="has_anomaly" />
      </field>
    </field>
  </record>
  <record id="product_template_form_view" model="ir.ui.view">
    <field name="name">product.template.form  (in alc_product_audit)</field>
    <field name="model">product.template</field>
    <field name="inherit_id" ref="product.product_template_only_form_view" />
    <field name="arch" type="xml">
      <form position="inside">
        <field name="has_anomaly" invisible="1" />
        <field name="no_min_max_no_on_command_reappro" invisible="1" />
        <field name="min_max_on_command_reappro" invisible="1" />
        <field name="sale_not_ok_not_archived" invisible="1" />
        <field name="sale_not_ok_archived_bin_available" invisible="1" />
        <field name="mismatch_route_picking" invisible="1" />
        <field name="mismatch_picking_bin" invisible="1" />
        <field name="mto_with_abnormal_route" invisible="1" />
        <field name="can_be_bought_without_buy_route" invisible="1" />
      </form>
      <header position="after">
        <div
          class="alert alert-warning"
          attrs="{'invisible': [('has_anomaly', '=', False)]}"
        >
                Following issue(s) is/are observed on the product:
                    <div
            attrs="{'invisible': [('no_min_max_no_on_command_reappro', '=', False)]}"
          >
            <p> - Product has no min/max and is not 'on command reappro' </p>
          </div>
                    <div
            attrs="{'invisible': [('min_max_on_command_reappro', '=', False)]}"
          >
            <p>- Product has min/max and is 'on command reappro'</p>
          </div>
                    <div
            attrs="{'invisible': [('sale_not_ok_not_archived', '=', False)]}"
          >
            <p>- Product is not salable but not archived</p>
          </div>
                    <div
            attrs="{'invisible': [('sale_not_ok_archived_bin_available', '=', False)]}"
          >
            <p>- Product is not salable and still has a bin</p>
          </div>
                    <div
            attrs="{'invisible': [('mismatch_route_picking', '=', False)]}"
          >
            <p
            >- More than one route is selected for the product, leading to a mismatch with the picking zone</p>
          </div>
                    <div attrs="{'invisible': [('mismatch_picking_bin', '=', False)]}">
            <p>- The selected picking zone does not match the bin</p>
          </div>
                    <div
            attrs="{'invisible': [('mto_with_abnormal_route', '=', False)]}"
          >
            <p>- MTO Product with abnormal routes</p>
          </div>
                    <div
            attrs="{'invisible': [('can_be_bought_without_buy_route', '=', False)]}"
          >
            <p>- Product can be purchased but does not have the buy route</p>
          </div>
                </div>
      </header>
    </field>
  </record>
</odoo>
