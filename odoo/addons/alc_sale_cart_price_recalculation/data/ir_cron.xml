<?xml version="1.0" ?>
<odoo noupdate="1">
  <record forcecreate="True" id="ir_cron_cart_price_recalculate" model="ir.cron">
    <field name="name">Eshop Cart - Recalculate prices to today</field>
    <field eval="False" name="active" />
    <field name="user_id" ref="base.user_root" />
    <field name="interval_number">24</field>
    <field name="interval_type">hours</field>
    <field name="numbercall">-1</field>
    <field name="model_id" ref="sale.model_sale_order" />
    <field
      name="nextcall"
      eval="(datetime.now() + timedelta(days=1)).strftime('%Y-%m-%d 01:00:01')"
    />
    <field name="code">model._cron_recompute_cart_price()</field>
    <field name="run_as_queue_job" eval="1" />
    <field ref="queue_job_cron.channel_root_ir_cron" name="channel_id" />
  </record>

  <record id="job_recalculate_cart_price_to_now" model="queue.job.function">
    <field name="model_id" ref="sale.model_sale_order" />
    <field name="method">_recalculate_cart_price_to_now</field>
    <field
      name="channel_id"
      ref="alc_queue_job_background_channel.channel_root_background_process"
    />
  </record>
</odoo>
