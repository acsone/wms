<odoo noupdate="1">
    <record id="sale_order_request_backorder_cancellation" model="mail.template">
            <field name="name">Demande d'annulation produit en backorder</field>
            <field
      name="email_from"
    >{{ (object.partner_id.email and '%s &lt;%s&gt;' % (object.partner_id.name, object.partner_id.email) or '') }}</field>
            <field
      name="subject"
    >Ref {{ object.name }}: Demande annulation backorder {{ ctx['product'].name }}</field>
            <field name="email_to">callcenter@alcyonbelux.be</field>
            <field name="model_id" ref="sale.model_sale_order" />
            <field name="auto_delete" eval="True" />
            <field name="lang">{{ object.partner_id.lang }}</field>
            <field name="body_html" type="html">
<p>Bonjour,</p>
<p><t t-out="object.partner_id.name" /> demande l'annulation de <t
          t-out="ctx['quantity']"
        /> unité(s) en backorder pour le produit <t
          t-out="ctx['product'].display_name"
        /> dans la commande <t t-out="object.name" /> du <t
          t-out="format_datetime(dt=object.date_order, tz=user.tz)"
        />.</p>
<p>Merci de faire le nécessaire.</p>
</field>
        </record>
</odoo>
