<odoo>
  <record id="filter_manufacturer" model="product.filter">
    <field name="based_on">field</field>
    <field
      name="field_id"
      ref="product_manufacturer.field_product_template_manufacturer"
    />
    <field name="help">Filter on Manufacturer</field>
    <field name="name">Manufacturer</field>
    <field name="sequence">20</field>
  </record>
  <record id="filter_indication_option_ids" model="product.filter">
    <field name="based_on">product_attribute</field>
    <field name="sequence" eval="50" />
    <field name="name">Indications</field>
    <field name="product_attribute_id" ref="alc_pim.attribute_indication_option_ids" />
   </record>
</odoo>
