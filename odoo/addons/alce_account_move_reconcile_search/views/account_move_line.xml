<odoo>


    <record model="ir.ui.view" id="account_move_line_search_view">
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account_accountant.view_account_move_line_search_bank_rec_widget"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="filter_domain">['|', ('name', 'ilike', self), ('ref', 'ilike', self)]</attribute>
            </xpath>
        </field>
    </record>


</odoo>
