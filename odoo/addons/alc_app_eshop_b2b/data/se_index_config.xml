          "name":{
            "index":true,
            "type":"text"
          },
          "id":{
            "type":"integer"
          }
        }
      },
      "supplier_id":{
        "type":"integer"
      },
      "supplier_promotion":{
        "type":"nested",
        "properties":{
          "time_frame":{
            "type":"date_range",
            "format":"yyyy-MM-dd"
          }
        }
      },
      "cross":{
        "fields":{
          "raw":{
            "type":"text",
            "analyzer":"analyzer_lang",
            "similarity":"boolean"
          }
        },
        "type":"keyword"
      },
      "categories":{
        "type":"nested",
        "properties":{
          "id":{
            "type":"integer"
          },
          "name":{
            "type":"keyword"
          },
          "level":{
            "type":"integer"
          }
        }
      },
      "short_description":{
        "type":"text",
        "analyzer":"analyzer_lang"
      },
      "main":{
        "type":"boolean"
      },
      "price":{
        "dynamic":false,
        "type":"object"
      },
      "stock":{
        "properties":{
          "global":{
            "properties":{
              "state":{
                "type":"keyword"
              }
            }
          }
        }
      },
      "brand":{
        "properties":{
          "name":{
            "fields":{
              "raw":{
                "type":"text"
              }
            },
            "type":"keyword"
          }
        }
      },
      "redirect_url_key":{
        "type":"keyword"
      },
      "structured_attributes":{
        "type":"nested",
        "properties":{
          "fields":{
            "type":"nested"
          }
        }
      },
      "storage_temperature_id":{
        "properties":{
          "name":{
            "type":"keyword"
          },
          "id":{
            "type":"integer"
          }
        }
      },
      "manufacturer":{
        "properties":{
          "name":{
            "fields":{
              "raw":{
                "type":"text"
              }
            },
            "type":"keyword"
          }
        }
      },
      "indicated_price":{
        "type":"double"
      },
      "name":{
        "fields":{
          "raw":{
            "type":"text",
            "analyzer":"analyzer_lang"
          },
          "start":{
            "type":"text",
            "analyzer":"analyzer_startswith",
            "similarity":"boolean"
          }
        },
        "type":"keyword"
      },
      "supplier_promotion_veterinary":{
        "type":"nested",
        "properties":{
          "time_frame":{
            "type":"date_range",
            "format":"yyyy-MM-dd"
          }
        }
      },
      "packaging_ids":{
        "type":"keyword"
      },
      "specials":{
        "type":"nested"
      },
      "supplier_discount":{
        "type":"nested",
        "properties":{
          "time_frame":{
            "type":"date_range",
            "format":"yyyy-MM-dd"
          }
        }
      },
      "attributes":{
        "properties":{
          "species_id":{
            "type":"keyword"
          },
          "presentation_option_id":{
            "fields":{
              "raw":{
                "type":"text"
              }
            },
            "type":"keyword"
          },
          "active_principle_option_ids":{
            "fields":{
              "raw":{
                "type":"text",
                "analyzer":"analyzer_lang"
              }
            },
            "type":"keyword"
          },
          "species_ids":{
            "fields":{
              "raw":{
                "type":"text"
              }
            },
            "type":"keyword"
          },
          "administration_route_option_ids":{
            "fields":{
              "raw":{
                "type":"text"
              }
            },
            "type":"keyword"
          },
          "animal_size_option_ids":{
            "fields":{
              "raw":{
                "type":"text"
              }
            },
            "type":"keyword"
          },
          "categ_age_option_ids":{
            "fields":{
              "raw":{
                "type":"text"
              }
            },
            "type":"keyword"
          },
          "indication_option_ids":{
            "fields":{
              "raw":{
                "type":"text"
              }
            },
            "type":"keyword"
          },
          "taxes_id":{
            "type":"keyword"
          },
          "product_color_option_ids":{
            "type":"keyword"
          },
          "size_clothing_option_id":{
            "fields":{
              "raw":{
                "type":"text"
              }
            },
            "type":"keyword"
          },
          "food_range_option_id":{
            "fields":{
              "raw":{
                "type":"text"
              }
            },
            "type":"keyword"
          }
        }
      },
      "model":{
        "properties":{
          "name":{
            "ignore_above":256,
            "fields":{
              "raw":{
                "type":"text"
              }
            },
            "type":"keyword"
          }
        }
      },
      "description_shop_short":{
        "type":"text",
        "analyzer":"analyzer_lang"
      }
    }
  },
  "settings":{
    "index.mapping.total_fields.limit": 2000,
    "default_pipeline":"set-current-price",
    "analysis":{
      "filter":{
        "french_elision":{
          "articles":[
            "l",
            "m",
            "t",
            "qu",
            "n",
            "s",
            "j",
            "d",
            "c",
            "jusqu",
            "quoiqu",
            "lorsqu",
            "puisqu"
          ],
          "type":"elision",
          "articles_case":true
        },
        "french_keywords":{
          "keywords":[
            "Example"
          ],
          "type":"keyword_marker"
        },
        "french_stemmer":{
          "type":"stemmer",
          "language":"light_french"
        },
        "french_stop":{
          "stopwords":"_french_",
          "type":"stop"
        },
        "word_delimiter":{
          "catenate_all":true,
          "catenate_numbers":true,
          "generate_word_parts":true,
          "split_on_numerics":false,
          "generate_number_parts":true,
          "preserve_original":true,
          "type":"word_delimiter",
          "split_on_case_change":true
        }
      },
      "index":{
        "sort.order":[
          "asc"
        ],
        "sort.field":[
          "sequence"
        ]
      },
      "char_filter":{
        "replace":{
          "type":"mapping",
          "mappings":[
            "&=> and "
          ]
        }
      },
      "analyzer":{
        "analyzer_lang":{
          "filter":[
            "french_elision",
            "lowercase",
            "asciifolding",
            "french_stop",
            "french_keywords",
            "french_stemmer"
          ],
          "tokenizer":"standard"
        },
        "analyzer_startswith":{
          "filter":[
            "asciifolding",
            "lowercase"
          ],
          "tokenizer":"standard"
        },
        "default":{
          "filter":[
            "lowercase",
            "word_delimiter"
          ],
          "char_filter":[
            "html_strip",
            "replace"
          ],
          "type":"custom",
          "tokenizer":"whitespace"
        }
      }
    }
  }
}
]]>
        </field>
    </record>

