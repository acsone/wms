      name="body_str"
    > <![CDATA[
{
  "mappings":{
    "properties":{
      "links":{
        "dynamic":false,
        "type":"object"
      },
      "hierarchicalCategories":{
        "type":"nested",
        "properties":{
          "ancestors":{
            "type":"keyword"
          },
          "order":{
            "type":"integer"
          },
          "value":{
            "type":"keyword"
          },
          "level":{
            "type":"integer"
          }
        }
      },
      "description_shop_long":{
        "type":"text",
        "analyzer":"analyzer_lang"
