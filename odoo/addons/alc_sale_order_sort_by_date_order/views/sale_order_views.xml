<odoo>

  <record model="ir.ui.view" id="sale_order_tree_view">
    <field name="name">sale.order.tree (in alc_sale_order_sort_by_date_order)
    </field>
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale.view_order_tree" />
    <field name="arch" type="xml">
      <xpath expr="//tree" position="attributes">
        <attribute name="default_order">date_order desc, name desc</attribute>
      </xpath>
    </field>
  </record>

  <record model="ir.ui.view" id="view_quotation_tree">
    <field name="name">sale.quotation.tree (in alc_sale_order_sort_by_date_order)
    </field>
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale.view_quotation_tree" />
    <field name="arch" type="xml">
      <xpath expr="//tree" position="attributes">
        <attribute name="default_order">date_order desc, name desc</attribute>
      </xpath>
    </field>
  </record>

</odoo>
