<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="product_stock_bin_form_view" model="ir.ui.view">
    <field name="name">product.stock.bin.form</field>
    <field name="model">product.stock.bin</field>
    <field name="arch" type="xml">
      <form string="Storage Location">
        <sheet>
          <h1>
            <field name="product_id" />
          </h1>
          <group>
            <group>
              <field name="location_id" />
            </group>
            <group>
              <field
                name="bin_location_id"
                domain="[('id','child_of',location_id),('usage', '=', 'internal'),('act_as_view', '=', False)]"
                attrs="{'readonly':[('location_id','=',False)]}"
              />
            </group>
          </group>
        </sheet>
      </form>
    </field>
  </record>
  <record id="product_stock_bin_tree_view" model="ir.ui.view">
    <field name="name">product.stock.bin.tree</field>
    <field name="model">product.stock.bin</field>
    <field name="arch" type="xml">
      <tree>
        <field name="product_id" />
        <field name="location_id" />
        <field name="bin_location_id" />
      </tree>
    </field>
  </record>
  <record id="product_stock_bin_search_view" model="ir.ui.view">
    <field name="name">product.stock.bin.search</field>
    <field name="model">product.stock.bin</field>
    <field name="arch" type="xml">
      <search string="Storage Location">
        <field name="product_id" />
        <field name="location_id" />
        <field name="bin_location_id" />
      </search>
    </field>
  </record>
  <record id="product_stock_bin_action" model="ir.actions.act_window">
    <field name="name">Storage Locations</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">product.stock.bin</field>
    <field name="view_type">form</field>
    <field name="view_mode">tree,form</field>
  </record>
  <menuitem
    action="product_stock_bin_action"
    name="Product Bins"
    parent="stock.menu_product_in_config_stock"
    id="menu_product_stock_bin"
    sequence="10"
  />
</odoo>
