<odoo noupdate="0">
  <record id="seq_picking_type_location_content_transfer" model="ir.sequence">
    <field name="name">Location Content Transfer</field>
    <field name="prefix">LCT</field>
    <field name="padding">5</field>
    <field name="company_id" eval="False" />
  </record>
  <record id="picking_type_location_content_transfer" model="stock.picking.type">
    <field name="name">Location Content Transfer</field>
    <field name="sequence_id" ref="seq_picking_type_location_content_transfer" />
    <field name="sequence" eval="10" />
    <field name="warehouse_id" ref="stock.warehouse0" />
    <field name="default_location_src_id" ref="stock.stock_location_stock" />
    <field name="default_location_dest_id" ref="stock.stock_location_stock" />
    <field name="use_create_lots" eval="0" />
    <field name="use_existing_lots" eval="1" />
    <field name="color" eval="5" />
    <field name="code">internal</field>
    <field name="display_completion_info" eval="1" />
  </record>
</odoo>
