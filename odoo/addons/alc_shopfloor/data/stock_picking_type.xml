<odoo noupdate="1">
  <!-- only used  on empty DB since a migration script / init_hook
         is in charge of renaming existing xml ids records for the
         following records
     -->
  <record id="stock_picking_type_rangement_medoc" model="stock.picking.type">
    <field name="name">Rangement Médicaments</field>
    <field name="sequence_id" ref="stock.seq_picking_internal" />
    <field name="sequence" eval="10" />
    <field name="warehouse_id" ref="stock.warehouse0" />
    <field name="default_location_src_id" ref="stock.stock_location_stock" />
    <field name="default_location_dest_id" ref="stock.stock_location_stock" />
    <field name="use_create_lots" eval="0" />
    <field name="use_existing_lots" eval="1" />
    <field name="color" eval="5" />
    <field name="code">internal</field>
    <field name="display_completion_info" eval="1" />
  </record>
  <record id="stock_picking_type_reassort_medoc" model="stock.picking.type">
    <field name="name">Réassort Médicaments</field>
    <field name="sequence_id" ref="stock.seq_picking_internal" />
    <field name="sequence" eval="10" />
    <field name="warehouse_id" ref="stock.warehouse0" />
    <field name="default_location_src_id" ref="stock.stock_location_stock" />
    <field name="default_location_dest_id" ref="stock.stock_location_stock" />
    <field name="use_create_lots" eval="0" />
    <field name="use_existing_lots" eval="1" />
    <field name="color" eval="5" />
    <field name="code">internal</field>
    <field name="display_completion_info" eval="1" />
  </record>
  <record id="stock_picking_type_medoc" model="stock.picking.type">
    <field name="name">Pick Médicaments</field>
    <field name="sequence_id" ref="stock.seq_picking_internal" />
    <field name="sequence" eval="10" />
    <field name="warehouse_id" ref="stock.warehouse0" />
    <field name="default_location_src_id" ref="stock.stock_location_stock" />
    <field name="default_location_dest_id" ref="stock.stock_location_stock" />
    <field name="use_create_lots" eval="0" />
    <field name="use_existing_lots" eval="1" />
    <field name="color" eval="5" />
    <field name="code">internal</field>
    <field name="display_completion_info" eval="1" />
  </record>
</odoo>
