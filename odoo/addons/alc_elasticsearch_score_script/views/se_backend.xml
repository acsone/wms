<odoo>

    <record model="ir.ui.view" id="se_backend_elasticsearch_form_view">
        <field name="model">se.backend</field>
        <field name="inherit_id" ref="connector_search_engine.se_backend_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="score_script" string="Score script">
                    <button
            name="create_or_update_score_on_position_script"
            string="Sync Score On Position Script"
            class="oe_highlight"
            type="object"
          />
                    <group string="Score On Position Script">
                        <field
              nolabel="1"
              colspan="2"
              name="score_on_position_script"
              widget="ace"
              options="{'mode': 'python'}"
            />
                    </group>
                </page>
            </xpath>
        </field>
    </record>


</odoo>
