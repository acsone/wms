<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="view_picking_form" model="ir.ui.view">
    <field name="name">stock.picking.form in (alc_stock_delivery_slip)u</field>
    <field name="model">stock.picking</field>
    <field name="inherit_id" ref="stock.view_picking_form" />
    <field name="arch" type="xml">
      <xpath
        expr="//page[@name='operations']/field/form/group/field[@name='product_id']"
        position="before"
      >
        <field name="order_id" groups="base.group_no_one" />
        <field name="sale_line_id" groups="base.group_no_one" />
      </xpath>
    </field>
  </record>
  <!-- Add an entry in the action menu to re generate the delivery note -->
  <record id="action_server_generate_delivery_note" model="ir.actions.server">
    <field name="name">Generate delivery note</field>
    <field name="model_id" ref="stock.model_stock_picking" />
    <field name="binding_model_id" ref="stock.model_stock_picking" />
    <field name="state">code</field>
    <field name="code">records.create_delivery_note()</field>
  </record>
</odoo>
