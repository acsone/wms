<?xml version="1.0" ?>
<odoo>
    <record id="view_round_instance_kanban" model="ir.ui.view">
    <field name="name">round.instance.kanban.gls</field>
    <field name="model">round.instance</field>
    <field name="inherit_id" ref="delivery_rounds.view_round_instance_kanban" />
      <field name="arch" type="xml">
            <xpath expr="//field[@name='count_picking_done_total']" position="after">
              <field name="is_gls_sent" invisible="1" />
            </xpath>
            <xpath expr="//a[@name='button_deliver']" position="attributes">
              <field name="is_gls_sent" />
                <attribute
          name="attrs"
        >{'invisible':[("is_gls_sent", '!=', True)]}</attribute>
            </xpath>
        </field>
    </record>
    <record id="view_round_instance_form" model="ir.ui.view">
    <field name="name">round.instance.form.gls</field>
    <field name="model">round.instance</field>
    <field name="inherit_id" ref="delivery_rounds.view_round_instance_form" />
      <field name="arch" type="xml">
            <xpath expr="//field[@name='date']" position="after">
                <field name="is_gls_sent" invisible="1" />
            </xpath>
            <xpath
        expr="//header//button[@name='button_deliver']"
        position="attributes"
      >
                <attribute
          name="attrs"
        >{'invisible':[("is_gls_sent", '!=', True)]}</attribute>
            </xpath>
            <xpath
        expr="//field[@name='instance_customer_ids']//button[@name='button_deliver']"
        position="attributes"
      >
                <attribute
          name="attrs"
        >{'invisible':['|', ('delivered', '!=', False), ("is_gls_sent", '!=', True)]}</attribute>
            </xpath>
        </field>
    </record>
</odoo>
