<odoo>
  <record model="ir.ui.view" id="stock_lot_update_form_view">
    <field name="name">stock.lot.update.form (in stock_lot_update)</field>
    <field name="model">stock.lot.update</field>
    <field name="arch" type="xml">
      <form string="Update lot product">
        <group>
          <field name="company_id" invisible="1" />
          <field name="product_id" />
        </group>
        <footer>
          <button
            name="action_update"
            string="Update product on this lot"
            class="btn-primary"
            type="object"
          />
          <button string="Cancel" class="btn-default" special="cancel" />
        </footer>
      </form>
    </field>
  </record>
</odoo>
