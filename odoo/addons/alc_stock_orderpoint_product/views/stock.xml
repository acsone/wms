<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="view_stock_orderpoint_search" model="ir.ui.view">
    <field name="name">stock.orderpoint.search</field>
    <field name="model">stock.warehouse.orderpoint</field>
    <field name="inherit_id" ref="stock.warehouse_orderpoint_search" />
    <field name="arch" type="xml">
      <field name="name" position="after">
        <filter name="active" string="Active" domain="[('active','=',True)]" />
        <filter name="inactive" string="Inactive" domain="[('active','=',False)]" />
      </field>
    </field>
  </record>
  <record id="view_stock_orderpoint_tree" model="ir.ui.view">
    <field name="name">stock.orderpoint.tree</field>
    <field name="model">stock.warehouse.orderpoint</field>
    <field name="inherit_id" ref="stock.view_warehouse_orderpoint_tree_editable" />
    <field name="arch" type="xml">
      <field name="active" position="attributes">
        <attribute name="invisible">0</attribute>
      </field>
    </field>
  </record>
  <record id="stock.action_orderpoint" model="ir.actions.act_window">
    <field
      name="context"
    >{'search_default_active':True, 'search_default_inactive':True}</field>
  </record>
</odoo>
