<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@id='companies']" position="after">
                <h2>Reports</h2>
                <div class="row mt16 o_settings_container" id="reports_settings">
                    <div
            class="col-xs-12 col-md-6 o_setting_box"
            id="enable_render_qweb_pdf_batch"
          >
                        <div class="o_setting_left_pane">
                            <field name="enable_render_qweb_pdf_batch" />
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="enable_render_qweb_pdf_batch" />
                        </div>
                    </div>
                    <div
            class="col-xs-12 col-md-6 o_setting_box"
            id="render_qweb_pdf_batch_size"
            attrs="{'invisible':[('enable_render_qweb_pdf_batch', '=', False)]}"
          >
                        <div class="o_setting_left_pane">
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="render_qweb_pdf_batch_size" />
                            <field name="render_qweb_pdf_batch_size" />
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
