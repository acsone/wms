<odoo>
  <record model="ir.ui.view" id="abc_classification_profile_form_view">
    <field
      name="name"
    >abc.classification.profile.form (in alc_product_abc_classification_picking_zone)</field>
    <field name="model">abc.classification.profile</field>
    <field
      name="inherit_id"
      ref="product_abc_classification_base.abc_classification_profile_form_view"
    />
    <field name="arch" type="xml">
      <field name="level_ids" position="after">
        <field
          name="picking_zone_ids"
          widget="many2many_tags"
          options="{'open': true}"
        />
        <field name="exclude_product_mto" />
      </field>
    </field>
  </record>
  <record model="ir.ui.view" id="abc_classification_profile_tree_view">
    <field
      name="name"
    >abc.classification.profile.tree (in alc_product_abc_classification_picking_zone)</field>
    <field name="model">abc.classification.profile</field>
    <field
      name="inherit_id"
      ref="product_abc_classification_base.abc_classification_profile_tree_view"
    />
    <field name="arch" type="xml">
      <field name="name" position="after">
        <field name="picking_zone_ids" />
        <field name="exclude_product_mto" />
      </field>
    </field>
  </record>
</odoo>
