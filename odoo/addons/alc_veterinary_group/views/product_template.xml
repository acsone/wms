<odoo>
    <record id="product_template_form_view_discount_specials" model="ir.ui.view">
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='sales']" position="inside">
                <group name="veterinary_groups" string="Veterinary Groups">
                    <field name="veterinary_group_ids">
                        <tree editable="top">
                            <field name="name" />
                        </tree>
                    </field>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
