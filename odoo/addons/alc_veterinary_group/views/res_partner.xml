<odoo>
  <record id="view_partner_form" model="ir.ui.view">
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="base.view_partner_form" />
    <field name="priority">99</field>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='function']" position="after">
        <field
          name="veterinary_group_ids"
          widget="many2many_tags"
          options="{'no_create': True}"
        />
        <field name="is_dates_contract_visible" invisible="1" />
        <field name="is_date_start_contract_editable" invisible="1" />
        <field name="is_date_end_contract_editable" invisible="1" />
            <label
          for="date_start_contract_alcyonnaire"
          string="Alcyonnaire Contract Validity"
          attrs="{'invisible': [('is_dates_contract_visible', '=', False)]}"
        />
            <div
          class="o_row"
          attrs="{'invisible': [('is_dates_contract_visible', '=', False)]}"
        >
                from <field
            name="date_start_contract_alcyonnaire"
            attrs="{'readonly': [('is_date_start_contract_editable', '=', False)]}"
          />
                to <field
            name="date_end_contract_alcyonnaire"
            attrs="{'readonly': [('is_date_end_contract_editable', '=', False)], 'invisible': [('date_start_contract_alcyonnaire', '=', False)]}"
          />

            </div>
          <field name="is_exclusive_vet_efficiency_member"/>
      </xpath>
    </field>
  </record>
</odoo>
