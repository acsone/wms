<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
  <record id="product_template_form_view" model="ir.ui.view">
    <field name="model">product.template</field>
    <field name="inherit_id" ref="product.product_template_form_view" />
    <field name="arch" type="xml">
      <xpath expr="//page[@name='sales']/group[@name='sale']" position="before">
        <separator name="additional_product" string="Additional product" />
        <div class="col-lg-12">For <field
            name="ratio_main_product"
            class="oe_inline"
          /> products, <field
            name="ratio_additional_product"
            class="oe_inline"
          /> <field name="additional_product_id" class="oe_inline" /> given</div>
      </xpath>
    </field>
  </record>
</odoo>
