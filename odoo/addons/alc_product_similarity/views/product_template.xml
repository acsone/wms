<odoo>

    <record model="ir.ui.view" id="product_template_form_view">
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view" />
        <field name="arch" type="xml">
            <notebook position="inside">
                <page name="similar_products" string="Similar Products">
                    <!-- You can define a custom kanban view here by creating a child <kanban> node
                    inside the field (you can then remove the "mode" attribute) -->
                    <field name="similar_products_ids" mode="kanban" />
                </page>
            </notebook>
        </field>
    </record>


</odoo>
