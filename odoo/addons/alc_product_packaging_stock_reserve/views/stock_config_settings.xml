<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_config_settings" model="ir.ui.view">
        <field name="name">stock.unit</field>
        <field name="model">stock.config.settings</field>
        <field name="inherit_id" ref="stock.view_stock_config_settings"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <group name="alc_product_packaging_stock_reserve" string="Packaging reservation">
                    <field name="reservation_unit_min_quantity"/>
                    <button
                        class="oe_link"
                        type="action"
                        string="Configure Packaging Ratio By Type"
                        name="%(product_packaging_type.act_open_product_packaging_type_view)d"
                        colspan="2"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
