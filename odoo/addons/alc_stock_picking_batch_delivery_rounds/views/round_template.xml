<odoo>

    <record model="ir.ui.view" id="round_template_form_view">
        <field
      name="name"
    >round.template.form (in alc_stock_picking_batch_delivery_rounds)</field>
        <field name="model">round.template</field>
        <field name="inherit_id" ref="delivery_rounds.view_round_template_form" />
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="allow_cluster_picking" />
            </field>
        </field>
    </record>

    <record model="ir.ui.view" id="round_template_tree_view">
        <field
      name="name"
    >round.template.tree (in alc_stock_picking_batch_delivery_rounds)</field>
        <field name="model">round.template</field>
        <field name="inherit_id" ref="delivery_rounds.view_round_template_tree" />
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="allow_cluster_picking" />
            </field>
        </field>
    </record>

</odoo>
