<odoo>
    <record
    id="act_res_partner_2_product_promotion_subscription"
    model="ir.actions.act_window"
  >
        <field name="name">Product Promotion Subscriptions</field>
        <field name="res_model">alc.product.promotion.subscription</field>
        <field name="view_mode">tree,form,graph</field>
        <field name="context">{'search_default_partner_id': active_id}</field>
    </record>

    <record model="ir.ui.view" id="res_partner_form_view">
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="priority" eval="90" />
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button
          class="oe_stat_button"
          type="action"
          name="%(alc_product_promotion_subscription.act_res_partner_2_product_promotion_subscription)d"
          attrs="{'invisible': [('is_customer', '=', False)]}"
          icon="fa-percent"
        >
                    <field
            string="Product Promotion Subscriptions"
            name="alc_product_promotion_subscription_count"
            widget="statinfo"
          />
                </button>
            </div>
        </field>
    </record>

</odoo>
