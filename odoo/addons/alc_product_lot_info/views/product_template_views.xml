<odoo>
  <record model="ir.ui.view" id="product_template_form_view">
    <field name="name">product.template.form (in alc_product_lot_info)</field>
    <field name="model">product.template</field>
    <field name="inherit_id" ref="stock.view_template_property_form" />
    <field name="arch" type="xml">
      <group name="stock_property" position="before">
        <group name="lot" groups="stock.group_production_lot">
          <field
            name="lot_ids"
            nolabel="1"
            class="oe_inline"
            attrs="{'invisible': [('tracking', '!=', 'lot')]}"
          >
            <tree limit='5'>
              <field name="name" />
              <field name="qty_available" widget="integer" />
              <field name="expiration_date" widget="date" />
            </tree>
          </field>
        </group>
      </group>
    </field>
  </record>
</odoo>
