<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record model="ir.ui.view" id="se_backend_form_view">
        <field name="model">se.backend</field>
        <field name="inherit_id" ref="alc_se_backend_notebook.se_backend_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Security">
                    <button
            name="synchronize_roles"
            string="Synchronize Roles"
            class="oe_highlight"
            type="object"
          />
                    <group string="settings">
                        <group>
                            <field name="ssl" />
                        </group>
                        <group>
                            <field name="opensearch_user" />
                            <field name="opensearch_user_password" widget="password" />
                        </group>
                    </group>
                    <group name="security_roles" string="Security Roles">
                        <field name="role_ids" nolabel="1" colspan="2">
                            <tree editable="bottom">
                                <field name="name" />
                                <field name="extra_backend_roles" />
                                <field name="body" />
                                <button
                  name="put_role"
                  type="object"
                  string="Synchronize"
                />
                            </tree>
                        </field>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
