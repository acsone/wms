<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record model="ir.ui.view" id="se_backend_elasticsearch_form_view">
        <field name="name">se.backend.elasticsearch.security</field>
        <field name="model">se.backend.elasticsearch</field>
        <field
      name="inherit_id"
      ref="connector_elasticsearch.se_backend_elasticsearch_form_view"
    />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='es_password']" position="after">
                <field name="security" />
                <field name="ssl" />
            </xpath>
            <xpath expr="//sheet" position="inside">
                <group name="security" string="Security">
                    <button
            name="synchronize_roles"
            string="Synchronize Roles"
            class="oe_highlight"
            type="object"
          />
                </group>
                <group name="security_roles" string="Security Roles">
                    <field name="role_ids" nolabel="1">
                        <tree editable="bottom">
                            <field name="name" />
                            <field name="extra_backend_roles" />
                            <field name="body" />
                            <button
                name="synchronize"
                type="object"
                string="Synchronize"
              />
                        </tree>
                    </field>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
