<odoo>
    <record id="product_normal_form_view" model="ir.ui.view">
    <field name="model">product.product</field>
    <field name="inherit_id" ref="specific_product.product_normal_form_view" />
    <field name="arch" type="xml">
      <field name="cnk_code" position="after">
        <field name="code_cti" />
      </field>
    </field>
  </record>
  <record id="product_template_form_view_cti" model="ir.ui.view">
    <field name="model">product.template</field>
    <field name="inherit_id" ref="specific_product.product_template_only_form_view" />
    <field name="arch" type="xml">
      <xpath expr="//field[@name='cnk_code']" position="after">
        <field name="code_cti" />
      </xpath>
    </field>
  </record>
  <record id="product_template_form_view_pharmacy_only" model="ir.ui.view">
    <field name="model">product.template</field>
    <field
      name="inherit_id"
      ref="specific_product.web_published_product_template_form_view"
    />
    <field name="arch" type="xml">
      <xpath expr="//field[@name='veterinary_only']" position="after">
        <field name="pharmacy_only" />
      </xpath>
    </field>
  </record>
  <record id="product_template_manufacturer_form_view" model="ir.ui.view">
    <field name="model">product.template</field>
    <field
      name="inherit_id"
      ref="product_manufacturer.product_template_manufacturer_form_view"
    />
    <field name="arch" type="xml">
      <xpath expr="//group[@name='manufacturer']" position="inside">
        <group>
            <field name="code_amm" />
        </group>
      </xpath>
    </field>
  </record>
</odoo>
