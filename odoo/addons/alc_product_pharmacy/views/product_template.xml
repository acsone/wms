<odoo>
  <record id="product_template_form_view_cti" model="ir.ui.view">
    <field name="model">product.template</field>
    <field name="inherit_id" ref="product.product_template_only_form_view" />
    <field name="arch" type="xml">
      <xpath expr="//field[@name='default_code']" position="after">
        <field name="cnk_code" />
        <field name="code_cti" />
      </xpath>
    </field>
  </record>
  <record id="product_template_form_view_pharmacy_only" model="ir.ui.view">
    <field name="model">product.template</field>
    <field name="inherit_id" ref="product.product_template_form_view" />
    <field name="arch" type="xml">
      <xpath expr="//page[@name='sales']" position="inside">
        <group name="sales_restriction">
          <field name="veterinary_only" />
          <field name="belgium_only" />
        </group>
      </xpath>
    </field>
  </record>
  <record id="product_template_manufacturer_form_view" model="ir.ui.view">
    <field name="model">product.template</field>
    <field
      name="inherit_id"
      ref="product_manufacturer.product_template_manufacturer_form_view"
    />
    <field name="arch" type="xml">
      <xpath expr="//group[@name='manufacturer']" position="inside">
        <group>
            <field name="code_amm" />
        </group>
      </xpath>
    </field>
  </record>

  <record model="ir.ui.view" id="product_template_search_view">
    <field name="name">product.template.search (in alc_product_pharmacy)</field>
    <field name="model">product.template</field>
    <field name="inherit_id" ref="product.product_template_search_view" />
    <field name="arch" type="xml">
      <xpath expr="//search//field[@name='name']" position="after">
        <field
          name="cnk_code"
          filter_domain="[('cnk_code','ilike',self)]"
          string="CNK code"
        />
        <separator />
      </xpath>
      <xpath expr="//search//filter[@name='filter_to_purchase']" position="after">
        <separator />
          <filter
          string="Product without amm and belgian veterinary med or importation"
          name="filter_is_amm_missing"
          domain="[ '|',
          ('is_vt_be', '=', True),
          ('is_import', '=', True),
          '&amp;',
          ('active', '=', True),
          ('code_amm', '=', False),
          ]"
        />
      </xpath>
    </field>
  </record>

</odoo>
