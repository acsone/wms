<odoo>
  <record model="ir.ui.view" id="stock_pack_operation_lot_add_form_view">
    <field name="name">stock.pack.operation.lot.add.form (in alc_stock_receive_lot_expiry)</field>
    <field name="model">stock.pack.operation.lot.add</field>
    <field name="inherit_id" ref="alc_stock_receive_lot.view_pack_operation_lot_add_form" />
    <field name="arch" type="xml">
      <header position="after">
        <field name="is_removal_date_expired" invisible="1" />
        <div class="alert alert-danger" style="margin-bottom:0px;font-weight: bolder;text-align: center;" role="alert"
          attrs="{'invisible': [('is_removal_date_expired', '=', False)]}">
          Filled in lot is expired! Please check the product.
        </div>
      </header>
    </field>
  </record>
</odoo>
