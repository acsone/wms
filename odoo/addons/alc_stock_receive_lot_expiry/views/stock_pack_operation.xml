<odoo>
  <record model="ir.ui.view" id="stock_pack_operation_form_view">
    <field
      name="name"
    >stock.pack.operation.form (in alc_stock_receive_lot_expiry)</field>
    <field name="model">stock.pack.operation</field>
    <field name="inherit_id" ref="stock.view_pack_operation_lot_form" />
    <field name="arch" type="xml">
      <field name="lot_name" position="before">
        <field name="is_product_expired" invisible="1" />
      </field>
      <xpath expr="//tree" position="attributes">
        <attribute name="decoration-danger">is_product_expired == True</attribute>
      </xpath>
    </field>
  </record>
</odoo>
