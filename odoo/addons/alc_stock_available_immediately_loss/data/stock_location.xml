<odoo>
    <!-- Exclude from immediately usable qty Loss location -->

    <function model="stock.location" name="write">
        <value
      model="stock.location"
      eval="obj().env.ref('stock.warehouse0').with_context(active_test=False).loss_location_id.ids"
    />
        <value eval="{'exclude_from_immediately_usable_qty': True}" />
    </function>
</odoo>
