<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="alc_classified_search_view" model="ir.ui.view">
        <field name="name">alc.classified.search</field>
        <field name="model">alc.classified</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="body" />
                <field name="partner_id" />
                <filter
          string="Pending"
          name="Pending"
          domain="[('state', '=', 'pending')]"
        />
                <filter
          string="Published"
          name="Published"
          domain="[('state', '=', 'published')]"
        />
                <filter
          string="Rejected"
          name="Rejected"
          domain="[('state', '=', 'cancel')]"
        />
                <group expand="0" string="Group By">
                    <filter
            string="Status"
            name="Status"
            context="{'group_by':'state'}"
          />
                    <filter
            string="Partner"
            name="Partner"
            context="{'group_by':'partner_id'}"
          />
                    <filter
            string="State"
            name="State"
            context="{'group_by':'state_id'}"
          />
                    <filter
            string="Category"
            name="Category"
            context="{'group_by':'category'}"
          />
                </group>
            </search>
        </field>
    </record>

    <record id="alc_classified_tree_view" model="ir.ui.view">
        <field name="name">alc.classified.tree</field>
        <field name="model">alc.classified</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="partner_id" />
                <field name="category" />
                <field name="state" />
                <field name="state_id" />
                <field name="date_start" />
                <field name="date_end" />
            </tree>
        </field>
    </record>

    <record id="alc_classified_form_view" model="ir.ui.view">
        <field name="name">alc.classified.form</field>
        <field name="model">alc.classified</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
            name="confirm"
            type="object"
            class="btn btn-primary"
            attrs="{'invisible':[('state','=', 'published')]}"
            string="Publish"
          />
                    <button
            name="action_reject"
            type="object"
            class="btn btn-primary"
            attrs="{'invisible':[('state','=', 'cancel')]}"
            string="Reject"
          />
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="partner_id" />
                        <field name="date_start" />
                        <field name="date_end" />
                        <field name="sequence" />
                        <field name="category" />
                        <field name="rejection_reason" />
                        <field name="body" />
                        <field name="state_id" />
                        <field name="email" />
                        <field name="contact" />
                        <field name="phone" />
                        <field name="file_id" />
                    </group>
                </sheet>
                <div class="oe_chatter">
                  <field name="message_follower_ids" widget="mail_followers" />
                  <field name="message_ids" widget="mail_thread" />
                </div>
            </form>
        </field>
    </record>

    <record model="ir.actions.act_window" id="alc_classified_act_window">
        <field name="name">Classifieds</field>
        <field name="res_model">alc.classified</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="search_view_id" ref="alc_classified_search_view" />
        <field name="view_id" ref="alc_classified_tree_view" />
    </record>

    <menuitem
    id="alc_classified_menu"
    name="Classifieds"
    parent="sale.menu_sales_config"
    action="alc_classified_act_window"
    sequence="105"
  />
</odoo>
