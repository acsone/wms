<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record model="ir.ui.view" id="alc_classified_wizard_rejection_form_view">
        <field name="name">alc.classified.wizard.form</field>
        <field name="model">alc.classified.wizard.rejection</field>
        <field name="arch" type="xml">
            <form string="Reject Classified">
                <group>
                    <field name="alc_classified_id" invisible="1" />
                    <field name="name" />
                    <field name="reason" />
                </group>
                <footer>
                    <button
            name="execute"
            class="btn btn-primary"
            type="object"
            string="Reject"
          />
                    <button special="cancel" string="Cancel" />
                </footer>
            </form>
        </field>
    </record>
    <record
    model="ir.actions.act_window"
    id="alc_classified_wizard_rejection_act_window"
  >
        <field name="name">Reject Classified</field>
        <field name="res_model">alc.classified.wizard.rejection</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>
</odoo>
