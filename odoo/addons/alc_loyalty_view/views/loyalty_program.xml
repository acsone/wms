<odoo>

    <record model="ir.ui.view" id="loyalty_program_form_view">
        <field name="model">loyalty.program</field>
        <field name="inherit_id" ref="loyalty.loyalty_program_view_form"/>
        <field name="arch" type="xml">
            <page name="rules_rewards" position="attributes">
                <attribute
                    name="attrs"
                    operation="attrs_domain_add"
                    key="invisible"
                    join_operator="OR">
                        [('program_type', '=', 'year_end_rebate')]
                </attribute>
            </page>
            <page name="rules_rewards" position="after">
                <page string="Rules &amp; Rewards" name="rules_rewards_end_of_years" attrs="{'invisible': [('program_type', '!=', 'year_end_rebate')]}">
                    <group>
                        <group>
                            <field name="rule_ids" colspan="2" mode="tree" nolabel="1" add-label="Add a rule"
                                class="o_loyalty_kanban_inline" widget="loyalty_one2many" context="{'currency_symbol': currency_symbol, 'program_type': program_type}"/>
                        </group>
                        <group>
                            <field name="reward_ids" colspan="2" mode="kanban" nolabel="1" add-label="Add a reward"
                                class="o_loyalty_kanban_inline" widget="loyalty_one2many" context="{'currency_symbol': currency_symbol, 'program_type': program_type}"/>
                        </group>
                    </group>
                </page>
            </page>
            <xpath expr="//sheet/div[@name='button_box']" position="inside">
                <button class="oe_stat_button" type="object" name="action_open_conditional_rules"
                    icon="fa-list">
                    <div class="o_form_field o_stat_info">
                        <span class="o_stat_value">
                            <field name="rules_count"/>
                        </span>
                        <span class="o_stat_text">
                            Rules
                        </span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>

</odoo>
