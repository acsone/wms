<odoo>

    <record model="ir.ui.view" id="stock_return_picking_form_view">
        <field name="name">stock.return.picking.form (in alc_restocking_exclude_not_salable)
        </field>
        <field name="model">stock.return.picking</field>
        <field name="inherit_id" ref="stock.view_stock_return_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[1]" position="after">
             <field name="has_archived_product" invisible="1"/>
                <div class="alert alert-warning" attrs="{'invisible': [('has_archived_product', '=', False)]}">
                    <field name="archived_products_message"/>
                </div>
            </xpath>
            <field name="quantity" position="after">
                <field name="not_salable_product"/>
            </field>
            <tree position="attributes">
                <attribute name="decoration-danger">not_salable_product == True</attribute>
            </tree>
        </field>
    </record>
</odoo>