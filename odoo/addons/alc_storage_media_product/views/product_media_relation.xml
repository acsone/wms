<odoo>

    <record model="ir.ui.view" id="product_media_relation_form_view">
        <field
      name="name"
    >product.media.relation.form (in alc_storage_media_product)</field>
        <field name="model">product.media.relation</field>
        <field
      name="inherit_id"
      ref="storage_media_product.product_media_relation_form"
    />
        <field name="arch" type="xml">
            <field name="media_id" position="after">
                <field name="url" widget="url" />
                <field name="lang" />
                <field name="media_type_id" />
            </field>
        </field>
    </record>


    <record model="ir.ui.view" id="product_media_relation_tree_view">
        <field
      name="name"
    >product.media.relation.tree (in alc_storage_media_product)</field>
        <field name="model">product.media.relation</field>
        <field
      name="inherit_id"
      ref="storage_media_product.product_media_relation_tree"
    />
        <field name="arch" type="xml">
            <field name="media_id" position="after">
                <field name="url" widget="url" />
                <field name="lang" />
                <field name="media_type_id" />
            </field>
        </field>
    </record>

    <record model="ir.ui.view" id="product_media_relation_kanban">
        <field name="model">product.media.relation</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="url" />
                <field name="lang" />
                <field name="name" />
                <field name="attribute_value_ids" />
                <field name="media_id" invisible="1" />
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_vignette oe_semantic_html_override">
                            <a
                t-if="! read_only_mode"
                type="delete"
                style="position: absolute; right: 0; padding: 4px; diplay: inline-block"
              >X</a>
                            <div class="oe_kanban_details">
                                <h4>
                                    <a type="open">
                                         <field name="name" />
                                    </a>
                                </h4>
                                <a t-att-href="record.url.value">
                                    <field name="url" />
                                </a>
                                <p>
                                    <field name="lang" />
                                </p>
                                <p>
                                    <field name="media_type_id" />
                                </p>
                            </div>
                        </div>
                   </t>
                </templates>
            </kanban>
        </field>
    </record>
</odoo>
