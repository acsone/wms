<odoo>

    <record id="product_template_only_form_view" model="ir.ui.view">
        <field name="name">product.template.form (in alc_storage_media_product)</field>
        <field name="model">product.template</field>
        <field
      name="inherit_id"
      ref="storage_media_product.product_template_only_form_view"
    />
        <field name="priority" eval="32" />
        <field name="arch" type="xml">
            <field name="media_ids" position="attributes">
                <attribute name="mode">kanban</attribute>
                <attribute name="widget">media_handle</attribute>
            </field>
        </field>
    </record>

</odoo>
