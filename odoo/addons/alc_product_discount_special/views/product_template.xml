<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="product_template_form_view_discount_specials" model="ir.ui.view">
    <field name="model">product.template</field>
    <field name="inherit_id" ref="product.product_template_form_view" />
    <field name="arch" type="xml">
      <xpath expr="//page[@name='sales']" position="inside">
        <group name="discount_specials" string="Discount Specials">
          <div colspan="2">
          <field name="product_discount_special_ids" no_label="1">
              <tree editable="top">
                  <field name="date_start" />
                  <field name="date_end" />
              </tree>
          </field>
          </div>
        </group>
      </xpath>
    </field>
  </record>
</odoo>
