<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="product_discount_special_search_view" model="ir.ui.view">
        <field name="model">product.discount.special</field>
        <field name="arch" type="xml">
            <search>
                <field name="date_start" />
                <field name="date_end" />
                <field name="product_template_id" />
                <filter
          string="Past"
          name="past"
          domain="[('date_end','&lt;', datetime.datetime.combine(context_today(), datetime.time(0,0,0)))]"
          help="Past ads from today"
        />
                <filter
          string="Current"
          name="current"
          domain="['&amp;', ('date_start','&lt;=', datetime.datetime.combine(context_today(), datetime.time(0,0,0))), ('date_end','&gt;=', datetime.datetime.combine(context_today(), datetime.time(0,0,0)))]"
          help="Current ads"
        />
                <filter
          string="Upcoming"
          name="upcoming"
          domain="[('date_start','&gt;', datetime.datetime.combine(context_today(), datetime.time(0,0,0)))]"
          help="Upcoming ads from today"
        />
            </search>
        </field>
    </record>

    <record id="product_discount_special_tree_view" model="ir.ui.view">
        <field name="model">product.discount.special</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" widget="handle" />
                <field name="date_start" />
                <field name="date_end" />
                <field name="product_template_id" options="{'no_create':True}" />
            </tree>
        </field>
    </record>

    <record id="product_discount_special_form_view" model="ir.ui.view">
        <field name="model">product.discount.special</field>
        <field name="arch" type="xml">
            <form>
                <header>
                </header>
                <sheet>
                    <group>
                        <field name="sequence" />
                        <field name="date_start" />
                        <field name="date_end" />
                        <field name="product_template_id" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record model="ir.actions.act_window" id="product_discount_special_act_window">
        <field name="name">Discount Specials</field>
        <field name="res_model">product.discount.special</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{"search_default_upcoming":1,
            "search_default_current":1}
        </field>
        <field name="search_view_id" ref="product_discount_special_search_view" />
        <field name="view_id" ref="product_discount_special_tree_view" />
    </record>
    <record model="ir.ui.menu" id="product_discount_special_menu">
        <field name="name">Discount Specials</field>
        <field name="parent_id" ref="sale.menu_sales_config" />
        <field name="action" ref="product_discount_special_act_window" />
        <field name="sequence" eval="99" />
    </record>
</odoo>
