<odoo>
  <record model="ir.ui.view" id="alc_average_daily_sale_search_view">
    <field
      name="name"
    >alc.average.daily.sale.search (in alc_product_average_daily_sale)</field>
    <field name="model">alc.average.daily.sale</field>
    <field name="arch" type="xml">
      <search string="Search Average Daily Sale">
        <field name="product_id" />
        <field name="picking_zone_id" />
        <separator />
        <filter
          string="Can be Sold"
          name="filter_to_sell"
          domain="[('sale_ok','=',1)]"
        />
        <separator />
        <filter
          string="Normal product"
          name="normal_product"
          domain="[('is_mto_product','=',False)]"
        />
        <filter
          string="On Order"
          name="on_order"
          domain="[('is_mto_product','=',True)]"
        />
        <group expand='0' string='Group by...'>
          <filter
            string="Picking zone"
            domain="[]"
            context="{'group_by': 'picking_zone_id'}"
          />
        </group>
      </search>
    </field>
  </record>
  <record model="ir.ui.view" id="alc_average_daily_sale_tree_view">
    <field
      name="name"
    >alc.average.daily.sale.tree (in alc_product_average_daily_sale)</field>
    <field name="model">alc.average.daily.sale</field>
    <field name="arch" type="xml">
      <tree create="false" delete="false">
        <field name="product_id" />
        <field name="abc_classification_level" />
        <field name="average_qty_by_sale" />
        <field name="average_daily_sales_count" />
        <field name="average_daily_qty" />
        <field name="stddev" />
        <field name="stddev_daily" />
        <field name="safety" />
        <field name="safety_bin_min_qty" />
        <!-- field name="safety_bin_min_qty_old"/ -->
        <field name="nbr_sales" />
        <field name="date_from" />
        <field name="date_to" />
        <field name="warehouse_id" />
      </tree>
    </field>
  </record>
  <record model="ir.actions.act_window" id="alc_average_daily_sale_act_window">
    <field name="name">Average Daily Sales</field>
    <field name="res_model">alc.average.daily.sale</field>
    <field name="view_mode">tree</field>
    <field name="domain">[]</field>
    <field
      name="context"
    >{"search_default_filter_to_sell":1, "search_default_normal_product": 1}</field>
  </record>
  <record model="ir.ui.menu" id="alc_average_daily_sale_menu">
    <field name="name">Average Daily Sales</field>
    <field name="parent_id" ref="stock.menu_warehouse_report" />
    <field name="action" ref="alc_average_daily_sale_act_window" />
    <field name="sequence" eval="99" />
  </record>
</odoo>
