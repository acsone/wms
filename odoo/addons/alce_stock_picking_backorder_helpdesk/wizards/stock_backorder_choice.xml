<odoo>
  <record model="ir.ui.view" id="stock_backorder_choice_form_view">
    <field
      name="name"
    >stock.backorder.choice.form (in alce_stock_picking_backorder_helpdesk)</field>
    <field name="model">stock.backorder.choice</field>
    <field
      name="inherit_id"
      ref="stock_picking_backorder.stock_backorder_choice_view_form"
    />
    <field name="arch" type="xml">
      <field name="is_purchase_back_order_accepted" position="after">
        <field name="is_helpdesk_ticket_to_create" />
      </field>
      <group name="main" position="after">
        <group
          name="helpdesk"
          string="Helpdesk"
          attrs="{'invisible': [('is_helpdesk_ticket_to_create', '=', False)]}"
        >
          <field
            name="helpdesk_ticket_description"
            attrs="{'required': [('is_helpdesk_ticket_to_create', '=', True)]}"
          />
          <field name="helpdesk_ticket_reason_id" />
        </group>
      </group>
    </field>
  </record>
</odoo>
