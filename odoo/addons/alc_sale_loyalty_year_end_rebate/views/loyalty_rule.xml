<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.ui.view" id="loyalty_rule_form_view">
        <field name="model">loyalty.rule</field>
        <field name="inherit_id" ref="loyalty.loyalty_rule_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/group[2]/group[2]" position="attributes">
                <attribute name="attrs" operation="attrs_domain_add"
                        key="invisible" join_operator="AND">
                        [("program_type", "!=", "year_end_rebate")]
                </attribute>
            </xpath>
            <xpath expr="//sheet/group[2]/group[2]/label[@for='reward_point_amount']" position="attributes">
                <attribute name="attrs" operation="attrs_domain_add"
                        key="invisible" join_operator="AND">
                        [("program_type", "!=", "year_end_rebate")]
                </attribute>
            </xpath>
            <xpath expr="//sheet/group[2]/group[2]/div" position="attributes">
                <attribute name="attrs" operation="attrs_domain_add"
                        key="invisible" join_operator="AND">
                        [("program_type", "!=", "year_end_rebate")]
                </attribute>
            </xpath>
            <field name="reward_point_mode" position="attributes">
                <attribute name="attrs" operation="attrs_domain_add"
                        key="invisible" join_operator="AND">
                        [("program_type", "!=", "year_end_rebate")]
                </attribute>
            </field>

            <field name="reward_point_amount" position="before">
                <div class="me-2" attrs="{'invisible': [('program_type', '!=', 'year_end_rebate')]}"> min:&amp;nbsp;</div>
            </field>
            <field name="reward_point_amount" position="after">
                <div class="me-2" attrs="{'invisible': [('program_type', '!=', 'year_end_rebate')]}"> max:&amp;nbsp;</div>
                <field name="reward_point_max_amount" attrs="{'invisible': [('program_type', '!=', 'year_end_rebate')]}" digits="[42,3]"/>
            </field>

            <!-- hide product some criteria -->
            <field name="product_domain" position="attributes">
                <attribute name="attrs">{"invisible": [("program_type", "=", "year_end_rebate")]}</attribute>
            </field>
            <field name="product_category_id" position="attributes">
                <attribute name="attrs">{"invisible": [("program_type", "=", "year_end_rebate")]}</attribute>
            </field>
            <field name="product_tag_id" position="attributes">
                <attribute name="attrs">{"invisible": [("program_type", "=", "year_end_rebate")]}</attribute>
            </field>

            <!-- hide all partner criteria -->
            <field name="partner_ids" position="attributes">
                <attribute name="attrs">{"invisible": [("program_type", "=", "year_end_rebate")]}</attribute>
            </field>
            <field name="partner_domain" position="attributes">
                <attribute name="attrs">{"invisible": [("program_type", "=", "year_end_rebate")]}</attribute>
            </field>

        </field>
    </record>

     <record model="ir.ui.view" id="loyalty_rule_tree_view">
        <field name="name">loyalty.rule.tree.view</field>
        <field name="model">loyalty.rule</field>
        <field name="inherit_id" ref="alc_loyalty_info.loyalty_rule_tree_view"/>
        <field name="arch" type="xml">
            <field name="reward_point_amount" position="after">
                <field name="program_type" invisible="1"/>
                <field name="reward_point_max_amount" attrs="{'invisible': [('program_type', '!=', 'year_end_rebate')]}" digits="[42,3]"/>
            </field>
        </field>
    </record>
</odoo>
