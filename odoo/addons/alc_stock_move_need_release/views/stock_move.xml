<odoo>

    <record model="ir.ui.view" id="stock_move_form_view">
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_move_form" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='main_grp_col1']" position="inside">
                <field
          name="need_release"
          groups="alc_stock_move_need_release.group_can_see_need_release_field"
        />
            </xpath>
        </field>
    </record>

    <record id="stock_move_set_need_release_to_true" model="ir.actions.server">
        <field name="name">Set need_release to True</field>
        <field name="model_id" ref="stock.model_stock_move" />
        <field name="binding_model_id" ref="stock.model_stock_move" />
        <field
      name="groups_id"
      eval="[(4, ref('alc_stock_move_need_release.group_can_see_need_release_field'))]"
    />
        <field name="state">code</field>
        <field name="code">
for rec in records:
    if not rec.need_release and rec.state not in ('done', 'cancel') and all(m.state in ('done', 'cancel') for m in rec.move_orig_ids):
        rec.write({'need_release': True})
        </field>
    </record>

</odoo>
