#. module: alc_rma_stock_delivery_slip
#: model:ir.model.fields,help:alc_rma_stock_delivery_slip.field_rma_operation__no_csv_delivery_slip
msgid "If checked, the CSV delivery slip will not be sent for this operation."
msgstr ""
"Si coché, le bordereau de livraison CSV ne sera pas envoyé pour cette "
"opération."

#. module: alc_rma_stock_delivery_slip
#: model:ir.model.fields,help:alc_rma_stock_delivery_slip.field_rma_operation__no_entry_register_at_delivery
msgid ""
"If checked, the entry register will not be add to the delivery document."
msgstr ""
"Si coché, le registre d'entrée ne sera pas ajouté au document de livraison."

#. module: alc_rma_stock_delivery_slip
#: model:ir.model.fields,help:alc_rma_stock_delivery_slip.field_rma_operation__no_entry_register_at_reception
msgid ""
"If checked, the entry register will not be add to the reception document."
msgstr ""
"Si coché, le registre d'entrée ne sera pas ajouté au document de réception."

