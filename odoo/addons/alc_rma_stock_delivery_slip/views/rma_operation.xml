<odoo>

    <record model="ir.ui.view" id="rma_operation_form_view">
        <field name="model">rma.operation</field>
        <field name="inherit_id" ref="rma.rma_operation_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='different_return_product']" position="after">
                <field
          name="no_entry_register_at_reception"
          attrs="{'invisible': [('action_create_receipt', '=', False)]}"
        />
            </xpath>
            <xpath
        expr="//field[@name='action_create_delivery']//parent::group/following-sibling::group[1]"
        position="inside"
      >
                <field
          name="no_entry_register_at_delivery"
          attrs="{'invisible': [('action_create_delivery', '=', False)]}"
        />
                <field
          name="no_csv_delivery_slip"
          attrs="{'invisible': [('action_create_delivery', '=', False)]}"
        />
            </xpath>
        </field>
    </record>


</odoo>
