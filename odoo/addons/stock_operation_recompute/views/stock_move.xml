<?xml version="1.0" encoding="utf-8" ?>
<odoo>
<record id="view_move_picking_tree" model="ir.ui.view">
    <field name="name">stock.move.tree (in stock_operation_recompute)</field>
    <field name="model">stock.move</field>
    <field name="inherit_id" ref="stock.view_move_picking_tree" />
    <field name="arch" type="xml">
      <field name="date_expected" position="after">
        <field name="missing_packop" invisible="1" />
        <button
          name="force_recompute_pack_operation"
          type="object"
          attrs="{'invisible': ['|', ('state', 'not in', ('assigned', 'confirmed')), ('missing_packop', '=', False)]}"
          icon="fa-archive"
          help="Recompute Pack Operation"
        />
      </field>
    </field>
  </record>
</odoo>
