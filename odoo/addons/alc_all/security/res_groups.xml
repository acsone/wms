<odoo noupdate="1">
  <!-- Activate configuration options -->
  <record model="res.groups" id="base.group_user">
    <field
      name="implied_ids"
      eval="[(4, ref('stock.group_production_lot')),
                                     (4, ref('product.group_stock_packaging')),
                                     (4, ref('stock.group_tracking_lot')),
                                     (4, ref('product.group_discount_per_so_line')),
                                     (4, ref('stock.group_stock_storage_categories')),
                                     ]"
    />
  </record>
  <record model="res.groups" id="base.group_portal">
    <field name="implied_ids" eval="[(4, ref('stock.group_production_lot'))]" />
  </record>

</odoo>
