<odoo>

  <record id="stock_route_reassort" model="stock.route">
    <field name="name">Réassort</field>
    <field name="product_categ_selectable" eval="0" />
    <field name="product_selectable" eval="0" />
    <field name="packaging_selectable" eval="0" />
    <field name="warehouse_selectable" eval="1" />
    <field name="warehouse_ids" eval="[(4, ref('stock.warehouse0'))]" />
    <field name="sequence">999</field>
  </record>

  <function model="stock.route" name="write">
    <value
      model="stock.route"
      eval="obj().env.ref('stock_dropshipping.route_drop_shipping').ids"
    />
    <value eval="{'product_selectable': False, 'product_categ_selectable': False}" />
  </function>
</odoo>
