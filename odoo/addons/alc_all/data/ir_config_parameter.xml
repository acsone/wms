<odoo>

  <!-- Config Settings -->
  <!-- settings are forced since they are not supposed to be changed by the user -->
  <function
    model="ir.config_parameter"
    name="set_param"
    eval="('alc_product_supplierinfo_check.check_alcyon_constraints_on_supplierinfo', True)"
  />
  <function
    model="ir.config_parameter"
    name="set_param"
    eval="('alc_stock_location_constraint.stock_location_constraint', True)"
  />
  <function
    model="ir.config_parameter"
    name="set_param"
    eval="('alc_sale_exception_settings.sale_exception_check_enabled', True)"
  />
  <function
    model="ir.config_parameter"
    name="set_param"
    eval="('constrain_discount_pricelist', True)"
  />
  <!-- Set location reception on 'buy' rules -->
  <function model="stock.rule" name="write">
    <value
      model="stock.rule"
      eval="obj().search([('action', '=', 'buy'), ('company_id', '=', ref('base.main_company')),('route_id', '!=', ref('stock_dropshipping.route_drop_shipping'))]).ids"
    />
    <value eval="{'location_dest_id': ref('stock.stock_location_company')}" />
  </function>
  <!-- Send email for internal sale orders -->
  <function
    model="ir.config_parameter"
    name="set_param"
    eval="('sale_mail_internal.send_email', True)"
  />
  <!-- Sale exceptions -->
  <function
    model="ir.config_parameter"
    name="set_param"
    eval="('alc_sale_exception_settings.sale_exception_check_enabled', True)"
  />
  <function
    model="ir.config_parameter"
    name="set_param"
    eval="('alc_sale_exception_settings.sale_exception_non_blocking_as_exception', False)"
  />
  <function
    model="ir.config_parameter"
    name="set_param"
    eval="('stock_move_free_reservation_reassign.reassign_stock_move_after_free_reservation', True)"
  />
  <function
    model="ir.config_parameter"
    name="set_param"
    eval="('alc_sale_processing_finalizer.send_email', True)"
  />
  <function
    model="ir.config_parameter"
    name="set_param"
    eval="('stock_release_channel_process_end_time.stock_release_use_channel_end_date', True)"
  />
  <function
    model="ir.config_parameter"
    name="set_param"
    eval="('alc_report_sale.on_confirm_generate_quotation_report', True)"
  />
  <function
    model="ir.config_parameter"
    name="set_param"
    eval="('alc_report_sale.on_confirm_generate_and_send_pharmacist_report', True)"
  />
    <function
    model="ir.config_parameter"
    name="set_param"
    eval="('alc_stock_scheduler_filter.apply_filter_on_orderpoint_scheduler', True)"
  />
  <function
    model="ir.config_parameter"
    name="set_param"
    eval="('alc_stock_available_product_expiry.excludes_expired_lot_from_qty_available', True)"
  />
</odoo>
