<odoo>

  <!-- Set location reception on 'buy' rules -->
  <function model="stock.rule" name="write">
    <value
      model="stock.rule"
      eval="obj().search([('action', '=', 'buy'), ('company_id', '=', ref('base.main_company')), ('route_id', '!=', ref('stock_dropshipping.route_drop_shipping'))]).ids"
    />
    <value
      eval="{'location_dest_id': ref('alc_stock_location_data.stock_location_vlb')}"
    />
  </function>

  <!-- Set not group propagation on zone picking rules -->
  <function model="stock.rule" name="write">
    <value
      model="stock.rule"
      eval="obj().search([('action', '=', 'pull'), ('route_id', 'in', (20, 14, 13, 11, 8, 12, 10)), ('location_dest_id', '=', ref('stock.stock_location_output'))]).ids"
    />
    <value eval="{'propagate_original_group': False}" />
  </function>

  <data noupdate="1">
    <record id="stock_rule_reserve_to_stock" model="stock.rule">
      <field name="name">Reserve to stock</field>
      <field name="action">pull</field>
      <field name="picking_type_id" ref="stock_picking_type_reassort" />
      <field name="location_src_id" ref="stock_location_reserve" />
      <field name="location_dest_id" ref="stock.stock_location_stock" />
      <field name="procure_method">make_to_stock</field>
      <field name="route_id" ref="stock_route_reassort" />
      <field name="auto_create_group" eval="True" />
    </record>
  </data>
</odoo>
