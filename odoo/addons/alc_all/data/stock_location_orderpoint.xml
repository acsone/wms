<odoo>
    <data noupdate="1">

        <record id="stock_location_orderpoint_fillup" model="stock.location.orderpoint">
            <field name="name">FillUp</field>
            <field name="trigger">auto</field>
            <field name="replenish_method">fill_up</field>
            <field name="location_id" ref="stock.stock_location_stock" />
            <field name="route_id" ref="stock_route_reassort" />
            <field name="sequence">1</field>
            <field name="priority">1</field>
        </record>
        <record
      id="stock_location_orderpoint_average"
      model="stock.location.orderpoint"
    >
            <field name="name">Average Daily Sale</field>
            <field name="trigger">cron</field>
            <field name="replenish_method">average_daily_sale</field>
            <field name="location_id" ref="stock.stock_location_stock" />
            <field name="route_id" ref="stock_route_reassort" />
            <field name="sequence">2</field>
            <field name="priority">0</field>
        </record>
    </data>
    <data>
        <!-- Every orderpoint should always exclude supplier locations -->
        <function model="stock.location.orderpoint" name="write">
            <value model="stock.location.orderpoint" eval="obj().search([]).ids" />
            <value
        eval="{'stock_excluded_location_domain_char': '[(\'location_id.usage\', \'!=\', \'supplier\')]'}"
      />
        </function>
        <!-- Average orderpoints should always exclude supplier locations -->
        <function model="stock.location.orderpoint" name="write">
            <value
        model="stock.location.orderpoint"
        eval="obj().search([('replenish_method', '=', 'average_daily_sale')]).ids"
      />
            <value eval="{'use_to_compute_available_quantities': True}" />
        </function>
    </data>


</odoo>
