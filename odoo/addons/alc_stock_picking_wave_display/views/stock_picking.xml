<odoo>

    <record model="ir.ui.view" id="stock_picking_tree_operator_view">
        <field
      name="name"
    >stock.picking.tree (in alc_stock_picking_wave_display)</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="batch_id" />
                <field name="batch_state" />
            </xpath>
        </field>
    </record>
</odoo>
