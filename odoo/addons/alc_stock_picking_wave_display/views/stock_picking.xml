<odoo>

    <record model="ir.ui.view" id="view_stock_picking_wave_tree_inherit">
        <field name="name">stock.picking.wave.inherit.tree</field>
        <field name="model">stock.picking</field>
        <field
      name="inherit_id"
      ref="stock_picking_wave.view_stock_picking_wave_tree_inherit"
    />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='wave_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <record model="ir.ui.view" id="stock_picking_tree_view">
        <field
      name="name"
    >stock.picking.tree (in alc_stock_picking_wave_display)</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="specific_zetes.view_vpicktree_ro" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='zetes_state']" position="after">
                <field name="wave_id" />
                <field name="wave_state" />
            </xpath>
        </field>
    </record>

    <record model="ir.ui.view" id="stock_picking_tree_operator_view">
        <field
      name="name"
    >stock.picking.tree (in alc_stock_picking_wave_display)</field>
        <field name="model">stock.picking</field>
        <field
      name="inherit_id"
      ref="specific_zetes.view_stock_picking_operator_tree"
    />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='zetes_state']" position="after">
                <field name="wave_id" />
                <field name="wave_state" />
            </xpath>
        </field>
    </record>
</odoo>
