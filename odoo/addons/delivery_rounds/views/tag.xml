<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
  <record id="round_tag_view_tree" model="ir.ui.view">
    <field name="name">round.tag.view.tree</field>
    <field name="model">round.tag</field>
    <field name="arch" type="xml">
      <tree editable="bottom">
        <field name="name" />
        <field name="code" />
      </tree>
    </field>
  </record>
  <record id="action_round_tag" model="ir.actions.act_window">
    <field name="name">Tags</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">round.tag</field>
    <field name="view_type">form</field>
    <field name="view_mode">tree</field>
  </record>
  <menuitem
    id="menu_round_tag"
    action="action_round_tag"
    parent="menu_delivery_round_settings"
    sequence="100"
  />
</odoo>
