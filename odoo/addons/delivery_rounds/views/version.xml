<?xml version="1.0" ?>
<odoo>
  <record id="view_round_template_version_tree" model="ir.ui.view">
    <field name="name">round.template.version.tree</field>
    <field name="model">round.template.version</field>
    <field name="arch" type="xml">
      <tree>
        <field name="name" />
        <field name="is_default_version" />
      </tree>
    </field>
  </record>
  <record id="view_round_template_version_form" model="ir.ui.view">
    <field name="name">round.template.version.form</field>
    <field name="model">round.template.version</field>
    <field name="arch" type="xml">
      <form string="Versions">
        <header />
        <sheet>
        <div class="oe_button_box" name="button_box">
          <button
              name="toggle_active"
              type="object"
              class="oe_stat_button"
              icon="fa-archive"
            >
            <field
                name="active"
                widget="boolean_button"
                options='{"terminology": "archive"}'
              />
          </button>
        </div>
        <group>
          <field name="name" />
          <field name="is_default_version" />
        </group>
        <group string="Templates">
          <field name="template_ids" nolabel="1" />
        </group>
        </sheet>
      </form>
    </field>
  </record>
  <record id="action_round_template_version" model="ir.actions.act_window">
    <field name="name">Versions</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">round.template.version</field>
    <field name="view_type">form</field>
    <field name="view_mode">tree,form</field>
  </record>
  <menuitem
    action="action_round_template_version"
    id="menu_round_template_version"
    parent="menu_delivery_round_settings"
    sequence="10"
  />
</odoo>
