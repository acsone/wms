<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_order_form" model="ir.ui.view">
        <field name="name">view.order.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/form/group/group/div[field[@name='qty_delivered']]" position="after">
                <field name="product_qty_remains_to_deliver" invisible="1"/>
                <button name="%(action_cancel_remaining_wizard)d"
                        type="action"
                        icon="fa-ban"
                        colspan="2"
                        string="Cancel remaining qty"
                        style="margin-bottom: 1em;margin-top: 1em"
                        attrs="{'invisible': [('product_qty_remains_to_deliver', '=', 0)]}"/>
            </xpath>

            <xpath expr="//field[@name='order_line']/tree/field[@name='qty_delivered']" position="after">
                <field name="product_qty_remains_to_deliver" invisible="1"/>
                <button name="%(action_cancel_remaining_wizard)d" type="action" icon="fa-ban" attrs="{'invisible': [('product_qty_remains_to_deliver', '=', 0)]}"/>
            </xpath>
        </field>
    </record>
</odoo>
