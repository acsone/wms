<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record model="ir.ui.view" id="view_picking_form">
        <field name="name">view.picking.form (in stock_move_priority_manage)</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form" />
        <field name="arch" type="xml">
            <field name="is_locked" position="before">
                <field name="is_priority_editable" invisible="1" />
            </field>
            <field name="priority" position="attributes">
                <attribute
          name="attrs"
        >{'readonly': [('is_priority_editable', '=', False)]}</attribute>
                <attribute
          name="groups"
        >stock_move_manage_priority.group_stock_move_priority_manager</attribute>
            </field>
        </field>
    </record>
</odoo>
