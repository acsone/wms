<?xml version="1.0" ?>
<odoo>
  <record id="view_pack_operation_lot_add_form" model="ir.ui.view">
    <field name="name">stock.pack.operation.lot.add.form</field>
    <field name="model">stock.pack.operation.lot.add</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <field name="picking_is_completed" invisible="1" />
          <field name="product_id" invisible="1" />
          <button
            name="button_nextlot"
            type="object"
            string="Next Lot"
            class="oe_highlight"
            attrs="{'invisible': ['|', ('lot_required', '!=', True), ('picking_is_completed', '=', True)]}"
          />
          <button
            name="button_nextop"
            type="object"
            string="Next Operation"
            class="oe_highlight"
            attrs="{'invisible': [('picking_is_completed', '=', True)]}"
          />
          <button
            name="button_nextdestloc"
            type="object"
            string="Next Destination"
            class="oe_highlight"
            attrs="{'invisible': [('picking_is_completed', '=', True)]}"
          />
          <button name="button_transfer" type="object" string="Transfer" />
        </header>
        <div
          class="alert alert-warning"
          role="alert"
          attrs="{'invisible': ['|', ('is_qty_exceeded', '=', False), ('is_surplus_qty_confirmed', '=', True)]}"
        >
          You received more than the expected remaining quantity.
          Please confirm by ticking the 'Confirm received more than expected' checkbox.
        </div>
        <div
          class="alert alert-success oe_button_box"
          role="alert"
          attrs="{'invisible': [('picking_is_completed', '=', False)]}"
        >
          <p class="mt-3">
            The picking seems to be completed and is about to be validated.
          </p>
        </div>

        <sheet>
          <group name="incking_info">
            <group>
              <field name="partner_id" />
            </group>
            <group>
              <field name="origin" />
            </group>
          </group>
          <group name="operation_select">
            <field name="picking_id" invisible="1" />
<!--            We replace the tree view on move lines because the default one would send us back to the picking instead of the wizard on selecting a line (see action_open_reference)-->
            <field
              name="move_line_id"
              domain="[('picking_id','=',picking_id)]"
              options="{'no_create':1}"
              attrs="{'required': [('picking_is_completed', '=', False)]}"
              context="{'tree_view_ref':'stock.view_move_line_tree_detailed'}"
            />
            <label for="remaining_qty" />
            <span>
              <field name="remaining_qty" class="oe_inline" readonly="1" /> out of
              <field name="product_qty" class="oe_inline" readonly="1" />
              <field
                name="product_uom_id"
                class="oe_inline"
                groups="uom.group_uom"
                readonly="1"
              />
            </span>
          </group>
          <group name="operation_details">
            <group>
              <field name="lot_required" invisible="1" />
              <label for="expiration_date" string="Date d'expiration" />
              <div>
                <field
                  name="expiration_date"
                  placeholder="__/__/____"
                  attrs="{'required': [('lot_required', '=', True), ('picking_is_completed', '=', False)], 'readonly': ['|', ('move_line_id', '=', False), ('lot_required', '=', False)]}"
                  widget="date"
                />
              </div>
              <field
                name="lot_name"
                attrs="{'required': [('lot_required', '=', True), ('picking_is_completed', '=', False)], 'readonly': ['|', ('move_line_id', '=', False), ('lot_required', '=', False)]}"
              />
              <field name="qty" attrs="{'readonly': [('move_line_id', '=', False)]}" />
              <field name="is_qty_exceeded" invisible="1" />
              <field
                name="is_surplus_qty_confirmed"
                attrs="{'invisible': [('is_qty_exceeded', '=', False)], 'required': [('is_qty_exceeded', '=', True)]}"
              />
            </group>
            <group col="1">
              <label for="location_dest_id" />
              <h2>
                <field name="location_op_dest_id" />
                <field
                  name="location_dest_id"
                  domain="['|', '|', ('is_reception_wizard', '=', True), ('scrap_location', '=', True),
                           '&amp;', ('usage', '=', 'internal'), ('id', 'child_of', location_op_dest_id)]"
                  attrs="{'required': [('picking_is_completed', '=', False)]}"
                  options="{'no_create':1}"
                />
              </h2>
            </group>
          </group>
          <footer>
          </footer>
        </sheet>
      </form>
    </field>
  </record>
  <record id="action_pack_operation_lot_add" model="ir.actions.act_window">
    <field name="name">Receive</field>
    <field name="res_model">stock.pack.operation.lot.add</field>
    <field name="type">ir.actions.act_window</field>
    <field name="view_mode">form</field>
    <field name="target">current</field>
  </record>
</odoo>
