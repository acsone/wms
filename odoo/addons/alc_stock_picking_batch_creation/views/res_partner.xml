<odoo>
    <record model="ir.ui.view" id="res_partner_form_view">
        <field
      name="name"
    >res.partner.form (in alc_stock_picking_batch_creation)</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='container_row_2']" position="inside">
                <group
          string="Cluster picking parameters"
          name="cluster_picking_parameters"
        >
                    <label for="device_type_ids" />
                    <div class="o_row">
                        <field name="device_type_ids" nolabel="1">
                            <tree>
                                <field name="name" />
                                <field name="user_min_volume" string="Min V" />
                                <field name="user_max_volume" string="Max V" />
                                <field name="user_max_weight" string="Max W" />
                                <field name="nbr_bins" string="Nr bins" />
                            </tree>

                        </field>
                    </div>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
