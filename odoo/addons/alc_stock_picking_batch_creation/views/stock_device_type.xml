<odoo>

    <record model="ir.ui.view" id="stock_device_type_tree_view">
        <field
      name="name"
    >stock.device.type.tree (in alc_stock_picking_batch_creation)</field>
        <field name="model">stock.device.type</field>
        <field
      name="inherit_id"
      ref="stock_picking_batch_creation.stock_device_type_tree_view"
    />
        <field name="arch" type="xml">
            <field name="min_volume" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
            <field name="max_volume" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
            <field name="min_volume" position="after">
                <field name="min_volume_liter" />
                <field name="max_volume_liter" />
            </field>
        </field>
    </record>

    <record model="ir.ui.view" id="stock_device_type_form_view">
        <field
      name="name"
    >stock.device.type.form (in alc_stock_picking_batch_creation)</field>
        <field name="model">stock.device.type</field>
        <field
      name="inherit_id"
      ref="stock_picking_batch_creation.stock_device_type_form_view"
    />
        <field name="arch" type="xml">
            <field name="min_volume" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
            <field name="max_volume" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
            <field name="min_volume" position="after">
                <field name="min_volume_liter" />
                <field name="max_volume_liter" />
            </field>
        </field>
    </record>



</odoo>
