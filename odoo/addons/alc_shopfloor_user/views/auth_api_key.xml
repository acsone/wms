<odoo>
  <record model="ir.ui.view" id="auth_api_key_form_view">
    <field name="name">auth.api.key.form (in alc_shopfloor_user)</field>
    <field name="model">auth.api.key</field>
    <field name="inherit_id" ref="auth_api_key.auth_api_key_form_view" />
    <field name="arch" type="xml">
      <field name="user_id" position="after">
        <field name="shopfloor_user_id" />
      </field>
    </field>
  </record>
  <record model="ir.ui.view" id="auth_api_key_tree_view">
    <field name="name">auth.api.key.tree (in alc_shopfloor_user)</field>
    <field name="model">auth.api.key</field>
    <field name="inherit_id" ref="auth_api_key.auth_api_key_tree_view" />
    <field name="arch" type="xml">
      <field name="user_id" position="after">
        <field name="shopfloor_user_id" />
      </field>
    </field>
  </record>
</odoo>
