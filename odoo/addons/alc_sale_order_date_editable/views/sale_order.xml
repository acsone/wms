<odoo>

    <record model="ir.ui.view" id="sale_order_form_view">
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath
        expr="//field[@name='date_order'][@groups='base.group_no_one']"
        position="attributes"
      >
                <attribute
          name="groups"
        >alc_sale_order_date_editable.group_sale_order_date_edit</attribute>
            </xpath>
            <xpath
        expr="//label[@for='date_order'][1]//parent::div"
        position="attributes"
      >
                <attribute
          name="groups"
        >alc_sale_order_date_editable.group_sale_order_date_edit</attribute>
            </xpath>
        </field>
    </record>

</odoo>
