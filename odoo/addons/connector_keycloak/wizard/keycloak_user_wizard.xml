<odoo>
    <record id="keycloak_user_wizard_form" model="ir.ui.view">
        <field name="model">keycloak.user.wizard</field>
        <field name="arch" type="xml">
            <form string="Keycloak User">
                <group>
                    <field name="keycloak_user_id" />
                    <field name="type" />
                    <field
            name="password"
            password="True"
            attrs="{'invisible': [('type', '!=', 'password')]}"
          />
                    <field
            name="temporary"
            attrs="{'invisible': [('type', '!=', 'password')]}"
          />
                    <field
            name="action"
            attrs="{'invisible': [('type', '!=', 'action')]}"
          />
                </group>
                <footer>
                    <button
            string="Update Keycloak User"
            name="execute"
            type="object"
            class="btn-primary"
          />
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
    <record id="keycloak_user_wizard_action" model="ir.actions.act_window">
        <field name="name">Update Keycloak User</field>
        <field name="res_model">keycloak.user.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="keycloak_user_wizard_form" />
        <field name="target">new</field>
    </record>
</odoo>
