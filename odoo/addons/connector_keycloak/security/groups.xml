<odoo noupdate="1">
  <record model="res.groups" id="group_keycloak_user">
    <field name="name">Keycloak User</field>
    <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
  </record>
  <record model="res.groups" id="group_keycloak_manager">
