<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record model="ir.ui.view" id="keycloak_backend_form_view">
        <field name="model">keycloak.backend</field>
        <field name="arch" type="xml">
            <form string="Keycloak Backend">
                <sheet>
                    <label for="name" class="oe_edit_only" />
                    <h1>
                        <field name="name" class="oe_inline" />
                    </h1>
                    <group name="configuration" string="Configuration">
                        <field
              name="server_url"
              placeholder="http://localhost:8080/auth/"
            />
                        <field name="client_id" />
                        <field name="realm_name" />
                        <field name="client_secret_key" password="True" />
                        <field name="user_realm_name" />
                        <separator
              name="separator"
              string="Website realms infos"
              colspan="4"
            />
                        <p class="oe_grey" colspan="2">
                            The following fields are used to request an access token for the website.
                            This is used to authenticate the users requests from the magento
                            api based on the provided credentials. You must therefore give a specific
                            client and secret key for the realm used by the website.
                        </p>
                        <field name="realm_client_id" />
                        <field name="realm_client_secret_key" password="True" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record model="ir.ui.view" id="keycloak_backend_tree_view">
        <field name="model">keycloak.backend</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
            </tree>
        </field>
    </record>

    <record model="ir.actions.act_window" id="keycloak_backend_act_window">
        <field name="name">Keycloak Backends</field>
        <field name="res_model">keycloak.backend</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>

    <menuitem
    id="keycloak_backend_menu"
    name="Keycloak Backends"
    parent="base.menu_custom"
    action="keycloak_backend_act_window"
  />

</odoo>
