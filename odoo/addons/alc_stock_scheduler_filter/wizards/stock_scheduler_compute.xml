<odoo>

    <record model="ir.ui.view" id="stock_scheduler_compute_form_view">
        <field name="model">stock.scheduler.compute</field>
        <field name="inherit_id" ref="stock.view_procurement_compute_wizard" />
        <field name="arch" type="xml">
            <xpath expr="//form/p" position="after">
        <group>
          <field name="procure_type" />
          <field
            name="supplier_ids"
            attrs="{'invisible': [('procure_type', '!=', 'by_suppliers')]}"
            widget="many2many_tags"
            options="{'no_create':True}"
          />
        </group>
        <div attrs="{'invisible': [('procure_type', '!=', 'by_days')]}">
          <h3
          >WARNING - You will generate procurement order by days. This process can take a very long time.</h3>
          <separator string="Days to generate" />
          <table class="table table-bordered text-center table-condensed" colspan="2">
            <tr>
              <th>
                <label for="is_manage_day_1" />
              </th>
              <th>
                <label for="is_manage_day_2" />
              </th>
              <th>
                <label for="is_manage_day_3" />
              </th>
              <th>
                <label for="is_manage_day_4" />
              </th>
              <th>
                <label for="is_manage_day_5" />
              </th>
              <th>
                <label for="is_manage_day_6" />
              </th>
              <th>
                <label for="is_manage_day_7" />
              </th>
            </tr>
            <tr>
              <td>
                <field name="is_manage_day_1" nolabel="1" />
              </td>
              <td>
                <field name="is_manage_day_2" nolabel="1" />
              </td>
              <td>
                <field name="is_manage_day_3" nolabel="1" />
              </td>
              <td>
                <field name="is_manage_day_4" nolabel="1" />
              </td>
              <td>
                <field name="is_manage_day_5" nolabel="1" />
              </td>
              <td>
                <field name="is_manage_day_6" nolabel="1" />
              </td>
              <td>
                <field name="is_manage_day_7" nolabel="1" />
              </td>
            </tr>
          </table>
        </div>
      </xpath>
        </field>
    </record>

    <record id="stock.menu_procurement_compute" model="ir.ui.menu">
      <field name="groups_id" eval="[(6, 0, [])]" />
    </record>

</odoo>
