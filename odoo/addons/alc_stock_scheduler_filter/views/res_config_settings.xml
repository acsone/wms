<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <div name="operations_setting_container" position="inside">
                <div
          class="col-12 col-lg-6 o_setting_box"
          id="apply_filter_on_orderpoint_scheduler"
        >
                    <div class="o_setting_left_pane">
                        <field name="apply_filter_on_orderpoint_scheduler" />
                    </div>
                    <div class="o_setting_right_pane">
                        <label
              for="apply_filter_on_orderpoint_scheduler"
              string="Restrict the scheduler to run only on days specified on the supplier partner form"
            />
                        <div class="text-muted">
                          Enable this constraint to filter when running the scheduler to run the scheduler on specific
                            suppliers, days or configured day on the partner supplier form.
                        </div>
                    </div>
                </div>
            </div>
        </field>
    </record>
</odoo>
