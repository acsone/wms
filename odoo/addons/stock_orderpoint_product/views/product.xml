<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_template_property_form" model="ir.ui.view">
        <field name="name">view_template_property_form inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="stock.view_template_property_form" />
        <field name="arch" type="xml">
            <group name="stock_property" position="after">
                <group string="Reordering Rules">
                    <field name="orderpoint_min"/>
                    <field name="orderpoint_max"/>
                    <field name="orderpoint_qty_multiple"/>
                </group>
            </group>
        </field>
    </record>
</odoo>
