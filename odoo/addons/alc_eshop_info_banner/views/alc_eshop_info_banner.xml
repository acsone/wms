<odoo>

    <record model="ir.ui.view" id="alc_eshop_info_banner_form_view">
        <field name="name">alc.eshop.info.banner.form (in alc_eshop_info_banner)</field>
        <field name="model">alc.eshop.info.banner</field>
        <field name="arch" type="xml">
            <form>
                <header>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box" />
                    <group>
                        <field name="type" />
                        <field name="visibility" />
                        <field name="date_start" />
                        <field name="date_end" />
                        <field name="html" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record model="ir.ui.view" id="alc_eshop_info_banner_search_view">
        <field
      name="name"
    >alc.eshop.info.banner.search (in alc_eshop_info_banner)</field>
        <field name="model">alc.eshop.info.banner</field>
        <field name="arch" type="xml">
            <search>
               <filter
          string="Past"
          name="past"
          domain="[('date_end','&lt;', datetime.datetime.combine(context_today(), datetime.time(0,0,0)))]"
          help="Past banners from today"
        />
                <filter
          string="Current"
          name="current"
          domain="['&amp;', ('date_start','&lt;=', datetime.datetime.combine(context_today(), datetime.time(0,0,0))), ('date_end','&gt;=', datetime.datetime.combine(context_today(), datetime.time(0,0,0)))]"
          help="Current banners"
        />
                <filter
          string="Upcoming"
          name="upcoming"
          domain="[('date_start','&gt;', datetime.datetime.combine(context_today(), datetime.time(0,0,0)))]"
          help="Upcoming banners from today"
        />
            </search>
        </field>
    </record>

    <record model="ir.ui.view" id="alc_eshop_info_banner_tree_view">
        <field name="name">alc.eshop.info.banner.tree (in alc_eshop_info_banner)</field>
        <field name="model">alc.eshop.info.banner</field>
        <field name="arch" type="xml">
            <tree>
                <field name="type" />
                <field name="visibility" />
                <field name="date_start" />
                <field name="date_end" />
                <field name="html" />
            </tree>
        </field>
    </record>

    <record model="ir.actions.act_window" id="alc_eshop_info_banner_act_window">
        <field name="name">Eshop Info Banner</field>
        <field name="res_model">alc.eshop.info.banner</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
       <field name="context">{"search_default_upcoming":1,
            "search_default_current":1}
        </field>
    </record>

    <record model="ir.ui.menu" id="alc_eshop_info_banner_menu">
        <field name="name">Eshop Info Banner</field>
        <field name="parent_id" ref="sale.menu_sale_config" />
        <field name="action" ref="alc_eshop_info_banner_act_window" />
        <field name="sequence" eval="99" />
    </record>

</odoo>
