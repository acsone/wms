<odoo>

    <record model="ir.ui.view" id="alc_eshop_info_banner_form_view">
        <field name="name">alc.eshop.info.banner.form (in alc_eshop_info_banner)</field>
        <field name="model">alc.eshop.info.banner</field>
        <field name="inherit_id" ref="alc_eshop_temporal_info_mixin.alc_eshop_temporal_info_mixin_form_view" />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <field name="date_start" position="before">
                <field name="type" />
                <field name="visibility" />
            </field>
            <field name="date_end" position="after">
                <field name="html" />
            </field>
        </field>
    </record>

    <record model="ir.ui.view" id="alc_eshop_info_banner_search_view">
        <field
      name="name"
    >alc.eshop.info.banner.search (in alc_eshop_info_banner)</field>
        <field name="model">alc.eshop.info.banner</field>
        <field name="inherit_id" ref="alc_eshop_temporal_info_mixin.alc_eshop_temporal_info_mixin_search_view" />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='current']" position="attributes">
                <attribute name="help">"Valid today</attribute>
            </xpath>
        </field>
    </record>

    <record model="ir.ui.view" id="alc_eshop_info_banner_tree_view">
        <field name="name">alc.eshop.info.banner.tree (in alc_eshop_info_banner)</field>
        <field name="model">alc.eshop.info.banner</field>
        <field name="inherit_id" ref="alc_eshop_temporal_info_mixin.alc_eshop_temporal_info_mixin_tree_view" />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <field name="date_start" position="before">
                <field name="type" />
                <field name="visibility" />
            </field>
            <field name="date_end" position="after">
                <field name="html" />
            </field>
        </field>
    </record>

    <record model="ir.actions.act_window" id="alc_eshop_info_banner_act_window">
        <field name="name">Eshop Info Banner</field>
        <field name="res_model">alc.eshop.info.banner</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
       <field name="context">{"search_default_upcoming":1,
            "search_default_current":1}
        </field>
    </record>

    <record model="ir.ui.menu" id="alc_eshop_info_banner_menu">
        <field name="name">Eshop Info Banner</field>
        <field name="parent_id" ref="base.menu_custom" />
        <field name="action" ref="alc_eshop_info_banner_act_window" />
        <field name="sequence" eval="99" />
    </record>

</odoo>
