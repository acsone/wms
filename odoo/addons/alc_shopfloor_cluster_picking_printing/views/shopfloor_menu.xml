<odoo>

    <record model="ir.ui.view" id="shopfloor_menu_form_view">
        <field name="model">shopfloor.menu</field>
        <field
      name="inherit_id"
      ref="alc_shopfloor_product_print_label.shopfloor_menu_form_view"
    />
        <field name="arch" type="xml">
            <field name="food_label" position="after">
                <field
          name="print_on_pack_pickings"
          attrs="{'invisible': [('pack_pickings', '=', False)]}"
        />
            </field>
        </field>
    </record>


</odoo>
