<odoo>

    <record model="ir.ui.view" id="alc_placedesvetos_payment_globalization_form_view">
        <field name="name">alc.placedesvetos.payment.globalization.form (in alc_placedesvetos_payment_globalization)</field>
        <field name="model">alc.placedesvetos.payment.globalization</field>
        <field name="inherit_id" ref="alc_account_payment_globalization.alc_account_payment_globalization_form_view"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <field name="partner_id" position="attributes">
                <attribute name="readonly">1</attribute>
            </field>
            <field name="payment_mode_id" position="attributes">
                <attribute name="readonly">1</attribute>
            </field>
        </field>
    </record>

    <record model="ir.actions.act_window" id="alc_placedesvetos_payment_globalization_act_window">
        <field name="name">PlaceDesVetos Payment Globalization</field>
        <field name="res_model">alc.placedesvetos.payment.globalization</field>
        <field name="view_mode">form</field>
        <field name="context">{}</field>
        <field name="target">new</field>
    </record>


    <record model="ir.ui.menu" id="alc_placedesvetos_payment_globalization_menu">
        <field name="name">PlaceDesVetos Payment Globalization</field>
        <field name="parent_id" ref="alc_account_payment_globalization.alc_account_actions_menu"/>
        <field name="action" ref="alc_placedesvetos_payment_globalization_act_window"/>
    </record>
</odoo>
