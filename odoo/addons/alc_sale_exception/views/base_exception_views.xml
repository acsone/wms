<?xml version="1.0" ?>
<odoo>
    <record id="view_exception_rule_form" model="ir.ui.view">
        <field name="name">exception.rule.form (in alc_sale_exception)</field>
        <field name="model">exception.rule</field>
        <field name="inherit_id" ref="base_exception.view_exception_rule_form" />
        <field name="arch" type="xml">
            <field name="is_blocking" position="after">
                <field
          name="warning_text"
          attrs="{'invisible': [('is_blocking', '=', True)]}"
        />
            </field>
        </field>
    </record>
</odoo>
