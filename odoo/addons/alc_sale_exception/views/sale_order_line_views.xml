<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
  <record id="view_order_form" model="ir.ui.view">
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale_exception.view_order_form" />
    <field name="priority">100</field>
    <field name="arch" type="xml">
      <xpath
        expr="//field[@name='order_line']/tree//field[@name='price_subtotal']"
        position="after"
      >
        <field name="main_exception_id" />
      </xpath>
      <xpath expr="//field[@name='order_line']/tree" position="attributes">
        <attribute name="decoration-danger">False</attribute>
        <attribute name="decoration-warning">main_exception_id</attribute>
      </xpath>
    </field>
  </record>
</odoo>
