<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_pack_operation_lot_specific_form" model="ir.ui.view">
        <field name="name">stock.pack.operation.lots.specific.form</field>
        <field name="model">stock.pack.operation</field>
        <field name="inherit_id" ref="stock.view_pack_operation_lot_form"/>
        <field name="arch" type="xml">

            <field name="lot_name" position="before">
                <field name="is_product_expired" invisible="1"/>
                <field name="life_date" invisible="not context.get('only_create', False)" required="context.get('only_create', False)"/>
            </field>

            <xpath expr="//tree" position="attributes">
                <attribute name="decoration-danger">is_product_expired == True</attribute>
            </xpath>

        </field>
    </record>

</odoo>
