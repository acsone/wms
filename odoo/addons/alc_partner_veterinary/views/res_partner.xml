<odoo>
  <record id="view_partner_form" model="ir.ui.view">
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="alc_partner_type.view_partner_form" />
    <field name="priority">99</field>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='function']" position="after">
        <field
          name="vet_depot_number"
          attrs="{'invisible': [('partner_type', '!=', 'veterinary')], 'required': [('partner_type', '=', 'veterinary')]}"
        />
        <field
          name="vet_subscription_number"
          attrs="{'invisible': [('partner_type', 'not in', ['veterinary', 'student_like'])], 'required': [('partner_type', 'in', ['veterinary', 'student_like'])]}"
        />
      </xpath>
    </field>
  </record>
</odoo>
