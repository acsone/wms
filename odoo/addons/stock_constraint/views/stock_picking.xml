<?xml version="1.0"?>
<odoo>

    <record id="view_picking_uncancel_form" model="ir.ui.view">
        <field name="name">uncancel</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="groups_id" eval="[(4, ref('stock_constraint.group_picking_cancel'))]"/>
        <field name="arch" type="xml">
            <button name="action_cancel" position="after">
                <button name="action_uncancel" states="cancel" string="Uncancel" type="object"
                    groups="stock_constraint.group_picking_cancel"/>
            </button>
        </field>
    </record>

</odoo>
