<odoo>
  <record model="ir.ui.view" id="sale_order_form_view">
    <field
      name="name"
    >sale.order.form (in alc_sale_product_expected_receipt_date)</field>
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale_stock.view_order_form_inherit_sale_stock" />
    <field name="arch" type="xml">
      <xpath
        expr="//field[@name='order_line']/form//field[@name='analytic_tag_ids']/parent::div"
        position="after"
      >
        <field name="next_expected_date_for_receipt" />
      </xpath>
    </field>
  </record>
</odoo>
