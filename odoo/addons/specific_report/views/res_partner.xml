<?xml version="1.0" ?>
<odoo>
  <record id="view_partner_form" model="ir.ui.view">
    <field name="name">res.partner.form.round.inherit</field>
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="delivery_rounds.view_partner_form" />
    <field name="arch" type="xml">
      <xpath expr="//group[@name='delivery']" position="inside">
        <field name="is_hide_prices_deliveryslip" />
        <field name="show_deliveryslip_cnk" />
        <field name="is_hide_entry_register" />
      </xpath>
    </field>
  </record>
</odoo>
