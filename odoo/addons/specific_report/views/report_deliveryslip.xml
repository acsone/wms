        <tbody class="invoice_tbody">
          <t
            t-foreach="deliveryslip.with_context(lang=partner.lang).get_moves_by_order(is_entry_register=True)"
            t-as="grouped_lines"
          >
            <t t-set="order" t-value="grouped_lines[0]" />
            <t t-set="move_lines" t-value="grouped_lines[1][0]" />
            <t t-if="order">
              <tr>
                <td />
                <td />
                <td />
                <td />
                <td />
                <td />
                <td />
              </tr>
              <tr>
                <td colspan="7" class="sale_separator">
                  <t t-call="specific_report.deliveryslip_orderref" />
                </td>
              </tr>
              <tr>
                <td />
                <td />
                <td />
                <td />
                <td />
                <td />
                <td />
              </tr>
            </t>
            <t t-foreach="move_lines" t-as="line">
              <t t-set="order_line" t-value="line.order_line_id" />
              <t t-set="quants" t-value="line.get_lots()" />
              <t t-set="first_quant" t-value="quants and quants.pop()" />
              <tr>
                <td>
                  <span t-field="line.product_id.default_code" />
                </td>
                <td class="text-left">
                  <span t-field="line.product_id.name" />
                  <div t-if="line.serial_number"> (S/N: <span
                      t-field="line.serial_number"
                    />)</div>
                </td>
                <td class="text-center">
                  <span
                    t-if="line.product_id.picking_zone_id == line.env.ref('__setup__.picking_zone_frigo')"
                  >
                    <i class="fa fa-check" aria-hidden="true" />
                  </span>
                </td>
                <td>
                  <span t-esc="int(line.product_qty)" />
                </td>
                <td>
                  <t t-esc="first_quant and first_quant[0] or ''" />
                </td>
                <td>
                  <t t-esc="first_quant and int(first_quant[1])  or ''" />
                </td>
                <td style="white-space:nowrap">
                  <t
                    t-esc="first_quant and first_quant[2] and first_quant[2][:10] or ''"
                  />
                </td>
              </tr>
              <tr t-foreach="quants" t-as="quant">
                <td />
                <td />
                <td />
                <td />
                <td>
                  <span t-esc="quant[0]" />
                </td>
                <td>
                  <span t-esc="int(quant[1])" />
                </td>
                <td style="white-space:nowrap">
                  <span t-esc="quant[2] and quant[2][:10]" />
                </td>
              </tr>
            </t>
          </t>
          <tr>
            <td />
            <td />
            <td />
            <td />
            <td />
            <td />
            <td />
          </tr>
        </tbody>
      </table>
    </div>
  </template>
  <template id="specific_report.report_deliveryslip">
    <t t-call="report.html_container">
      <t t-set="company" t-value="res_company" />
      <t t-set="partner" t-value="deliveryslip.partner_id" />
      <t
        t-set="order"
        t-value="deliveryslip.with_context(lang=partner.lang).get_moves_by_order()[0]"
      />
      <div class="header">
        <div>
          <div class="logo">
            <img
              t-if="company.logo"
              t-att-src="'data:image/png;base64,%s' % company.logo"
              style="max-height: 70px;"
            />
          </div>
          <div class="main_title">
            <t
              t-set="order"
              t-value="deliveryslip.with_context(lang=partner.lang).get_moves_by_order()[0][0]"
            />
            <t t-if="deliveryslip.picking_type_code=='outgoing'">Delivery slip</t>
            <t t-if="deliveryslip.picking_type_code=='incoming'">Goods return note</t>
          </div>
        </div>
      </div>
      <t t-call="specific_report.report_deliveryslip_alcyon" t-lang="partner.lang" />
      <t t-call="specific_report.page_number_footer" t-lang="partner.lang" />
    </t>
  </template>
  <template id="specific_report.report_deliveryslip_entry_register">
    <t t-call="report.html_container">
      <t t-set="company" t-value="res_company" />
      <t t-set="partner" t-value="deliveryslip.partner_id" />
      <div class="header">
        <div>
          <div class="logo">
            <img
              t-if="company.logo"
              t-att-src="'data:image/png;base64,%s' % company.logo"
              style="max-height: 70px;"
            />
          </div>
          <div class="main_title">
                        Entry register
                    </div>
        </div>
      </div>
      <t
        t-call="specific_report.report_deliveryslip_entry_register_body"
        t-lang="partner.lang"
      />
      <t t-call="specific_report.page_number_footer" t-lang="partner.lang" />
    </t>
  </template>
  <template id="stock.report_deliveryslip">
    <t t-foreach="docs" t-as="deliveryslip">
      <t
        t-call="specific_report.report_deliveryslip"
        t-lang="deliveryslip.partner_id.lang"
      />
      <t
        t-set="depot_number"
        t-value="deliveryslip.partner_id.vet_depot_number or deliveryslip.partner_id.parent_id.vet_depot_number"
      />
      <t
        t-if="not deliveryslip.partner_id.is_hide_entry_register and depot_number and deliveryslip.get_entry_register_lines()"
        t-call="specific_report.report_deliveryslip_entry_register"
        t-lang="deliveryslip.partner_id.lang"
      />
    </t>
  </template>
</odoo>
