<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_saleorder_document_inherit" priority="100" inherit_id="sale.report_saleorder_document">

        <xpath expr="//h2" position="replace">
            <h2>
                <t t-if="doc.is_consignment">
                    <span>Consignment # </span>
                </t>
                <t t-else="">
                    <span t-if="doc.state not in ['draft','sent']">Order # </span>
                    <span t-if="doc.state in ['draft','sent']">Quotation # </span>
                </t>
                <span t-field="doc.name"/>
                <t t-if="doc.suite_name">
                    <span> n° </span>
                    <span t-field="doc.suite_name"/>
                </t>
            </h2>
        </xpath>

        <xpath expr="//div[@t-if='doc.user_id.name']" position="replace"/>

        <xpath expr="//div[@name='payment_term']" position="replace"/>

        <xpath expr="//div[@t-field='doc.partner_invoice_id']" position="attributes">
            <attribute name="t-options">{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;], &quot;no_marker&quot;: True}</attribute>
        </xpath>

        <xpath expr="//p[@t-if='doc.partner_invoice_id.vat']" position="after">
            <p t-if="doc.partner_invoice_id.vet_depot_number">Depot number: <span t-field="doc.partner_invoice_id.vet_depot_number"/></p>
        </xpath>

        <xpath expr="//div[@t-field='doc.partner_shipping_id']" position="attributes">
            <attribute name="t-options">{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;], &quot;no_marker&quot;: True}</attribute>
        </xpath>

        <xpath expr="//p[@t-if='doc.partner_shipping_id.vat']" position="after">
            <p t-if="doc.partner_shipping_id.vet_depot_number">Depot number: <span t-field="doc.partner_shipping_id.vet_depot_number"/></p>
        </xpath>

    </template>

    <template id="report_saleorder_document_pharmacist_supplier">
        <t t-call="report.external_layout">
            <t t-set="doc" t-value="doc.with_context({'lang':doc.partner_id.lang})" />
            <div class="page">
                <div class="oe_structure"/>

                <t t-set="pharmacist" t-value="doc._get_pharmacist(raise_errors=False)"/>
                <div class="row">
                    <div class="col-xs-6">
                        <t t-if="pharmacist">
                            <div t-raw="pharmacist"
                                t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True, "phone_icons": True}'/>
                        </t>
                        <t t-if="not pharmacist">
                          <span>No associated pharmacist</span>
                        </t>
                    </div>
                </div>

                <br/>

                <div class="row">
                    <div class="col-xs-6">
                        <div t-field="doc.partner_invoice_id"
                            t-options='{"widget": "contact", "fields": ["address", "name", "phone", "fax"], "no_marker": True, "phone_icons": True}'/>
                        <p t-if="doc.partner_invoice_id.vat">VAT: <span t-field="doc.partner_invoice_id.vat"/></p>
                    </div>
                </div>

                <h2>
                    <span >Order # </span>
                    <span t-field="doc.name"/>
                </h2>

                <div class="row mt32 mb32" id="informations">
                    <div t-if="doc.partner_id.ref" class="col-xs-3">
                        <strong>Customer:</strong>
                        <p t-field="doc.partner_id.ref"/>
                    </div>
                <!-- TODO add delivery rounds -->
                    <!--<div t-if="doc.partner_id.round_itinerary_ids" class="col-xs-3">-->
                        <!--<strong>Delivery round:</strong>-->
                        <!--<p t-esc="','.join(it.name for it in doc.partner_id.round_itinerary_ids)"/>-->
                    <!--</div>-->
                    <div t-if="doc.date_order" class="col-xs-3">
                        <strong>Date Ordered:</strong>
                        <p t-field="doc.date_order"/>
                    </div>
                </div>

                    <table class="table table-condensed">
                        <thead>
                            <tr>
                                <th>Ref</th>
                                <th>Description</th>
                                <th class="text-right">Quantity</th>
                            </tr>
                       </thead>
                       <tbody class="sale_tbody">
                              <!-- Lines with human drug product category -->
                              <t t-foreach="doc.order_lines_human_drug()" t-as="l">
                                  <tr>
                                      <td><span t-field="l.product_id.default_code"/></td>
                                      <td><span t-field="l.name"/></td>
                                      <td class="text-right">
                                          <span t-field="l.product_uom_qty"/>
                                          <span t-field="l.product_uom" groups="product.group_uom"/>
                                      </td>
                                  </tr>
                              </t>

                        </tbody>
                    </table>

                <div class="oe_structure"/>
            </div>
        </t>
    </template>


    <template id="report_saleorder_pharmacist_supplier">
        <t t-call="report.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="specific_report.report_saleorder_document_pharmacist_supplier" t-lang="doc.partner_id.lang"/>
            </t>
        </t>
    </template>

    <report
        id="report_sale_order_pharmacist_supplier"
        string="Pharmacist fax content"
        model="sale.order"
        report_type="qweb-pdf"
        file="specific_report.report_saleorder_pharmacist_supplier"
        name="specific_report.report_saleorder_pharmacist_supplier"
    />
</odoo>
