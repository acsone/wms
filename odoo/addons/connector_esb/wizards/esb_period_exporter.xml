<odoo>
  <record model="ir.ui.view" id="esb_period_exporter_form_view">
    <field name="name">esb.period.exporter.form (in connector_esb)</field>
    <field name="model">esb.period.exporter</field>
    <field name="arch" type="xml">
      <form string="Esb Period Exporter">
        <field name="state" invisible="1" />
        <group states="input">
          <field name="backend_timestamp_id" invisible="1" />
          <field name="export_from" />
          <field name="export_to" />
        </group>
        <footer states="input">
          <button name="doit" string="OK" class="btn-primary" type="object" />
          <button string="Cancel" class="btn-default" special="cancel" />
        </footer>
        <group states="result">
          <field name="result_content" filename="result_filename" readonly="1" />
          <field name="result_filename" invisible="1" />
        </group>
        <footer states="result">
          <button special="cancel" string="Close" class="btn-primary" />
        </footer>
      </form>
    </field>
  </record>
  <record model="ir.actions.act_window" id="esb_period_exporter_act_window">
    <field name="name">Esb Period Exporter</field>
    <field name="res_model">esb.period.exporter</field>
    <field name="view_mode">form</field>
    <field name="context">{}</field>
    <field name="target">new</field>
  </record>
</odoo>
