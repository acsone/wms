<odoo>

    <record model="ir.ui.view" id="stock_release_channel_form_view">
        <field name="model">stock.release.channel</field>
        <field
      name="inherit_id"
      ref="stock_release_channel.stock_release_channel_form_view"
    />
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Automatic picking settings">
                    <group>
                        <group>
                            <p
                colspan="2"
                style="color: grey; font-style: italic;"
              >Prevent automatic picking once the shipment has been started.</p>
                        <field name="auto_disallow_pick" />
                        </group>
                        <group>
                            <p
                colspan="2"
                style="color: grey; font-style: italic;"
              >Enable automatic picking once the shipment has been completed.</p>
                <field name="auto_allow_pick" class="oe_inline" no_label="1" />
                            <field
                name="auto_allow_pick_time_before_leave"
                widget="float_time"
              />

                        <field
                name="auto_allow_pick_datetime"
                attrs="{'invisible': [('auto_allow_pick', '=', False)]}"
              />

                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>



</odoo>
