<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="view_report_stock_quant_bylocation_search" model="ir.ui.view">
    <field name="name">report.stock.quant.bylocation.search</field>
    <field name="model">report.stock.quant.bylocation</field>
    <field name="arch" type="xml">
      <search>
        <field name="product_id" />
        <field name="location_id" filter_domain="[('location_id', 'child_of', self)]" />
        <field name="owner_id" groups="stock.group_tracking_owner" />
        <filter
          string="Available"
          name="available"
          domain="[('reservation_id','=',False)]"
        />
        <group expand='0' string='Group by...'>
          <filter
            string="Location"
            name="locationgroup"
            domain="[]"
            context="{'group_by': 'location_id'}"
          />
          <filter
            string="Product"
            name="productgroup"
            context="{'group_by': 'product_id'}"
          />
          <filter
            string="Owner"
            context="{'group_by': 'owner_id'}"
            groups="stock.group_tracking_owner"
          />
          <filter
            string="Company"
            domain="[]"
            context="{'group_by': 'company_id'}"
            groups="base.group_multi_company"
          />
        </group>
      </search>
    </field>
  </record>
  <record id="view_report_stock_quant_bylocation_tree" model="ir.ui.view">
    <field name="name">report.stock.quant.bylocation.tree</field>
    <field name="model">report.stock.quant.bylocation</field>
    <field name="arch" type="xml">
      <tree string="Stock by location" create="0" delete="0">
        <field name="product_id" />
        <field name="qty" />
        <field name="product_uom_id" groups="product.group_uom" />
        <field name="location_id" />
        <field name="reservation_id" widget="boolean" />
        <field name="owner_id" groups="stock.group_tracking_owner" />
        <field name="company_id" groups="base.group_multi_company" />
      </tree>
    </field>
  </record>
</odoo>
