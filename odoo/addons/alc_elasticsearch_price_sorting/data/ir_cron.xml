<odoo noupdate="1">
  <record
    forcecreate="True"
    id="alc_elasticsearch_price_sorting_refresh_prices"
    model="ir.cron"
  >
    <field name="name">Relaunch pipeline to update current price in Opensearch</field>
      <field name="model_id" ref="connector_search_engine.model_se_backend" />
      <field name="state">code</field>
      <field name="code">model.cron_execute_pipeline_set_current_price()</field>
      <field name="user_id" ref="base.user_root" />
      <field name="interval_number">1</field>
      <field name="interval_type">days</field>
      <field name="numbercall">-1</field>
      <field eval="False" name="doall" />
      <field eval="1" name="run_as_queue_job" />
      <field ref="queue_job_cron.channel_root_ir_cron" name="channel_id" />
  </record>
</odoo>
