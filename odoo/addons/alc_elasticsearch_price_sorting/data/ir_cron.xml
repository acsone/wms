<odoo noupdate="1">
  <record
    forcecreate="True"
    id="alc_elasticsearch_price_sorting_refresh_prices"
    model="ir.cron"
  >
    <field name="name">Relaunch pipeline to update current price in Opensearch</field>
    <field name="active" eval="True" />
    <field name="user_id" ref="base.user_root" />
    <field name="interval_number">1</field>
    <field name="interval_type">days</field>
    <field name="numbercall">-1</field>
    <field name="doall" eval="False" />
    <field name="model" eval="'se.backend.elasticsearch'" />
    <field name="function" eval="'cron_execute_pipeline_set_current_price'" />
    <field name="args" eval="'()'" />
    <field
      name="nextcall"
      eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 04:00:00')"
    />
    <field eval="1" name="run_as_queue_job" />
  </record>
</odoo>
