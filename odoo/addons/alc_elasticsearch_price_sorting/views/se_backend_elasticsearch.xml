<odoo>

    <record model="ir.ui.view" id="se_backend_elasticsearch_form_view">
        <field
      name="name"
    >se.backend.elasticsearch.form (in alc_elasticsearch_price_sorting)
        </field>
        <field name="model">se.backend.elasticsearch</field>
        <field
      name="inherit_id"
      ref="connector_elasticsearch.se_backend_elasticsearch_form_view"
    />
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group name="price_sorting" string="Price Sorting">
                    <group>
                        <field name="net_price_sort_script" />
                        <field name="current_price_pipeline_script" />
                    </group>
                    <group>
                        <button
              name="create_or_update_current_price_pipeline_script"
              string="Sync Pipeline Script"
              class="oe_highlight"
              type="object"
            />
                        <button
              name="create_or_update_net_price_sort_script"
              string="Sync Sort Script"
              class="oe_highlight"
              type="object"
            />
                    </group>
                </group>
            </xpath>
        </field>
    </record>


</odoo>
