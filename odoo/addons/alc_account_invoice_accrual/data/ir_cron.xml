<?xml version="1.0" encoding="UTF-8" ?>
<odoo noupdate="1">
    <record forcecreate="True" id="ir_cron_cutoff_expense" model="ir.cron">
        <field name="name">Make accrual at end of period - expense refund</field>
        <field eval="True" name="active" />
        <field name="model_id" ref="account_cutoff_base.model_account_cutoff" />
        <field name="state">code</field>
        <field name="code">model._cron_cutoff_expense_refund()</field>
        <field name="user_id" ref="base.user_root" />
        <field name="interval_number">1</field>
        <field name="interval_type">months</field>
        <field name="numbercall">-1</field>
        <field name="doall" eval="False" />
    </record>
    <record forcecreate="True" id="ir_cron_cutoff_revenue" model="ir.cron">
        <field name="name">Make accrual at end of period - revenue refund</field>
        <field eval="True" name="active" />
        <field name="model_id" ref="account_cutoff_base.model_account_cutoff" />
        <field name="state">code</field>
        <field name="code">model._cron_cutoff_revenue_refund()</field>
        <field name="user_id" ref="base.user_root" />
        <field name="interval_number">1</field>
        <field name="interval_type">months</field>
        <field name="numbercall">-1</field>
        <field name="doall" eval="False" />
    </record>
</odoo>
