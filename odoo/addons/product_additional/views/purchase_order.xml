<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="purchase_order_form" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']" position="before">
                <button name="button_compute_additional_products" string="Compute additional products" type="object" class="oe_highlight" attrs="{'invisible': [('state', 'not in', ('draft', 'sent'))]}" confirm="This action will erase all existing additional lines"/>
            </xpath>

            <xpath expr="//field[@name='order_line']/tree" position="inside">
                <field name="is_additional_product" invisible="1"/>
            </xpath>

            <xpath expr="//field[@name='order_line']/tree" position="attributes">
                <attribute name="decoration-success">is_additional_product</attribute>
            </xpath>
        </field>
    </record>
</odoo>
