<odoo>

    <record model="ir.ui.view" id="product_state_form_view">
        <field name="name">product.state.form (in alc_product_state)</field>
        <field name="model">product.state</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="name" />
                    <field name="sequence" />
                </group>
            </form>
        </field>
    </record>


    <record model="ir.ui.view" id="product_state_tree_view">
        <field name="name">product.state.tree (in alc_product_state)</field>
        <field name="model">product.state</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="sequence" />
            </tree>
        </field>
    </record>

    <record model="ir.actions.act_window" id="product_state_act_window">
        <field name="name">Product state</field> <!-- TODO -->
        <field name="res_model">product.state</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>

    <record model="ir.ui.menu" id="product_state_menu">
        <field name="name">Product state</field>
        <field name="parent_id" ref="sale.prod_config_main" /> <!-- TODO -->
        <field name="action" ref="product_state_act_window" />
        <field name="sequence" eval="2" /> <!-- TODO -->
    </record>

</odoo>
