<odoo>
  <record model="ir.ui.view" id="sale_order_form_view">
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale_stock.view_order_form_inherit_sale_stock_qty" />
    <field name="arch" type="xml">
      <xpath
        expr="//field[@name='order_line']/tree//field[@name='display_qty_widget']"
        position="after"
      >
        <field
          name="forecast_expected_date"
          string="Expected Receipt Date"
          attrs="{'column_invisible':[('parent.state', '!=', 'done')]}"
        />
      </xpath>
    </field>
  </record>
</odoo>
