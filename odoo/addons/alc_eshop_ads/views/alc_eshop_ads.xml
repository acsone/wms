<odoo>

    <record model="ir.ui.view" id="alc_eshop_ads_form_view">
        <field name="name">alc.eshop.ads.form (in alc_eshop_ads)</field>
        <field name="model">alc.eshop.ads</field>
        <field name="arch" type="xml">
            <form>
                <header>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <field name="is_published" invisible="1" />
                        <button
              name="action_toggle_is_published"
              attrs="{'invisible': [('is_published', '=', False)]}"
              class="oe_stat_button"
              type="object"
              icon="fa-globe"
            >
                            <div class="o_stat_info o_field_widget">
                                <span class="text-success">Published</span>
                            </div>
                        </button>
                        <button
              name="action_toggle_is_published"
              attrs="{'invisible': [('is_published', '=', True)]}"
              class="oe_stat_button"
              type="object"
              icon="fa-eye-slash"
            >
                            <div class="o_stat_info o_field_widget">
                                <span class="text-danger">Unpublished</span>
                            </div>
                        </button>
                    </div>

                     <field name="image_medium" />
                    <div class="oe_title">
                        <label class="oe_edit_only" for="name" string="Name" />
                        <h1><field name="name" placeholder="name" /></h1>
                    </div>
                    <group>
                        <group id="access">
                            <field name="visibility" placeholder="name" />
                        </group>
                        <group>
                            <field
                name="image"
                class="oe_avatar"
                options="{'preview_image': 'image_medium', 'zoom': true}"
              />
                            <field name="file_id" />
                            <field name="site_url" />
                            <field name="lang_id" />
                        </group>
                        <group>
                            <field name="date_start" />
                            <field name="date_end" />
                            <field name="display_slot" />
                            <field name="display_time" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record model="ir.ui.view" id="alc_eshop_ads_kanban_view">
       <field name="name">alc.eshop.ads.kanban (in alc_eshop_ads)</field>
        <field name="model">alc.eshop.ads</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="id" />
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_image">
                                <img
                  t-att-src="kanban_image('alc.eshop.ads', 'image_medium', record.id.raw_value)"
                  alt="ad image"
                />
                            </div>
                            <div class="oe_kanban_details">
                                <strong>
                                    <field name="name" />
                                </strong>
                                <ul>
                                    <li>From
                                        <field name="date_start" /> to <field
                      name="date_end"
                    />
                                    </li>
                                    <li>Slot:
                                        <field name="display_slot" />
                                    </li>
                                    <li>Lang:
                                        <field name="lang_id" />
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record model="ir.ui.view" id="alc_eshop_ads_search_view">
        <field name="name">alc.eshop.ads.search (in alc_eshop_ads)</field>
        <field name="model">alc.eshop.ads</field>
        <field name="arch" type="xml">
            <search>
                <filter
          string="Past"
          name="past"
          domain="[('date_end','&lt;', datetime.datetime.combine(context_today(), datetime.time(0,0,0)))]"
          help="Past ads from today"
        />
                <filter
          string="Current"
          name="current"
          domain="['&amp;', ('date_start','&lt;=', datetime.datetime.combine(context_today(), datetime.time(0,0,0))), ('date_end','&gt;=', datetime.datetime.combine(context_today(), datetime.time(0,0,0)))]"
          help="Current ads"
        />
                <filter
          string="Upcoming"
          name="upcoming"
          domain="[('date_start','&gt;', datetime.datetime.combine(context_today(), datetime.time(0,0,0)))]"
          help="Upcoming ads from today"
        />
            </search>
        </field>
    </record>

    <record model="ir.ui.view" id="alc_eshop_ads_tree_view">
        <field name="name">alc.eshop.ads.tree (in
            alc_eshop_ads)
        </field>
        <field name="model">alc.eshop.ads</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="date_start" />
                <field name="date_end" />
                <field name="display_slot" />
                <field name="lang_id" />
            </tree>
        </field>
    </record>

    <record model="ir.ui.view" id="alc_eshop_ads_calendar_view">
        <field name="name">alc.eshop.ads.calendar (in alc_eshop_ads)</field>
        <field name="model">alc.eshop.ads</field>
        <field name="arch" type="xml">
            <calendar
        string="EShop Ads"
        date_start="date_start"
        date_stop="date_end"
        mode="month"
      >
                <field name="display_name" />
            </calendar>
        </field>
    </record>

    <record model="ir.actions.act_window" id="alc_eshop_ads_act_window">
        <field name="name">EShop Ads</field>
        <field name="res_model">alc.eshop.ads</field>
        <field name="view_mode">kanban,tree,calendar,form</field>
        <field name="domain">[]</field>
        <field name="context">{"search_default_upcoming":1,
            "search_default_current":1}
        </field>
    </record>

    <record model="ir.ui.menu" id="alc_eshop_ads_menu">
        <field name="name">EShop Ads</field>
        <field name="parent_id" ref="base.menu_custom" />
        <field name="action" ref="alc_eshop_ads_act_window" />
        <field name="sequence" eval="99" />
    </record>

</odoo>
