<odoo>

    <record model="ir.ui.view" id="alc_delivery_window_importer_form_view">
        <field name="name">alc.delivery.window.importer.form (in
            alc_partner_delivery_window_import)
        </field>
        <field name="model">alc.delivery.window.importer</field>
        <field name="arch" type="xml">
            <form string="Delivery Windows Importer">
                <div class="alert alert-warning" id="images_info" role="alert">
                    <field name="description" />
                </div>
                <group>
                    <field name="document" />
                </group>
                <footer>
                    <button
            name="doit"
            string="Import"
            class="btn-primary"
            type="object"
          />
                    <button string="Cancel" class="btn-default" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record model="ir.actions.act_window" id="alc_delivery_window_importer_act_window">
        <field name="name">Delivery Window Importer</field>
        <field name="res_model">alc.delivery.window.importer</field>
        <field name="view_mode">form</field>
        <field name="context">{}</field>
        <field name="target">new</field>
    </record>

    <record model="ir.ui.menu" id="alc_delivery_window_importer_menu">
        <field name="name">Delivery Window Importer</field>
        <field name="parent_id" ref="contacts.res_partner_menu_config" />
        <field name="action" ref="alc_delivery_window_importer_act_window" />
        <field name="sequence" eval="17" />
    </record>
</odoo>
