<odoo>

    <record model="ir.ui.view" id="rma_form_view">
        <field name="model">rma</field>
        <field name="inherit_id" ref="rma.rma_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='page_other']" position="inside">
                <group string="Preparation">
                    <field name="internal_picking_id"/>
                    <field name="internal_picking_user_id"/>
                </group>
            </xpath>
        </field>
    </record>

    <record model="ir.ui.view" id="rma_search_view">
        <field name="model">rma</field>
        <field name="inherit_id" ref="rma.rma_view_search" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="internal_picking_id"/>
                <field name="internal_picking_user_id"/>
            </xpath>
            <xpath expr="//group[@name='group_by']" position="inside">
                <filter
                    string="First Preparation User"
                    name="internal_picking_user_id"
                    context="{'group_by':'internal_picking_user_id'}"
                />
            </xpath>
        </field>
    </record>

    <record model="ir.ui.view" id="rma_tree_view">
        <field name="model">rma</field>
        <field name="inherit_id" ref="rma.rma_view_tree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="internal_picking_user_id" optional="hide"/>
            </xpath>
        </field>
    </record>

</odoo>
