<odoo>

    <record model="ir.ui.view" id="fastapi_endpoint_settings_form_view">
        <field name="model">fastapi.endpoint.settings</field>
        <field
      name="inherit_id"
      ref="alc_b2c_connector.fastapi_endpoint_settings_form_view"
    />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_mode_id']" position="after">
                <field name="discount_pricelist_id" />
            </xpath>
        </field>
    </record>



</odoo>
