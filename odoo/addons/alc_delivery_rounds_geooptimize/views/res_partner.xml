<odoo>
  <record model="ir.ui.view" id="res_partner_form_view">
    <field name="name">res.partner.form (in alc_delivery_rounds_geooptimize)</field>
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="delivery_rounds.view_partner_form" />
    <field name="arch" type="xml">
      <xpath expr="//group[@name='delivery']" position="inside">
        <field name="use_specific_delivery_duration" />
        <field
          name="specific_delivery_duration"
          attrs="{'required': [('use_specific_delivery_duration', '=', True)], 'invisible': [('use_specific_delivery_duration', '=', False)]}"
        />
      </xpath>
    </field>
  </record>
</odoo>
