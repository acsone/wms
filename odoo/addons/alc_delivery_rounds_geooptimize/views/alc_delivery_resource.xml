<odoo>

    <record model="ir.ui.view" id="alc_delivery_resource_form_view">
        <field name="name">alc.delivery.resource.form (in
            alc_delivery_rounds_geooptimize)
        </field>
        <field name="model">alc.delivery.resource</field>
        <field name="arch" type="xml">
            <form>
                <header>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="display_name" readonly="1" class="oe_inline" />
                        </h1>
                    </div>
                    <group>
                        <field name="geo_optimization_resource_id" />
                        <field name="delivery_person_id" />
                        <field
              name="use_delivery_person_coordinates_as_end"
              attrs="{'invisible': [('delivery_person_id', '=', False)]}"
            />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record model="ir.ui.view" id="alc_delivery_resource_search_view">
        <field name="name">alc.delivery.resource.search (in
            alc_delivery_rounds_geooptimize)
        </field>
        <field name="model">alc.delivery.resource</field>
        <field name="arch" type="xml">
            <search>
                <field name="geo_optimization_resource_id" />
                <field name="delivery_person_id" />
            </search>
        </field>
    </record>

    <record model="ir.ui.view" id="alc_delivery_resource_tree_view">
        <field name="name">alc.delivery.resource.tree (in
            alc_delivery_rounds_geooptimize)
        </field>
        <field name="model">alc.delivery.resource</field>
        <field name="arch" type="xml">
            <tree editable="top">
                <field name="geo_optimization_resource_id" />
                <field name="delivery_person_id" />
                <field name="use_delivery_person_coordinates_as_end" />
            </tree>
        </field>
    </record>

    <record model="ir.actions.act_window" id="alc_delivery_resource_act_window">
        <field name="name">Delivery Resource</field>
        <field name="res_model">alc.delivery.resource</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>

    <record model="ir.ui.menu" id="alc_delivery_resource_menu">
        <field name="name">Delivery Resource</field>
        <field name="parent_id" ref="delivery_rounds.menu_delivery_round_settings" />
        <field name="action" ref="alc_delivery_resource_act_window" />
        <field name="sequence" eval="80" />
    </record>

</odoo>
