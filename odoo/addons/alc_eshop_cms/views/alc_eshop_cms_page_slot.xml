<odoo>

    <record model="ir.ui.view" id="alc_eshop_cms_page_slot_tree_view">
        <field name="name">alc.eshop.cms.page.slot.tree (in alc_eshop_cms)</field>
        <field name="model">alc.eshop.cms.page.slot</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="name" />
            </tree>
        </field>
    </record>

    <record model="ir.actions.act_window" id="alc_eshop_cms_page_slot_act_window">
        <field name="name">Cms Page Slots</field>
        <field name="res_model">alc.eshop.cms.page.slot</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>

    <record model="ir.ui.menu" id="alc_eshop_cms_page_slot_menu">
        <field name="name">Cms Page Slots</field>
        <field name="parent_id" ref="alc_eshop_cms.alc_eshop_cms_menu" />
        <field name="action" ref="alc_eshop_cms_page_slot_act_window" />
        <field name="sequence" eval="26" />
    </record>
</odoo>
