<odoo>

    <record model="ir.ui.view" id="alc_eshop_cms_snippet_form_view">
        <field name="name">alc.eshop.cms.snippet.form (in alc_eshop_cms)</field>
        <field name="model">alc.eshop.cms.snippet</field>
        <field name="arch" type="xml">
            <form>
                <header>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box" />
                    <div class="oe_title">
                        <label class="oe_edit_only" for="name" string="Name" />
                        <h1>
                            <field name="name" placeholder="name" />
                        </h1>
                    </div>
                    <group colspan="4">
                        <field name="code" />
                        <field name="content" />
                        <field name="lang_ids" widget="many2many_checkboxes" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>


    <record model="ir.ui.view" id="alc_eshop_cms_snippet_tree_view">
        <field name="name">alc.eshop.cms.snippet.tree (in alc_eshop_cms)</field>
        <field name="model">alc.eshop.cms.snippet</field>
        <field name="arch" type="xml">
            <tree>
                <field name="code" />
                <field name="name" />
                <field name="lang_ids" widget="many2many_tags" />
            </tree>
        </field>
    </record>

    <record model="ir.actions.act_window" id="alc_eshop_cms_snippet_act_window">
        <field name="name">Eshop Snippet</field>
        <field name="res_model">alc.eshop.cms.snippet</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>

    <record model="ir.ui.menu" id="alc_eshop_cms_snippet_menu">
        <field name="name">Eshop Snippet</field>
        <field name="parent_id" ref="alc_eshop_cms.alc_eshop_cms_menu" />
        <field name="action" ref="alc_eshop_cms_snippet_act_window" />
        <field name="sequence" eval="26" />
    </record>

</odoo>
