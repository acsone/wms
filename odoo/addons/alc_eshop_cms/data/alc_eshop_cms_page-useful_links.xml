<odoo noupdate="1">

    <record model="alc.eshop.cms.page" id="alc_eshop_cms_page_legal-organisations">
        <field name="name">Legal organisations</field>
        <field name="sequence">40</field>
        <field name="published" eval="1" />
        <field name="cms_page_group_id" ref="alc_eshop_cms_page_group_useful-links" />
        <field
      name="cms_page_slot_ids"
      eval="[(4, ref('alc_eshop_cms.alc_eshop_cms_page_slot_footer'))]"
    />
        <field
      name="lang_ids"
      eval="[(4, ref('base.lang_en')), (4, ref('base.lang_fr_BE')), (4, ref('base.lang_nl_BE'))]"
    />
        <field
      name="content"
    ><![CDATA[
<h1>Useful links</h1>
<h2>Legal organisations</h2>
<p><a href="https://www.famhp.be/en"> FAMHP: Federal Agency for Medecines and Health Products </a></p>
<p><a href="https://www.fasfc.be/"> FASFC : Federal Agency for the Safety of the Food Chain </a></p>
]]></field>
    </record>

    <record model="alc.eshop.cms.page" id="alc_eshop_cms_page_veterinary-organisations">
        <field name="name">Veterinary organisations</field>
        <field name="sequence">41</field>
        <field name="published" eval="1" />
        <field name="cms_page_group_id" ref="alc_eshop_cms_page_group_useful-links" />
        <field
      name="cms_page_slot_ids"
      eval="[(4, ref('alc_eshop_cms.alc_eshop_cms_page_slot_footer'))]"
    />
        <field
      name="lang_ids"
      eval="[(4, ref('base.lang_en')), (4, ref('base.lang_fr_BE')), (4, ref('base.lang_nl_BE'))]"
    />
        <field
      name="content"
    ><![CDATA[
<h1>Useful links</h1>
<h2>Veterinary organisations</h2>
<p><a href="https://www.ordre-veterinaires.be/"> College of Veterinarians </a></p>
<p><a href="https://upv.be/"> UPV </a></p>
]]></field>
    </record>

</odoo>
