<odoo>
    <record id="view_account_journal_form" model="ir.ui.view">
        <field
      name="name"
    >account.journal.form (in alc_account_move_maturity_date)</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form" />
        <field name="arch" type="xml">
            <xpath
        expr="//field[@name='sale_activity_type_id']/parent::group"
        position="after"
      >
                <group string="Maturity Date" name="alc_maturity_date">
                    <field name="use_move_date_as_date_maturity" />
                </group>
            </xpath>
        </field>
    </record>
</odoo>
