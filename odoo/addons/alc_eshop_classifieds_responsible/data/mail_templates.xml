<odoo noupdate="1">
    <record id="submit_mail_template" model="mail.template">
            <field name="name">New Classified ad</field>
            <field
      name="email_from"
    >{{(object.partner_id.email and '%s &lt;%s&gt;' % (object.partner_id.name, object.partner_id.email) or '')}}</field>
            <field
      name="subject"
    >Une nouvelle petite annonce vient d'être soumise: {{object.name}}</field>
            <field name="email_to">{{object.user_id.email}}</field>
            <field name="model_id" ref="alc_eshop_classifieds.model_alc_classified" />
            <field name="auto_delete" eval="True" />
            <field name="lang">{{object.partner_id.lang}}</field>
            <field
      name="body_html"
    ><![CDATA[
<p>Bonjour,</p>
<p>{{object.partner_id.name}} vient de soumettre une annonce pour publication.</p>
<p>Merci de faire le nécessaire.</p>
]]></field>
        </record>
</odoo>
