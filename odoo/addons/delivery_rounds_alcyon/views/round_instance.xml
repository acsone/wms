<?xml version="1.0" ?>
<odoo>
  <record id="view_round_instance_kanban" model="ir.ui.view">
    <field name="name">count alcyon</field>
    <field name="model">round.instance</field>
    <field name="inherit_id" ref="delivery_rounds.view_round_instance_kanban" />
    <field name="arch" type="xml">
      <xpath expr="//templates" position="before">
        <field name="count_picking_available_total_ali" />
        <field name="count_picking_available_total_med" />
        <field name="count_picking_available_total_mat" />
        <field name="count_picking_available_total_frigo" />
        <field name="count_picking_available_total_pharm" />
      </xpath>
      <xpath expr="//button/field[@name='count_picking_done_total']" position="after">
        <button
          class="btn btn-picking"
          name="action_picking_tree_available"
          type="object"
          id="action_picking_tree_available_ali"
        >
          <div id="master-ali">
            <div id="progress-bar-ali">
              <field
                name="count_picking_done_total_ali"
                widget="progress"
                title="Aliments"
                options="{'current_value': 'count_picking_done_total_ali', 'max_value': 'count_picking_available_total_ali'}"
              />
            </div>
          </div>
        </button>
        <button
          class="btn btn-picking"
          name="action_picking_tree_available"
          type="object"
        >
          <div id="master-med">
            <div id="progress-bar-med">
              <field
                name="count_picking_done_total_med"
                widget="progress"
                title="Médicaments"
                options="{'current_value': 'count_picking_done_total_med', 'max_value': 'count_picking_available_total_med'}"
              />
            </div>
          </div>
        </button>
        <button
          class="btn btn-picking"
          name="action_picking_tree_available"
          type="object"
        >
          <div id="master-frigo">
            <div id="progress-bar-frigo">
              <field
                name="count_picking_done_total_frigo"
                widget="progress"
                title="Frigo"
                options="{'current_value': 'count_picking_done_total_frigo', 'max_value': 'count_picking_available_total_frigo'}"
              />
            </div>
          </div>
        </button>
        <button
          class="btn btn-picking"
          name="action_picking_tree_available"
          type="object"
        >
          <div id="master-mat">
            <div id="progress-bar-mat">
              <field
                name="count_picking_done_total_mat"
                widget="progress"
                title="Matériel"
                options="{'current_value': 'count_picking_done_total_mat', 'max_value': 'count_picking_available_total_mat'}"
              />
            </div>
          </div>
        </button>
        <button
          class="btn btn-picking"
          name="action_picking_tree_available"
          type="object"
        >
          <div id="master-pharm">
            <div id="progress-bar-pharm">
                <field
                name="count_picking_done_total_pharm"
                widget="progress"
                title="Zone M"
                options="{'current_value': 'count_picking_done_total_pharm', 'max_value': 'count_picking_available_total_pharm'}"
              />
            </div>
          </div>
        </button>
      </xpath>
    </field>
  </record>
</odoo>
