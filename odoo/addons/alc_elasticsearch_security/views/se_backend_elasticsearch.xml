<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record model="ir.ui.view" id="se_backend_elasticsearch_form_view">
        <field name="name">se.backend.elasticsearch.security</field>
        <field name="model">se.backend.elasticsearch</field>
        <field
      name="inherit_id"
      ref="elasticsearch_security.se_backend_elasticsearch_form_view"
    />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='security']//button" position="before">
                    <button
          name="create_pricelist_roles"
          string="Create Pricelist Roles"
          class="oe_highlight"
          type="object"
        />
            </xpath>
        </field>
    </record>

</odoo>
