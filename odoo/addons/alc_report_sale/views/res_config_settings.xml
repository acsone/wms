<odoo>

    <record model="ir.ui.view" id="res_config_settings_form_view">
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@id='proforma_configuration']" position="after">
                <div
          class="col-xs-12 col-md-6 o_setting_box"
          id="on_confirm_generate_quotation_report"
        >
            <div class="o_setting_left_pane">
              <field name="on_confirm_generate_quotation_report" />
            </div>
            <div class="o_setting_right_pane">
              <label for="on_confirm_generate_quotation_report" />
              <div class="text-muted">
                Generate and save quotation on confirmation.
              </div>
            </div>
          </div>
              <div
          class="col-xs-12 col-md-6 o_setting_box"
          id="on_confirm_generate_and_send_pharmacist_report"
        >
            <div class="o_setting_left_pane">
              <field name="on_confirm_generate_and_send_pharmacist_report" />
            </div>
            <div class="o_setting_right_pane">
              <label for="on_confirm_generate_and_send_pharmacist_report" />
              <div class="text-muted">
                Generate and send order to pharmacist on confirm if SO contains products from drugstore.
              </div>
            </div>
          </div>
            </xpath>
        </field>
    </record>

</odoo>
