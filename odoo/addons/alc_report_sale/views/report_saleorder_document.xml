<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <template
    id="report_saleorder_document_inherit"
    priority="100"
    inherit_id="sale_triple_discount.report_saleorder_document_triple_discount"
  >
    <xpath expr="//h2" position="before">
            <div class="row">
                <div class="col-6">
                    <strong
            t-if="doc.partner_shipping_id == doc.partner_invoice_id"
          >Invoicing and shipping address:</strong>
                    <strong
            t-if="doc.partner_shipping_id != doc.partner_invoice_id"
          >Invoicing address:</strong>
                    <div
            t-field="doc.partner_invoice_id"
            t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}'
          />
                    <p t-if="doc.partner_invoice_id.vat">VAT: <span
              t-field="doc.partner_invoice_id.vat"
            /></p>
                    <p
            t-if="doc.partner_invoice_id.vet_depot_number"
          >Depot number: <span t-field="doc.partner_invoice_id.vet_depot_number" /></p>
                    <div
            t-if="doc.partner_shipping_id != doc.partner_invoice_id"
            class="mt8"
          >
                        <strong>Shipping address:</strong>
                        <div
              t-field="doc.partner_shipping_id"
              t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}'
            />
                        <p t-if="doc.partner_shipping_id.vat">VAT: <span
                t-field="doc.partner_shipping_id.vat"
              /></p>
                        <p
              t-if="doc.partner_shipping_id.vet_depot_number"
            >Depot number: <span
                t-field="doc.partner_shipping_id.vet_depot_number"
              /></p>
                    </div>
                </div>
                <div class="col-5 col-offset-1">
                    <div
            t-field="doc.partner_id"
            t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}'
          />
                </div>
            </div>
      <div t-if="not (env.context.get('proforma', False) or is_pro_forma)">
          <span
          style="font-weight:bold;text-decoration:underline;font-size:18px;"
        ><center>DON'T FORGET TO BRING BACK COOLPACK IF ANY</center></span>
      </div>
    </xpath>
    <xpath expr="//h2" position="replace">
      <h2>
        <t t-if="doc.is_consignment">
          <span>Consignment # </span>
        </t>
        <t t-else="">
          <span
            t-if="env.context.get('proforma', False) or is_pro_forma"
          >Pro-Forma Invoice # </span>
          <span t-elif="doc.state not in ['draft','sent']">Order # </span>
          <span t-else="doc.state in ['draft','sent']">Quotation # </span>
        </t>
        <span t-field="doc.name" />
        <t t-if="doc.suite_name">
          <span> n° </span>
          <span t-field="doc.suite_name" />
        </t>
      </h2>
    </xpath>
    <xpath expr="//div[@t-if='doc.user_id.name']" position="replace" />
    <xpath expr="//div[@name='so_total_summary']" position="after">
        <div id="subtotal_wwo_discount">
          <div
          t-attf-class="#{'col-6' if report_type != 'html' else 'col-sm-7 col-md-6'} ms-auto"
        >
            <table class="table table-sm table-borderless">
              <tr>
                <td class="border-black o_subtotal">
                  <strong>Subtotal without discount</strong>
                </td>
                <td class="text-end">
                    <span
                  t-field="doc.price_total_no_discount"
                  t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: doc.pricelist_id.currency_id}"
                />
                </td>
              </tr>
              <tr>
                <td class="border-black o_subtotal">
                  <strong>Discount subtotal</strong>
                </td>
                <td class="text-end">
                    <span
                  t-field="doc.discount_total"
                  t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: doc.pricelist_id.currency_id}"
                />
                </td>
              </tr>
            </table>
          </div>
        </div>
    </xpath>

    <xpath expr="//th[@t-if='display_discount2']" position="replace" />
    <xpath expr="//th[@t-if='display_discount3']" position="replace" />
    <xpath expr="//td[@t-if='display_discount2']" position="replace" />
    <xpath expr="//td[@t-if='display_discount3']" position="replace" />
  </template>
  <template id="report_saleorder_document_pharmacist_supplier">
    <t t-call="web.external_layout">
      <t t-set="doc" t-value="doc.with_context({'lang':doc.partner_id.lang})" />
      <div class="page">
        <div class="oe_structure" />
        <t t-set="pharmacist" t-value="doc._get_pharmacist(raise_errors=False)" />
        <div class="row">
          <div class="col-6">
            <t t-if="pharmacist">
              <div
                t-out="pharmacist"
                t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;], &quot;no_marker&quot;: True, &quot;phone_icons&quot;: True}"
              />
            </t>
            <t t-if="not pharmacist">
              <span>No associated pharmacist</span>
            </t>
          </div>
        </div>
        <br />
        <div class="row">
          <div class="col-6">
            <div
              t-field="doc.partner_invoice_id"
              t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;, &quot;phone&quot;, &quot;fax&quot;], &quot;no_marker&quot;: True, &quot;phone_icons&quot;: True}"
            />
            <p t-if="doc.partner_invoice_id.vat">VAT: <span
                t-field="doc.partner_invoice_id.vat"
              /></p>
          </div>
        </div>
        <h2>
          <span>Order # </span>
          <span t-field="doc.name" />
        </h2>
        <div class="row mt32 mb32" id="informations">
          <div t-if="doc.partner_id.ref" class="col-3">
            <strong>Customer:</strong>
            <p t-field="doc.partner_id.ref" />
          </div>
          <!-- TODO add delivery rounds -->
          <!--<div t-if="doc.partner_id.round_itinerary_ids" class="col-xs-3">-->
          <!--<strong>Delivery round:</strong>-->
          <!--<p t-esc="','.join(it.name for it in doc.partner_id.round_itinerary_ids)"/>-->
          <!--</div>-->
          <div t-if="doc.date_order" class="col-3">
            <strong>Date Ordered:</strong>
            <p t-field="doc.date_order" />
          </div>
          <div t-if="doc.client_order_ref">
            <strong>Customer Reference:</strong>
            <p t-field="doc.client_order_ref" />
          </div>
        </div>
        <table class="table table-condensed">
          <thead>
            <tr>
              <th>Ref</th>
              <th>Description</th>
              <th class="text-right">Quantity</th>
            </tr>
          </thead>
          <tbody class="sale_tbody">
            <!-- Lines with human drug product category -->
            <t t-foreach="doc.order_lines_human_drug()" t-as="l">
              <tr>
                <td>
                  <span t-field="l.product_id.default_code" />
                </td>
                <td>
                  <span t-field="l.name" />
                </td>
                <td class="text-right">
                  <span t-field="l.product_uom_qty" />
                  <span t-field="l.product_uom" groups="product.group_uom" />
                </td>
              </tr>
            </t>
          </tbody>
        </table>
        <div class="oe_structure" />
      </div>
    </t>
  </template>
  <template id="report_saleorder_pharmacist_supplier">
    <t t-call="web.html_container">
      <t t-foreach="docs" t-as="doc">
        <t
          t-call="alc_report_sale.report_saleorder_document_pharmacist_supplier"
          t-lang="doc.partner_id.lang"
        />
      </t>
    </t>
  </template>
  <record id="report_sale_order_pharmacist_supplier" model="ir.actions.report">
    <field name="name">Pharmacist fax content</field>
    <field name="model">sale.order</field>
    <field name="report_type">qweb-pdf</field>
    <field
      name="report_file"
    >alc_report_sale.report_saleorder_pharmacist_supplier</field>
    <field
      name="report_name"
    >alc_report_sale.report_saleorder_pharmacist_supplier</field>
  </record>
</odoo>
