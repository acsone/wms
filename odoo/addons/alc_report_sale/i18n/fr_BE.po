#. module: alc_report_sale
#: model:mail.template,body_html:alc_report_sale.email_template_pharmacist_supplier_order
msgid ""
"<p>Hello,</p>\n"
"        <p>\n"
"            We have received this order that is subjected to you.<br>\n"
"            We transfer it to you and wait for your packages to deliver them "
"to the customer.\n"
"        </p>\n"
"\n"
"        <p>Please find here attached the order.</p>\n"
"        <p>We wish you good reception.</p>\n"
"        <p>Sincerely,</p>\n"
"        <p>Your Team Alcyon</p>\n"
"    "
msgstr ""
"<p>Bonjour,</p>\n"
"        <p>\n"
"            Nous avons reçu la commande reprise ci-dessous qui vous est "
"destinée.<br>\n"
"            Nous vous la transférons et attendons vos colis pour la "
"livraison au client.\n"
"        </p>\n"
"\n"
"        <p>Vous trouverez ci-joint la note d’envoi électronique de votre "
"livraison.</p>\n"
"        <p>Nous vous en souhaitons bonne réception.</p>\n"
"        <p>Cordialement,</p>\n"
"        <p>Votre équipe Alcyon</p>\n"
"    "

