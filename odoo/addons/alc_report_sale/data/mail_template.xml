<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
  <record id="email_template_pharmacist_supplier_order" model="mail.template">
    <field name="name">Pharmacist order - Send by Email</field>
    <field name="email_from">{{user.company_id.partner_id.email}}</field>
    <field name="subject">Alcyon Medicine order {{object.name}}</field>
    <field name="model_id" ref="sale.model_sale_order" />
    <field
      name="report_template"
      ref="alc_report_sale.report_sale_order_pharmacist_supplier"
    />
    <field
      name="report_name"
    >{{(object.name or '').replace('/','_')}}{{object.state == 'draft' and '_draft' or ''}}</field>
    <field name="lang">fr_BE</field>
    <field name="body_html" type="html">
        <p>Hello,</p>
        <p>
            We have received this order that is subjected to you.<br />
            We transfer it to you and wait for your packages to deliver them to the customer.
        </p>

        <p>Please find here attached the order.</p>
        <p>We wish you good reception.</p>
        <p>Sincerely,</p>
        <p>Your Team Alcyon</p>
    </field>
  </record>
</odoo>
