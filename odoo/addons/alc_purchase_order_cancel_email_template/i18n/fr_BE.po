#. module: alc_purchase_order_cancel_email_template
#: model:mail.template,body_html:alc_purchase_order_cancel_email_template.cancel_purchase_order
msgid ""
"\n"
"            \n"
"                <p>Hello,</p>\n"
"                <p>We decided to cancel the purchase order ${object.partner_ref or ''} (${object.amount_total} €) from ${object.date_order} for the following reason:<br/>\n"
"                ${object.cancel_reason_id.name}</p>\n"
"                <p>Thank you for your understanding.</p>\n"
"                <p>Best regards,<br/>\n"
"                Alcyon</p>\n"
"            \n"
"        "
msgstr ""
"\n"
"            \n"
"                <p>Bonjour,</p>\n"
"                <p>Nous avons décidé d'annuler la commande ${object.partner_ref or ''} (${object.amount_total} €) du ${object.date_order} pour la cause suivante:<br/>\n"
"                ${object.cancel_reason_id.name}</p>\n"
"                <p>Nous vous remercions de votre compréhension.</p>\n"
"                <p>Bien à vous,<br/>\n"
"                Alcyon</p>\n"
"            \n"
"        "

#. module: alc_purchase_order_cancel_email_template
#: model:mail.template,name:alc_purchase_order_cancel_email_template.cancel_purchase_order
msgid "Cancel purchase order"
msgstr "Achat : Annulation de commande"

#. module: alc_purchase_order_cancel_email_template
#: model:mail.template,subject:alc_purchase_order_cancel_email_template.cancel_purchase_order
msgid "Purchase order ${object.partner_ref or ''} canceled"
msgstr "Bon de commande ${object.partner_ref or ''} annulé"

#. module: alc_purchase_order_cancel_email_template
#: model:mail.template,description:alc_purchase_order_cancel_email_template.cancel_purchase_order
msgid "Sent manually to cancel a purchase"
msgstr "Envoyé manuellement pour annuler un achat"
