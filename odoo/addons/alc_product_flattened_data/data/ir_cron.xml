<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">

  <record
    forcecreate="True"
    id="alc_product_flattened_datas_refresh_materialized_view"
    model="ir.cron"
  >
    <field name="name">Refresh Flattened Product Data materialized view</field>
        <field name="model_id" ref="model_alc_product_flattened_data" />
        <field name="state">code</field>
        <field name="code">model.refresh_view()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="doall" eval="False" />
        <field name="active" eval="True" />
        <field name="user_id" ref="base.user_root" />
        <field eval="1" name="run_as_queue_job" />
        <field
      name="nextcall"
      eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 04:00:00')"
    />
    </record>
</odoo>
