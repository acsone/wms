<odoo>


    <record id="sale_order_form_view" model="ir.ui.view">
        <field name="name">sale.order.form (in alc_sales_cancel_cron)</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="specific_sale.view_order_form"/>
        <field name="arch" type="xml">
            <field name="suite_name" position="after">
                <field name="auto_finalize_processing"/>
            </field>

        </field>
    </record>
    <record model="ir.ui.view" id="sale_order_search_view">
        <field name="name">sale.order.search (in alc_sales_cancel_cron)</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <field name="product_id" position="after">
                <field name="auto_finalize_processing"/>
            </field>
        </field>
    </record>
</odoo>
