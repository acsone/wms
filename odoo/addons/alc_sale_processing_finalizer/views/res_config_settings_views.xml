<odoo>

    <record model="ir.ui.view" id="res_config_settings_form_view">
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@id='proforma_configuration']" position="after">
                <div
          class="col-xs-12 col-md-6 o_setting_box"
          id="send_processing_finalizer_email"
        >
            <div class="o_setting_left_pane">
              <field name="send_processing_finalizer_email" />
            </div>
            <div class="o_setting_right_pane">
              <label for="send_processing_finalizer_email" />
              <div class="text-muted">
                Send an email for auto-finalized BO older than 3 months.
              </div>
            </div>
          </div>
            </xpath>
        </field>
    </record>

</odoo>
