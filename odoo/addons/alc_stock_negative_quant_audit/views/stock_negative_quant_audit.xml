<odoo>

    <record model="ir.ui.view" id="stock_negative_quant_audit_form_view">
        <field
      name="name"
    >stock.negative.quant.audit.form (in alc_stock_negative_quant_audit)</field>
        <field name="model">stock.negative.quant.audit</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="product_id" />
                        <field name="quant_id" />
                        <field name="create_date" />
                        <field name="user_id" />
                        <field name="stacktrace" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record model="ir.ui.view" id="stock_negative_quant_audit_search_view">
        <field
      name="name"
    >stock.negative.quant.audit.search (in alc_stock_negative_quant_audit)</field>
        <field name="model">stock.negative.quant.audit</field>
        <field name="arch" type="xml">
            <search>
                <field name="product_id" />
                <field name="quant_id" />
                <group expand='0' string='Group by...'>
                    <filter
            string="Product"
            domain="[]"
            context="{'group_by': 'product_id'}"
          />
                </group>
            </search>
        </field>
    </record>

    <record model="ir.ui.view" id="stock_negative_quant_audit_tree_view">
        <field
      name="name"
    >stock.negative.quant.audit.tree (in alc_stock_negative_quant_audit)</field>
        <field name="model">stock.negative.quant.audit</field>
        <field name="arch" type="xml">
            <tree>
                <field name="quant_id" />
                <field name="product_id" />
            </tree>
        </field>
    </record>

    <record model="ir.actions.act_window" id="stock_negative_quant_audit_act_window">
        <field name="name">Stock Negative Quant Audit</field>
        <field name="res_model">stock.negative.quant.audit</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>

    <record model="ir.ui.menu" id="stock_negative_quant_audit_menu">
        <field name="name">Stock Negative Quant Audit</field>
        <field name="parent_id" ref="stock.menu_warehouse_report" />
        <field name="action" ref="stock_negative_quant_audit_act_window" />
        <field name="sequence" eval="16" />
         <field name="groups_id" eval="[(6, 0, [ref('stock.group_stock_manager')])]" />
    </record>

</odoo>
