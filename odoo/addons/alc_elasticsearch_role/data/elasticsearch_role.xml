<odoo>
  <record id="role_guest" model="elasticsearch.role">
    <field name="backend_id" ref="alc_search_engine_backend.elasticsearch_backend" />
    <field name="name">guest</field>
    <field name="body">{
  "cluster_permissions": ["read"],
  "index_permissions": [
    {
      "index_patterns":["alc_shopinvader_category_*"],
      "allowed_actions": ["read"],
      "masked_fields": []
    },
    {
      "index_patterns":["alc_eshop_info_banner_*"],
      "allowed_actions": ["read"],
      "masked_fields": []
    },
    {
      "index_patterns":["alc_shopinvader_variant_*"],
      "dls": "{\"bool\": {\"must\": {\"term\": {\"allowed_partner_types\": \"guest\"}}}}",
      "fls": ["allowed_partner_types", "supplier_id", "objectID", "model", "url_key", "redirect_url_key", "main", "short_description", "description", "name.*", "name", "short_name", "seo_title", "meta_keywords", "meta_description", "variant_count", "categories", "categories.*", "sku", "variant_attributes", "images", "attributes", "attributes.*", "structured_attributes", "structured_attributes.*", "attribute_set", "hierarchicalCategories", "hierarchicalCategories.*", "barcode", "belgium_only", "cnk_code", "create_date", "vendor_product_code", "veterinary_only", "taxes_id", "not_sold_on_website", "packaging_ids", "route_from_categ_ids", "unit_in_shrink_wrap", "promo_bag", "sterile", "fabric", "link_info", "link_notice", "link_video", "description_shop_short", "description_shop_long", "class_amcra", "code_amm", "code_cti", "storage_temperature_id", "dimensional_uom_id", "manufacturer", "manufacturer.*", "specials", "specials.*", "is_meds", "is_equipment", "is_food", "is_psychotropic", "is_pharmaceutical", "is_import", "is_narcotic_vet", "is_mto", "is_human", "id", "best_before_date", "brand.*", "medias.*", "url_key_locales", "cross.*", "veterinary_groups.*"],
      "allowed_actions": ["read"],
      "masked_fields": []
    }
  ],
  "tenant_permissions": []
}
    </field>
    <field name="extra_backend_roles">opendistro_security_anonymous_backendrole</field>
  </record>
