<odoo>

    <record model="ir.ui.view" id="stock_pack_operation_lot_add_form_view">
        <field
      name="name"
    >stock.pack.operation.lot.add.form (in alc_stock_receive_display_stock_storage_type)</field>
        <field name="model">stock.pack.operation.lot.add</field>
        <field
      name="inherit_id"
      ref="alc_stock_receive_lot.view_pack_operation_lot_add_form"
    />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='operation_details']" position="after">
                <group name="stock_storage_type_info">
                    <field
            name="package_type_id"
            attrs="{'invisible': [('move_line_id', '=', False)]}"
          />
                </group>
            </xpath>
        </field>
    </record>



</odoo>
