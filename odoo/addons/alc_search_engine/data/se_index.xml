<odoo noupdate="1">

    <record id="index_config_shopinvader_category" model="se.index.config">
        <field name="name">Shopinvader Category Index config</field>
        <field name="body">{}</field>
        <field name="body_str">
            {
              "settings" : {
                "index" : {
                  "sort.field" : ["id"],
                  "sort.order" : ["asc"]
                }
              },
              "mappings": {
                "properties": {
                  "url_key": {
                    "type":  "keyword"
                  },
                  "redirect_url_key": {
                    "type":  "keyword"
                  },
                  "id": {
                    "type":  "integer"
                  }
                }
              }
            }
        </field>
    </record>

    <record id="elasticsearch_shopinvader_variant_index_fr_BE" model="se.index">
        <field name="custom_tech_name">shopinvader_variant</field>
        <field name="model_id" ref="shopinvader.model_shopinvader_variant" />
        <field name="lang_id" eval="ref('base.lang_fr_BE')" />
        <field
      name="backend_id"
      search="[('tech_name','=','elasticsearch_backend')]"
      model='se.backend'
    />
        <field name="exporter_id" ref="shopinvader.ir_exp_shopinvader_variant" />
        <field name="config_id" ref="index_config_shopinvader_variant_fr" />
    </record>

