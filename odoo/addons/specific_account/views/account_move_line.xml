<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
  <record id="view_account_move_line_filter" model="ir.ui.view">
    <field name="name">account.move.line.search</field>
    <field name="model">account.move.line</field>
    <field name="inherit_id" ref="account.view_account_move_line_filter" />
    <field name="arch" type="xml">
      <field name="journal_id" position="after">
        <separator />
        <filter
          string="Due date over 210 days"
          domain="[
          ('date_maturity', '&lt;', (context_today() + relativedelta(days=-210)).strftime('%Y-%m-%d'))]"
        />
        <filter
          string="Due date between 90 to 210 days"
          domain="[
          '&amp;',
          ('date_maturity', '&gt;=', (context_today() + relativedelta(days=-210)).strftime('%Y-%m-%d')),
          ('date_maturity', '&lt;=', (context_today() + relativedelta(days=-90)).strftime('%Y-%m-%d'))]"
        />
        <filter
          string="Due date up to 89 days"
          domain="[
          '&amp;',
          ('date_maturity', '&gt;', (context_today() + relativedelta(days=-90)).strftime('%Y-%m-%d')),
          ('date_maturity', '&lt;', context_today().strftime('%Y-%m-%d'))]"
        />
      </field>
      <xpath expr="//filter[@name='unreconciled']" position="attributes">
        <attribute name="domain">[('full_reconcile_id', '=', False),
          ('amount_residual','!=', 0), ('account_id.reconcile','=',True)]</attribute>
      </xpath>
    </field>
  </record>
  <record id="view_move_line_tree" model="ir.ui.view">
    <field name="name">account.move.line.tree</field>
    <field name="model">account.move.line</field>
    <field name="inherit_id" ref="account.view_move_line_tree" />
    <field name="arch" type="xml">
      <field name="credit" position="after">
        <field name="amount_residual" />
      </field>
    </field>
  </record>
</odoo>
