<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
  <record id="provision_on_order" model="exception.rule">
    <field name="name">Warning provision on order</field>
    <field name="description">Provision on order</field>
    <field name="active">True</field>
    <field name="sequence">30</field>
    <field name="model">sale.order.line</field>
    <field
      name="warning_text"
    >Item bought on order, neither taken back nor exchanged.</field>
    <field name="code">
failed = object.warning_provision_on_order()
            </field>
  </record>
  <!-- Other exceptions -->
  <record id="no_backorder" model="exception.rule">
    <field name="name">No backorder</field>
    <field name="description">This customer does not want backorder</field>
    <field name="active">True</field>
    <field name="sequence">20</field>
    <!--            <field name="rule_group">sale</field>-->
    <field name="model">sale.order.line</field>
    <field name="code">
failed = object.validate_no_backorder()
            </field>
    <field name="is_blocking">True</field>
  </record>
  <record id="warning_supplier_break" model="exception.rule">
    <field name="name">Out of stock at supplier level</field>
    <field name="description">Out of stock at supplier level</field>
    <field name="active">True</field>
    <field name="sequence">100</field>
    <field name="model">sale.order.line</field>
    <field name="warning_text">Out of stock at supplier level</field>
    <field name="code">
failed = object.warning_supplier_break()
            </field>
  </record>
</odoo>
