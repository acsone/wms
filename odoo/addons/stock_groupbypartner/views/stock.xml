<?xml version="1.0"?>
<odoo>

    <record id="view_picking_type_form" model="ir.ui.view">
        <field name="name">picking.type.groupbypartner</field>
        <field name="model">stock.picking.type</field>
        <field name="inherit_id" ref="stock.view_picking_type_form"/>
        <field name="arch" type="xml">
            <field name="warehouse_id" position="after">
                <field name="groupbypartner"/>
                <field name="groupbypartner_maxweight" attrs="{'invisible': [('groupbypartner','=',False)]}"/>
            </field>
        </field>
    </record>

    <record id="procurement_group_form_view_herited" model="ir.ui.view">
        <field name="name">procurement.group.view.form.inherit.picking</field>
        <field name="model">procurement.group</field>
        <field name="inherit_id" ref="procurement.procurement_group_form_view"/>
        <field name="arch" type="xml">
            <field name="move_type" position="after">
                <field name="carrier_id" context="{'active_test': False}"/>
            </field>
        </field>
    </record>

</odoo>
