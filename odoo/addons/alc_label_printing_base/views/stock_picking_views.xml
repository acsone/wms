<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="view_picking_form" model="ir.ui.view">
    <field name="name">stock.picking.form.print</field>
    <field name="model">stock.picking</field>
    <field name="inherit_id" ref="stock.view_picking_form" />
    <field name="arch" type="xml">
      <xpath
        expr="//page[@name='operations']/button[@name='action_put_in_pack']"
        position="after"
      >
        <button
          class="oe_link oe_right"
          name="%(print_label_action)d"
          type="action"
          string="&#128438;Print Packs"
          context="{'default_label_type': 'package'}"
        />
      </xpath>
    </field>
  </record>
  <template id="stock_pick_packs_label_zebra_v1">
    <div class="raw">
<t t-foreach="docs" t-as="pick">
<t t-set="packages" t-value="pick.mapped('move_line_ids.result_package_id')" />

<t
          t-set="ships"
          t-value="pick._get_all_dest_pickings().filtered(lambda r: r.picking_type_code == 'outgoing' and r.state not in ('cancel', 'done'))"
        />
<t t-set="ship" t-value="ships and ships[0]" />
<t t-foreach="packages" t-as="package">
<t t-foreach="range(package.number_of_parcels or 1)" t-as="index">
^XA

^FO30,30^GB<t
              t-esc="pick.release_channel_id.channel_code and len(pick.release_channel_id.channel_code) * 38"
            />,75,3,2^FS\r
^FO40,47^A0N60,60^FD<t t-esc="pick.release_channel_id.channel_code" />^FS\r

<t t-if="ship">
^FO200,20
^BQN,2,4
^FDQA,<t t-esc="ship.name" />^FS\r
</t>

<t t-if="('customer_id' in pick) and pick.customer_id.is_b2c_customer">
^FO340,47^A0N60,60^FDB2C^FS\r
</t>

^FO570,47,1^A0N60,60^FD<t t-esc="index + 1" /> / <t
              t-esc="package.number_of_parcels"
            />^FS\r

^FO30,140^A0N30,30^FD<t
              t-esc="res_company.convert_to_ascii(pick.partner_id.display_name and pick.partner_id.display_name[:29] or '')"
            />^FS\r
^FO30,170^A0N30,30^FD<t
              t-esc="res_company.convert_to_ascii(pick.partner_id.display_name and pick.partner_id.display_name[29:50] or '')"
            />^FS\r
^FO30,205^A0N35,30^FD<t t-esc="pick.partner_id.zip" /> <t
              t-esc="res_company.convert_to_ascii(pick.partner_id.city)"
            />^FS\r
^FO30,250^A0N30,30^FD<t
              t-esc="('customer_id' in pick) and (pick.partner_id != pick.customer_id) and res_company.convert_to_ascii(pick.customer_id.name and pick.customer_id.name[:29] or '') or ''"
            />^FS\r


^FO30,310^A0N20,25^FD<t t-esc="pick.name" /> - <t
              t-esc="pick._get_all_dest_pickings()[0].filtered(lambda r: r.picking_type_code == 'outgoing' and r.state not in ('cancel', 'done')).name"
            />^FS\r
^FO30,350^A0N45,45^FD<t t-esc="pick.checksum" />^FS\r

^FO570,310,1
^BXN,5,200
^FD<t t-esc="res_company.convert_to_ascii(package.name)" />^FS\r

^XZ
</t>
</t>
</t>
</div>
  </template>
  <record model="ir.actions.report" id="report_stock_pick_packs_label">
    <field name="name">Alcyon Pack Label</field>
    <field name="model">stock.picking</field>
    <field name="report_type">qweb-pdf</field>
    <field
      name="report_name"
    >alc_label_printing_base.stock_pick_packs_label_zebra_v1</field>
    <field
      name="report_file"
    >alc_label_printing_base.stock_pick_packs_label_zebra_v1</field>
  </record>
</odoo>
