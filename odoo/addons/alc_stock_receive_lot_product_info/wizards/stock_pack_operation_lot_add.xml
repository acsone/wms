<odoo>
  <record model="ir.ui.view" id="stock_pack_operation_lot_add_form_view">
    <field name="name">stock.pack.operation.lot.add.form (in
            alc_stock_receive_lot_product_info)
        </field>
    <field name="model">stock.pack.operation.lot.add</field>
    <field name="inherit_id" ref="stock_receive_lot.view_pack_operation_lot_add_form" />
    <field name="arch" type="xml">
      <group name="operation_details" position="after">
        <group name="lots">
          <field name="tracking" invisible="1" />
          <field
            name="lot_ids"
            attrs="{'invisible': [('tracking', '!=', 'lot')]}"
            nolabel="1"
          >
            <tree limit='5' default_order="life_date DESC">
              <field name="name" />
              <field name="qty_available" widget="integer" />
              <field name="life_date" />
            </tree>
          </field>
          <field name="stock_bin_ids" nolabel="1">
            <tree>
              <field name="sequence" widget="handle" />
              <field name="location_id" />
              <field name="bin_location_id" />
            </tree>
          </field>
        </group>
      </group>
    </field>
  </record>
</odoo>
