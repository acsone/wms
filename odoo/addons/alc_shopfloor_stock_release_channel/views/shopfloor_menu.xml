<odoo>

    <record model="ir.ui.view" id="shopfloor_menu_form_view">
        <field name="model">shopfloor.menu</field>
        <field
      name="inherit_id"
      ref="shopfloor_batch_automatic_creation.shopfloor_menu_form_view"
    />
        <field name="arch" type="xml">
            <field name="batch_create" position="after">
                  <field
          name="restrict_to_same_release_channel"
          attrs="{'invisible': [('batch_create', '=', False)]}"
        />
             </field>
        </field>
    </record>

</odoo>
