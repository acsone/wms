#. module: specific_account
#: model:ir.model.fields,help:specific_account.field_ir_sequence_use_end_date
msgid "By default Odoo will use\n"
"                                  the start date (from) to compute date\n"
"                                  with the prefix range_ (eg: range_year).\n"
"\n"
"                                  If you set this flag Odoo will use the end\n"
"                                  date (to) to compute date with\n"
"                                  the prefix range.\n"
"                                  Eg: From 1/10/2016 to 31/9/2017\n"
"                                  without the flag:\n"
"                                  %(range_year)s => 2016\n"
"                                  with the flag\n"
"                                  %(range_year)s => 2017\n"
"                                  "
msgstr "Par défault, Odoo utilise\n"
"                                  la date de départ (De) pour calculer la date\n"
"                                  avec le préfixe range_ (eg: range_year).\n"
"\n"
"                                  Si vous coché cette case, Odoo va utiliser la date de fin (A)\n"
"                                  pour calculer la date avec le préfixe range\n"
"                                  Exemple: Du 1/10/2016 au 31/9/2017\n"
"                                  sans cocher la case:\n"
"                                  %(range_year)s => 2016\n"
"                                  en cochant la case\n"
"                                  %(range_year)s => 2017\n"
"                                  "

