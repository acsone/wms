<odoo>
  <data noupdate="1">
    <record model="db2.importer" id="db2_sale_importer">
      <field name="name">Sale importer</field>
      <field name="date_start">2016-01-01</field>
      <field name="mode">history</field>
    </record>
  </data>

  <data noupdate="0">

  <!-- sale order header table -->
  <record model="db2.importer.table" id="db2_table_pentcdcl_for_sale">
    <field name="importer_id" ref="db2_sale_importer"/>
    <field name="schema">SBDATA</field>
    <field name="table_name">PENTCDCL</field>
    <field name="table_prefix">ecc</field>
    <field name="id_columns">eccsui,ecccli,eccsuc</field>
    <field name="where_clause">ecctyc &lt;&gt; 2</field>
    <field name="create_job" eval="True"/>
    <field name="eta">2</field>
  </record>

  <!-- sale order detail line table -->
  <record model="db2.importer.table" id="db2_table_pdetcdcl_for_sale">
    <field name="importer_id" ref="db2_sale_importer"/>
    <field name="schema">SBDATA</field>
    <field name="table_name">PDETCDCL</field>
    <field name="table_prefix">dcc</field>
    <field name="id_columns">dccsui,dccncl,dccsuc,dccnli</field>
  </record>

  </data>

  <data noupdate="1">
    <record model="db2.importer" id="db2_purchase_importer">
      <field name="name">Purchase importer</field>
      <field name="date_start">2016-01-01</field>
      <field name="mode">history</field>
    </record>
  </data>

  <data noupdate="0">
  <!-- purchase order header table -->
  <record model="db2.importer.table" id="db2_table_pentcdfo_for_purchase">
    <field name="importer_id" ref="db2_purchase_importer"/>
    <field name="schema">SBDATA</field>
    <field name="table_name">PENTCDFO</field>
    <field name="table_prefix">ecf</field>
    <field name="id_columns">ecfsui,ecffou,ecfsuc</field>
    <field name="create_job" eval="True"/>
    <field name="eta">2</field>
  </record>

  <!-- purchase order detail line table -->
  <record model="db2.importer.table" id="db2_table_pdetcdfo_for_purchase">
    <field name="importer_id" ref="db2_purchase_importer"/>
    <field name="schema">SBDATA</field>
    <field name="table_name">PDETCDFO</field>
    <field name="table_prefix">dcf</field>
    <field name="id_columns">dcfsui,dcffou,dcfsuc,dcfnli</field>
  </record>
  </data>

  <!-- a specific importer to import history from the following 10 clients:
    ref  | name                        | tour | activity
    354  | ADAM BERNARD                | 98   | Vétérinaires
    6891 | BOTTON & CALBERG (CINEY PA) | 42   | Vétérinaires
    7583 | EPC DEPOT                   | 85   | Epécé
    379  | ETUDIANT COMPTOIR           | 95   | Etudiants
    8657 | NEW CAROLOVET               | 98   | Vétérinaires
    8264 | NEWPHARMA                   | 98   | Pharmacies
    8585 | OLALUX                      | 6    | Exportation
    3993 | STAFFE NATHALIE             | 28   | Vétérinaires
    560  | THISSEN-HOGGE               | 72   | Vétérinaires
    600  | ULG DEP. PÔLE EQUIN         | 98   | Vétérinaires

    -->
  <data noupdate="1">
    <record model="db2.importer" id="db2_importer_10_clients">
      <field name="name">10 clients sales importer</field>
      <field name="date_start">2012-01-01</field>
      <field name="mode">final_update</field>
    </record>
  </data>

  <data noupdate="0">
  <!-- sale order header table -->
  <record model="db2.importer.table" id="db2_table_pentcdcl_for_10_customers">
    <field name="importer_id" ref="db2_importer_10_clients"/>
    <field name="schema">SBDATA</field>
    <field name="table_name">PENTCDCL</field>
    <field name="table_prefix">ecc</field>
    <field name="id_columns">eccsui,ecccli,eccsuc</field>
    <field name="create_job" eval="True"/>
    <field name="eta">2</field>
    <field name="where_clause">ecctyc &lt;&gt; 2 AND ecccli IN (354, 6891, 379, 8657, 8264, 8585, 3993, 560, 600)</field>
  </record>

  <!-- sale order detail line table -->
  <record model="db2.importer.table" id="db2_table_pdetcdcl_for_10_customers">
    <field name="importer_id" ref="db2_importer_10_clients"/>
    <field name="schema">SBDATA</field>
    <field name="table_name">PDETCDCL</field>
    <field name="table_prefix">dcc</field>
    <field name="id_columns">dccsui,dccncl,dccsuc,dccnli</field>
    <field name="where_clause">dccncl IN (354, 6891, 379, 8657, 8264, 8585, 3993, 560, 600)</field>
  </record>
  </data>


  <data noupdate="1">
    <record model="db2.importer" id="db2_ticket_importer">
      <field name="name">Helpdesk ticket importer</field>
      <field name="date_start">2018-06-22</field>
      <field name="mode">history</field>
    </record>
  </data>

  <data noupdate="0">
  <!-- helpdesk ticket detail line table -->
  <!-- DRECEP for "Détail réception" -->
  <record model="db2.importer.table" id="db2_table_drecep_for_ticket">
    <field name="importer_id" ref="db2_ticket_importer"/>
    <field name="schema">SBDATA</field>
    <field name="table_name">DRECEP</field>
    <field name="table_prefix">drp</field>
    <field name="id_columns">drpsui,drpseq</field>
    <field name="where_clause">drpprb &lt;&gt; ''</field>
    <field name="create_job" eval="False"/>
  </record>

  <!-- helpdesk ticket detail line table -->
  <!-- HISPRB for "Code problème" (for description)-->
  <!-- we create jobs with based on the number of entry of this table
       as DRECEP - o2m -> HISPRB - o2o -> HISSPR
       -->
  <record model="db2.importer.table" id="db2_table_hisprb_for_ticket">
    <field name="importer_id" ref="db2_ticket_importer"/>
    <field name="schema">SBDATA</field>
    <field name="table_name">HISPRB</field>
    <field name="table_prefix">hpb</field>
    <field name="id_columns">hpbsui,hpbnli,hpbcpb</field>
    <field name="create_job" eval="True"/>
    <field name="eta">2</field>
  </record>

  <!-- helpdesk ticket detail line table -->
  <!-- HISSPR for "Code problème" (for state) -->
  <record model="db2.importer.table" id="db2_table_hisspr_for_ticket">
    <field name="importer_id" ref="db2_ticket_importer"/>
    <field name="schema">SBDATA</field>
    <field name="table_name">HISSPR</field>
    <field name="table_prefix">hps</field>
    <field name="id_columns">hpssui,hpsnli,hpscpb</field>
    <field name="create_job" eval="False"/>
  </record>

  </data>

</odoo>
