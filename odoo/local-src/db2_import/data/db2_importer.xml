<odoo>
  <data noupdate="1">
    <record model="db2.importer" id="db2_sale_importer">
      <field name="name">Sale importer</field>
      <field name="date_start">2016-01-01</field>
      <field name="mode">history</field>
    </record>
  </data>

  <data noupdate="0">

  <!-- sale order header table -->
  <record model="db2.importer.table" id="db2_table_pentcdcl">
    <field name="importer_id" ref="db2_sale_importer"/>
    <field name="schema">SBDATA</field>
    <field name="table_name">PENTCDCL</field>
    <field name="table_prefix">ecc</field>
    <field name="id_columns">eccsui,ecccli,eccsuc</field>
    <field name="create_job" eval="True"/>
    <field name="eta">2</field>
  </record>

  <!-- sale order detail line table -->
  <record model="db2.importer.table" id="db2_table_pdetcdcl">
    <field name="importer_id" ref="db2_sale_importer"/>
    <field name="schema">SBDATA</field>
    <field name="table_name">PDETCDCL</field>
    <field name="table_prefix">dcc</field>
    <field name="id_columns">dccsui,dcccli,dccsuc,dccnli</field>
  </record>

  <!-- relation table between lot and move
       containing reference to sale order -->
  <record model="db2.importer.table" id="db2_table_mvtlot">
    <field name="importer_id" ref="db2_sale_importer"/>
    <field name="schema">SBDATA</field>
    <field name="table_name">MVTLOT</field>
    <field name="table_prefix">mlt</field>
    <field name="id_columns">mltart,mltlot,mltnum,mltsuc,mltsui,mltnli</field>
  </record>
  </data>

  <data noupdate="1">
    <record model="db2.importer" id="db2_purchase_importer">
      <field name="name">Purchase importer</field>
      <field name="date_start">2016-01-01</field>
      <field name="mode">history</field>
    </record>
  </data>

  <data noupdate="0">
  <!-- purchase order header table -->
  <record model="db2.importer.table" id="db2_table_pentcdfo">
    <field name="importer_id" ref="db2_purchase_importer"/>
    <field name="schema">SBDATA</field>
    <field name="table_name">PENTCDFO</field>
    <field name="table_prefix">ecf</field>
    <field name="id_columns">ecfsui,ecffou,ecfsuc</field>
    <field name="create_job" eval="True"/>
    <field name="eta">2</field>
  </record>

  <!-- purchase order detail line table -->
  <record model="db2.importer.table" id="db2_table_pdetcdfo">
    <field name="importer_id" ref="db2_purchase_importer"/>
    <field name="schema">SBDATA</field>
    <field name="table_name">PDETCDFO</field>
    <field name="table_prefix">dcf</field>
    <field name="id_columns">dcfsui,dcffou,dcfsuc,dcfnli</field>
  </record>
  </data>

  <!-- a specific importer to import history from the following 10 clients:
    ref  | name                        | tour | activity
    354  | ADAM BERNARD                | 98   | Vétérinaires
    6891 | BOTTON & CALBERG (CINEY PA) | 42   | Vétérinaires
    7583 | EPC DEPOT                   | 85   | Epécé
    379  | ETUDIANT COMPTOIR           | 95   | Etudiants
    8657 | NEW CAROLOVET               | 98   | Vétérinaires
    8264 | NEWPHARMA                   | 98   | Pharmacies
    8585 | OLALUX                      | 6    | Exportation
    3993 | STAFFE NATHALIE             | 28   | Vétérinaires
    560  | THISSEN-HOGGE               | 72   | Vétérinaires
    600  | ULG DEP. PÔLE EQUIN         | 98   | Vétérinaires

    -->
  <data noupdate="1">
    <record model="db2.importer" id="db2_importer_10_clients">
      <field name="name">10 clients sales importer</field>
      <field name="date_start">2012-01-01</field>
      <field name="mode">final_update</field>
    </record>
  </data>

  <data noupdate="0">
  <!-- sale order header table -->
  <record model="db2.importer.table" id="db2_table_pentcdcl">
    <field name="importer_id" ref="db2_importer_10_clients"/>
    <field name="schema">SBDATA</field>
    <field name="table_name">PENTCDCL</field>
    <field name="table_prefix">ecc</field>
    <field name="id_columns">eccsui,ecccli,eccsuc</field>
    <field name="create_job" eval="True"/>
    <field name="eta">2</field>
    <field name="where_clause">ecccli IN (354, 6891, 379, 8657, 8264, 8585, 3993, 560, 600)</field>
  </record>

  <!-- sale order detail line table -->
  <record model="db2.importer.table" id="db2_table_pdetcdcl">
    <field name="importer_id" ref="db2_importer_10_clients"/>
    <field name="schema">SBDATA</field>
    <field name="table_name">PDETCDCL</field>
    <field name="table_prefix">dcc</field>
    <field name="id_columns">dccsui,dccncl,dccsuc,dccnli</field>
    <field name="where_clause">dccncl IN (354, 6891, 379, 8657, 8264, 8585, 3993, 560, 600)</field>
  </record>

  <!-- relation table between lot and move
       containing reference to sale order -->
  <record model="db2.importer.table" id="db2_table_mvtlot">
    <field name="importer_id" ref="db2_importer_10_clients"/>
    <field name="schema">SBDATA</field>
    <field name="table_name">MVTLOT</field>
    <field name="table_prefix">mlt</field>
    <field name="id_columns">mltart,mltlot,mltnum,mltsuc,mltsui,mltnli</field>
    <field name="where_clause">mltnum IN (354, 6891, 379, 8657, 8264, 8585, 3993, 560, 600)</field>
  </record>
  </data>
</odoo>
