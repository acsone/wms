<odoo>
    <record id="view_order_form" model="ir.ui.view">
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Adds supplierinfo_discount_sale_allowed and discount_pricelist_id in sale.order form view -->
            <field name="pricelist_id" position="after">
                <field name="supplier_promotion_allowed"/>
                <field name="discount_pricelist_id" groups="product.group_sale_pricelist"/>
            </field>

            <!-- In Form view Remove label "discount"-->
            <xpath expr="//label[@for='discount']" position="delete" />
            <xpath expr="//div[@name='discount']" position="delete" />

            <!-- In form view replace discount by supplier_promotion and alcyon_discount -->
            <field name="price_unit" position="after">
                <field name="edited_supplier_promotion" invisible="1"/>
                <field name="supplier_promotion" readonly="0" class="oe_inline"/>
                <field name="edited_alcyon_discount" invisible="1"/>
                <field name="alcyon_discount" readonly="0" class="oe_inline"/>
            </field>

            <!-- Tree view of order_lines used in SO -->
            <xpath expr="//tree/field[@name='discount']" position="replace">
                <field name="supplier_promotion" readonly="0"/>
                <field name="edited_supplier_promotion" invisible="1"/>
                <field name="alcyon_discount" readonly="0"/>
                <field name="edited_alcyon_discount" invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>
