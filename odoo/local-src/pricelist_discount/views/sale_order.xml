<odoo>
    <record id="view_order_form" model="ir.ui.view">
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Adds promotion_pricelist_id and discount_pricelist_id in sale.order form view -->
            <field name="pricelist_id" position="after">
                <field name="promotion_pricelist_id" groups="product.group_sale_pricelist"/>
                <field name="discount_pricelist_id" groups="product.group_sale_pricelist"/>
            </field>

            <!-- In Form view Remove label "discount"-->
            <xpath expr="//label[@for='discount']" position="delete" />

            <!-- In form view replace discount by supplier_promotion and alcyon_discount -->
            <xpath expr="//div[@name='discount']" position="replace">
                <div name="supplier_promotion">
                    <field name="supplier_promotion" class="oe_inline"/>
                    %%
                </div>

                <div name="alcyon_discount">
                    <field name="alcyon_discount" class="oe_inline"/>
                    %%
                </div>
            </xpath>
            <!-- Tree view of order_lines used in SO -->
            <xpath expr="//tree/field[@name='discount']" position="replace">
                <field name="supplier_promotion"/>
                <field name="alcyon_discount"/>
            </xpath>
        </field>
    </record>
</odoo>
