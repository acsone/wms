<?xml version="1.0"?>
<odoo>
    <!-- Hide discount_policy in product price list -->
    <record model="ir.ui.view" id="product_pricelist_view_tree">
        <field name="name">product.pricelist.tree</field>
        <field name="model">product.pricelist</field>
        <field name="inherit_id" ref="product_visible_discount.product_pricelist_view_tree"/>
        <field name="arch" type="xml">
            <field name="discount_policy" position="attributes">
                <attribute name="invisible">True</attribute>
            </field>
        </field>
    </record>

    <record model="ir.ui.view" id="product_pricelist_view_form">
        <field name="name">product.pricelist.form</field>
        <field name="model">product.pricelist</field>
        <field name="inherit_id" ref="product_visible_discount.product_pricelist_view_form"/>
        <field name="arch" type="xml">
            <field name="discount_policy" position="attributes">
                <attribute name="invisible">True</attribute>
            </field>
        </field>
    </record>
</odoo>
