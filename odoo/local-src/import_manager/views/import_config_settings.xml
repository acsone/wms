<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="import_config_settings_view_form" model="ir.ui.view">
        <field name="name">import.config.settings.view.form</field>
        <field name="model">import.config.settings</field>
        <field name="arch" type="xml">
            <form string="Import configuration" class="oe_form_configuration">
                <header>
                    <button string="Apply" type="object" name="execute" class="oe_highlight"/>
                    <button string="Cancel" type="object" name="cancel" class="oe_link"/>
                </header>
                <group string="Imports">
                    <field name="import_path"/>
                </group>
            </form>
        </field>
    </record>

    <record id="action_import_config_settings" model="ir.actions.act_window">
        <field name="name">Import configuration</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">import.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
    </record>

    <menuitem id="main_menu_imports" name="Imports" parent="base.menu_custom"
            sequence="100"/>
    <menuitem id="menu_import_config_settings" name="Configuration" parent="main_menu_imports"
            sequence="10" action="action_import_config_settings"/>
</odoo>