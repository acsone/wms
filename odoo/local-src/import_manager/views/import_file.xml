<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="import_file_view_form" model="ir.ui.view">
        <field name="name">import.file.view.form</field>
        <field name="model">import.file</field>
        <field name="arch" type="xml">
            <form string="Import File">
                <header>
                    <button string="Execute import" type="object" name="execute_import"/>
                </header>
                <group>
                    <field name="name"/>
                    <field name="sequence"/>
                    <field name="importer"/>
                    <field name="filename"/>
                    <field name="file_type"/>
                    <field name="active"/>
                    <field name="last_import"/>
                </group>
                <label for="logger_ids"/>
                <field name="logger_ids">
                    <tree>
                        <field name="date_start"/>
                        <field name="date_end"/>
                        <field name="state"/>
                    </tree>
                </field>
            </form>
        </field>
    </record>

    <record id="import_file_view_tree" model="ir.ui.view">
        <field name="name">import.file.view.tree</field>
        <field name="model">import.file</field>
        <field name="arch" type="xml">
            <tree string="Import File">
                <field name="name"/>
                <field name="sequence"/>
                <field name="importer"/>
                <field name="filename"/>
                <field name="file_type"/>
                <field name="active"/>
                <field name="last_import"/>
                <button type="object" name="execute_import" icon="fa-play"/>
            </tree>
        </field>
    </record>

    <record id="import_file_action" model="ir.actions.act_window">
        <field name="name">Imports</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">import.file</field>
        <field name="view_mode">tree,form</field>
        <field name="view_type">form</field>
    </record>

    <menuitem id="menu_import_file_action" name="Imports" parent="main_menu_imports"
            sequence="40" action="import_file_action"/>
</odoo>