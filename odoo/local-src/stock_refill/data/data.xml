<?xml version="1.0"?>
<odoo noupdate="1">

    <record model="ir.cron" forcecreate="True" id="cron_compute_refill_priority">
        <field name="name">Compute Refill Priority</field>
        <field name="active">True</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="doall" eval="False" />
        <field eval="'()'" name="args"/>
        <field name="model">product.product</field>
        <field name="function">cron_compute_refill_priority</field>
        <field name="nextcall" eval="(DateTime.now()).strftime('%Y-%m-%d 0:00:01')" />
    </record>

</odoo>
