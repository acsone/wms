<?xml version="1.0"?>
<odoo>

    <record id="partner_archive_new_partner_view" model="ir.ui.view">
        <field name="name">partner.archive.new.partner.form</field>
        <field name="model">partner.archive.new.partner.wizard</field>
        <field name="arch" type="xml">
            <form string="Select new partner before archiving">
                <p>Select a new partner to replace the existing one on the following documents :</p>
                <group>
                    <field name="old_partner_id" invisible="1"/>
                    <field name="old_partner_company_id" invisible="1"/>
                    <field name="sale_ids">
                        <tree>
                            <field name="name"/>
                            <field name="date_order"/>
                            <field name="state"/>
                            <field name="user_id"/>
                            <field name="amount_total"/>
                        </tree>
                    </field>
                    <field name="picking_ids">
                        <tree>
                            <field name="name"/>
                            <field name="min_date"/>
                            <field name="state" />
                            <field name="location_id"/>
                            <field name="location_dest_id"/>
                        </tree>
                    </field>
                    <field name="invoice_ids">
                        <tree>
                            <field name="number"/>
                            <field name="name"/>
                            <field name="date_invoice"/>
                            <field name="state"/>
                            <field name="amount_total"/>
                            <field name="payment_term_id"/>
                            <field name="sent"/>
                        </tree>
                    </field>
                    <field name="new_partner_id"
                        domain="[
                            ('id', '!=', old_partner_id),
                            ('customer','=',True),
                            ('company_id','=', old_partner_company_id),
                            ]" />
                </group>
                <footer>
                    <button string="Change partner and archive" name="action_confirm"
                        type="object" class="btn-primary"
                        attrs="{'invisible': [('new_partner_id', '=', False)]}"/>
                    <button string="Cancel" class="btn-default" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

</odoo>
