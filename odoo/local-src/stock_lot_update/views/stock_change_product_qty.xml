<?xml version="1.0" encoding="utf-8"?>
<odoo>
        <record id="view_change_product_quantity_inherit" model="ir.ui.view">
            <field name="name">view.change.product.quantity.inherit</field>
            <field name="model">stock.change.product.qty</field>
            <field name="inherit_id" ref="stock.view_change_product_quantity" />
            <field name="arch" type="xml">
                <xpath expr="//field[@name='lot_id']" position="before">
                    <field name="product_tmpl_tracking" invisible="1"/>
                </xpath>

                <xpath expr="//field[@name='lot_id']" position="attributes">
                    <attribute name="attrs">{'required': [('product_tmpl_tracking', '=', 'lot')]}</attribute>
                </xpath>
            </field>
        </record>
</odoo>
