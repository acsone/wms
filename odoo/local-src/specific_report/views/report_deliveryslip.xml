    <template id="specific_report.report_deliveryslip">
        <t t-call="report.html_container">
            <t t-set="company" t-value="res_company"/>
            <t t-set="partner" t-value="deliveryslip.partner_id"/>

            <div class="header">
                <div>
                    <div class="logo">
                        <img t-if="company.logo"
                             t-att-src="'data:image/png;base64,%s' % company.logo"
                             style="max-height: 70px;"/>
                    </div>
                    <div class="main_title">
                        Delivery slip
                    </div>
                </div>

            </div>

            <t t-call="specific_report.report_deliveryslip_alcyon" t-lang="partner.lang"/>

            <t t-call="specific_report.page_number_footer" t-lang="partner.lang"/>
        </t>
    </template>

    <template id="specific_report.report_deliveryslip_entry_register">
        <t t-call="report.html_container">
            <t t-set="company" t-value="res_company"/>
            <t t-set="partner" t-value="deliveryslip.partner_id"/>

            <div class="header">
                <div>
                    <div class="logo">
                        <img t-if="company.logo"
                             t-att-src="'data:image/png;base64,%s' % company.logo"
                             style="max-height: 70px;"/>
                    </div>
                    <div class="main_title">
                        Entry register
                    </div>
                </div>

            </div>

            <t t-call="specific_report.report_deliveryslip_entry_register_body" t-lang="partner.lang"/>

            <t t-call="specific_report.page_number_footer" t-lang="partner.lang"/>
        </t>
    </template>

    <template id="stock.report_deliveryslip">
        <t t-foreach="docs" t-as="deliveryslip">
            <t t-call="specific_report.report_deliveryslip" t-lang="deliveryslip.partner_id.lang"/>
            <t t-if="deliveryslip.get_entry_register_lines()" t-call="specific_report.report_deliveryslip_entry_register" t-lang="deliveryslip.partner_id.lang"/>
        </t>
    </template>
</odoo>
