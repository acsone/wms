<odoo>
    <template id="specific_report.report_deliveryslip_alcyon">
        <div class="page">
            <div id="left_header" class="remove_padding_top">
                <table id="invoice_reference" class="border_table round_table">
                    <tr>
                        <td><span>Customer</span></td>
                        <td><span>N° Document</span></td>
                        <td><span>Scheduled date</span></td>
                    </tr>
                    <tr>
                        <td>
                            <span t-field="partner.ref"/>
                        </td>
                        <td>
                            <span t-field="deliveryslip.name"/>
                        </td>
                        <td>
                            <span t-field="deliveryslip.date"/>
                        </td>
                    </tr>
                    <tr>
                        <td colspan="3">
                            <span>Your VAT number:</span>
                            <span t-field="partner.vat"/>
                        </td>
                    </tr>
                </table>
            </div>

            <div id="partner_header" class="remove_padding_top">
                <t t-if="partner.parent_id">
                    <span t-field="partner.parent_id"/>
                    <br/>
                </t>
                <t t-if="partner.title">
                    <span t-field="partner.title"/>
                </t>
                <span t-field="partner.name"/>
                <br/>
                <t t-if="partner.street">
                    <span t-field="partner.street"/>
                    <br/>
                </t>
                <t t-if="partner.zip or partner.city">
                    <span t-field="partner.zip"/>
                    <span t-field="partner.city"/>
                    <br/>
                </t>
                <t t-if="partner.country_id">
                    <span t-field="partner.country_id"/>
                </t>
            </div>
            <table id="products_table" class="round_table products_table_deliveryslip">
                <thead>
                    <tr>
                        <th rowspan="2">Product<br/>reference</th>
                        <th rowspan="2">Name</th>
                        <th rowspan="2">Fridge</th>
                        <th rowspan="2">Quantity</th>
                        <th colspan="3" style="border-left: thin solid black;">By lot</th>
                    </tr>
                    <tr>
                        <th style="border-left: thin solid black;">Number</th>
                        <th>Quantity</th>
                        <th>Expiration date</th>
                    </tr>
                </thead>
                <tbody class="invoice_tbody">
                    <t t-foreach="deliveryslip.get_moves_by_order()" t-as="grouped_lines">
                        <t t-set="order" t-value="grouped_lines[0]"/>
                        <t t-set="move_lines" t-value="grouped_lines[1][0]"/>
                        <t t-set="backorder_move_lines" t-value="grouped_lines[1][1]"/>

                        <t t-if="order">
                            <tr><td/><td/><td/><td/><td/><td/><td/></tr>
                            <tr>
                                <td colspan="7" class="sale_separator">
                                    <div>
                                        <span>Order</span>
                                        <span t-field="order.name"/>
                                        <span>of</span>
                                        <span t-field="order.date_order_short"/>
                                    </div>
                                </td>
                            </tr>
                            <tr><td/><td/><td/><td/><td/><td/><td/></tr>
                        </t>

                        <t t-foreach="move_lines" t-as="line">
                            <t t-set="order_line" t-value="line.order_line_id"/>
                            <t t-set="quants" t-value="line.get_lots()"/>
                            <t t-set="first_quant" t-value="quants and quants.pop()"/>
                            <tr>
                                <td>
                                    <span t-field="line.product_id.default_code"/>
                                </td>
                                <td>
                                    <span t-field="line.product_id.name"/>
                                    <div t-if="line.serial_number"> (S/N: <span t-field="line.serial_number"/>)</div>
                                </td>
                                <td style="text-align: center;">
                                    <span t-if="line.product_id.picking_zone_id == line.env.ref('__setup__.picking_zone_frigo')">
                                        <i class="fa fa-check" aria-hidden="true"></i>
                                    </span>
                                </td>
                                <td>
                                    <span t-esc="int(line.product_qty)"/>
                                </td>
                                <td>
                                    <t t-esc="first_quant and first_quant[0] or ''"/>
                                </td>
                                <td>
                                    <t t-esc="first_quant and int(first_quant[1])  or ''"/>
                                </td>
                                <td>
                                    <t t-esc="first_quant and first_quant[2] and first_quant[2][:10] or ''"/>
                                </td>
                            </tr>
                            <tr t-foreach="quants" t-as="quant">
                                <td/>
                                <td/>
                                <td/>
                                <td/>
                                <td>
                                    <span t-esc="quant[0]"/>
                                </td>
                                <td>
                                    <span t-esc="int(quant[1])"/>
                                </td>
                                <td>
                                    <span t-esc="quant[2] and quant[2][:10]"/>
                                </td>
                            </tr>
                        </t>

                        <t t-if="backorder_move_lines">
                            <tr><td/><td/><td/><td/><td/><td/><td/></tr>
                            <tr>
                                <td colspan="7" class="sale_separator">
                                    <div class="no_background" style="padding-left: 2mm; padding-right: 2mm; padding-top: 1mm">
                                        <div t-if="order" style="padding-left: 2mm; padding-right: 2mm;">Balance to be delivered on order <span t-field="order.name"/></div>
                                        <div t-if="not order">Balance to be delivered</div>
                                        <table style="width: 50%;">
                                            <tbody>
                                                <tr t-foreach="backorder_move_lines" t-as="line">
                                                    <td style="border: none;">
                                                        <span t-field="line.product_id.default_code"/>
                                                    </td>
                                                    <td style="border: none;">
                                                        <span t-field="line.product_id.name"/>
                                                    </td>
                                                    <td style="border: none;">
                                                        <span t-esc="int(line.product_qty)"/>
                                                    </td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </td>
                            </tr>
                        </t>
                    </t>
                    <tr><td/><td/><td/><td/><td/><td/><td/></tr>
                </tbody>
            </table>

            <p id="delivery_condition" t-field="company.delivery_terms_conditions"/>

            <div class="row">
                <div class="col-xs-2">
                    <div class="border_table round_table summary_deliverslip">
                        <div style="text-align: center">
                            Number of<br/>packages<br/>
                            <strong><span t-esc="len(deliveryslip.pack_operation_pack_ids)"/></strong>
                        </div>
                    </div>
                </div>
                <div class="col-xs-4">
                    <div class="border_table round_table summary_deliverslip">
                        <div style="height: 50%; border-bottom: 1px solid black">
                            Round: <br/>
                            <span t-if="deliveryslip.delivery_round_id" t-field="deliveryslip.delivery_round_id.display_name" />
                        </div>
                        <div style="height: 50%">
                            Delivery:
                        </div>
                    </div>
                </div>
                <div class="col-xs-2">
                    <div class="border_table round_table summary_deliverslip" style="text-align: center">
                        <div style="height: 50%; border-bottom: 1px solid black">
                            PORT:
                        </div>
                        <div style="height: 50%">
                            Weight:<br/><span t-field="deliveryslip.weight"/> Kg
                        </div>
                    </div>
                </div>
                <div class="col-xs-4">
                    <div class="border_table round_table summary_deliverslip">
                        <div>
                            Received the:<br/>
                            Signature:
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </template>

    <template id="specific_report.report_deliveryslip">
        <t t-call="report.html_container">
            <t t-foreach="docs" t-as="deliveryslip">
                <t t-set="company" t-value="res_company"/>
                <t t-set="deliveryslip" t-value="deliveryslip.with_context({'lang': deliveryslip.partner_id.lang})"/>
                <t t-set="partner" t-value="deliveryslip.partner_id"/>

                <div class="header">
                    <div>
                        <div id="logo">
                            <img t-if="company.logo"
                                 t-att-src="'data:image/png;base64,%s' % company.logo"
                                 style="max-height: 70px;"/>
                        </div>
                        <div id="main_title">
                            Delivery slip
                        </div>
                    </div>

                </div>

                <t t-call="specific_report.report_deliveryslip_alcyon" t-lang="partner.lang"/>

                <t t-call="specific_report.page_number_footer"/>
            </t>
        </t>
    </template>

    <template id="stock.report_deliveryslip">
        <t t-call="specific_report.report_deliveryslip"/>
    </template>
</odoo>
