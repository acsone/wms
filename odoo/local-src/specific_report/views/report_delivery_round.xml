<odoo>
    <template id="delivery_rounds.delivery_round_report">
        <t t-foreach="docs" t-as="delivery">
            <t t-call="report.html_container">
                <t t-set="company" t-value="res_company"/>

                <div class="header">
                    <div class="row">
                        <div class="col-xs-1"/>
                        <div class="col-xs-10">
                            <table class="table table-bordered table-condensed">
                                <tbody>
                                    <tr>
                                        <td align="center" class="col-xs-3" style="vertical-align: middle;">
                                            <img t-if="company.logo" t-att-src="'data:image/png;base64,%s' % company.logo" style="max-height: 70px;"/>
                                        </td>
                                        <td align="center" class="col-xs-6" style="vertical-align: middle;">
                                            <span t-field="company.street"/>,
                                            <span t-field="company.zip"/>
                                            <span t-field="company.city"/>
                                            -
                                            <span t-field="company.country_id"/>
                                            <br/>
                                            <span>Phone:</span>
                                            <span t-field="company.phone"/>
                                            -
                                            <span>Fax:</span>
                                            <span t-field="company.fax"/>
                                            <br/>
                                            <span>Email:</span>
                                            <span t-field="company.email"/>
                                        </td>
                                        <td align="center" class="col-xs-3" style="vertical-align: middle;">
                                            Delivery round
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <div class="col-xs-1"/>
                    </div>
                </div>
                <div class="page">
                    <h2><span t-field="delivery.name"/></h2>
                    <div class="row" style="margin-top: 15px;">
                        <div class="col-xs-5">
                            <table class="table">
                                <tbody>
                                    <tr>
                                        <td class="col-ws-4">Driver</td>
                                        <td class="col-ws-8"></td>
                                    </tr>
                                    <tr>
                                        <td>Vehicle</td>
                                        <td></td>
                                    </tr>
                                    <tr>
                                        <td>Registration</td>
                                        <td></td>
                                    </tr>
                                    <tr>
                                        <td>Start mileage</td>
                                        <td></td>
                                    </tr>
                                    <tr>
                                        <td>End mileage</td>
                                        <td></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <div class="col-xs-2"/>
                        <div class="col-xs-5">
                            <table class="table">
                                <tbody>
                                    <tr>
                                        <td class="col-ws-4">Stops</td>
                                        <td class="col-ws-8">
                                            <span t-esc="len(delivery.shipping_ids)" />
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>Departure time</td>
                                        <td></td>
                                    </tr>
                                    <tr>
                                        <td>Arriving time</td>
                                        <td></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="row">
                        <table class="table table-bordered table-condensed">
                            <thead>
                                <tr class="active">
                                    <th>Seq.</th>
                                    <th>Reference</th>
                                    <th>Name</th>
                                    <th>Address</th>
                                    <th>Mobile</th>
                                    <th>Phone</th>
                                    <th>Notes</th>
                                    <th># Drug</th>
                                    <th># Cold</th>
                                    <th># Food</th>
                                    <th># Equip.</th>
                                    <th># Hum.</th>
                                    <th># Tot.</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="delivery.shipping_ids" t-as="shipping">
                                    <td>
                                        <span t-field="shipping.sequence" />
                                    </td>
                                    <td>
                                        <span t-field="shipping.name" />
                                    </td>
                                    <td>
                                        <span t-field="shipping.partner_id.name" />
                                    </td>
                                    <td>
                                        <address t-field="shipping.partner_id"
                                                 t-field-options='{"widget": "contact", "fields": ["address"], "no_marker": true}' />
                                    </td>
                                    <td>
                                        <span t-field="shipping.partner_id.mobile" />
                                    </td>
                                    <td>
                                        <span t-field="shipping.partner_id.phone" />
                                    </td>
                                    <td>
                                        <span t-field="shipping.note" />
                                    </td>
                                    <td>
                                        <span t-esc="int(shipping.number_of_drug)"/>
                                    </td>
                                    <td>
                                        <span t-esc="int(shipping.number_of_cold)"/>
                                    </td>
                                    <td>
                                        <span t-esc="int(shipping.number_of_food)"/>
                                    </td>
                                    <td>
                                        <span t-esc="int(shipping.number_of_equipment)"/>
                                    </td>
                                    <td>
                                        <span t-esc="int(shipping.number_of_human_food)"/>
                                    </td>
                                    <td>
                                        <span t-esc="int(shipping.number_total)"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <t t-call="specific_report.page_number_footer"/>
            </t>
        </t>
    </template>

    <report
            string="Delivery round"
            id="action_report_delivery_round"
            model="round.instance"
            report_type="qweb-pdf"
            name="delivery_rounds.delivery_round_report"
            file="delivery_rounds.delivery_round_report"
        />
</odoo>
