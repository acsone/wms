<odoo>
    <template id="delivery_rounds.delivery_round_report">
        <t t-foreach="docs" t-as="delivery">
            <t t-call="report.html_container">
                <t t-set="index" t-as="1"/>
                <div class="page">
                    <h2><span t-field="delivery.name"/></h2>
                    <div class="row" style="margin-top: 15px;">
                        <div class="col-xs-5">
                            <table class="table">
                                <tbody>
                                    <tr>
                                        <td class="col-ws-4">Driver</td>
                                        <td class="col-ws-8"></td>
                                    </tr>
                                    <tr>
                                        <td>Vehicle</td>
                                        <td></td>
                                    </tr>
                                    <tr>
                                        <td>Registration</td>
                                        <td></td>
                                    </tr>
                                    <tr>
                                        <td>Start mileage</td>
                                        <td></td>
                                    </tr>
                                    <tr>
                                        <td>End mileage</td>
                                        <td></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <div class="col-xs-2"/>
                        <div class="col-xs-5">
                            <table class="table">
                                <tbody>
                                    <tr>
                                        <td class="col-ws-4">Stops</td>
                                        <td class="col-ws-8">
                                            <span t-esc="len(delivery.shipping_ids)" />
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>Departure time</td>
                                        <td><span t-esc="delivery.get_time_leave_planned()"/></td>
                                    </tr>
                                    <tr>
                                        <td>Arriving time</td>
                                        <td></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="row">
                        <table class="table table-bordered table-condensed">
                            <thead>
                                <tr class="active">
                                    <th>Seq.</th>
                                    <th>Customer</th>
                                    <th>Mobile</th>
                                    <th>Phone</th>
                                    <th># Drug</th>
                                    <th># Cold</th>
                                    <th># Food</th>
                                    <th># Equip.</th>
                                    <th># Hum.</th>
                                    <th># Tot.</th>
                                    <th>Notes</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="delivery.shipping_ids.filtered(lambda x: x.state == 'done')" t-as="shipping">
                                    <td>
                                        <span t-esc="index" />
                                    </td>
                                    <td>
                                        <span t-field="shipping.partner_id.name" />
                                        <address t-field="shipping.partner_id"
                                                 t-field-options='{"widget": "contact", "fields": ["address"], "no_marker": true}' />
                                    </td>
                                    <td>
                                        <span t-field="shipping.partner_id.mobile" />
                                    </td>
                                    <td>
                                        <span t-field="shipping.partner_id.phone" />
                                    </td>
                                    <td>
                                        <t t-if="shipping.number_of_drug">
                                            <span t-esc="int(shipping.number_of_drug)"/>
                                            box(es)
                                        </t>
                                        <br t-if="shipping.number_of_drug and shipping.item_number_of_drug"/>
                                        <t t-if="shipping.item_number_of_drug">
                                            <span t-esc="int(shipping.item_number_of_drug)"/>
                                            unit(s)
                                        </t>
                                    </td>
                                    <td>
                                        <t t-if="shipping.number_of_cold">
                                            <span t-esc="int(shipping.number_of_cold)"/>
                                            box(es)
                                        </t>
                                        <br t-if="shipping.number_of_cold and shipping.item_number_of_cold"/>
                                        <t t-if="shipping.item_number_of_cold">
                                            <span t-esc="int(shipping.item_number_of_cold)"/>
                                            unit(s)
                                        </t>
                                    </td>
                                    <td>
                                        <t t-if="shipping.number_of_food">
                                            <span t-esc="int(shipping.number_of_food)"/>
                                            box(es)
                                        </t>
                                        <br t-if="shipping.number_of_food and shipping.item_number_of_food"/>
                                        <t t-if="shipping.item_number_of_food">
                                            <span t-esc="int(shipping.item_number_of_food)"/>
                                            unit(s)
                                        </t>
                                    </td>
                                    <td>
                                        <t t-if="shipping.number_of_equipment">
                                            <span t-esc="int(shipping.number_of_equipment)"/>
                                            box(es)
                                        </t>
                                        <br t-if="shipping.number_of_equipment and shipping.item_number_of_equipment"/>
                                        <t t-if="shipping.item_number_of_equipment">
                                            <span t-esc="int(shipping.item_number_of_equipment)"/>
                                            unit(s)
                                        </t>
                                    </td>
                                    <td>
                                        <t t-if="shipping.number_of_human_drug">
                                            <span t-esc="int(shipping.number_of_human_drug)"/>
                                            box(es)
                                        </t>
                                        <br t-if="shipping.number_of_human_drug and shipping.item_number_of_human_drug"/>
                                        <t t-if="shipping.item_number_of_human_drug">
                                            <span t-esc="int(shipping.item_number_of_human_drug)"/>
                                            unit(s)
                                        </t>
                                    </td>
                                    <td>
                                        <t t-if="shipping.number_total">
                                            <span t-esc="int(shipping.number_total)"/>
                                            box(es)
                                        </t>
                                        <br t-if="shipping.number_total and shipping.item_number_total"/>
                                        <t t-if="shipping.item_number_total">
                                            <span t-esc="int(shipping.item_number_total)"/>
                                            unit(s)
                                        </t>
                                    </td>
                                    <td style="width: 33%;">
                                        <strong>
                                            <span t-field="shipping.note" />
                                        </strong>
                                    </td>
                                </tr>
                                <t t-set="index + 1" t-as="index"/>
                            </tbody>
                        </table>
                    </div>
                </div>
            </t>
        </t>
    </template>

    <report
            string="Delivery round"
            id="action_report_delivery_round"
            model="round.instance"
            report_type="qweb-pdf"
            name="delivery_rounds.delivery_round_report"
            file="delivery_rounds.delivery_round_report"
        />
</odoo>
