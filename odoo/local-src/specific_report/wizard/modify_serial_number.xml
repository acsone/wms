<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="modify_serial_number_view_form" model="ir.ui.view">
        <field name="name">Modify serial number view form</field>
        <field name="model">modify.serial.number</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="serial_number"/>
                </group>

                <footer>
                    <button name="save_new_serial_number" string="Apply"
                            type="object" class="btn btn-sm btn-primary" />
                    <button string="Cancel" class="btn btn-sm btn-default" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
