<?xml version="1.0" encoding="utf-8"?>
<odoo>
         <record id="view_product_template_stock_bin_form" model="ir.ui.view">
            <field name="name">product.template.stock.bin.form</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="stock.view_template_property_form"/>
            <field name="arch" type="xml">
                <group name="stock_property" position="before">
                    <group name="stock_bins">
                        <field name="stock_bin_ids" nolabel="1">
                            <tree editable="bottom">
                                <field name="sequence" widget="handle"/>
                                <field name="location_id" />

                                <field name="bin_location_id" domain="[('id','child_of',location_id),('usage', '=', 'internal'), ('act_as_view', '=', False)]"
                                    attrs="{'readonly':[('location_id','=',False)]}" />
                            </tree>
                        </field>
                    </group>
                </group>
            </field>
        </record>
</odoo>
