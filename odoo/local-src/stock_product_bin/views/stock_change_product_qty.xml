<?xml version="1.0" encoding="utf-8"?>
<openerp>
    <data>
        <record id="view_change_product_quantity_inherit" model="ir.ui.view">
            <field name="name">view.change.product.quantity.inherit</field>
            <field name="model">stock.change.product.qty</field>
            <field name="inherit_id" ref="stock.view_change_product_quantity" />
            <field name="arch" type="xml">
                <xpath expr="//field[@name='location_id']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>

                <xpath expr="//field[@name='location_id']" position="after">
                    <field name="stock_bin_ids" context="{'default_product_id': product_id}">
                        <tree editable="bottom">
                            <field name="product_id" invisible="1"/>
                            <field name="sequence" widget="handle"/>
                            <field name="location_id" />
                            <field name="bin_location_id" domain="[('id','child_of',location_id),('usage', '=', 'internal')]"
                                attrs="{'readonly':[('location_id','=',False)]}" />
                        </tree>
                    </field>
                </xpath>
            </field>
        </record>
    </data>
</openerp>
