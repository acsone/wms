<?xml version="1.0" encoding="utf-8"?>
<openerp>
    <data>
        <record id="view_round_zone_import" model="ir.ui.view">
            <field name="name">Delivery Date</field>
            <field name="model">round.zone.import</field>
            <field name="arch" type="xml">
                <form string="Import Zone">
                    <group>
                        <field name="zone_id"/>
                    </group>
                    <footer>
                        <button name="confirm"
                            string="Confirm" type="object"
                            class="oe_highlight"/>
                        or
                        <button string="Cancel" class="oe_link"
                            special="cancel" />
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_round_zone_import" model="ir.actions.act_window">
            <field name="name">Import Zone</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">round.zone.import</field>
            <field name="view_type">form</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_round_zone_import"/>
            <field name="target">new</field>
        </record>
    </data>
<openerp>
