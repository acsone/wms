<?xml version="1.0" encoding="utf-8"?>
<odoo>
        <record id="view_picking_assign_delivery_round" model="ir.ui.view">
            <field name="name">Delivery Date</field>
            <field name="model">picking.assign.delivery.round</field>
            <field name="arch" type="xml">
                <form string="Include in a Delivery Round">
                    <group>
                        <field name="delivery_round_id"/>
                    </group>
                    <footer>
                        <button name="confirm"
                            string="Confirm" type="object"
                            class="oe_highlight"/>
                        or
                        <button string="Cancel" class="oe_link"
                            special="cancel" />
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_picking_assign_delivery_round" model="ir.actions.act_window">
            <field name="name">Assign Delivery Round</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">picking.assign.delivery.round</field>
            <field name="view_type">form</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_picking_assign_delivery_round"/>
            <field name="target">new</field>
        </record>
</odoo>
