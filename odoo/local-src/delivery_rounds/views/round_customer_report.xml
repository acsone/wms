<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <template id="round_customer_report" name="round.instance.customer report">
    <ol>
      <li t-foreach="pickings" t-as="picking">
        <strong><span t-esc="picking['picking'].name"/></strong> <span t-esc="picking['message']" />
      </li>
    </ol>
  </template>

  <template id="round_report_delivery" name="round.instance report_delivery">
    <p>Failed to deliver some pickings, you can retry manually from this view.</p>
    <br />
    <ol>
      <li t-foreach="customers" t-as="customer">
        <strong><span t-esc="customer['customer'].partner_id.display_name"/></strong> <span t-raw="customer['report']" />
      </li>
    </ol>
  </template>
  
</odoo>
