<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="cron_delivery_plan_tree" model="ir.ui.view">
        <field name="name">cron.delivery.plan.tree</field>
        <field name="model">cron.delivery.plan</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="week_day" atts="{'required': [('date_overwrite', '=', False)]}"/>
                <field name="date_overwrite" atts="{'required': [('week_day', '=', False)]}"/>
                <field name="next_execution"/>
                <field name="version_id"/>
                <field name="tag_ids" widget="many2many_tags"/>
                <field name="active" invisible="1"/>
            </tree>
        </field>
    </record>

    <record id="action_cron_delivery_plan" model="ir.actions.act_window">
        <field name="name">Cron delivery plan</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">cron.delivery.plan</field>
        <field name="view_type">form</field>
        <field name="view_mode">tree</field>
    </record>

    <menuitem id="menu_cron_delivery_plan" action="action_cron_delivery_plan" parent="menu_delivery_round_settings" sequence="110"/>
</odoo>
