<?xml version="1.0"?>
<openerp>
  <data>

    <record id="view_round_zone_tree" model="ir.ui.view">
        <field name="name">round.zone.tree</field>
        <field name="model">round.zone</field>
        <field name="arch" type="xml">
            <tree string="Zones">
                <field name="code" />
                <field name="name" />
            </tree>
        </field>
    </record>
    <record id="view_round_zone_form" model="ir.ui.view">
        <field name="name">round.zone.form</field>
        <field name="model">round.zone</field>
        <field name="arch" type="xml">
            <form string="Zones">
                <group>
                    <group>
                        <field name="name" />
                        <field name="code" />
                    </group>
                    <group>
                        <field name="vehicle_id" />
                    </group>
                </group>
                <field name="partner_position_ids">
                    <tree string="Partners" editable="top">
                        <field name="sequence" />
                        <field name="partner_id" />
                    </tree>
                </field>
            </form>
        </field>
    </record>

    <record id="action_round_zone_tree" model="ir.actions.act_window">
        <field name="name">Zones</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">round.zone</field>
        <field name="view_type">form</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem action="action_round_zone_tree" id="menu_round_zone" parent="menu_delivery_round" sequence="20"/>


  </data>
</openerp>

