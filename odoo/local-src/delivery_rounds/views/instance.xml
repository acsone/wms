<?xml version="1.0"?>
<odoo>

    <record id="view_round_instance_kanban" model="ir.ui.view">
        <field name="name">round.instance.kanban</field>
        <field name="model">round.instance</field>
        <field name="arch" type="xml">
            <kanban class="oe_background_grey o_kanban_dashboard o_stock_kanban">
                <field name="color"/>
                <field name="state"/>
                <field name="count_picking_available_total"/>
                <field name="count_picking_available_partner"/>
                <field name="count_picking_available_weight"/>
                <templates>
                    <t t-name="kanban-box">
                      <div class="delivery_round_kanban">
                        <div t-attf-class="#{kanban_color(record.color.raw_value)}">
                            <div class="o_kanban_card_header">
                                <div class="o_kanban_card_header_title">
                                    <div class="o_primary"><field name="template_id"/></div>
                                    <div class="o_secondary">
                                        <div style="display:inline-table"><strong><field name="time_picking_planned" widget="float_time"/></strong></div>
                                        <div style="display:inline-table;white-space:pre"> | </div>
                                        <div style="display:inline-table"><strong><field name="time_leave_planned" widget="float_time"/></strong></div>
                                        <!-- nodate is not transfered in the context from search view
                                        <field name="date" t-if="!user_context['nodate']"/>
                                        -->
                                    </div>
                                </div>
                                <div class="o_kanban_manage_button_section">
                                    <a class="o_kanban_manage_toggle_button" href="#">More <i class="fa fa-caret-down"/></a>
                                </div>
                            </div>
                            <div class="container o_kanban_card_content o_visible">
                                <div class="row">
                                    <div class="col-xs-6 o_kanban_primary_left">
                                        <button class="btn btn-primary" name="action_picking_tree_available" type="object">
                                            <span ><t t-esc="record.count_picking_available_total.value"/> Pickings</span>
                                        </button>
                                    </div>
                                    <div class="col-xs-6 o_kanban_primary_right">
                                        <div class="row">
                                            <div class="col-xs-9">
                                                Destinations
                                            </div>
                                            <div class="col-xs-3">
                                                <field name="count_picking_available_partner"/>
                                            </div>
                                        </div>

                                        <div class="row">
                                            <div class="col-xs-9">
                                                Weight
                                            </div>
                                            <div class="col-xs-3">
                                                <field name="count_picking_available_weight"/>kg
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="row" style="margin-top:-20px">
                                    <!-- TODO: if we show this, we better optimize its loading
                                    <field name="itinerary_ids"/>
                                    -->
                                </div>
                                <div class="row" style="margin-top:140px">
                                    <div class="col-xs-12 o_kanban_primary_bottom" t-attf-style="#{(record.state.raw_value=='draft' and 'background-color: lightblue') or (record.state.raw_value=='open' and 'background-color: lightgreen') or ''}">
                                        <field name="count_picking_done_total" widget="progress" title="Pickings" options="{'current_value': 'count_picking_done_total', 'max_value': 'count_picking_available_total'}"/>
                                    </div>
                                </div>
                            </div><!--
                            No space here
                            --><div class="container o_kanban_card_manage_pane o_invisible">
                            <div class="row">
                                <div class="col-xs-6 o_kanban_card_manage_section o_kanban_manage_view">
                                    <div class="o_kanban_card_manage_title">
                                        <span>Actions</span>
                                    </div>
                                    <div><a name="button_confirm" type="object" states="draft">Launch Pickings</a></div>
                                    <div><a name="button_deliver" type="object" states="open">Deliver</a></div>
                                    <div><a name="print_all_deliveryslip" type="object" states="done">Print all deliveryslip</a></div>
                                    <br/>
                                </div>
                            </div>
                            <div t-if="widget.editable" class="o_kanban_card_manage_settings row">
                                <div class="col-xs-8">
                                    <ul class="oe_kanban_colorpicker" data-field="color"/>
                                </div>
                                <div class="col-xs-4 text-right">
                                    <a type="edit">Edit</a>
                                </div>
                            </div>
                        </div>
                        </div>
                      </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>


    <record id="view_round_instance_search" model="ir.ui.view">
        <field name="name">round.instance.search</field>
        <field name="model">round.instance</field>
        <field name="arch" type="xml">
            <search string="Delivery Rounds">
                <field name="template_name"/>
                <field name="template_code"/>
                <field name="date" context="{'nodate':1}"/>
                <separator/>
                <field name="partner_ids" string="Customer"/>
                <filter name="today" string="Today" domain="[('date','=',time.strftime('%%Y-%%m-%%d'))]" context="{'nodate':1}"/>
            </search>
        </field>
    </record>

    <record id="view_round_instance_tree" model="ir.ui.view">
        <field name="name">round.instance.tree</field>
        <field name="model">round.instance</field>
        <field name="arch" type="xml">
            <tree string="Delivery Rounds">
                <field name="date" />
                <field name="time_picking_planned" widget="float_time"/>
                <field name="time_leave_planned" widget="float_time"/>
                <field name="template_id" />
                <field name="name" />
                <field name="state" />
                <field name="tag_ids" widget="many2many_tags" options="{'no_create': True}"/>
            </tree>
        </field>
    </record>

    <record id="view_round_instance_form" model="ir.ui.view">
        <field name="name">round.instance.form</field>
        <field name="model">round.instance</field>
        <field name="arch" type="xml">
            <form string="Delivery Round">
                <header>
                    <button name="button_confirm" type="object" string="Launch Pickings" states="draft" class="oe_highlight"/>
                    <button name="button_deliver" type="object" string="Deliver" states="open" class="oe_highlight"/>
                    <button name="print_all_deliveryslip" type="object" string="Print all deliveryslip" states="done" class="oe_highlight"/>
                    <field name="state" widget="statusbar" clickable="False"/>

                </header>
                <sheet>

                    <div class="oe_button_box" name="button_box">

                        <button class="oe_stat_button" name="action_view_shippings"
                                type="object" icon="fa-truck">
                            <field string="Deliveries" name="shipping_count" widget="statinfo" />
                        </button>

                        <button class="oe_stat_button" name="action_view_pickings"
                                type="object" icon="fa-truck">
                            <field string="Pickings" name="picking_count" widget="statinfo" />
                        </button>

                    </div>

                    <div class="oe_title">
                        <h1>
                            <field name="template_id" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="date" />
                            <field name="time_picking_planned" widget="float_time"/>
                            <field name="time_leave_planned" widget="float_time"/>
                        </group>
                        <group>
                            <field name="name"/>
                            <field name="itinerary_ids" widget="many2many_tags"/>
                            <field name="tag_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        </group>
                    </group>
                    <button name="button_itinerary_import" type="object" string="Import from itinerary"/>
                    <notebook>
                        <page string="Customers">
                            <field name="instance_customer_ids">
                                <tree editable="bottom" create="0" delete="0">
                                    <field name="partner_id"/>
                                    <field name="rank"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Statistics">
                            <group>
                                <field name="stat_time_picking" widget="float_time"/>
                                <field name="stat_time_leave" widget="float_time"/>
                            </group>
                        </page>
                    </notebook>

                </sheet>
            </form>
        </field>
    </record>

    <record id="action_round_instance" model="ir.actions.act_window">
        <field name="name">Delivery Rounds</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">round.instance</field>
        <field name="view_type">form</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="context">{'search_default_today': 1}</field>
    </record>

    <menuitem action="action_round_instance" id="menu_round_instance" parent="menu_delivery_round" sequence="20"/>


</odoo>
