<?xml version="1.0"?>
<odoo>

    <record id="view_round_vehicle_tree" model="ir.ui.view">
        <field name="name">round.vehicle.tree</field>
        <field name="model">round.vehicle</field>
        <field name="arch" type="xml">
            <tree string="Vehicles">
                <field name="time" widget="float_time"/>
                <field name="name" />
            </tree>
        </field>
    </record>
    <record id="view_round_vehicle_form" model="ir.ui.view">
        <field name="name">round.vehicle.form</field>
        <field name="model">round.vehicle</field>
        <field name="arch" type="xml">
            <form string="Vehicles">
                <group>
                    <field name="name" />
                    <field name="time" widget="float_time" />
                </group>
                <group string="Zones">
                    <field name="zone_ids" nolabel="1"/>
                </group>
            </form>
        </field>
    </record>

    <record id="action_round_vehicle_tree" model="ir.actions.act_window">
        <field name="name">Vehicles</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">round.vehicle</field>
        <field name="view_type">form</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem action="action_round_vehicle_tree" id="menu_round_vehicle" parent="menu_delivery_round_settings" sequence="20"/>


</odoo>

