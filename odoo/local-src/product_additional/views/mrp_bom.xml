<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record model="ir.ui.view" id="view_mrp_bom_specific_form">
        <field name="name">mrp.bom.specific.form</field>
        <field name="model">mrp.bom</field>
        <field name="inherit_id" ref="mrp.mrp_bom_form_view"/>
        <field name="arch" type="xml">

            <field name="company_id" position="before">
                <field name="bom_with_additional_product"/>
            </field>

            <xpath expr="//field[@name='bom_line_ids']/tree/field[@name='product_uom_id']" position="after">
                <field name="is_additional_product"/>
            </xpath>

        </field>
    </record>

    <record model="ir.ui.view" id="view_mrp_bom_line_specific_form">
        <field name="name">mrp.bom.line.specific.form</field>
        <field name="model">mrp.bom.line</field>
        <field name="inherit_id" ref="mrp.mrp_bom_line_view_form"/>
        <field name="arch" type="xml">

            <div class="o_row" position="after">
                <field name="is_additional_product"/>
            </div>

        </field>
    </record>

</odoo>
