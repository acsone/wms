<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record model="ir.ui.view" id="view_sale_order_specific_form">
        <field name="name">sale.order.specific.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <field name="carrier_id" position="after">
                <field name="compute_shipping_costs_on_invoice" invisible="True"/>
            </field>

            <xpath expr="//field[@name='delivery_price']/parent::div" position="attributes">
                <attribute name="attrs">{'invisible': [('compute_shipping_costs_on_invoice', '=', True)]}</attribute>
            </xpath>

        </field>
    </record>

</odoo>