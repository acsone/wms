<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record model="ir.ui.view" id="view_account_invoice_specific_form">
        <field name="name">account.invoice.specific.form</field>
        <field name="model">account.invoice</field>
        <field name="inherit_id" ref="account.invoice_form"/>
        <field name="arch" type="xml">

            <header position="inside">
                <field name="allow_compute_shipping_costs" invisible="True"/>
                <button name="compute_shipping_costs" type="object" string="Compute Shipping Costs" class="oe_highlight"
                         attrs="{'invisible':[('allow_compute_shipping_costs','!=',True)]}"/>
            </header>

        </field>
    </record>

</odoo>