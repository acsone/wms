<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="scheduled_week_days_form" model="ir.ui.view">
        <field name="name">scheduled.week.days.form</field>
        <field name="model">scheduled.week.days</field>
        <field name="arch" type="xml">
            <form string="">
                <sheet>
                    <group>
                        <label string="Closing delivery dates"/>
                        <table class="table table-bordered text-center table-condensed" style="width: auto;">
                            <tr>
                                <th><label for="day_1"/></th>
                                <th><label for="day_2"/></th>
                                <th><label for="day_3"/></th>
                                <th><label for="day_4"/></th>
                                <th><label for="day_5"/></th>
                                <th><label for="day_6"/></th>
                                <th><label for="day_7"/></th>
                            </tr>
                            <tr>
                                <td><field name="day_1" nolabel="1"/></td>
                                <td><field name="day_2" nolabel="1"/></td>
                                <td><field name="day_3" nolabel="1"/></td>
                                <td><field name="day_4" nolabel="1"/></td>
                                <td><field name="day_5" nolabel="1"/></td>
                                <td><field name="day_6" nolabel="1"/></td>
                                <td><field name="day_7" nolabel="1"/></td>
                            </tr>
                        </table>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="partner_scheduled_week_form" model="ir.ui.view">
        <field name="name">partner.scheduled.week.form</field>
        <field name="model">partner.scheduled.week</field>
        <field name="arch" type="xml">
            <form string="">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="start_date"/>
                        <field name="end_date"/>
                        <field name="partner_id" invisible="1"/>
                    </group>
                    <group name="week">
                        <label string="Closing delivery dates End date included"/>
                        <table class="table table-bordered text-center table-condensed" style="width: auto;">
                            <tr>
                                <th><label for="day_1"/></th>
                                <th><label for="day_2"/></th>
                                <th><label for="day_3"/></th>
                                <th><label for="day_4"/></th>
                                <th><label for="day_5"/></th>
                                <th><label for="day_6"/></th>
                                <th><label for="day_7"/></th>
                            </tr>
                            <tr>
                                <td><field name="day_1" nolabel="1"/></td>
                                <td><field name="day_2" nolabel="1"/></td>
                                <td><field name="day_3" nolabel="1"/></td>
                                <td><field name="day_4" nolabel="1"/></td>
                                <td><field name="day_5" nolabel="1"/></td>
                                <td><field name="day_6" nolabel="1"/></td>
                                <td><field name="day_7" nolabel="1"/></td>
                            </tr>
                        </table>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="scheduled_week_days_tree" model="ir.ui.view">
        <field name="name">partner.scheduled.week.tree</field>
        <field name="model">partner.scheduled.week</field>
        <field name="arch" type="xml">
            <tree string="Partners working days">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
            </tree>
        </field>
    </record>

    <record id="partner_scheduled_week_action" model="ir.actions.act_window">
        <field name="name">Partner Scheduled Days</field>
        <field name="res_model">partner.scheduled.week</field>
        <field name="view_type">form</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('partner_id', '=', active_id)]</field>
    </record>

</odoo>
