<?xml version="1.0" encoding="UTF-8" ?>
<odoo noupdate="1">
    <record id="ir_cron_execute_all_exports" model="ir.cron">
        <field name="name">Execute all exports</field>
        <field eval="False" name="active" />
        <field name="user_id" ref="base.user_root" />
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field eval="False" name="doall" />
        <field eval="'zelapro.export'" name="model" />
        <field eval="'execute_all_exports'" name="function" />
        <field name="nextcall" eval="(DateTime.now()).strftime('%Y-%m-%d 3:00:01')" />
    </record>

    <record id="ir_cron_update_abc_code" model="ir.cron">
        <field name="name">Update ABC Code</field>
        <field eval="False" name="active" />
        <field name="user_id" ref="base.user_root" />
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field eval="False" name="doall" />
        <field eval="'zelapro.config.settings'" name="model" />
        <field eval="'recompute_all_abc_code'" name="function" />
        <field name="nextcall" eval="(DateTime.now()).strftime('%Y-%m-%d 2:00:01')" />
    </record>
</odoo>