<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="import_cadencier_header" model="import.file">
        <field name="name">Import Cadencier header</field>
        <field name="importer">import.cadencier.header</field>
        <field name="filename">H_\w*.csv</field>
        <field name="is_regex" eval="1"/>
        <field name="file_type">csv</field>
        <field name="sequence">10</field>
    </record>

    <record id="import_cadencier_details" model="import.file">
        <field name="name">Import Cadencier Details</field>
        <field name="importer">import.cadencier</field>
        <field name="filename">D_\w*.csv</field>
        <field name="is_regex" eval="1"/>
        <field name="file_type">csv</field>
        <field name="sequence">20</field>
    </record>
</odoo>