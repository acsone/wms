<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="zelapro_config_settings_view_form" model="ir.ui.view">
        <field name="name">zelapro.config.settings.view.form</field>
        <field name="model">zelapro.config.settings</field>
        <field name="arch" type="xml">
            <form string="Configure Zelapro" class="oe_form_configuration">
                <header>
                    <button string="Apply" type="object" name="execute" class="oe_highlight"/>
                    <button string="Cancel" type="object" name="cancel" class="oe_link"/>
                </header>
                <group string="Exports">
                    <field name="delimiter"/>
                    <field name="export_path"/>
                </group>
            </form>
        </field>
    </record>

    <record id="action_zelapro_config_settings" model="ir.actions.act_window">
        <field name="name">Configure Zelapro</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">zelapro.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
    </record>

    <menuitem id="menu_zelapro_config_settings" name="Settings" parent="main_menu_zelapro"
            sequence="10" action="action_zelapro_config_settings"/>
</odoo>