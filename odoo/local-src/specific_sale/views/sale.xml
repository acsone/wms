<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_order_form" model="ir.ui.view">
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <field name="team_id" position="after">
                <field name="sale_channel_visible" invisible="1"/>
                <field name="sale_channel" attrs="{'invisible': [('sale_channel_visible', '=', False)]}"/>
            </field>

            <field name="client_order_ref" position="replace"/>

            <field name="partner_id" position="after">
                <field name="client_order_ref"/>
            </field>

            <xpath expr="//field[@name='order_line']/form//label[@for='qty_delivered']" position="before">
                <field name="product_qty_unavailable"/>
            </xpath>

            <xpath expr="//field[@name='order_line']/tree//field[@name='product_uom_qty']" position="after">
                <field name="product_qty_unavailable"/>
            </xpath>

            <xpath expr="//field[@name='order_line']/tree//field[@name='price_subtotal']" position="after">
                <field name="exception"/>
            </xpath>

            <xpath expr="//field[@name='order_line']/tree" position="attributes">
                <attribute name="decoration-warning">exception</attribute>
            </xpath>

            <xpath expr="//field[@name='order_line']/form//field[@name='analytic_tag_ids']/parent::div" position="after">
                <field name="next_expected_date_for_receipt"/>
                <label for="production_lot_ids" colspan="2"/>
                <div colspan="2">
                    <field name="production_lot_ids" context="{'only_wh_stock_quants': True}">
                        <tree>
                            <field name="name"/>
                            <field name="product_qty"/>
                            <field name="product_uom_id"/>
                            <field name="use_date"/>
                            <field name="life_date"/>
                        </tree>
                    </field>
                </div>
            </xpath>

        </field>
    </record>

    <record id="view_order_lines_unavailable_tree" model="ir.ui.view">
        <field name="name">sale.order.lines.unavailable.tree</field>
        <field name="model">sale.order.line</field>
        <field name="priority">2000</field>
        <field name="arch" type="xml">
            <tree string="Sales Order Lines Unavailable" create="false" delete="false">
                <field name="product_id" invisible="1"/>
                <field name="order_id"/>
                <field name="order_partner_id"/>
                <field name="name"/>
                <field name="product_uom_qty"/>
                <field name="product_qty_unavailable" string="Quantity unavailable at order line save"/>
                <field name="current_product_qty_unavailable" string="Quantity unavailable at now"/>
                <field name="qty_delivered"/>
                <field name="product_qty_remains_to_deliver"/>
            </tree>
        </field>
    </record>

    <record id="action_sale_lines_unavailable_list" model="ir.actions.act_window">
        <field name="name">Sale Order Lines Unavailable</field>
        <field name="res_model">sale.order.line</field>
        <field name="view_id" ref="view_order_lines_unavailable_tree"/>
        <field name="domain">[('state', 'in', ['sale'])]</field>
    </record>

    <menuitem id="menu_sale_lines_unavailable_list"
              action="action_sale_lines_unavailable_list"
              parent="sales_team.menu_sale_report"
              sequence="200"/>

    <record id="sale.action_quotations" model="ir.actions.act_window">
        <field name="domain">[('state', 'not in', ('sale', 'done'))]</field>
    </record>


</odoo>
