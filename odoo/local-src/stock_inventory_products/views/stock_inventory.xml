<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="stock_inventory_view_form" model="ir.ui.view">
        <field name="name">stock.inventory.view.form inherit</field>
        <field name="model">stock.inventory</field>
        <field name="inherit_id" ref="stock.view_inventory_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/group/group[field[@name='location_id']]" position="after">
                <div attrs="{'invisible': ['|',('filter', '!=', 'products_selected'),('state', '!=', 'draft')]}">
                    <label for="product_ids"/>
                    <field name="product_ids" attrs="{'required': [('filter', '=', 'products_selected')]}"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
