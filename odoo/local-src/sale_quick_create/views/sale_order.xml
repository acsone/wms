<odoo>

    <record model="ir.ui.view" id="sale_order_form_view">
        <field name="name">sale.order.form (in sale_quick_create)</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="specific_sale.view_order_form"/>
        <field name="arch" type="xml">
            <form position="inside">
                <field name="is_quick_edited" invisible="1"/>
            </form>
            <header position="attributes">
                <attribute name="attrs">{'invisible': [("is_quick_edited", "=", True)]}</attribute>
            </header>
            <header position="after">
                <div class="alert alert-warning"
                     style="margin-bottom:0px;"
                     role="alert"
                     attrs="{'invisible': [('is_quick_edited', '=', False)]}">
                    You are into 'Lines Fast Entry' mode. Do you want to finalize this process?
                    <button name="action_finalize_quick_edit"
                        type="object"
                        class="btn-primary"
                        icon="fa-floppy-o"
                        string="Finalize"
                    />
                </div>

            </header>
            <div class="oe_button_box" name="button_box" position="inside">
                <button name="action_open_line_fast_entry"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-pencil-square-o"
                    >
                  <span>Lines Fast Entry</span>
                </button>
            </div>

        </field>
    </record>



</odoo>
