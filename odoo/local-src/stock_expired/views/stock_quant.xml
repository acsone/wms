<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record model="ir.ui.view" id="view_stock_quant_expired_tree">
        <field name="name">stock.quant.expired.tree</field>
        <field name="model">stock.quant</field>
        <field name="priority">2000</field>
        <field name="arch" type="xml">
            <tree string="Stock quants" create="false" edit="false" delete="false">
                <field name="product_id"/>
                <field name="qty"/>
                <field name="product_uom_id"/>
                <field name="lot_id"/>
                <field name="location_id"/>
                <field name="alert_date"/>
                <field name="removal_date"/>
                <field name="use_date"/>
                <field name="life_date"/>
            </tree>
        </field>
    </record>

    <record id="stock_quant_specific_search" model="ir.ui.view">
        <field name="name">stock.quant.specific.search</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.quant_search_view"/>
        <field name="arch" type="xml">

            <filter name="positive" position="after">
                <separator/>
                <field name="removal_date"/>
                <filter name="on_alert" string="Quants on alert" domain="[('alert_date', '&lt;', time.strftime('%Y-%m-%d %H:%M:%S'))]"/>
                <filter name="expired" string="Quants expired" domain="[('removal_date', '&lt;', time.strftime('%Y-%m-%d %H:%M:%S'))]"/>
            </filter>

        </field>
    </record>

    <record id="action_stock_quant_expired_tree" model="ir.actions.act_window">
        <field name="name">Stock quant expired</field>
        <field name="res_model">stock.quant</field>
        <field name="view_type">form</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_on_alert':1, 'search_default_expired':1}</field>
        <field name="view_id" ref="view_stock_quant_expired_tree"/>
    </record>

    <menuitem action="action_stock_quant_expired_tree" id="menu_action_stock_quant_expired_tree" parent="stock.menu_stock_inventory_control" sequence="200"/>

</odoo>
