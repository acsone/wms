<odoo noupdate="1">

  <record forcecreate="True" id="ir_cron_edi_import" model="ir.cron">
    <field name="name">EDI - Imports</field>
    <field eval="True" name="active"/>
    <field name="user_id" ref="base.user_root"/>
    <field name="interval_number">1</field>
    <field name="interval_type">minutes</field>
    <field name="numbercall">-1</field>
    <field eval="False" name="doall"/>
    <field eval="'edi.backend'" name="model"/>
    <field eval="'cron_import'" name="function"/>
    <field eval="'()'" name="args"/>
    <field eval="1" name="run_as_queue_job"/>
    <field ref="queue_job_cron.channel_root_ir_cron" name="channel_id"/>
  </record>
</odoo>