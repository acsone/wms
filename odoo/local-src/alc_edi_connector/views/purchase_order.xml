<odoo>

    <record model="ir.ui.view" id="purchase_order_form_view">
        <field name="name">purchase.order.form (in alc_edi_connector)</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase_order_approved.purchase_order_form"/>
        <field name="arch" type="xml">
            <button name="button_release" position="before">
                <field name="is_edi_available" invisible="1"/>
                <button name="send_ubl_order_document"
                        string="Send UBL Order"
                        type="object"
                        states="approved"
                        class="oe_highlight"
                        attrs="{'invisible': [('is_edi_available', '=', False)]}"/>
            </button>
        </field>
    </record>



</odoo>
