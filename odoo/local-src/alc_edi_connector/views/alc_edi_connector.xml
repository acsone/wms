<odoo>

    <record model="ir.ui.view" id="alc_edi_connector_form_view">
        <field name="name">alc.edi.connector.form (in alc_edi_connector)</field>
        <field name="model">alc.edi.connector</field>
        <field name="arch" type="xml">
            <form>
                <header>
                     <button name="test_connection" string="Test connection" class="oe_highlight" type="object"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" />
                        </h1>
                    </div>
                    <group>
                        <field name="channel"/>
                    </group>
                    <group name="sftp">
                        <field name="hostname"/>
                        <field name="username"/>
                        <field name="password" password="True"/>
                        <field name="port"/>
                        <field name="pk_env_variable"/>
                        <field name="path_read"/>ble"/>
                        <field name="path_write"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record model="ir.ui.view" id="alc_edi_connector_tree_view">
        <field name="name">alc.edi.connector.tree (in alc_edi_connector)</field>
        <field name="model">alc.edi.connector</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="channel"/>
            </tree>
        </field>
    </record>

    <record model="ir.actions.act_window" id="alc_edi_connector_act_window">
        <field name="name">Edi Connector</field>
        <field name="res_model">alc.edi.connector</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>

    <record model="ir.ui.menu" id="alc_edi_connector_menu">
        <field name="name">Edi Connector</field>
        <field name="parent_id" ref="base.menu_custom"/>
        <field name="action" ref="alc_edi_connector_act_window"/>
        <field name="sequence" eval="16"/>
    </record>

</odoo>
