<?xml version="1.0" encoding="utf-8"?>
<openerp>
<data>

    <record id="view_picking_form" model="ir.ui.view">
        <field name="name">stock.picking.form.print</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <button name="put_in_pack" position="after">
                <button class="oe_link oe_right"
                    name="print_packages_label" type="object"
                    string="&#128438;Print Packs" />
                <button class="oe_link oe_right"
                    name="print_products_label" type="object"
                    string="&#128438;Print Products" />
            </button>
        </field>
    </record>

    <record id="view_pack_operation_details_form" model="ir.ui.view">
        <field name="name">stock.pack.operation.details.form</field>
        <field name="model">stock.pack.operation</field>
        <field name="inherit_id" ref="stock.view_pack_operation_details_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='qty_to']" position="before">
                <header>
                    <button type="object" name="print_product_label" string="Print Product Label"/>
                </header>
            </xpath>
        </field>
    </record>

</data>
</openerp>
