<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--Helpdesk Ticket-->
    <record id="helpdesk_ticket_view_form" model="ir.ui.view">
        <field name="name">helpdesk.ticket.form</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_ticket_view_form" />
        <field name="arch" type="xml">
            <field name="kanban_state" position="after">
                <field name="sale_order_id" />
                <field name="purchase_order_id" />
            </field>
            <field name="tag_ids" position="after">
                <field name="helpdesk_ticket_reason_id" />
                <field name="ref" />
            </field>
            <field name="ticket_type_id" position="attributes">
                <attribute name="attrs">{'readonly': [('stock_picking_id', '!=', False)]}</attribute>
            </field>
            <field name="ticket_type_id" position="after">
                <field name="stock_picking_id" attrs="{'invisible': [('stock_picking_id', '=', False)], 'readonly': [('stock_picking_id', '!=', False)]}" />
            </field>
        </field>
    </record>

    <!--Helpdesk Ticket Reason-->
    <record id="helpdesk_ticket_reasom_view_tree" model="ir.ui.view">
        <field name="name">helpdesk.ticket.reason.tree</field>
        <field name="model">helpdesk.ticket.reason</field>
        <field name="arch" type="xml">
            <tree editable="top" string="Reason">
                <field name="name"/>
            </tree>
        </field>
    </record>

    <record id="helpdesk_ticket_reason_action" model="ir.actions.act_window">
        <field name="name">Ticket Reason</field>
        <field name="res_model">helpdesk.ticket.reason</field>
        <field name="view_type">form</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
          <p class="oe_view_nocontent_create">
            Click to create a new ticket reason.
          </p><p>
            Reason allows to organize tickets.
          </p>
        </field>
    </record>

    <menuitem id="helpdesk_ticket_reason_menu" action="helpdesk_ticket_reason_action"
        sequence="1" parent="helpdesk.helpdesk_menu_config"
        groups="base.group_no_one"/>

</odoo>
