#. module: specific_helpdesk
#: model:mail.template,body_html:specific_helpdesk.email_template_helpdesk_msg_1
msgid "<?xml version=\"1.0\"?>\n"
"<div style=\"max-width:600px; height:auto; margin-left:30px;\">\n"
"    <div style=\"margin-left:30px;align=center;\">\n"
"        Dear ${object.sudo().partner_id.name or 'Madam, Sir'},\n"
"    </div>\n"
"    <div style=\"margin-left:30px;align=center;\" width=\"60%\">\n"
"        MESSAGE_01\n"
"    </div><br/>\n"
"    <span style=\"margin-left:30px;font-weight:normal;\">Thank you </span>\n"
"    <span style=\"margin-left:30px;font-weight:normal;\">${object.team_id.name or 'Helpdesk'} Team.</span>\n"
"</div>\n"
"        "
msgstr "<?xml version=\"1.0\"?>\n"
"<div style=\"max-width:600px; height:auto; margin-left:30px;\">\n"
"    Chère/Cher ${object.sudo().partner_id.name or 'Madame/Monsieur'},<br/><br/>\n"
"    </div>\n"
"    <div style=\"margin-left:30px;align=center;\" width=\"60%\">\n"
"        Lors de votre livraison du ${object.stock_picking_id.date_done} nous avons constaté que ${object.qty_received} de ${object.product_id.name} étai(en)t abîmé(s)\n"
"        Merci de reprendre ce(s) produit(s) et de nous le(s) créditer.\n"
"    </div><br/>\n"
"    <span style=\"margin-left:30px;font-weight:normal;\">Merci,</span>\n"
"    L'Équipe ${object.team_id.name or 'Helpdesk'}.\n"
"</div>\n"
"        "

