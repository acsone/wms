<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="bank_holiday_view_tree" model="ir.ui.view">
        <field name="name">bank.holiday.view.tree</field>
        <field name="model">bank.holiday</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="name"/>
                <field name="date"/>
            </tree>
        </field>
    </record>

    <record id="bank_holiday_action" model="ir.actions.act_window">
        <field name="name">Bank Holidays</field>
        <field name="res_model">bank.holiday</field>
        <field name="view_type">form</field>
        <field name="view_mode">tree</field>
        <field name="context">{}</field>
        <field name="view_id" ref="bank_holiday_view_tree"/>
    </record>

    <menuitem id="main_menu_calendar_config" name="Configuration" parent="calendar.mail_menu_calendar" sequence="5"/>
    <menuitem id="menu_bank_holiday_action" name="Bank Holidays" parent="main_menu_calendar_config" sequence="1" action="bank_holiday_action" groups="purchase.group_purchase_manager"/>

</odoo>
