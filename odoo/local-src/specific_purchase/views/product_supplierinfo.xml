<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="product_supplierinfo_view_form" model="ir.ui.view">
        <field name="name">product.supplierinfo.view.form</field>
        <field name="model">product.supplierinfo</field>
        <field name="inherit_id" ref="product.product_supplierinfo_form_view"/>
        <field name="priority">40</field>
        <field name="arch" type="xml">

            <xpath expr="//label[@for='date_start']" position="replace"/>
            <xpath expr="//div[field[@name='date_start']]" position="replace"/>

            <xpath expr="//group[label[@for='price']]" position="attributes">
                <attribute name="string">Purchase</attribute>
            </xpath>

            <xpath expr="//group[field[@name='product_tmpl_id']]" position="before">
                <group name="price_list" string="Price List">
                    <label for="date_start" string="Validity"/>
                    <div><field name="date_start" class="oe_inline"/> to <field name="date_end" class="oe_inline"/></div>
                </group>
            </xpath>

        </field>
    </record>

</odoo>
