<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="product_supplierinfo_view_tree" model="ir.ui.view">
        <field name="name">product.supplierinfo.view.tree</field>
        <field name="model">product.supplierinfo</field>
        <field name="priority">200</field>
        <field name="arch" type="xml">
            <tree string="Supplier info" editable="top">
                <field name="name"/>
                <field name="product_tmpl_id" domain="[('supplier_id', '=', name)]"/>
                <field name="product_cnk_code" readonly="1" />
                <field name="product_code"/>
                <field name="min_qty"/>
                <field name="price"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="discount_purchase" />
                <field name="discount_sale" />
                <button name="open_form_view" type="object" icon="fa-pencil-square-o"/>
            </tree>
        </field>
    </record>

    <record id="product_supplierinfo_view_form" model="ir.ui.view">
        <field name="name">product.supplierinfo.view.form</field>
        <field name="model">product.supplierinfo</field>
        <field name="priority">300</field>
        <field name="arch" type="xml">
            <form string="Supplier info" >
                <sheet>
                    <div class="oe_title">
                        <label class="oe_edit_only" for="name" string="Supplier"/>
                        <h1><field name="name" placeholder="Supplier"/></h1>
                        <label class="oe_edit_only" for="product_tmpl_id" string="Product"/>
                        <h2><field name="product_tmpl_id" domain="[('supplier_id', '=', name)]" placeholder="Product"/></h2>
                    </div>
                    <group>
                        <field name="product_cnk_code" readonly="1"/>
                        <field name="product_code"/>
                    </group>
                    <group>
                        <field name="min_qty"/>
                        <field name="price"/>
                        <field name="date_start"/>
                        <field name="date_end"/>
                        <field name="discount_purchase" />
                        <field name="discount_sale" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>


    <record id="action_product_supplierinfo" model="ir.actions.act_window">
        <field name="name">Vendor Promotions</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">product.supplierinfo</field>
        <field name="view_id" ref="specific_purchase.product_supplierinfo_view_tree"/>
        <field name="view_type">form</field>
        <field name="view_mode">form,tree</field>
    </record>

    <menuitem
        action="action_product_supplierinfo" id="menu_product_supplierinfo"
        parent="purchase.menu_procurement_management" sequence="17"
      />
</odoo>
