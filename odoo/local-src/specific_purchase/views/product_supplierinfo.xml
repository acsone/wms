<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="product_supplierinfo_view_form" model="ir.ui.view">
        <field name="name">product.supplierinfo.view.form</field>
        <field name="model">product.supplierinfo</field>
        <field name="priority">200</field>
        <field name="arch" type="xml">
            <tree string="Supplier info" editable="top">
                <field name="name"/>
                <field name="product_tmpl_id"/>
                <field name="product_name"/>
                <field name="product_code"/>
                <field name="min_qty"/>
                <field name="price"/>
                <field name="date_start"/>
                <field name="date_end"/>
            </tree>
        </field>
    </record>

    <record id="action_product_supplierinfo" model="ir.actions.act_window">
        <field name="name">Vendor Promotions</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">product.supplierinfo</field>
        <field name="view_id" ref="specific_purchase.product_supplierinfo_view_form"/>
        <field name="view_type">form</field>
        <field name="view_mode">tree</field>
    </record>

    <menuitem
        action="action_product_supplierinfo" id="menu_product_supplierinfo"
        parent="purchase.menu_procurement_management" sequence="17"
      />
</odoo>