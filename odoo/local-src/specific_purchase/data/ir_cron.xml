<?xml version="1.0" encoding="UTF-8" ?>
<odoo noupdate="1">
    <record id="generate_procurement_order" model="ir.cron">
        <field name="name">Generate procurement order</field>
        <field name="active" eval="True"/>
        <field name="user_id" ref="base.user_root" />
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field eval="False" name="doall" />
        <field eval="'procurement.order'" name="model" />
        <field eval="'_procure_orderpoint_confirm'" name="function" />
        <field name="nextcall" eval="(datetime.now()).strftime('%Y-%m-%d 4:00:01')" />
    </record>
</odoo>
