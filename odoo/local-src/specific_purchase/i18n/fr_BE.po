#. module: specific_purchase
#: model:mail.template,body_html:specific_purchase.cancel_purchase_order
msgid "\n"
"            \n"
"                <p>Hello,</p>\n"
"                <p>We decided to cancel the purchase order ${object.partner_ref or ''} (${object.amount_total} €) from ${object.date_order} for the following reason:<br/>\n"
"                ${object.cancel_reason_id.name}</p>\n"
"                <p>Thank you for your understanding.</p>\n"
"                <p>Best regards,<br/>\n"
"                Alcyon</p>\n"
"            \n"
"        "
msgstr "\n"
"            \n"
"                <p>Bonjour,</p>\n"
"                <p>Nous avons décidé d'annuler la commande ${object.partner_ref or ''} (${object.amount_total} €) du ${object.date_order} pour la cause suivante:<br/>\n"
"                ${object.cancel_reason_id.name}</p>\n"
"                <p>Nous vous remercions de votre compréhension.</p>\n"
"                <p>Bien à vous,<br/>\n"
"                Alcyon</p>\n"
"            \n"
"        "

