<odoo>
    <record id="view_partner_simple_form" model="ir.ui.view">
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="account.view_partner_property_form"/>
        <field name="arch" type="xml">
            <field name="function" position="before">
                <field name="alcyon_category_id"/>
                <field name="depot_number_visible" invisible="1"/>
                <field name="depot_number"
                       attrs="{'invisible': [('depot_number_visible', '=', False)], 'required': [('depot_number_visible', '=', True)]}"/>
            </field>
            <group name="fiscal_information" position="inside">
                <field name="legal_entity" attrs="{'invisible': [('company_type', '=', 'person')]}"/>
            </group>
        </field>
    </record>
</odoo>
