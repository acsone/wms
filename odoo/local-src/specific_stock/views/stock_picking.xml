<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_picking_form" model="ir.ui.view">
        <field name="name">stock.picking.form.print</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page/button[@name='put_in_pack']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//header" position="inside">
                <button class="oe_link oe_right"
                    name="%(put_in_pack_helper_action)d" type="action"
                    string="&#8627;Put in Pack" context="{'default_picking_id': active_id}"/>
            </xpath>

            <xpath expr="//button[@name='do_new_transfer']" position="attributes">
                <attribute name="attrs">{'invisible': ['|', ('operator_id', '=', False), ('state', 'not in', ['draft','partially_available','assigned'])]}</attribute>
                <attribute name="states"/>
            </xpath>

            <xpath expr="//field[@name='pack_operation_product_ids']" position="attributes">
                <attribute name="attrs">{'readonly': [('operator_id', '=', False)]}</attribute>
            </xpath>
            <xpath expr="//field[@name='pack_operation_product_ids']/tree" position="inside">
                <field name="operator_id" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='pack_operation_product_ids']/tree/button[@name='split_lot']" position="attributes">
                <attribute name="attrs">{'invisible': ['|', '|', ('lots_visible', '=', False), ('state', 'not in', ['confirmed', 'assigned', 'waiting', 'partially_available','done']), ('operator_id', '=', False)]}</attribute>
            </xpath>
            <xpath expr="//field[@name='pack_operation_product_ids']/tree/button[@name='show_details']" position="attributes">
                <attribute name="attrs">{'invisible': ['|', ('state', 'not in', ['confirmed', 'assigned', 'waiting', 'partially_available']), ('operator_id', '=', False)]}</attribute>
                <attribute name="states"/>
            </xpath>

            <xpath expr="//field[@name='pack_operation_pack_ids']" position="attributes">
                <attribute name="attrs">{'invisible': [('pack_operation_pack_ids', '=', []), ('picking_type_entire_packs', '=', False)], 'readonly': [('operator_id', '=', False)]}</attribute>
            </xpath>
            <xpath expr="//field[@name='pack_operation_pack_ids']/tree" position="inside">
                <field name="operator_id" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='pack_operation_pack_ids']/tree/button[@name='show_details']" position="attributes">
                <attribute name="attrs">{'invisible': ['|', ('state', 'not in', ['confirmed', 'assigned', 'waiting', 'partially_available']), ('operator_id', '=', False)]}</attribute>
                <attribute name="states"/>
            </xpath>

            <field name="min_date" position="after">
                <field name="date_done" />
            </field>
        </field>
    </record>

    <record id="view_stock_picking_tree" model="ir.ui.view">
        <field name="name">Picking Type</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='picking_type_id']" position="attributes">
                <attribute name="invisible">0</attribute>
            </xpath>
        </field>
    </record>

</odoo>
