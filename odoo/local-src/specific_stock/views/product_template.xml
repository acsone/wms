<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_product_template_specific_form" model="ir.ui.view">
        <field name="name">product.template.specific.form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="stock.view_template_property_form"/>
        <field name="arch" type="xml">

            <field name="use_time" position="attributes">
                <attribute name="readonly">True</attribute>
            </field>

            <field name="life_time" position="attributes">
                <attribute name="readonly">True</attribute>
            </field>

            <field name="removal_time" position="attributes">
                <attribute name="readonly">True</attribute>
            </field>

            <field name="alert_time" position="attributes">
                <attribute name="readonly">True</attribute>
            </field>

        </field>
    </record>

    <record id="product_template_only_form_view" model="ir.ui.view">
        <field name="name">product_template_only_form_view</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='route_from_categ_ids']" position="after">
                <field name="picking_zone_id" options="{'no_create': True, 'no_open': True}"/>
            </xpath>
        </field>
    </record>

</odoo>
