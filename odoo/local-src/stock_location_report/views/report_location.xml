<odoo>
    <template id="assets_specific" inherit_id="report.assets_common">
        <xpath expr="." position="inside">
            <link rel="stylesheet" href="/stock_location_report/static/src/css/location_report.css"/>
        </xpath>
    </template>

    <template id="stock.location_report">
        <t t-call="report.html_container">
        <t t-call="report.external_layout">
            <div t-foreach="docs.filtered(lambda r: not r.height.isdigit())._get_by_position('zone')" t-as="zone" class="page">
            <h1>Zone: <t t-esc="zone"/></h1>
            <div class="zone">
                <t t-foreach="zone_value._get_by_position('corridor')" t-as="corridor" class="corridor">

                <t t-set="shelfs" t-value="zone_value._get_by_position('shelf', reverse=corridor_index % 2).keys()"/>

                <t t-foreach="[corridor_index % 2, (corridor_index+1) % 2]" t-as="oddeven">
                    <div class="corridor">
                        <div><t t-esc="corridor"/></div>
                        <div><table>
                            <tr class="height height_header">
                                <td><div> </div></td>
                                <td t-foreach="shelfs" t-as="shelf" t-if="shelf.isdigit() and int(shelf) % 2 - oddeven" class="shelf">
                                    <div>
                                        <t t-esc="shelf"/>
                                    </div>
                                </td>
                            </tr>
                            <tr t-foreach="corridor_value._get_by_position('height', reverse=1)" t-as="height" class="height">
                                <td><div><t t-esc="height"/></div></td>
                                <td t-foreach="shelfs" t-as="shelf" t-if="shelf.isdigit() and int(shelf) % 2 - oddeven" class="shelf">
                                    <div class="box"
                                            t-att-style="'background-color:%s' % box_value.color"
                                            t-foreach="height_value.filtered(lambda r: r.shelf==shelf)._get_by_position('box', reverse=corridor_index % 2)" t-as="box">
                                        <t t-esc="box_value.bin_checksum_1"/>
                                    </div>
                                </td>
                            </tr>
                        </table></div>
                    </div>
                    <div class="spacer" t-if="not oddeven_index"> </div>
                </t>
                </t>
            </div>
        </div>
        </t>
        </t>
    </template>

    <report
            string="Locations"
            id="action_report_location"
            model="stock.location"
            report_type="qweb-html"
            name="stock.location_report"
            file="stock.location_report"
        />
</odoo>
