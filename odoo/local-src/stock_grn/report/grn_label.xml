<template id="grn_label">
    <html>
    <head>
    <style>

    </style>
    </head>
    <body>

    <div class="header">
        <div style="float:left;font-size:10px">
            <span t-field="report.name"/>
        </div>
        <div style="float:right;font-size:10px">
            <span t-field="user.name"/>
        </div>
    </div>

    <div class="footer">
    </div>

    <t t-set="labelnr" t-value="1"/>
    <div class="page">
        <t t-foreach="docs" t-as="object">

            <div t-att-style="'padding:10px 10px; font-size:11px; page-break-inside:avoid; overflow:hidden; border:0px solid black; display:inline-block; width:%s%%%%; height:29.9mm;' % (100 / paperformat.content_columns)">
                <div style="white-space:nowrap">
                    <span t-field="object.name"/>
                </div>
            </div>

            <t t-set="labelnr" t-value="labelnr + 1"/>
            <t t-if="labelnr > paperformat.content_count and object != object[-1]">
                <p style="page-break-after: always">&amp;nbsp;</p>
                <t t-set="labelnr" t-value="1"/>
            </t>
        </t>
    </div>
    </body>
    </html>
</template>

